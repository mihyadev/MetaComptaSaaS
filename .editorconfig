# EditorConfig — keep French source files UTF-8
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cshtml,css,js,json,md,yml,yaml}]
charset = utf-8

[*.{cs,cshtml}]
indent_style = space
indent_size = 4

[*.{css,js,json,yml,yaml}]
indent_style = space
indent_size = 2
