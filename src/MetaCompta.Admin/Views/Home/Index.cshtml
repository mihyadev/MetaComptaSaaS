@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard Administrateur";
    var cabResult = ViewBag.CabinetsResult as ApiResponse<AdminPagedResult>;
    var cabItems = cabResult?.Data?.Items ?? new List<JsonElement>();
    var totalCabinets = cabResult?.Data?.TotalCount ?? 0;
    var activeCabinets = cabItems.Count(i => i.TryGetProperty("isActive", out var a) && a.GetBoolean());
    var totalUsers = cabItems.Sum(i => i.TryGetProperty("userCount", out var u) ? u.GetInt32() : 0);
}

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3" style="border-left:4px solid #dc2626;">
            <div class="text-muted small">Cabinets Totaux</div>
            <div class="fw-bold fs-2">@totalCabinets</div>
            <small class="text-success">@activeCabinets actif(s)</small>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3" style="border-left:4px solid #10b981;">
            <div class="text-muted small">Utilisateurs Totaux</div>
            <div class="fw-bold fs-2">@totalUsers</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3" style="border-left:4px solid #f59e0b;">
            <div class="text-muted small">Cabinets Actifs</div>
            <div class="fw-bold fs-2">@activeCabinets</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3" style="border-left:4px solid #2563eb;">
            <div class="text-muted small">Cabinets Inactifs</div>
            <div class="fw-bold fs-2">@(totalCabinets - activeCabinets)</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between">
                <h6 class="fw-bold"><i class="bi bi-building me-2 text-danger"></i>Cabinets</h6>
                <a href="/Cabinets" class="btn btn-sm btn-outline-danger rounded-pill">Voir tout</a>
            </div>
            <div class="card-body px-4">
                <table class="table table-hover table-sm">
                    <thead><tr><th>Cabinet</th><th>Email</th><th>Utilisateurs</th><th>Statut</th></tr></thead>
                    <tbody>
                        @if (cabItems.Count == 0) {
                        <tr><td colspan="4" class="text-center text-muted py-3">Aucun cabinet. <a href="/Cabinets">Cr&eacute;er un cabinet</a></td></tr>
                        }
                        @foreach (var item in cabItems.Take(5))
                        {
                            var name = item.GetProperty("name").GetString() ?? "";
                            var email = item.GetProperty("email").GetString() ?? "";
                            var isActive = item.TryGetProperty("isActive", out var actEl) && actEl.GetBoolean();
                            var userCount = item.TryGetProperty("userCount", out var ucEl) ? ucEl.GetInt32() : 0;
                        <tr>
                            <td class="fw-medium">@name</td>
                            <td><code class="small">@email</code></td>
                            <td>@userCount</td>
                            <td>@if (isActive) { <span class="badge bg-success">Actif</span> } else { <span class="badge bg-secondary">Inactif</span> }</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h6 class="fw-bold"><i class="bi bi-lightning me-2 text-danger"></i>Actions Rapides</h6>
            </div>
            <div class="card-body px-4">
                <a href="/Cabinets" class="btn btn-outline-danger w-100 mb-2 rounded-pill"><i class="bi bi-building-add me-2"></i>G&eacute;rer les Cabinets</a>
                <a href="/ReferenceData" class="btn btn-outline-primary w-100 mb-2 rounded-pill"><i class="bi bi-database me-2"></i>Donn&eacute;es de R&eacute;f&eacute;rence</a>
                <a href="/AuditLogs" class="btn btn-outline-secondary w-100 rounded-pill"><i class="bi bi-journal-text me-2"></i>Journaux d'Audit</a>
            </div>
        </div>
    </div>
</div>