<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetaCompta Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Nav(string c) => ctrl == c ? "nav-link active" : "nav-link";
}

<nav class="mc-sidebar" id="sidebar" aria-label="Administration">
    <div class="sidebar-brand">
        <div class="brand-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <div>
            <h4>MetaCompta</h4>
            <div class="brand-sub">Administration SaaS</div>
        </div>
    </div>
    <div class="sidebar-client-context">
        <div class="client-context-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="client-context-label mb-0"><i class="bi bi-gear"></i> Plateforme</div>
                <span class="mode-badge cabinet">Admin</span>
            </div>
            <div class="client-context-name mt-1">Console centrale</div>
        </div>
    </div>
    <div class="sidebar-scroll">
        <div class="nav-section">Navigation <span class="section-line"></span></div>
        <ul class="nav flex-column">
            <li class="nav-item"><a class="@Nav("Home")" href="/Home"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a></li>
            <li class="nav-item"><a class="@Nav("Cabinets")" href="/Cabinets"><i class="bi bi-building"></i> Cabinets</a></li>
            <li class="nav-item"><a class="@Nav("ReferenceData")" href="/ReferenceData"><i class="bi bi-database"></i> Données de référence</a></li>
            <li class="nav-item"><a class="@Nav("AuditLogs")" href="/AuditLogs"><i class="bi bi-journal-text"></i> Journaux d'audit</a></li>
        </ul>
    </div>
</nav>

<div class="mc-main">
    <header class="mc-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light border d-md-none rounded-circle" type="button" onclick="document.getElementById('sidebar').classList.toggle('show')">
                <i class="bi bi-list"></i>
            </button>
            <h1 class="h5 fw-bold mb-0">@ViewData["Title"]</h1>
        </div>
        <div class="user-menu">
            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">Admin</span>
            <span class="text-body-secondary small d-none d-md-inline">@Context.Session.GetString("UserName")</span>
            <a href="/Account/Logout" class="btn btn-sm btn-outline-danger rounded-pill">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </header>
    <div class="mc-content">
        @RenderBody()
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
