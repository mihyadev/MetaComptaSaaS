<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetaCompta Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        :root { --admin-primary: #dc2626; --admin-dark: #450a0a; }
        body { background: #f8fafc; min-height: 100vh; }
        .sidebar-admin {
            width: 240px; background: linear-gradient(180deg, #450a0a, #991b1b);
            min-height: 100vh; position: fixed; left: 0; top: 0; z-index: 1000;
        }
        .sidebar-admin .brand { color: #fff; text-align: center; padding: 1.5rem 1rem; font-weight: 800; font-size: 1.1rem; }
        .sidebar-admin .nav-link {
            color: rgba(255,255,255,0.7); padding: 0.75rem 1.5rem; font-size: 0.9rem;
            border-left: 3px solid transparent; transition: all 0.2s;
        }
        .sidebar-admin .nav-link:hover, .sidebar-admin .nav-link.active {
            color: #fff; background: rgba(255,255,255,0.1); border-left-color: #fca5a5;
        }
        .main-admin { margin-left: 240px; padding: 1.5rem; }
        .topbar-admin {
            background: #fff; border-bottom: 1px solid #e2e8f0; padding: 0.75rem 1.5rem;
            margin: -1.5rem -1.5rem 1.5rem; display: flex; justify-content: space-between; align-items: center;
        }
    </style>
</head>
<body>
    <div class="sidebar-admin">
        <div class="brand">⚙️ MetaCompta<br /><small style="font-weight:400;font-size:0.7rem;opacity:0.7;">Administration SaaS</small></div>
        <hr class="mx-3 border-light opacity-25" />
        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="/Home">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cabinets" ? "active" : "")" href="/Cabinets">
                <i class="bi bi-building me-2"></i> Cabinets
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ReferenceData" ? "active" : "")" href="/ReferenceData">
                <i class="bi bi-database me-2"></i> Données de Référence
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active" : "")" href="/AuditLogs">
                <i class="bi bi-journal-text me-2"></i> Journaux d'Audit
            </a>
        </nav>
    </div>
    <div class="main-admin">
        <div class="topbar-admin">
            <h5 class="mb-0 fw-bold">@ViewData["Title"]</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-danger">Admin</span>
                <span class="text-muted">@Context.Session.GetString("UserName")</span>
                <a href="/Account/Logout" class="btn btn-outline-danger btn-sm rounded-pill"><i class="bi bi-box-arrow-right"></i></a>
            </div>
        </div>
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
