@{ ViewData["Title"] = "Données de Référence"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0">Données de Référence</h5>
    <button class="btn btn-danger rounded-pill px-3"><i class="bi bi-plus me-1"></i>Nouvelle Entrée</button>
</div>

<div class="row g-4">
    @foreach (var cat in new[] {
        ("Taux TVA", "bi-percent", "4 entrées"),
        ("Taux CNSS", "bi-shield-check", "2 entrées"),
        ("Taux AMO", "bi-heart-pulse", "2 entrées"),
        ("Barème IR", "bi-bar-chart-steps", "6 tranches"),
        ("Taux IS", "bi-building", "4 taux"),
        ("Déductions IR", "bi-dash-circle", "3 déductions"),
        ("Catégories Documents", "bi-folder", "6 catégories"),
        ("Formes Juridiques", "bi-diagram-3", "9 formes"),
        ("Types Contrat", "bi-file-earmark", "3 types")
    })
    {
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:rgba(220,38,38,0.1);color:#dc2626;">
                        <i class="bi @cat.Item2 fs-5"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold">@cat.Item1</div>
                        <small class="text-muted">@cat.Item3</small>
                    </div>
                    <a href="#" class="btn btn-outline-danger btn-sm rounded-pill"><i class="bi bi-pencil"></i></a>
                </div>
            </div>
        </div>
    }
</div>
