@using MetaCompta.Admin.Controllers
@{
    ViewData["Title"] = "Nouvelle Entrée";
    var categoryLabels = new Dictionary<string, (string Label, string Icon)> {
        {"TVA_RATE", ("Taux TVA", "bi-percent")},
        {"CNSS_RATE", ("Taux CNSS", "bi-shield-check")},
        {"AMO_RATE", ("Taux AMO", "bi-heart-pulse")},
        {"BAREME_IR", ("Barème IR", "bi-bar-chart-steps")},
        {"TAUX_IS", ("Taux IS", "bi-building")},
        {"DEDUCTIONS_IR", ("Déductions IR", "bi-dash-circle")},
        {"CATEGORIE_DOCUMENT", ("Catégories Documents", "bi-folder")},
        {"FORME_JURIDIQUE", ("Formes Juridiques", "bi-diagram-3")},
        {"TYPE_CONTRAT", ("Types Contrat", "bi-file-earmark")},
        {"SECTEUR_ACTIVITE", ("Secteurs Activité", "bi-grid")},
        {"SITUATION_FAMILIALE", ("Situation Familiale", "bi-people")},
        {"SEXE", ("Sexe", "bi-gender-ambiguous")},
        {"MODE_PAIEMENT", ("Mode de Paiement", "bi-credit-card")},
        {"STATUT_CLIENT", ("Statut Client", "bi-person-check")},
        {"STATUT_EMPLOYE", ("Statut Employé", "bi-person-badge")},
        {"STATUT_DECLARATION", ("Statut Déclaration", "bi-file-earmark-check")},
        {"STATUT_PAIE", ("Statut Paie", "bi-cash-stack")},
        {"TYPE_DECLARATION", ("Type Déclaration", "bi-file-earmark-text")},
        {"TYPE_ABSENCE", ("Type Absence", "bi-calendar-x")},
        {"VILLE", ("Villes", "bi-geo-alt")}
    };
    var selectedCategory = ViewBag.SelectedCategory as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a href="/ReferenceData">Données de Référence</a></li>
                <li class="breadcrumb-item active">Nouvelle Entrée</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-1"><i class="bi bi-plus-circle text-danger me-2"></i>Nouvelle Entrée</h4>
        <p class="text-muted mb-0">Ajouter une nouvelle donnée de référence</p>
    </div>
    <a href="/ReferenceData" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Retour</a>
</div>

@if (TempData["Error"] != null) {
<div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="post" action="/ReferenceData/Save">
    <input type="hidden" name="id" value="0" />
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h6 class="fw-bold mb-0"><i class="bi bi-database me-2 text-danger"></i>Informations</h6>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Catégorie <span class="text-danger">*</span></label>
                            <select name="category" class="form-select" required>
                                <option value="">— Sélectionner une catégorie —</option>
                                @foreach (var cl in categoryLabels)
                                {
                                    <option value="@cl.Key" selected="@(cl.Key == selectedCategory ? "selected" : null)">@cl.Value.Item1</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-code"></i></span>
                                <input type="text" name="code" class="form-control border-start-0" placeholder="Ex: TVA_20" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Libellé <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag"></i></span>
                                <input type="text" name="label" class="form-control border-start-0" placeholder="Ex: TVA 20%" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Valeur texte</label>
                            <input type="text" name="value" class="form-control" placeholder="Valeur texte optionnelle" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Valeur numérique</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-123"></i></span>
                                <input type="number" name="numericValue" class="form-control border-start-0" step="0.01" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ordre de tri</label>
                            <input type="number" name="sortOrder" class="form-control" value="10" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Bar -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="/ReferenceData" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4"><i class="bi bi-check-circle me-2"></i>Enregistrer</button>
            </div>
        </div>
    </div>
</form>
