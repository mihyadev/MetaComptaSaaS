@model MetaCompta.Application.DTOs.CourrierDomiciliationDto
@{
    var hasDocs = Model.Pieces?.Any() == true || Model.ScanDocumentId.HasValue;
    var openDemande = Model.ActionsClient?.Any(a =>
        a.TypeAction is "Pickup" or "Forward"
        && a.Statut is not ("Closed" or "HandedOver" or "Delivered")) == true;
    var demandeDone = Model.ActionsClient?.Any(a =>
        (a.TypeAction is "Pickup" or "Forward" && a.Statut is "Closed" or "HandedOver" or "Delivered")
        || (a.TypeAction is "View" or "Archive")) == true;
    var terminal = Model.Statut is "Closed" or "Archived";

    // 4 steps only
    string title, hint, icon;
    int current;
    if (terminal) { current = 4; title = "Terminé"; hint = "Courrier clôturé."; icon = "bi-check-circle"; }
    else if (!hasDocs) { current = 1; title = "Étape 1 — Déposer le document"; hint = "Ajoutez le scan dans la photothèque."; icon = "bi-upload"; }
    else if (!Model.ClientNotifie) { current = 2; title = "Étape 2 — Notifier le client"; hint = "Le client pourra alors choisir une action sur l’Extranet."; icon = "bi-bell"; }
    else if (openDemande) { current = 3; title = "Étape 3 — Traiter la demande client"; hint = "Un seul bouton : « Demande traitée »."; icon = "bi-gear"; }
    else if (!demandeDone) { current = 3; title = "Étape 3 — Attendre le client"; hint = "Le client agit sur l’Extranet (retrait / réexpédition…)."; icon = "bi-hourglass-split"; }
    else { current = 4; title = "Étape 4 — Clôturer"; hint = "La demande est finie — clôturez le courrier."; icon = "bi-lock"; }

    var labels = new[] { "1. Document", "2. Notifier", "3. Client", "4. Clôturer" };
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:44px;height:44px;background:#e0f2fe;">
                <i class="bi @icon text-primary fs-5"></i>
            </div>
            <div>
                <div class="text-uppercase text-muted fw-semibold" style="font-size:0.68rem;">Parcours simple</div>
                <div class="fw-bold">@title</div>
                <div class="small text-muted mb-0">@hint</div>
            </div>
        </div>
        <div class="d-flex gap-1">
            @for (var i = 0; i < 4; i++)
            {
                var active = (i + 1) == current;
                var done = (i + 1) < current;
                var bg = active ? "#0ea5e9" : done ? "#86efac" : "#e2e8f0";
                var color = active ? "#fff" : done ? "#166534" : "#64748b";
                <div class="flex-grow-1 text-center rounded-3 py-2 px-1" style="background:@bg;color:@color;font-size:0.72rem;font-weight:700;">
                    @labels[i]
                </div>
            }
        </div>
    </div>
</div>
