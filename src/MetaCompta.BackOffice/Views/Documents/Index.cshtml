@model MetaCompta.Application.DTOs.PagedResult<MetaCompta.Application.DTOs.DocumentDto>
@{
    ViewData["Title"] = "Documents";
    var categorie = ViewBag.Categorie as string;
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-folder2-open me-2"></i>Documents</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item active">Documents</li>
            </ol>
        </nav>
    </div>
</div>

@if (client != null)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 rounded-3">
        <i class="bi bi-building fs-5"></i>
        <div>
            <strong>@client.RaisonSociale</strong>
            @if (!string.IsNullOrEmpty(client.ICE)) { <span class="ms-2 text-muted small">ICE: @client.ICE</span> }
        </div>
    </div>
}

<!-- Filters -->
<div class="mc-card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Catégorie</label>
                <select name="categorie" class="form-select">
                    <option value="">Toutes</option>
                    <option value="PieceJustificative" selected="@(categorie == "PieceJustificative")">Pièces justificatives</option>
                    <option value="Contrat" selected="@(categorie == "Contrat")">Contrats & Statuts</option>
                    <option value="Formulaire" selected="@(categorie == "Formulaire")">Formulaires officiels</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Recherche</label>
                <input type="text" name="search" class="form-control" placeholder="Nom du document..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Filtrer</button>
            </div>
        </form>
    </div>
</div>

<!-- Documents Table -->
<div class="mc-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-files me-2"></i>Liste des documents (@(Model?.TotalCount ?? 0))</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mc-table mb-0">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Type</th>
                        <th>Taille</th>
                        <th>Date upload</th>
                        <th>Statut</th>
                        <th>Partagé</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        foreach (var doc in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark fs-5 text-primary"></i>
                                        <span class="fw-medium">@doc.Nom</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark">@doc.Categorie</span></td>
                                <td>@doc.TypeDocument</td>
                                <td>@doc.TailleFichier</td>
                                <td>@(doc.DateUpload.ToString("dd/MM/yyyy"))</td>
                                <td><span class="badge badge-@doc.Statut?.ToLower()">@doc.Statut</span></td>
                                <td>
                                    @if (doc.EstPartage)
                                    {
                                        <i class="bi bi-share-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-lock text-muted"></i>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "Documents", new { id = doc.Id })" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                                    @if (ViewBag.CanDocumentShare as bool? ?? false)
                                    {
                                        <form method="post" action="@Url.Action("ToggleShare", "Documents")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@doc.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Basculer partage"><i class="bi bi-share"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-folder fs-1 d-block mb-2"></i>
                                Aucun document trouvé pour ce client.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
