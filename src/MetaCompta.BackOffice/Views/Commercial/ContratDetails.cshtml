@model ContratCommercialDto
@{
    ViewData["Title"] = $"Contrat {Model.Reference}";
    var isBrouillonOrEnCours = Model.Statut == RefCodes.StatutContrat.Brouillon || Model.Statut == RefCodes.StatutContrat.EnCours;
    var source = Model.BonCommandeReference != null
        ? $"Depuis BC {Model.BonCommandeReference}"
        : Model.DevisReference != null
            ? $"Depuis Devis {Model.DevisReference}"
            : "Contrat direct";

    var soft = Model.Statut switch
    {
        RefCodes.StatutContrat.Brouillon => "bg-secondary-subtle text-secondary-emphasis",
        RefCodes.StatutContrat.EnCours => "bg-info-subtle text-info-emphasis",
        RefCodes.StatutContrat.Signe => "bg-primary-subtle text-primary-emphasis",
        RefCodes.StatutContrat.Valide => "bg-success-subtle text-success-emphasis",
        RefCodes.StatutContrat.Actif => "bg-success-subtle text-success-emphasis",
        RefCodes.StatutContrat.Suspendu => "bg-warning-subtle text-warning-emphasis",
        RefCodes.StatutContrat.Remplace => "bg-dark-subtle text-dark-emphasis",
        "Termine" => "bg-dark-subtle text-dark-emphasis",
        RefCodes.StatutContrat.Resilie => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
    var border = Model.Statut switch
    {
        RefCodes.StatutContrat.Valide => "border-success",
        RefCodes.StatutContrat.Actif => "border-success",
        RefCodes.StatutContrat.Signe => "border-primary",
        RefCodes.StatutContrat.EnCours => "border-info",
        RefCodes.StatutContrat.Suspendu => "border-warning",
        RefCodes.StatutContrat.Remplace => "border-dark",
        RefCodes.StatutContrat.Resilie => "border-danger",
        _ => "border-secondary"
    };
    var isManageStatut = Model.Statut == RefCodes.StatutContrat.Valide || Model.Statut == RefCodes.StatutContrat.Actif;
    var canEditEquipe = Model.Statut != RefCodes.StatutContrat.Termine
        && Model.Statut != RefCodes.StatutContrat.Resilie
        && Model.Statut != RefCodes.StatutContrat.Annule
        && (ViewBag.CanCommercialEdit as bool? ?? false);
    var canCommercialEdit = ViewBag.CanCommercialEdit as bool? ?? false;
    var canCommercialSign = ViewBag.CanCommercialSign as bool? ?? false;
    var canCommercialValidate = ViewBag.CanCommercialValidate as bool? ?? false;
    var canCommercialCreate = ViewBag.CanCommercialCreate as bool? ?? false;
    var canFactureCreate = ViewBag.CanFactureCreate as bool? ?? false;
    var employees = ViewBag.Employees as List<CabinetEmployeeDto> ?? new List<CabinetEmployeeDto>();
    var hasEquipe = (Model.Membres?.Count ?? 0) > 0;

    var _dtlGroups = new (string Label, string Color, string[] Codes)[] {
        ("Tenue comptable & États financiers", "primary", new[]{"COMPTABILITE","TRESORERIE","BILAN","ETATSFISCAUX","LIASSEFISCALE","EG"}),
        ("Déclarations fiscales (DGI / SIMPL)", "info", new[]{"TVA","IR_SAL","RAS_FONC","RAS_DIV","DRF","CM","DT","DEI_TP","DRVT","CSS_SOL","DRG","IR_COMP"}),
        ("Acomptes IS & Solde", "warning", new[]{"ACOMPTES","REG_IS"}),
        ("Social (CNSS / Damancom) & Paie", "success", new[]{"CNSS","DTS","PAIE","DCH_ETS"}),
        ("Secrétariat juridique annuel", "danger", new[]{"PV_AGO","DEPOT_RC"}),
    };
    var _usedDtl = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase);
}

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-start gap-3">
        <span class="bg-primary text-white rounded-3 p-3 lh-1">
            <i class="bi bi-file-earmark-text fs-4"></i>
        </span>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Contrats" class="text-decoration-none">Contrats</a></li>
                    <li class="breadcrumb-item active">@Model.Reference</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-2">
                @Model.Reference
                <span class="badge rounded-pill @soft px-3 py-2 align-middle">@Model.Statut</span>
            </h1>
            <div class="d-flex flex-wrap align-items-center gap-2 text-body-secondary">
                <span class="badge rounded-circle text-bg-primary">@(string.IsNullOrEmpty(Model.ClientName) ? "?" : Model.ClientName.Trim()[0].ToString().ToUpper())</span>
                <span class="fw-semibold text-body">@Model.ClientName</span>
                <span>·</span>
                <span>@source</span>
                <span>·</span>
                <span class="badge rounded-pill text-bg-light border">@Model.ModeleFacturation</span>
            </div>
        </div>
    </div>
    <a asp-action="Contrats" class="btn btn-light border rounded-pill px-3">Retour au board</a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap gap-2">
            @if (isBrouillonOrEnCours && !Model.EstSigne)
            {
                @if (canCommercialEdit)
                {
                    <a asp-action="ContratEdit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-pencil me-1"></i>Éditer
                    </a>
                }
                @if (canCommercialSign)
                {
                    <button type="button" class="btn btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#signerModal">
                        <i class="bi bi-pen me-1"></i>Signer
                    </button>
                }
            }
            @if (Model.EstSigne && Model.Statut == RefCodes.StatutContrat.Signe && canCommercialValidate)
            {
                <form asp-action="ContratValider" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success rounded-pill px-3">Valider &amp; Activer</button>
                </form>
            }
            @if (isManageStatut)
            {
                @if (canFactureCreate)
                {
                    <button type="button" class="btn btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#genererFactureModal">Générer Facture</button>
                }
                @if (canCommercialEdit)
                {
                    <form asp-action="ContratSuspendre" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-warning rounded-pill px-3">Suspendre</button>
                    </form>
                    <form asp-action="ContratTerminer" asp-route-id="@Model.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Terminer ce contrat ?');">
                        <button type="submit" class="btn btn-dark rounded-pill px-3">Terminer</button>
                    </form>
                }
            }
            @if (Model.Statut == RefCodes.StatutContrat.Suspendu && canCommercialEdit)
            {
                <form asp-action="ContratReactiver" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success rounded-pill px-3">Réactiver</button>
                </form>
            }
            @if (canCommercialCreate)
            {
                <form asp-action="ContratDupliquer" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-light border rounded-pill px-3">Dupliquer</button>
                </form>
            }
            @if (Model.PeutRectifier && canCommercialCreate)
            {
                <button type="button" class="btn btn-outline-warning rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#rectificatifModal">
                    <i class="bi bi-file-earmark-diff me-1"></i>Créer un rectificatif
                </button>
            }
            @if (canEditEquipe)
            {
                <a href="#equipe-form" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-people me-1"></i>Équipe du dossier
                </a>
            }
        </div>
    </div>
</div>

@if (Model.EstRectificatif)
{
    <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Rectificatif</strong> du contrat
        @if (Model.ParentContratId is int pid)
        {
            <a asp-action="ContratDetails" asp-route-id="@pid" class="fw-semibold">@(Model.ParentContratReference ?? $"#{pid}")</a>
        }
        (v@(Model.Version)). Éditez, signez puis validez pour remplacer l'original.
        @if (!string.IsNullOrWhiteSpace(Model.MotifRectificatif))
        {
            <div class="small mt-1">Motif : @Model.MotifRectificatif</div>
        }
    </div>
}
else if (Model.Statut == RefCodes.StatutContrat.Remplace && Model.RemplaceParContratId is int rid)
{
    <div class="alert alert-secondary border-0 shadow-sm rounded-4 mb-4">
        <i class="bi bi-archive me-1"></i>
        Contrat <strong>remplacé</strong> par le rectificatif
        <a asp-action="ContratDetails" asp-route-id="@rid" class="fw-semibold">@(Model.RemplaceParContratReference ?? $"#{rid}")</a>
        — conservé pour l'historique.
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="small text-body-secondary text-uppercase fw-semibold mb-1">Début</div>
                <div class="fs-5 fw-bold">@(Model.DateDebutContrat?.ToString("dd/MM/yyyy") ?? "—")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="small text-body-secondary text-uppercase fw-semibold mb-1">Fin</div>
                <div class="fs-5 fw-bold">@(Model.DateFinContrat?.ToString("dd/MM/yyyy") ?? "—")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="small text-body-secondary text-uppercase fw-semibold mb-1">Signature</div>
                <div class="fw-bold">
                    @if (Model.EstSigne)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis px-3 py-2">@Model.SignataireNom</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2">En attente</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 @border">
            <div class="card-body">
                <div class="small text-body-secondary text-uppercase fw-semibold mb-1">TTC</div>
                <div class="fs-4 fw-bold text-success">@Model.MontantTTC.ToString("N2") <span class="fs-6">@Model.Devise</span></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">Informations</span>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="small text-body-secondary">Émission</div>
                        <div class="fw-semibold">@Model.DateEmission.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="small text-body-secondary">Fréquence</div>
                        <div class="fw-semibold">@(Model.FrequenceFacturation ?? "—")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="small text-body-secondary">Version</div>
                        <div class="fw-semibold">v@Model.Version</div>
                    </div>
                    <div class="col-12">
                        <div class="small text-body-secondary mb-2">Équipe du dossier</div>
                        @if (!hasEquipe)
                        {
                            <span class="text-warning-emphasis small">
                                <i class="bi bi-exclamation-triangle me-1"></i>Aucune équipe affectée — obligatoire avant validation
                            </span>
                        }
                        else
                        {
                            <div class="table-responsive border rounded-3">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-body-secondary text-uppercase">
                                            <th class="ps-3 fw-semibold border-0">Collaborateur</th>
                                            <th class="fw-semibold border-0">Pôle</th>
                                            <th class="fw-semibold border-0">Rôle</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in Model.Membres ?? new List<ContratMembreDto>())
                                        {
                                            <tr>
                                                <td class="ps-3 fw-semibold">@(m.UserName ?? m.UserId)</td>
                                                <td class="text-body-secondary small">@(m.Departement ?? "—")</td>
                                                <td class="small">@(string.IsNullOrWhiteSpace(m.RoleLabel) ? "—" : m.RoleLabel)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="col-12">
                        <div class="small text-body-secondary mb-2">Identifiants</div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge rounded-pill text-bg-light border px-3 py-2">ICE @(Model.ClientICE ?? "—")</span>
                            <span class="badge rounded-pill text-bg-light border px-3 py-2">IF @(Model.ClientIF ?? "—")</span>
                            <span class="badge rounded-pill text-bg-light border px-3 py-2">CNSS @(Model.ClientNumeroCNSS ?? "—")</span>
                            <span class="badge rounded-pill text-bg-light border px-3 py-2">RC @(string.IsNullOrWhiteSpace(Model.ClientRC) ? "—" : Model.ClientRC)@(string.IsNullOrWhiteSpace(Model.ClientVille) ? "" : " — " + Model.ClientVille)</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Objet))
                    {
                        <div class="col-12">
                            <div class="small text-body-secondary">Objet</div>
                            <div>@Model.Objet</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12">
                            <div class="small text-body-secondary">Notes</div>
                            <div>@Model.Notes</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (canEditEquipe)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="equipe-form">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex align-items-center justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">Équipe du dossier</div>
                        <div class="small text-body-secondary">Affectation des collaborateurs du cabinet</div>
                    </div>
                </div>
                <div class="card-body px-4 pb-4">
                    <form asp-action="ContratEquipe" asp-route-id="@Model.Id" method="post">
                        @{
                            ViewBag.Employees = employees;
                            ViewBag.InitialMembres = Model.Membres;
                            ViewBag.EditorId = "equipeDetails";
                            ViewBag.ShowActions = true;
                        }
                        @await Html.PartialAsync("_EquipeDossierEditor")
                        <div class="mt-3">
                            <button type="submit" class="btn btn-dark rounded-pill px-4">
                                Enregistrer l'équipe
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else if (hasEquipe)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="equipe-form">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="fw-semibold">Équipe du dossier</div>
                    <div class="small text-body-secondary">Consultation</div>
                </div>
                <div class="card-body px-4 pb-4">
                    @{
                        ViewBag.Employees = employees;
                        ViewBag.InitialMembres = Model.Membres;
                        ViewBag.EditorId = "equipeReadonly";
                        ViewBag.ShowActions = false;
                    }
                    @await Html.PartialAsync("_EquipeDossierEditor")
                </div>
            </div>
        }

        @if (Model.ServicesActives.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex align-items-center gap-2">
                    <span class="badge rounded-pill bg-info-subtle text-info-emphasis px-3 py-2">Périmètre</span>
                    <span class="badge rounded-pill bg-dark">@Model.ServicesActives.Count</span>
                </div>
                <div class="card-body px-4 pb-4 vstack gap-3">
                    @foreach (var grp in _dtlGroups)
                    {
                        var _gSvcs = Model.ServicesActives.Where(s =>
                            grp.Codes.Contains(s.TypeService ?? "", StringComparer.OrdinalIgnoreCase)).ToList();
                        if (!_gSvcs.Any()) { continue; }
                        foreach (var _s in _gSvcs) { _usedDtl.Add(_s.TypeService ?? ""); }
                        <div class="card border-0 bg-body-tertiary rounded-4 border-start border-4 border-@(grp.Color)">
                            <div class="card-body">
                                <div class="fw-semibold mb-2">
                                    <span class="badge rounded-pill bg-@(grp.Color)-subtle text-@(grp.Color)-emphasis">@grp.Label</span>
                                    <span class="small text-body-secondary">@_gSvcs.Count</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var svc in _gSvcs)
                                    {
                                        <span class="badge rounded-pill text-bg-light border px-3 py-2">
                                            <code class="me-1">@svc.TypeService</code>@(svc.LibelleService ?? "")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @{
                        var _dtlOthers = Model.ServicesActives.Where(s => !_usedDtl.Contains(s.TypeService ?? "")).ToList();
                    }
                    @if (_dtlOthers.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var svc in _dtlOthers)
                            {
                                <span class="badge rounded-pill text-bg-light border px-3 py-2">
                                    <code class="me-1">@svc.TypeService</code>@(svc.LibelleService ?? "")
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <span class="badge rounded-pill bg-success-subtle text-success-emphasis px-3 py-2">Honoraires</span>
                <span class="badge rounded-pill text-bg-light border">@Model.Lignes.Count ligne(s)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-body-secondary text-uppercase">
                            <th class="ps-4 fw-semibold border-0">#</th>
                            <th class="fw-semibold border-0">Description</th>
                            <th class="fw-semibold border-0">Périodicité</th>
                            <th class="fw-semibold border-0 text-end">HT</th>
                            <th class="fw-semibold border-0 text-end">Remise</th>
                            <th class="fw-semibold border-0 text-end">TVA</th>
                            <th class="fw-semibold border-0 text-end">Net</th>
                            <th class="fw-semibold border-0 text-end pe-4">TTC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lignes.OrderBy(x => x.Ordre))
                        {
                            <tr>
                                <td class="ps-4 text-body-secondary">@l.Ordre</td>
                                <td class="fw-semibold">@l.Description</td>
                                <td>
                                    <span class="badge rounded-pill text-bg-light border">
                                        @(string.IsNullOrWhiteSpace(l.ModeFacturation) ? "Ponctuel" : l.ModeFacturation)
                                    </span>
                                </td>
                                <td class="text-end">@l.PrixUnitaireHT.ToString("N2")</td>
                                <td class="text-end">@((l.RemisePourcentage ?? 0).ToString("N2")) %</td>
                                <td class="text-end">@l.TauxTVA.ToString("N0") %</td>
                                <td class="text-end fw-semibold">@l.MontantHT.ToString("N2")</td>
                                <td class="text-end fw-semibold pe-4">@l.MontantTTC.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Historique.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis px-3 py-2">Activité</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var h in Model.Historique)
                    {
                        <li class="list-group-item px-4 py-3">
                            <div class="d-flex justify-content-between gap-2 flex-wrap">
                                <div>
                                    <div class="fw-semibold">@h.Action</div>
                                    <div class="small text-body-secondary">@h.Commentaire</div>
                                </div>
                                <div class="text-end">
                                    <div class="small text-body-secondary">@h.DateAction.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div>
                                        @if (h.AncienStatut != null)
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">@h.AncienStatut</span>
                                            <span class="text-body-secondary">→</span>
                                        }
                                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">@h.NouveauStatut</span>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 sticky-top">
            <div class="card-header bg-success text-white border-0 rounded-top-4 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Montants</span>
                    <span class="badge text-bg-light text-success rounded-pill">@Model.Devise</span>
                </div>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between py-3">
                    <span class="text-body-secondary">HT</span>
                    <span class="fw-semibold">@Model.MontantHT.ToString("N2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between py-3">
                    <span class="text-body-secondary">TVA</span>
                    <span class="fw-semibold">@Model.MontantTVA.ToString("N2")</span>
                </li>
                @if (Model.MontantRemise > 0)
                {
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-body-secondary">Remise</span>
                        <span class="text-danger fw-semibold">-@Model.MontantRemise.ToString("N2")</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between py-3 bg-success-subtle">
                    <span class="fw-bold text-success-emphasis">TTC</span>
                    <span class="fw-bold text-success-emphasis fs-5">@Model.MontantTTC.ToString("N2")</span>
                </li>
            </ul>
            @if (Model.NombreFactures > 0)
            {
                <div class="card-body">
                    <div class="small text-body-secondary mb-2">@Model.NombreFactures facture(s) · @Model.TotalFacture.ToString("N2") @Model.Devise</div>
                    <a asp-action="Factures" class="btn btn-sm btn-outline-success rounded-pill w-100">Voir factures</a>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="signerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="ContratSigner" asp-route-id="@Model.Id" method="post">
                <div class="modal-header border-0">
                    <h1 class="modal-title fs-5 fw-bold">Signer le contrat</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nom du signataire</label>
                        <input name="SignataireNom" class="form-control rounded-3" required placeholder="Ex: Mohammed Alami" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fonction</label>
                        <input name="SignataireFonction" class="form-control rounded-3" placeholder="Ex: Gérant" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light border rounded-pill" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Signer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.PeutRectifier && canCommercialCreate)
{
    <div class="modal fade" id="rectificatifModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form asp-action="ContratRectificatif" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-0">
                        <h1 class="modal-title fs-5 fw-bold">Créer un rectificatif</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-body-secondary small mb-3">
                            Une nouvelle version brouillon sera créée (services, lignes, équipe repris).
                            L'original <strong>@Model.Reference</strong> reste en place jusqu'à la validation du rectificatif.
                        </p>
                        <div class="mb-0">
                            <label class="form-label fw-semibold" for="motifRectif">Motif (optionnel)</label>
                            <textarea name="motif" id="motifRectif" class="form-control rounded-3" rows="3"
                                      placeholder="Ex. Ajout service TVA, modification honoraires…"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light border rounded-pill" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-warning rounded-pill px-4">Créer &amp; éditer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (isManageStatut && canFactureCreate)
{
    <div class="modal fade" id="genererFactureModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form asp-action="FactureCreate" method="get">
                    <input type="hidden" name="contratId" value="@Model.Id" />
                    <div class="modal-header border-0">
                        <h1 class="modal-title fs-5 fw-bold">Générer une facture</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-body-secondary">Créer une facture pour <strong>@Model.Reference</strong></p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Fréquence</label>
                            <input type="text" class="form-control rounded-3" value="@(Model.FrequenceFacturation ?? "Non définie")" readonly />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">HT</label>
                                <input type="text" class="form-control rounded-3" value="@Model.MontantHT.ToString("N2") @Model.Devise" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">TTC</label>
                                <input type="text" class="form-control rounded-3" value="@Model.MontantTTC.ToString("N2") @Model.Devise" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light border rounded-pill" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Créer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
