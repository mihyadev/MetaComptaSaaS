@model ContratCommercialDto
@{
    ViewData["Title"] = $"Contrat {Model.Reference}";
    var isBrouillonOrEnCours = Model.Statut == RefCodes.StatutContrat.Brouillon || Model.Statut ==
    RefCodes.StatutContrat.EnCours;
    var source = Model.BonCommandeReference != null ? $"Depuis BC: {Model.BonCommandeReference}" : Model.DevisReference !=
    null ? $"Depuis Devis: {Model.DevisReference}" : "Contrat direct";
}

<!-- Workflow Steps -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center px-3">
            @{
                var steps = new[] {
                        ("Brouillon", "bi-pencil", "secondary"),
                        ("Signé", "bi-pen", "purple"),
                        ("Actif", "bi-check-circle-fill", "success"),
                        ("Terminé", "bi-stop-circle", "dark")
                        };
                var currentStep = Model.Statut switch
                {
                    "Brouillon" or RefCodes.StatutContrat.EnCours => 0,
                    RefCodes.StatutContrat.Signe => 1,
                    RefCodes.StatutContrat.Actif => 2,
                    RefCodes.StatutContrat.Suspendu => 2,
                    "Termine" or RefCodes.StatutContrat.Resilie => 3,
                    _ => 0
                    };
            }
            @for (int s = 0; s < steps.Length; s++)
            {
                var (label, icon, color) = steps[s];
                var isActive = s <= currentStep;
                var isCurrent = s == currentStep;
                <div class="text-center flex-fill position-relative">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center @(isActive ? $"bg-{color} text-white" : "bg-light text-muted")"
                        style="width:40px;height:40px;">
                        <i class="bi @icon"></i>
                    </div>
                    <div class="small @(isCurrent ? "fw-bold" : "text-muted") mt-1">@label</div>
                    @if (s < steps.Length - 1)
                    {
                        <div class="position-absolute top-50 start-50 w-100"
                            style="height:2px;transform:translateY(-10px);z-index:-1;">
                            <div class="@(isActive && s < currentStep ? $"bg-{color}" : "bg-light")"
                                style="height:2px;margin-left:50%;"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-text text-success me-2"></i>@Model.Reference</h4>
        <p class="text-muted mb-0">@Model.ClientName — <small>@source</small> — Modèle:
            <strong>@Model.ModeleFacturation</strong>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (isBrouillonOrEnCours && !Model.EstSigne)
        {
            <a asp-action="ContratEdit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill"><i
                    class="bi bi-pencil me-1"></i>Modifier</a>
            <button type="button" class="btn btn-purple rounded-pill text-white" data-bs-toggle="modal"
                data-bs-target="#signerModal"><i class="bi bi-pen me-1"></i>Signer</button>
        }
        @if (Model.EstSigne && Model.Statut == RefCodes.StatutContrat.Signe)
        {
            <form asp-action="ContratValider" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Valider &
                    Activer</button>
            </form>
        }
        @if (Model.Statut == RefCodes.StatutContrat.Actif)
        {
            <button type="button" class="btn btn-primary rounded-pill" data-bs-toggle="modal"
                data-bs-target="#genererFactureModal"><i class="bi bi-receipt me-1"></i>Générer Facture</button>
            <form asp-action="ContratSuspendre" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-warning rounded-pill"><i
                        class="bi bi-pause-circle me-1"></i>Suspendre</button>
            </form>
            <form asp-action="ContratTerminer" asp-route-id="@Model.Id" method="post" class="d-inline"
                onsubmit="return confirm('Terminer ce contrat ?');">
                <button type="submit" class="btn btn-dark rounded-pill"><i
                        class="bi bi-stop-circle me-1"></i>Terminer</button>
            </form>
        }
        @if (Model.Statut == RefCodes.StatutContrat.Suspendu)
        {
            <form asp-action="ContratValider" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success rounded-pill"><i
                        class="bi bi-play-circle me-1"></i>Réactiver</button>
            </form>
        }
        <form asp-action="ContratDupliquer" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-info rounded-pill"><i
                    class="bi bi-copy me-1"></i>Dupliquer</button>
        </form>
        <a asp-action="Contrats" class="btn btn-outline-secondary rounded-pill"><i
                class="bi bi-arrow-left me-1"></i>Retour</a>
    </div>
</div>

<!-- Infos principales -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient bg-success bg-opacity-10 border-0 rounded-top-4 py-3">
                <h6 class="fw-semibold mb-0 text-success"><i class="bi bi-info-circle me-2"></i>Informations du Contrat
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Statut</label>
                        @{
                            var badge = Model.Statut switch
                            {
                                RefCodes.StatutContrat.Brouillon => "secondary",
                                RefCodes.StatutContrat.EnCours => "info",
                                RefCodes.StatutContrat.Signe => "purple",
                                RefCodes.StatutContrat.Actif => "success",
                                RefCodes.StatutContrat.Suspendu => "warning",
                                "Termine" => "dark",
                                RefCodes.StatutContrat.Resilie => "danger",
                                _ => "secondary"
                                };
                        }
                        <p class="mb-2"><span class="badge bg-@badge rounded-pill fs-6">@Model.Statut</span></p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Date d'émission</label>
                        <p class="mb-2 fw-semibold">@Model.DateEmission.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Fréquence</label>
                        <p class="mb-2">@(Model.FrequenceFacturation ?? "Non définie")</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted"><i
                                class="bi bi-calendar-event text-primary me-1"></i>Date début</label>
                        <p class="mb-2 fw-semibold text-primary">@(Model.DateDebutContrat?.ToString("dd/MM/yyyy") ??
                                                        "Non définie")</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted"><i class="bi bi-calendar-x text-danger me-1"></i>Date
                            fin</label>
                        <p class="mb-2 fw-semibold text-danger">@(Model.DateFinContrat?.ToString("dd/MM/yyyy") ??
                                                        "Indéterminée")</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Version</label>
                        <p class="mb-2">v@Model.Version</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Objet))
                    {
                        <div class="col-12"><label class="form-label small text-muted">Objet</label>
                            <p class="mb-2">@Model.Objet</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12"><label class="form-label small text-muted">Notes</label>
                            <p class="mb-2">@Model.Notes</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <!-- Montants -->
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-header bg-gradient bg-primary bg-opacity-10 border-0 rounded-top-4 py-3">
                <h6 class="fw-semibold mb-0 text-primary text-center"><i class="bi bi-cash-stack me-2"></i>Montants</h6>
            </div>
            <div class="card-body text-center">
                <div class="mb-2"><span class="text-muted">HT:</span> <span
                        class="fw-semibold">@Model.MontantHT.ToString("N2") @Model.Devise</span></div>
                <div class="mb-2"><span class="text-muted">TVA:</span> <span>@Model.MontantTVA.ToString("N2")</span>
                </div>
                @if (Model.MontantRemise > 0)
                {
                    <div class="mb-2"><span class="text-muted">Remise:</span> <span
                            class="text-danger">-@Model.MontantRemise.ToString("N2")</span></div>
                }
                <hr />
                <div><span class="text-muted">TTC:</span> <span
                        class="fw-bold fs-4 text-primary">@Model.MontantTTC.ToString("N2") @Model.Devise</span></div>
            </div>
        </div>
        <!-- Signature -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient bg-purple bg-opacity-10 border-0 rounded-top-4 py-3"
                style="background: rgba(124,58,237,0.1)!important;">
                <h6 class="fw-semibold mb-0 text-center" style="color:#7c3aed;"><i class="bi bi-pen me-2"></i>Signature
                </h6>
            </div>
            <div class="card-body text-center">
                @if (Model.EstSigne)
                {
                    <div class="text-success mb-2"><i class="bi bi-check-circle-fill fs-3"></i></div>
                    <p class="fw-semibold mb-1">Signé par @Model.SignataireNom</p>
                    <p class="text-muted small mb-0">Le @Model.DateSignature?.ToString("dd/MM/yyyy HH:mm")</p>
                }
                else
                {
                    <div class="text-warning mb-2"><i class="bi bi-exclamation-triangle fs-3"></i></div>
                    <p class="text-muted mb-0">En attente de signature</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Lignes -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-semibold"><i class="bi bi-list-ul me-2"></i>Lignes du contrat (@Model.Lignes.Count)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Service décl.</th>
                        <th class="text-end">Qté</th>
                        <th class="text-end">Prix HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end pe-3">TTC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lignes.OrderBy(x => x.Ordre))
                    {
                        <tr>
                            <td class="ps-3">@l.Ordre</td>
                            <td>
                                <div class="fw-semibold">@l.Description</div>
                                @if (!string.IsNullOrWhiteSpace(l.TypeService))
                                {
                                    <small class="text-muted">@l.TypeService</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark">@l.TypeLigne</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(l.ServiceContratLibelle))
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info"><i
                                            class="bi bi-link-45deg me-1"></i>@l.ServiceContratLibelle</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">@l.Quantite @l.Unite</td>
                            <td class="text-end">@l.PrixUnitaireHT.ToString("N2")</td>
                            <td class="text-end">@l.TauxTVA%</td>
                            <td class="text-end fw-semibold">@l.MontantHT.ToString("N2")</td>
                            <td class="text-end fw-semibold pe-3">@l.MontantTTC.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Factures associées -->
@if (Model.NombreFactures > 0)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-semibold mb-0"><i class="bi bi-receipt me-2"></i>Factures associées (@Model.NombreFactures)</h6>
            <span class="text-muted small">Total facturé: @Model.TotalFacture.ToString("N2") @Model.Devise</span>
        </div>
        <div class="card-body">
            <p class="text-muted">Consultez les factures depuis la section <a asp-action="Factures"
                    class="fw-semibold">Factures</a>.</p>
        </div>
    </div>
}

<!-- Historique -->
@if (Model.Historique.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="fw-semibold"><i class="bi bi-clock-history me-2"></i>Historique</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Action</th>
                            <th>Statut</th>
                            <th>Commentaire</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Historique)
                        {
                            <tr>
                                <td class="ps-3"><small>@h.DateAction.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td class="fw-semibold">@h.Action</td>
                                <td>
                                    @if (h.AncienStatut != null)
                                    {
                                        <span class="badge bg-secondary rounded-pill">@h.AncienStatut</span>
                                        <text>→</text>
                                    }
                                    <span class="badge bg-primary rounded-pill">@h.NouveauStatut</span>
                                </td>
                                <td><small>@h.Commentaire</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Modal Signature -->
<div class="modal fade" id="signerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <form asp-action="ContratSigner" asp-route-id="@Model.Id" method="post">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pen me-2 text-purple"
                            style="color:#7c3aed;"></i>Signer le Contrat</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Nom du signataire <span class="text-danger">*</span></label>
                        <input name="SignataireNom" class="form-control rounded-3" required
                            placeholder="Ex: Mohammed Alami" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Fonction</label>
                        <input name="SignataireFonction" class="form-control rounded-3" placeholder="Ex: Gérant" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill"
                        data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-purple rounded-pill text-white px-4"><i
                            class="bi bi-pen me-1"></i>Signer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Générer Facture -->
@if (Model.Statut == RefCodes.StatutContrat.Actif)
{
    <div class="modal fade" id="genererFactureModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content rounded-4">
                <form asp-action="FactureCreate" method="get">
                    <input type="hidden" name="contratId" value="@Model.Id" />
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold"><i class="bi bi-receipt me-2 text-primary"></i>Générer une Facture
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">Créer une facture pour le contrat <strong>@Model.Reference</strong> — <span
                                class="badge bg-light text-dark">@Model.ModeleFacturation</span></p>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Fréquence</label>
                            <input type="text" class="form-control rounded-3 bg-light"
                                value="@(Model.FrequenceFacturation ?? "Non définie")" readonly />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Montant HT du contrat</label>
                                <input type="text" class="form-control rounded-3 bg-light"
                                    value="@Model.MontantHT.ToString("N2") @Model.Devise" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Montant TTC</label>
                                <input type="text" class="form-control rounded-3 bg-light"
                                    value="@Model.MontantTTC.ToString("N2") @Model.Devise" readonly />
                            </div>
                        </div>
                        <hr />
                        <p class="small text-muted"><i class="bi bi-info-circle me-1"></i>Vous serez redirigé vers le
                            formulaire de création de facture avec les paramètres du contrat pré-remplis (période, lignes,
                            etc.).</p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill"
                            data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i
                                class="bi bi-receipt me-1"></i>Créer la Facture</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .bg-purple {
        background-color: #7c3aed !important;
    }

    .btn-purple {
        background-color: #7c3aed !important;
        border-color: #7c3aed !important;
    }

    .btn-purple:hover {
        background-color: #6d28d9 !important;
        border-color: #6d28d9 !important;
    }
</style>