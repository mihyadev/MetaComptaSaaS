@model ContratCommercialCreateDto
@using System.Text.Json
@{
    var isEdit = ViewBag.ContratId != null;
    var contratId = isEdit ? (int)ViewBag.ContratId : 0;
    ViewData["Title"] = isEdit ? "Modifier le Contrat" : "Nouveau Contrat";
    var clients = ViewBag.Clients as List<ClientDto> ?? new();
    var clientServices = ViewBag.ClientServices as List<object> ?? new();
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var servicesJson = JsonSerializer.Serialize(clientServices, jsonOptions);

    // Dynamic TYPE_SERVICE from ReferenceData table (database-driven, not hardcoded)
    var typeServiceItems = (ViewData["Ref_TYPE_SERVICE"] as List<ReferenceDataDto>) ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-file-earmark-plus text-success me-2"></i>@ViewData["Title"]</h4>
        <p class="text-muted mb-0">@(isEdit ? "Modifier un contrat commercial existant" : "Créer un contrat commercial            directement")</p>
    </div>
    <a asp-action="Contrats" class="btn btn-outline-secondary rounded-pill"><i
            class="bi bi-arrow-left me-1"></i>Retour</a>
</div>

<form asp-action="@(isEdit ? "ContratEdit" : "ContratCreate")" asp-route-id="@(isEdit ? contratId : null)"
    method="post">
    <!-- Informations générales -->
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-header bg-gradient bg-success bg-opacity-10 border-0 rounded-top-4 py-3">
            <h6 class="fw-semibold mb-0 text-success"><i class="bi bi-info-circle me-2"></i>Informations générales</h6>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-medium">Client <span class="text-danger">*</span></label>
                    <select asp-for="ClientId" class="form-select rounded-3">
                        <option value="">Sélectionner un client</option>
                        @foreach (var c in clients)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.ClientId ? "selected" : null)">@c.RaisonSociale
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium">Objet</label>
                    <input asp-for="Objet" class="form-control rounded-3"
                        placeholder="Ex: Contrat prestations comptabilité 2026" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-medium">Devise</label>
                    <select asp-for="Devise" class="form-select rounded-3">
                        <option value="MAD" selected="@(Model.Devise == "MAD" ? "selected" : null)">MAD</option>
                        <option value="EUR" selected="@(Model.Devise == "EUR" ? "selected" : null)">EUR</option>
                        <option value="USD" selected="@(Model.Devise == "USD" ? "selected" : null)">USD</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="ModeleFacturation" class="form-label fw-medium">Modèle facturation <span
                            class="text-danger">*</span></label>
                    <select asp-for="ModeleFacturation" class="form-select rounded-3" required>
                        <option value="@RefCodes.ModeleFacturation.Forfait"
                            selected="@(Model.ModeleFacturation == RefCodes.ModeleFacturation.Forfait ? "selected" : null)">
                            Forfait</option>
                        <option value="Regie" selected="@(Model.ModeleFacturation == "Regie" ? "selected" : null)">Régie
                        </option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="DateDebutContrat" class="form-label fw-medium">Date de début <span
                            class="text-danger">*</span></label>
                    <input asp-for="DateDebutContrat" type="date" class="form-control rounded-3" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DateFinContrat" class="form-label fw-medium">Date de fin</label>
                    <input asp-for="DateFinContrat" type="date" class="form-control rounded-3" />
                </div>
                <div class="col-md-4">
                    <label asp-for="FrequenceFacturation" class="form-label fw-medium">Fréquence facturation</label>
                    <select asp-for="FrequenceFacturation" class="form-select rounded-3">
                        <option value=""
                            selected="@(string.IsNullOrEmpty(Model.FrequenceFacturation) ? "selected" : null)">--
                            Sélectionner --</option>
                        <option value="@RefCodes.Frequence.Mensuelle"
                            selected="@(Model.FrequenceFacturation == RefCodes.Frequence.Mensuelle ? "selected" : null)">
                            Mensuelle</option>
                        <option value="Trimestrielle"
                            selected="@(Model.FrequenceFacturation == "Trimestrielle" ? "selected" : null)">
                            Trimestrielle</option>
                        <option value="Semestrielle"
                            selected="@(Model.FrequenceFacturation == "Semestrielle" ? "selected" : null)">Semestrielle
                        </option>
                        <option value="@RefCodes.Frequence.Annuelle"
                            selected="@(Model.FrequenceFacturation == RefCodes.Frequence.Annuelle ? "selected" : null)">
                            Annuelle</option>
                        <option value="Ponctuelle"
                            selected="@(Model.FrequenceFacturation == "Ponctuelle" ? "selected" : null)">Ponctuelle
                        </option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-medium">Description</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="2"
                        placeholder="Description du contrat..."></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium">Conditions particulières</label>
                    <textarea asp-for="ConditionsParticulieres" class="form-control rounded-3" rows="2"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium">Clauses spécifiques</label>
                    <textarea asp-for="ClausesSpecifiques" class="form-control rounded-3" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium">Notes</label>
                    <textarea asp-for="Notes" class="form-control rounded-3" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Lignes du contrat -->
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div
            class="card-header bg-gradient bg-primary bg-opacity-10 border-0 rounded-top-4 py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-semibold mb-0 text-primary"><i class="bi bi-list-ul me-2"></i>Lignes du contrat</h6>
            <button type="button" class="btn btn-sm btn-primary rounded-pill" onclick="addLigne()"><i
                    class="bi bi-plus me-1"></i>Ajouter</button>
        </div>
        <div class="card-body">
            <div id="lignesContainer">
                @if (Model.Lignes.Any())
                {
                    for (int i = 0; i < Model.Lignes.Count; i++)
                    {
                        <div class="ligne-row border rounded-3 p-3 mb-2 bg-light bg-opacity-50" data-index="@i">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small text-muted mb-1">Description</label>
                                    <input name="Lignes[@i].Description" value="@Model.Lignes[i].Description"
                                        class="form-control form-control-sm rounded-3" placeholder="Description *" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small text-muted mb-1">Type</label>
                                    <select name="Lignes[@i].TypeLigne" class="form-select form-select-sm rounded-3">
                                        <option value="Service"
                                            selected="@(Model.Lignes[i].TypeLigne == "Service" ? "selected" : null)">Service
                                        </option>
                                        <option value="Régie"
                                            selected="@(Model.Lignes[i].TypeLigne == "Régie" ? "selected" : null)">Régie
                                        </option>
                                        <option value="@RefCodes.ModeleFacturation.Forfait"
                                            selected="@(Model.Lignes[i].TypeLigne == RefCodes.ModeleFacturation.Forfait ? "selected" : null)">
                                            Forfait</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small text-muted mb-1">Prestation</label>
                                    <select name="Lignes[@i].TypeService" class="form-select form-select-sm rounded-3">
                                        <option value="">— Aucune</option>
                                        @foreach (var ts in typeServiceItems)
                                        {
                                            <option value="@ts.Code" selected="@(Model.Lignes[i].TypeService == ts.Code ? "selected" : null)">@ts.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small text-muted mb-1">Qté</label>
                                    <input name="Lignes[@i].Quantite" value="@Model.Lignes[i].Quantite" type="number"
                                        step="0.01" class="form-control form-control-sm rounded-3" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small text-muted mb-1">Prix HT</label>
                                    <input name="Lignes[@i].PrixUnitaireHT" value="@Model.Lignes[i].PrixUnitaireHT"
                                        type="number" step="0.01" class="form-control form-control-sm rounded-3" />
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small text-muted mb-1">TVA%</label>
                                    <input name="Lignes[@i].TauxTVA" value="@Model.Lignes[i].TauxTVA" type="number" step="0.01"
                                        class="form-control form-control-sm rounded-3" />
                                </div>
                                <input name="Lignes[@i].Ordre" value="@Model.Lignes[i].Ordre" type="hidden" />
                                <div class="col-md-1 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                        onclick="this.closest('.ligne-row').remove()"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div id="noLignes" class="text-center text-muted py-3" style="display:none">
                <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                <small>Cliquez sur "Ajouter" pour ajouter des lignes</small>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Contrats" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
        <button type="submit" class="btn btn-success rounded-pill px-4"><i class="bi bi-check-circle me-1"></i>@(isEdit
                        ? "Enregistrer les modifications" : "Créer le Contrat")</button>
    </div>
</form>

<script>
    let ligneIndex = @(Model.Lignes.Count);

    // Liste plate de tous les services (chargée depuis ViewBag)
    const services = @Html.Raw(servicesJson);

    // Build TypeService options from ReferenceData (loaded dynamically from DB)
    const typeServiceOptionsHtml = [
        @foreach (var ts in typeServiceItems)
        {
            <text>`<option value="@ts.Code">@ts.Label</option>`,</text>
        }
    ].join('')

    function addLigne() {
        document.getElementById('noLignes').style.display = 'none';
        const container = document.getElementById('lignesContainer');
        const i = ligneIndex++;
        // TypeService dropdown is embedded in the HTML template
        container.insertAdjacentHTML('beforeend', `
            <div class="ligne-row border rounded-3 p-3 mb-2 bg-light bg-opacity-50">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">Description</label>
                        <input name="Lignes[${i}].Description" class="form-control form-control-sm rounded-3" placeholder="Description *" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">Type</label>
                        <select name="Lignes[${i}].TypeLigne" class="form-select form-select-sm rounded-3">
                            <option value="Service">Service</option>
                            <option value="Régie">Régie</option>
                            <option value="@RefCodes.ModeleFacturation.Forfait">Forfait</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">Prestation</label>
                        <select name="Lignes[${i}].TypeService" class="form-select form-select-sm rounded-3">
                            <option value="">— Aucune</option>
                            ${typeServiceOptionsHtml}
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small text-muted mb-1">Qté</label>
                        <input name="Lignes[${i}].Quantite" value="1" type="number" step="0.01" class="form-control form-control-sm rounded-3" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">Prix HT</label>
                        <input name="Lignes[${i}].PrixUnitaireHT" value="0" type="number" step="0.01" class="form-control form-control-sm rounded-3" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small text-muted mb-1">TVA%</label>
                        <input name="Lignes[${i}].TauxTVA" value="20" type="number" step="0.01" class="form-control form-control-sm rounded-3" />
                    </div>
                    <input name="Lignes[${i}].Ordre" value="${i + 1}" type="hidden" />
                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="this.closest('.ligne-row').remove()"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>
        `);
    }
</script>