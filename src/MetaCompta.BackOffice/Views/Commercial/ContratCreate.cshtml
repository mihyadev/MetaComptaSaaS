@model ContratCommercialCreateDto
@{
    var isEdit = ViewBag.ContratId != null;
    var contratId = isEdit ? (int)ViewBag.ContratId : 0;
    ViewData["Title"] = isEdit ? "Modifier le contrat" : "Nouveau contrat";
    var clients = ViewBag.Clients as List<ClientDto> ?? new();
    var typeServiceItems = (ViewData["Ref_TYPE_SERVICE"] as List<ReferenceDataDto>) ?? new();
    var checkedServices = Model.ServicesActives ?? new List<ContratServiceActiveLine>();
    var clientsJson = System.Text.Json.JsonSerializer.Serialize(
        clients.Select(c => new {
            id = c.Id, ice = c.ICE, fiscalId = c.IF, rc = c.RC,
            cnss = c.NumeroCNSS, ville = c.VilleSiegeSocial, name = c.RaisonSociale
        })
    );
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-primary text-white rounded-3 p-3 lh-1">
            <i class="bi bi-file-earmark-plus fs-4"></i>
        </span>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Contrats" class="text-decoration-none">Contrats</a></li>
                    <li class="breadcrumb-item active">@(isEdit ? "Éditer" : "Nouveau")</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0">@ViewData["Title"]</h1>
        </div>
    </div>
    <a asp-action="Contrats" class="btn btn-light border rounded-pill px-3">Retour au board</a>
</div>

<form asp-action="@(isEdit ? "ContratEdit" : "ContratCreate")" asp-route-id="@(isEdit ? contratId : null)"
      method="post" id="contratForm" class="needs-validation" novalidate>

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
                <div class="card-header bg-white border-0 pt-4 px-4 rounded-top-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">1 · Client</span>
                        <span class="text-body-secondary small">Identité &amp; période</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="clientSelect" class="form-label fw-semibold">Client</label>
                            <select asp-for="ClientId" class="form-select form-select-lg rounded-3" id="clientSelect" required>
                                <option value="">Sélectionner un client…</option>
                                @foreach (var c in clients)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.ClientId ? "selected" : null)">@c.RaisonSociale</option>
                                }
                            </select>
                            <div class="invalid-feedback">Client obligatoire.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Objet" class="form-label fw-semibold">Objet</label>
                            <input asp-for="Objet" class="form-control rounded-3" placeholder="Mission fiduciaire — exercice 2026" />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="DateDebutContrat" class="form-label fw-semibold">Début</label>
                            <input asp-for="DateDebutContrat" type="date" class="form-control rounded-3" required />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="DateFinContrat" class="form-label fw-semibold">Fin</label>
                            <input asp-for="DateFinContrat" type="date" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Devise" class="form-label fw-semibold">Devise</label>
                            <select asp-for="Devise" class="form-select rounded-3" id="deviseSelect">
                                <option value="MAD" selected="@(Model.Devise == "MAD" ? "selected" : null)">MAD</option>
                                <option value="EUR" selected="@(Model.Devise == "EUR" ? "selected" : null)">EUR</option>
                                <option value="USD" selected="@(Model.Devise == "USD" ? "selected" : null)">USD</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ModeleFacturation" class="form-label fw-semibold">Modèle</label>
                            <select asp-for="ModeleFacturation" class="form-select rounded-3">
                                <option value="Forfait" selected="@(Model.ModeleFacturation == "Forfait" ? "selected" : null)">Forfait</option>
                                <option value="Regie" selected="@(Model.ModeleFacturation == "Regie" ? "selected" : null)">Régie</option>
                                <option value="Mixte" selected="@(Model.ModeleFacturation == "Mixte" ? "selected" : null)">Mixte</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <div id="clientLegalBadge" class="bg-primary-subtle rounded-3 p-3 d-none">
                                <div class="small fw-semibold text-primary-emphasis mb-2">Identifiants légaux</div>
                                <div class="d-flex flex-wrap gap-2" id="clientLegalChips"></div>
                            </div>
                            <div id="clientLegalEmpty" class="form-text">Sélectionnez un client pour afficher ICE, IF, CNSS, RC.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConditionsParticulieres" class="form-label fw-semibold">Conditions particulières</label>
                            <textarea asp-for="ConditionsParticulieres" class="form-control rounded-3" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClausesSpecifiques" class="form-label fw-semibold">Clauses spécifiques</label>
                            <textarea asp-for="ClausesSpecifiques" class="form-control rounded-3" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold">Notes internes</label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            @{
                var employees = ViewBag.Employees as List<CabinetEmployeeDto> ?? new();
            }
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="fw-semibold">Équipe du dossier</div>
                    <div class="small text-body-secondary">Affectation des collaborateurs du cabinet</div>
                </div>
                <div class="card-body p-4">
                    @{
                        ViewBag.Employees = employees;
                        ViewBag.InitialMembreInputs = Model.Membres;
                        ViewBag.EditorId = "equipeCreate";
                        ViewBag.ShowActions = true;
                    }
                    @await Html.PartialAsync("_EquipeDossierEditor")
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-info">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill bg-info-subtle text-info-emphasis px-3 py-2">2 · Services</span>
                        <span class="text-body-secondary small">Périmètre opérationnel</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    @{
                        var svcVD = new ViewDataDictionary(ViewData);
                        svcVD["typeServiceItems"] = typeServiceItems;
                        svcVD["checkedServices"] = checkedServices;
                        svcVD["prefix"] = "svc";
                    }
                    @await Html.PartialAsync("_ServicesPicker", null, svcVD)
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-success">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis px-3 py-2">3 · Honoraires</span>
                        <span class="text-body-secondary small">Lignes libres</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3" onclick="addLigne()">
                        <i class="bi bi-plus-lg me-1"></i>Ajouter
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="feeTable">
                            <thead class="table-light">
                                <tr class="small text-body-secondary text-uppercase">
                                    <th class="ps-4 fw-semibold border-0">Description</th>
                                    <th class="fw-semibold border-0 text-end">Prix HT</th>
                                    <th class="fw-semibold border-0 text-end">Remise</th>
                                    <th class="fw-semibold border-0">TVA</th>
                                    <th class="fw-semibold border-0">Périodicité</th>
                                    <th class="fw-semibold border-0 text-end">Net</th>
                                    <th class="fw-semibold border-0 text-end">TTC</th>
                                    <th class="border-0 pe-3"></th>
                                </tr>
                            </thead>
                            <tbody id="lignesContainer">
                                @if (Model.Lignes.Any())
                                {
                                    for (int i = 0; i < Model.Lignes.Count; i++)
                                    {
                                        var mode = Model.Lignes[i].ModeFacturation ?? "";
                                        var tva = Model.Lignes[i].TauxTVA;
                                        <tr class="ligne-row">
                                            <td class="ps-4">
                                                <input name="Lignes[@i].Description" value="@Model.Lignes[i].Description"
                                                       class="form-control form-control-sm rounded-3" required />
                                                <input type="hidden" name="Lignes[@i].Quantite" value="@(Model.Lignes[i].Quantite <= 0 ? 1 : Model.Lignes[i].Quantite)" />
                                                <input type="hidden" name="Lignes[@i].Ordre" value="@(i + 1)" class="ligne-ordre" />
                                            </td>
                                            <td>
                                                <div class="input-group input-group-sm">
                                                    <input name="Lignes[@i].PrixUnitaireHT" value="@Model.Lignes[i].PrixUnitaireHT.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                           type="number" step="0.01" min="0" class="form-control text-end fee-pu rounded-start-3" oninput="recalcFees()" />
                                                    <span class="input-group-text rounded-end-3">MAD</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="input-group input-group-sm">
                                                    <input name="Lignes[@i].RemisePourcentage" value="@((Model.Lignes[i].RemisePourcentage ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                           type="number" step="0.01" min="0" max="100" class="form-control text-end fee-remise" oninput="recalcFees()" />
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <select name="Lignes[@i].TauxTVA" class="form-select form-select-sm rounded-3 fee-tva" onchange="recalcFees()">
                                                    <option value="20" selected="@(tva != 0 ? "selected" : null)">20 %</option>
                                                    <option value="0" selected="@(tva == 0 ? "selected" : null)">0 %</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select name="Lignes[@i].ModeFacturation" class="form-select form-select-sm rounded-3">
                                                    <option value="" selected="@(string.IsNullOrEmpty(mode) ? "selected" : null)">Ponctuel</option>
                                                    <option value="Mensuel" selected="@(mode == "Mensuel" ? "selected" : null)">Mensuel</option>
                                                    <option value="Trimestriel" selected="@(mode == "Trimestriel" ? "selected" : null)">Trimestriel</option>
                                                    <option value="Semestriel" selected="@(mode == "Semestriel" ? "selected" : null)">Semestriel</option>
                                                    <option value="Annuel" selected="@(mode == "Annuel" ? "selected" : null)">Annuel</option>
                                                </select>
                                            </td>
                                            <td class="text-end fw-semibold fee-net">0,00</td>
                                            <td class="text-end fw-semibold text-success fee-ttc">0,00</td>
                                            <td class="pe-3">
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                                        onclick="this.closest('.ligne-row').remove(); checkNoLignes(); recalcFees();">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="noLignes" class="text-center text-body-secondary py-5 @(Model.Lignes.Any() ? "d-none" : "")">
                        <div class="mb-2"><i class="bi bi-receipt fs-3 text-success"></i></div>
                        Aucune ligne — ajoutez librement vos honoraires
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="addLigne()">Ajouter</button>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 py-3 mb-2">
                <i class="bi bi-check2 me-1"></i>@(isEdit ? "Enregistrer" : "Créer le contrat")
            </button>
            <div class="text-center mb-4">
                <a asp-action="Contrats" class="link-secondary small">Annuler</a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top">
                <div class="card-header bg-primary text-white border-0 rounded-top-4 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Récapitulatif</span>
                        <span class="badge text-bg-light text-primary rounded-pill" id="recapLignes">0</span>
                    </div>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-semibold">Services</div>
                            <div class="small text-body-secondary">Cochés</div>
                        </div>
                        <span class="badge rounded-pill bg-info-subtle text-info-emphasis px-3" id="recapServices">0</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-body-secondary">Total HT</span>
                        <span class="fw-semibold" id="sumHT">0,00</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-body-secondary">TVA</span>
                        <span class="fw-semibold" id="sumTVA">0,00</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3 bg-success-subtle">
                        <span class="fw-bold text-success-emphasis">Total TTC</span>
                        <span class="fw-bold text-success-emphasis fs-5" id="sumTTC">0,00</span>
                    </li>
                </ul>
                <div class="card-body">
                    <div class="small text-body-secondary">
                        <i class="bi bi-info-circle me-1"></i>
                        Services = périmètre · Honoraires = facturation (indépendants)
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
(() => {
    'use strict';
    const form = document.getElementById('contratForm');
    form.addEventListener('submit', event => {
        reindexLignes();
        if (!form.checkValidity()) { event.preventDefault(); event.stopPropagation(); }
        form.classList.add('was-validated');
    }, false);
})();

let ligneIndex = @(Model.Lignes.Count);
const CLIENTS = @Html.Raw(clientsJson);

function chip(label, value) {
    if (!value) value = '—';
    return '<span class="badge rounded-pill text-bg-light border px-3 py-2">'
        + '<span class="text-body-secondary me-1">' + label + '</span><strong>' + String(value).replace(/</g,'&lt;') + '</strong></span>';
}

function refreshClientLegal() {
    var id = parseInt(document.getElementById('clientSelect').value || '0', 10);
    var c = CLIENTS.find(function (x) { return x.id === id; });
    var badge = document.getElementById('clientLegalBadge');
    var empty = document.getElementById('clientLegalEmpty');
    var chips = document.getElementById('clientLegalChips');
    if (!c) {
        badge.classList.add('d-none');
        empty.classList.remove('d-none');
        return;
    }
    empty.classList.add('d-none');
    badge.classList.remove('d-none');
    var rc = c.rc || '';
    if (c.ville) rc = rc ? (rc + ' — ' + c.ville) : c.ville;
    chips.innerHTML = chip('ICE', c.ice) + chip('IF', c.fiscalId) + chip('CNSS', c.cnss) + chip('RC', rc);
}

document.getElementById('clientSelect').addEventListener('change', refreshClientLegal);
refreshClientLegal();

function fmt(n) {
    return (Math.round((n + Number.EPSILON) * 100) / 100).toLocaleString('fr-MA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function recalcFees() {
    var sumHT = 0, sumTVA = 0, sumTTC = 0, n = 0;
    document.querySelectorAll('#lignesContainer .ligne-row').forEach(function (row) {
        n++;
        var pu = parseFloat(row.querySelector('.fee-pu')?.value) || 0;
        var remise = parseFloat(row.querySelector('.fee-remise')?.value) || 0;
        if (remise < 0) remise = 0; if (remise > 100) remise = 100;
        var tva = parseFloat(row.querySelector('.fee-tva')?.value) || 0;
        var net = pu * (1 - remise / 100);
        var ttc = net * (1 + tva / 100);
        var netEl = row.querySelector('.fee-net');
        var ttcEl = row.querySelector('.fee-ttc');
        if (netEl) netEl.textContent = fmt(net);
        if (ttcEl) ttcEl.textContent = fmt(ttc);
        sumHT += net; sumTVA += (ttc - net); sumTTC += ttc;
    });
    document.getElementById('sumHT').textContent = fmt(sumHT);
    document.getElementById('sumTVA').textContent = fmt(sumTVA);
    document.getElementById('sumTTC').textContent = fmt(sumTTC);
    document.getElementById('recapLignes').textContent = n;
}

function addLigne() {
    document.getElementById('noLignes').classList.add('d-none');
    const i = ligneIndex++;
    const tr = document.createElement('tr');
    tr.className = 'ligne-row';
    tr.innerHTML = `
        <td class="ps-4">
            <input name="Lignes[${i}].Description" class="form-control form-control-sm rounded-3" placeholder="Forfait mensuel" required />
            <input type="hidden" name="Lignes[${i}].Quantite" value="1" />
            <input type="hidden" name="Lignes[${i}].Ordre" value="${i + 1}" class="ligne-ordre" />
        </td>
        <td>
            <div class="input-group input-group-sm">
                <input name="Lignes[${i}].PrixUnitaireHT" value="0" type="number" step="0.01" min="0"
                    class="form-control text-end fee-pu rounded-start-3" oninput="recalcFees()" />
                <span class="input-group-text rounded-end-3">MAD</span>
            </div>
        </td>
        <td>
            <div class="input-group input-group-sm">
                <input name="Lignes[${i}].RemisePourcentage" value="0" type="number" step="0.01" min="0" max="100"
                    class="form-control text-end fee-remise" oninput="recalcFees()" />
                <span class="input-group-text">%</span>
            </div>
        </td>
        <td>
            <select name="Lignes[${i}].TauxTVA" class="form-select form-select-sm rounded-3 fee-tva" onchange="recalcFees()">
                <option value="20" selected>20 %</option><option value="0">0 %</option>
            </select>
        </td>
        <td>
            <select name="Lignes[${i}].ModeFacturation" class="form-select form-select-sm rounded-3">
                <option value="">Ponctuel</option>
                <option value="Mensuel">Mensuel</option>
                <option value="Trimestriel">Trimestriel</option>
                <option value="Semestriel">Semestriel</option>
                <option value="Annuel">Annuel</option>
            </select>
        </td>
        <td class="text-end fw-semibold fee-net">0,00</td>
        <td class="text-end fw-semibold text-success fee-ttc">0,00</td>
        <td class="pe-3">
            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                onclick="this.closest('.ligne-row').remove(); checkNoLignes(); recalcFees();"><i class="bi bi-x"></i></button>
        </td>`;
    document.getElementById('lignesContainer').appendChild(tr);
    recalcFees();
}

function checkNoLignes() {
    const count = document.querySelectorAll('#lignesContainer .ligne-row').length;
    document.getElementById('noLignes').classList.toggle('d-none', count > 0);
}

function reindexLignes() {
    document.querySelectorAll('#lignesContainer .ligne-row').forEach(function (row, newIdx) {
        row.querySelectorAll('[name]').forEach(function (el) {
            el.name = el.name.replace(/Lignes\[\d+\]/, 'Lignes[' + newIdx + ']');
        });
        var ord = row.querySelector('.ligne-ordre');
        if (ord) ord.value = newIdx + 1;
    });
}

setInterval(function () {
    var b = document.getElementById('svcCountBadge');
    var el = document.getElementById('recapServices');
    if (b && el) { var m = b.textContent.match(/(\d+)/); el.textContent = m ? m[1] : '0'; }
}, 400);

recalcFees();
</script>
}
