@model FactureDto
@{
    ViewData["Title"] = $"Facture {Model.Reference}";
    var resteDu = Model.MontantTTC - Model.MontantPaye;
    var pctPaye = Model.MontantTTC > 0 ? (Model.MontantPaye / Model.MontantTTC * 100) : 0;
    var canFactureSend = ViewBag.CanFactureSend as bool? ?? false;
    var canFactureCancel = ViewBag.CanFactureCancel as bool? ?? false;
    var canFacturePayments = ViewBag.CanFactureManagePayments as bool? ?? false;
    var canFactureCreate = ViewBag.CanFactureCreate as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-receipt text-primary me-2"></i>@Model.Reference</h4>
        <p class="text-muted mb-0">@Model.ClientName — @(Model.ContratReference != null ? $"Contrat            {Model.ContratReference}" : "Facture manuelle")</p>
    </div>
    <div class="d-flex gap-2">
        @if ((Model.Statut == RefCodes.StatutFacture.Brouillon || Model.Statut == RefCodes.StatutFacture.Emise) && canFactureSend)
        {
            <form asp-action="FactureEnvoyer" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-primary rounded-pill"><i class="bi bi-send me-1"></i>Envoyer</button>
            </form>
        }
        @if (Model.Statut != RefCodes.StatutFacture.Payee && Model.Statut != "Annulee" && Model.Statut != "Avoir" && canFacturePayments)
        {
            <button class="btn btn-success rounded-pill" data-bs-toggle="modal" data-bs-target="#paiementModal"><i
                    class="bi bi-cash me-1"></i>Enregistrer Paiement</button>
        }
        @if ((Model.Statut == RefCodes.StatutFacture.Brouillon || Model.Statut == RefCodes.StatutFacture.Emise) && canFactureCancel)
        {
            <form asp-action="FactureAnnuler" asp-route-id="@Model.Id" method="post" class="d-inline"
                onsubmit="return confirm('Annuler cette facture ?');">
                <button type="submit" class="btn btn-outline-danger rounded-pill"><i
                        class="bi bi-x-circle me-1"></i>Annuler</button>
            </form>
        }
        @if (canFactureCreate)
        {
            <form asp-action="FactureDupliquer" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-info rounded-pill"><i
                        class="bi bi-copy me-1"></i>Dupliquer</button>
            </form>
        }
        <a asp-action="Factures" class="btn btn-outline-secondary rounded-pill"><i
                class="bi bi-arrow-left me-1"></i>Retour</a>
    </div>
</div>

<!-- Infos + Montants -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Statut</label>
                        @{
                            var badge = Model.Statut switch
                            {
                                RefCodes.StatutFacture.Brouillon => "secondary",
                                RefCodes.StatutFacture.Emise => "info",
                                RefCodes.StatutFacture.Envoyee => "primary",
                                RefCodes.StatutFacture.PartiellementPayee => "warning",
                                RefCodes.StatutFacture.Payee =>
                                "success",
                                RefCodes.StatutFacture.EnRetard => "danger",
                                RefCodes.StatutFacture.Annulee =>
                                "dark",
                                _ => "secondary"
                                };
                        }
                        <p class="mb-2"><span class="badge bg-@badge rounded-pill fs-6">@Model.Statut</span></p>
                    </div>
                    <div class="col-md-4"><label class="form-label small text-muted">Date d'émission</label>
                        <p class="mb-2">@Model.DateEmission.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4"><label class="form-label small text-muted">Date d'échéance</label>
                        <p class="mb-2">@Model.DateEcheance.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4"><label class="form-label small text-muted">Période</label>
                        <p class="mb-2">@(Model.PeriodeDebut?.ToString("dd/MM/yyyy") ?? "-") →
                            @(Model.PeriodeFin?.ToString("dd/MM/yyyy") ?? "-")</p>
                    </div>
                    <div class="col-md-4"><label class="form-label small text-muted">Objet</label>
                        <p class="mb-2">@(Model.Objet ?? "-")</p>
                    </div>
                    <div class="col-md-4"><label class="form-label small text-muted">Version</label>
                        <p class="mb-2">v@Model.Version</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center">
                <h6 class="text-muted mb-3">Montants</h6>
                <div class="mb-2"><span class="text-muted">HT:</span> <span
                        class="fw-semibold">@Model.MontantHT.ToString("N2") @Model.Devise</span></div>
                <div class="mb-2"><span class="text-muted">TVA:</span> <span>@Model.MontantTVA.ToString("N2")</span>
                </div>
                <hr />
                <div class="mb-3"><span class="text-muted">TTC:</span> <span
                        class="fw-bold fs-5 text-primary">@Model.MontantTTC.ToString("N2") @Model.Devise</span></div>
                <!-- Barre de progression paiement -->
                <div class="progress mb-2" style="height: 8px;">
                    <div class="progress-bar bg-success" style="width: @pctPaye%"></div>
                </div>
                <div class="d-flex justify-content-between">
                    <small class="text-success fw-semibold">Payé: @Model.MontantPaye.ToString("N2")</small>
                    <small class="text-danger fw-semibold">Reste: @resteDu.ToString("N2")</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lignes -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-semibold"><i class="bi bi-list-ul me-2"></i>Lignes (@Model.Lignes.Count)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th class="text-end">Qté</th>
                        <th class="text-end">Prix HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end pe-3">TTC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lignes.OrderBy(x => x.Ordre))
                    {
                        <tr>
                            <td class="ps-3">@l.Ordre</td>
                            <td>
                                <div class="fw-semibold">@l.Description</div>
                                @if (!string.IsNullOrWhiteSpace(l.TypeService))
                                {
                                    <small class="text-muted">@l.TypeService</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark">@l.TypeLigne</span></td>
                            <td class="text-end">@l.Quantite @l.Unite</td>
                            <td class="text-end">@l.PrixUnitaireHT.ToString("N2")</td>
                            <td class="text-end">@l.TauxTVA%</td>
                            <td class="text-end fw-semibold">@l.MontantHT.ToString("N2")</td>
                            <td class="text-end fw-semibold pe-3">@l.MontantTTC.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paiements -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-semibold"><i class="bi bi-cash-stack me-2"></i>Paiements (@Model.Paiements.Count)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Référence</th>
                        <th>Date</th>
                        <th>Mode</th>
                        <th class="text-end">Montant</th>
                        <th>Statut</th>
                        <th>Note</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Paiements.Any())
                    {
                        @foreach (var p in Model.Paiements)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@p.Reference</td>
                                <td>@p.DatePaiement.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark">@p.ModePaiement</span></td>
                                <td class="text-end fw-semibold text-success">@p.Montant.ToString("N2") @p.Devise</td>
                                <td><span class="badge bg-success rounded-pill">@p.Statut</span></td>
                                <td><small>@p.Notes</small></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">Aucun paiement enregistré</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Historique -->
@if (Model.Historique.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="fw-semibold"><i class="bi bi-clock-history me-2"></i>Historique</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Action</th>
                            <th>Statut</th>
                            <th>Commentaire</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Historique)
                        {
                            <tr>
                                <td class="ps-3"><small>@h.DateAction.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td class="fw-semibold">@h.Action</td>
                                <td>
                                    @if (h.AncienStatut != null)
                                    {
                                        <span class="badge bg-secondary rounded-pill">@h.AncienStatut</span>
                                        <text>→</text>
                                    }
                                    <span class="badge bg-primary rounded-pill">@h.NouveauStatut</span>
                                </td>
                                <td><small>@h.Commentaire</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Modal Paiement -->
<div class="modal fade" id="paiementModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <form asp-action="EnregistrerPaiement" method="post">
                <input type="hidden" name="FactureId" value="@Model.Id" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cash me-2"></i>Enregistrer un paiement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Montant <span class="text-danger">*</span></label>
                        <input type="number" name="Montant" class="form-control rounded-3" step="0.01" min="0.01"
                            max="@resteDu" value="@resteDu" required />
                        <small class="text-muted">Reste dû: @resteDu.ToString("N2") @Model.Devise</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mode de paiement <span class="text-danger">*</span></label>
                        <select name="ModePaiement" class="form-select rounded-3" required>
                            <option value="">-- Sélectionner --</option>
                            <option value="Virement">Virement bancaire</option>
                            <option value="Cheque">Chèque</option>
                            <option value="Especes">Espèces</option>
                            <option value="CarteBancaire">Carte bancaire</option>
                            <option value="Prelevement">Prélèvement</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date du paiement <span class="text-danger">*</span></label>
                        <input type="date" name="DatePaiement" class="form-control rounded-3"
                            value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Référence bancaire</label>
                        <input type="text" name="ReferenceBancaire" class="form-control rounded-3"
                            placeholder="Ex: VIR-20260115-001" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Note</label>
                        <textarea name="Notes" class="form-control rounded-3" rows="2"
                            placeholder="Commentaire optionnel..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill"
                        data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4"><i
                            class="bi bi-check-lg me-1"></i>Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>