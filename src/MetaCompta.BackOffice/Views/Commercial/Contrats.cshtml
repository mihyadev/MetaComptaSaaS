@model PagedResult<ContratCommercialDto>
@{
    ViewData["Title"] = "Contrats";
    var statut = ViewBag.Statut as string ?? "";
    var canCommercialCreate = ViewBag.CanCommercialCreate as bool? ?? false;
    var canCommercialEdit = ViewBag.CanCommercialEdit as bool? ?? false;
    var items = Model.Items?.ToList() ?? new List<ContratCommercialDto>();
    var groups = new (string Key, string Label, string Border, string Soft, string Text)[] {
        ("Brouillon", "Brouillon", "border-secondary", "bg-secondary-subtle", "text-secondary-emphasis"),
        ("EnCours", "En cours", "border-info", "bg-info-subtle", "text-info-emphasis"),
        ("Signe", "Signé", "border-primary", "bg-primary-subtle", "text-primary-emphasis"),
        ("Valide", "Validé", "border-success", "bg-success-subtle", "text-success-emphasis"),
        ("Actif", "Actif", "border-success", "bg-success-subtle", "text-success-emphasis"),
        ("Suspendu", "Suspendu", "border-warning", "bg-warning-subtle", "text-warning-emphasis"),
        ("Termine", "Terminé", "border-dark", "bg-dark-subtle", "text-dark-emphasis"),
        ("Resilie", "Résilié", "border-danger", "bg-danger-subtle", "text-danger-emphasis"),
        ("Expire", "Expiré", "border-dark", "bg-dark-subtle", "text-dark-emphasis"),
    };
    string SoftBadge(string s) => s switch {
        RefCodes.StatutContrat.Brouillon => "bg-secondary-subtle text-secondary-emphasis",
        RefCodes.StatutContrat.EnCours => "bg-info-subtle text-info-emphasis",
        RefCodes.StatutContrat.Signe => "bg-primary-subtle text-primary-emphasis",
        RefCodes.StatutContrat.Valide => "bg-success-subtle text-success-emphasis",
        RefCodes.StatutContrat.Actif => "bg-success-subtle text-success-emphasis",
        RefCodes.StatutContrat.Suspendu => "bg-warning-subtle text-warning-emphasis",
        "Termine" => "bg-dark-subtle text-dark-emphasis",
        RefCodes.StatutContrat.Resilie => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-primary text-white rounded-3 p-3 lh-1">
            <i class="bi bi-kanban fs-4"></i>
        </span>
        <div>
            <h1 class="h3 fw-bold mb-0">Contrats</h1>
            <div class="text-body-secondary small">Board CRM · @Model.TotalCount item(s)</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light border rounded-pill px-3">
            <i class="bi bi-speedometer2 me-1"></i>Dashboard
        </a>
        @if (canCommercialCreate)
        {
            <a asp-action="ContratCreate" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i>Nouveau contrat
            </a>
        }
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="text-body-secondary small fw-semibold text-uppercase me-1">Filtrer</span>
            <a asp-action="Contrats" class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(statut) ? "btn-dark" : "btn-outline-secondary")">Tous</a>
            @foreach (var g in groups)
            {
                <a asp-action="Contrats" asp-route-statut="@g.Key"
                   class="btn btn-sm rounded-pill @(statut == g.Key ? "btn-dark" : "btn-outline-secondary")">@g.Label</a>
            }
        </div>
    </div>
</div>

@if (!items.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <span class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-3 fs-3">
                <i class="bi bi-inbox"></i>
            </span>
            <h2 class="h5 fw-semibold">Aucun contrat</h2>
            <p class="text-body-secondary mb-3">Créez votre premier item sur ce board.</p>
            @if (canCommercialCreate)
            {
                <a asp-action="ContratCreate" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-lg me-1"></i>Nouveau contrat
                </a>
            }
        </div>
    </div>
}
else
{
    @foreach (var g in groups)
    {
        var rows = items.Where(c => string.Equals(c.Statut, g.Key, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrEmpty(statut) && !string.Equals(statut, g.Key, StringComparison.OrdinalIgnoreCase)) { continue; }
        if (!rows.Any()) { continue; }

        <div class="card border-0 shadow-sm rounded-4 mb-3 border-start border-4 @g.Border">
            <div class="card-header bg-white border-0 py-3 rounded-top-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill @g.Soft @g.Text px-3 py-2">@g.Label</span>
                    <span class="text-body-secondary small">@rows.Count item(s)</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-body-secondary text-uppercase">
                            <th class="ps-4 fw-semibold border-0">Item</th>
                            <th class="fw-semibold border-0">Client</th>
                            <th class="fw-semibold border-0">Statut</th>
                            <th class="fw-semibold border-0">Modèle</th>
                            <th class="fw-semibold border-0 text-end">TTC</th>
                            <th class="fw-semibold border-0">Dates</th>
                            <th class="fw-semibold border-0 text-center">Signé</th>
                            <th class="fw-semibold border-0 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in rows)
                        {
                            var source = c.BonCommandeReference != null
                                ? $"BC {c.BonCommandeReference}"
                                : c.DevisReference != null ? $"DEV {c.DevisReference}" : "Direct";
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="ContratDetails" asp-route-id="@c.Id" class="fw-semibold text-decoration-none text-body">
                                        @c.Reference
                                    </a>
                                    <div class="small text-body-secondary">@source</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-circle bg-primary-subtle text-primary">
                                            @(string.IsNullOrEmpty(c.ClientName) ? "?" : c.ClientName.Trim()[0].ToString().ToUpper())
                                        </span>
                                        <span>@c.ClientName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @SoftBadge(c.Statut) px-3 py-2">@c.Statut</span>
                                </td>
                                <td><span class="badge rounded-pill text-bg-light border">@c.ModeleFacturation</span></td>
                                <td class="text-end fw-semibold text-nowrap">@c.MontantTTC.ToString("N2") <span class="text-body-secondary small">@c.Devise</span></td>
                                <td class="small text-nowrap text-body-secondary">
                                    @(c.DateDebutContrat?.ToString("dd/MM/yy") ?? "—")
                                    →
                                    @(c.DateFinContrat?.ToString("dd/MM/yy") ?? "—")
                                </td>
                                <td class="text-center">
                                    @if (c.EstSigne)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis">Oui</span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">—</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-action="ContratDetails" asp-route-id="@c.Id" class="btn btn-sm btn-light border rounded-pill">Ouvrir</a>
                                    @if (canCommercialEdit && !c.EstSigne && (c.Statut == RefCodes.StatutContrat.Brouillon || c.Statut == RefCodes.StatutContrat.EnCours))
                                    {
                                        <a asp-action="ContratEdit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill">Éditer</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link rounded-pill mx-1" asp-action="Contrats" asp-route-page="@i" asp-route-statut="@statut">@i</a>
                </li>
            }
        </ul>
    </nav>
}
