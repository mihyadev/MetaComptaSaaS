@model PagedResult<ContratCommercialDto>
@{
    ViewData["Title"] = "Contrats Commerciaux";
    var statut = ViewBag.Statut as string ?? "";

}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-text text-success me-2"></i>Contrats Commerciaux</h4>
        <p class="text-muted mb-0">@Model.TotalCount contrats au total</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ContratCreate" class="btn btn-success rounded-pill px-3"><i class="bi bi-plus-circle me-1"></i>Nouveau Contrat</a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
    </div>
</div>

<!-- Filtres avancés -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Statut</label>
                <select name="statut" class="form-select form-select-sm rounded-pill">
                    <option value="">Tous les statuts</option>
                    @foreach (var s in new[] { "Brouillon", "EnCours", "Signe", "Actif", "Suspendu", "Termine", "Resilie", "Expire" })
                    {
                        <option value="@s" selected="@(statut == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill"><i class="bi bi-funnel me-1"></i>Filtrer</button>
            </div>
            <div class="col-auto">
                <a asp-action="Contrats" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="bi bi-x-circle me-1"></i>Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<!-- Liste -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Référence</th><th>Client</th><th>Source</th><th>Modèle</th><th class="text-end">Montant TTC</th>
                        <th>Date début</th><th>Date fin</th><th>Factures</th><th>Signé</th><th>Statut</th><th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var c in Model.Items)
                        {
                            var badge = c.Statut switch { RefCodes.StatutContrat.Brouillon => "secondary", RefCodes.StatutContrat.EnCours => "info", RefCodes.StatutContrat.Signe => "purple", RefCodes.StatutContrat.Actif => "success", RefCodes.StatutContrat.Suspendu => "warning", "Termine" => "dark", RefCodes.StatutContrat.Resilie => "danger", RefCodes.StatutContrat.Expire => "dark", _ => "secondary" };
                            var source = c.BonCommandeReference != null ? $"BC: {c.BonCommandeReference}" : c.DevisReference != null ? $"DEV: {c.DevisReference}" : "Direct";
                            <tr>
                                <td class="ps-3"><a asp-action="ContratDetails" asp-route-id="@c.Id" class="fw-semibold text-decoration-none">@c.Reference</a></td>
                                <td>@c.ClientName</td>
                                <td><small class="text-muted">@source</small></td>
                                <td><span class="badge bg-light text-dark">@c.ModeleFacturation</span></td>
                                <td class="text-end fw-semibold">@c.MontantTTC.ToString("N2") @c.Devise</td>
                                <td><small>@(c.DateDebutContrat?.ToString("dd/MM/yyyy") ?? "—")</small></td>
                                <td><small>@(c.DateFinContrat?.ToString("dd/MM/yyyy") ?? "∞")</small></td>
                                <td class="text-center"><span class="badge bg-light text-dark">@c.NombreFactures</span></td>
                                <td class="text-center">@(c.EstSigne ? "✅" : "—")</td>
                                <td><span class="badge bg-@badge rounded-pill">@c.Statut</span></td>
                                <td class="text-end pe-3">
                                    <a asp-action="ContratDetails" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Aucun contrat trouvé</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link rounded-pill mx-1" asp-action="Contrats" asp-route-page="@i" asp-route-statut="@statut">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<style>.bg-purple { background-color: #7c3aed !important; }</style>
