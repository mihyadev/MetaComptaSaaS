@model PagedResult<FactureDto>
@{
    ViewData["Title"] = "Factures";
    var statut = ViewBag.Statut as string ?? "";
    var canFactureCreate = ViewBag.CanFactureCreate as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-receipt text-primary me-2"></i>Factures</h4>
        <p class="text-muted mb-0">@Model.TotalCount factures au total</p>
    </div>
    <div class="d-flex gap-2">
        @if (canFactureCreate)
        {
            <a asp-action="FactureCreate" class="btn btn-primary rounded-pill px-3"><i class="bi bi-plus-circle me-1"></i>Nouvelle Facture</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
    </div>
</div>

<!-- Filtres avancés -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Statut</label>
                <select name="statut" class="form-select form-select-sm rounded-pill">
                    <option value="">Tous les statuts</option>
                    @foreach (var s in new[] { RefCodes.StatutFacture.Brouillon, RefCodes.StatutFacture.Emise, RefCodes.StatutFacture.Envoyee, RefCodes.StatutFacture.PartiellementPayee, RefCodes.StatutFacture.Payee, RefCodes.StatutFacture.EnRetard, RefCodes.StatutFacture.Annulee, RefCodes.StatutFacture.Avoir, RefCodes.StatutFacture.Contentieux })
                    {
                        <option value="@s" selected="@(statut == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill"><i class="bi bi-funnel me-1"></i>Filtrer</button>
            </div>
            <div class="col-auto">
                <a asp-action="Factures" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="bi bi-x-circle me-1"></i>Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<!-- Liste -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Référence</th><th>Client</th><th>Contrat</th><th class="text-end">Montant TTC</th>
                        <th class="text-end">Payé</th><th class="text-end">Reste</th><th>Échéance</th><th>Statut</th><th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var f in Model.Items)
                        {
                            var badge = f.Statut switch { RefCodes.StatutFacture.Brouillon => "secondary", RefCodes.StatutFacture.Emise => "info", RefCodes.StatutFacture.Envoyee => "primary", RefCodes.StatutFacture.PartiellementPayee => "warning", RefCodes.StatutFacture.Payee => "success", RefCodes.StatutFacture.EnRetard => "danger", RefCodes.StatutFacture.Annulee => "dark", RefCodes.StatutFacture.Avoir => "dark", RefCodes.StatutFacture.Contentieux => "danger", _ => "secondary" };
                            var resteDu = f.MontantTTC - f.MontantPaye;
                            <tr>
                                <td class="ps-3"><a asp-action="FactureDetails" asp-route-id="@f.Id" class="fw-semibold text-decoration-none">@f.Reference</a></td>
                                <td>@f.ClientName</td>
                                <td><small class="text-muted">@(f.ContratReference ?? "-")</small></td>
                                <td class="text-end fw-semibold">@f.MontantTTC.ToString("N2")</td>
                                <td class="text-end text-success">@f.MontantPaye.ToString("N2")</td>
                                <td class="text-end @(resteDu > 0 ? "text-danger fw-semibold" : "")">@resteDu.ToString("N2")</td>
                                <td><small>@f.DateEcheance.ToString("dd/MM/yyyy")</small></td>
                                <td><span class="badge bg-@badge rounded-pill">@f.Statut</span></td>
                                <td class="text-end pe-3">
                                    <a asp-action="FactureDetails" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Aucune facture trouvée</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link rounded-pill mx-1" asp-action="Factures" asp-route-page="@i" asp-route-statut="@statut">@i</a>
                </li>
            }
        </ul>
    </nav>
}
