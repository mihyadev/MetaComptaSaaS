@model PagedResult<BonCommandeDto>
@{
    ViewData["Title"] = "Bons de Commande";
    var statut = ViewBag.Statut as string ?? "";

}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-cart-check text-info me-2"></i>Bons de Commande</h4>
        <p class="text-muted mb-0">@Model.TotalCount bons de commande au total</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Statut</label>
                <select name="statut" class="form-select form-select-sm rounded-pill">
                    <option value="">Tous</option>
                    <option value="@RefCodes.StatutBonCommande.Brouillon" selected="@(statut == RefCodes.StatutBonCommande.Brouillon)">Brouillon</option>
                    <option value="@RefCodes.StatutBonCommande.Confirme" selected="@(statut == RefCodes.StatutBonCommande.Confirme)">Confirmé</option>
                    <option value="@RefCodes.StatutBonCommande.Approuve" selected="@(statut == RefCodes.StatutBonCommande.Approuve)">Approuvé</option>
                    <option value="@RefCodes.StatutBonCommande.Annule" selected="@(statut == RefCodes.StatutBonCommande.Annule)">Annulé</option>
                </select>
            </div>
            <div class="col-md-3">
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill"><i class="bi bi-search me-1"></i>Filtrer</button>
            </div>
            <div class="col-auto">
                <a asp-action="BonsCommande" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="bi bi-x-circle me-1"></i>Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 mc-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Référence</th>
                        <th>Client</th>
                        <th>Devis source</th>
                        <th class="text-end">Montant TTC</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var b in Model.Items)
                        {
                            <tr>
                                <td class="ps-4"><code class="fw-semibold">@b.Reference</code></td>
                                <td>@b.ClientName</td>
                                <td><code>@b.DevisReference</code></td>
                                <td class="text-end fw-semibold">@b.MontantTTC.ToString("N2") @b.Devise</td>
                                <td><small>@b.DateEmission.ToString("dd/MM/yyyy")</small></td>
                                <td>
                                    @{ var bc = b.Statut switch { RefCodes.StatutBonCommande.Brouillon => "secondary", RefCodes.StatutBonCommande.Confirme => "info", RefCodes.StatutBonCommande.Approuve => "success", _ => "dark" }; }
                                    <span class="badge bg-@bc rounded-pill">@b.Statut</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="BonCommandeDetails" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>Aucun bon de commande</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.TotalPages; i++)
        { <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link rounded-pill mx-1" asp-action="BonsCommande" asp-route-page="@i" asp-route-statut="@statut">@i</a></li> }
    </ul></nav>
}
