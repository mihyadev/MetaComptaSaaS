@model ConvertDevisEnContratDto
@using System.Text.Json
@{
    ViewData["Title"] = "Convertir le Devis en Contrat";
    var devis = ViewBag.Devis as DevisDto;
    var clientServices = ViewBag.ClientServices as List<object> ?? new();
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var clientServicesJson = JsonSerializer.Serialize(clientServices, jsonOptions);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-arrow-right-circle text-success me-2"></i>Convertir en Contrat</h4>
        <p class="text-muted mb-0">Devis <code>@devis?.Reference</code> → Contrat commercial (conversion directe)</p>
    </div>
    <a asp-action="DevisDetails" asp-route-id="@Model.DevisId" class="btn btn-outline-secondary rounded-pill"><i
            class="bi bi-arrow-left me-1"></i>Retour au Devis</a>
</div>

<div class="row g-4">
    <!-- Résumé du devis -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient bg-primary bg-opacity-10 border-0 rounded-top-4 py-3">
                <h6 class="fw-semibold mb-0 text-primary"><i class="bi bi-file-earmark-text me-2"></i>Devis source</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Référence</small>
                    <span class="fw-semibold">@devis?.Reference</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Client</small>
                    <span class="fw-semibold">@devis?.ClientName</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Objet</small>
                    <span>@(devis?.Objet ?? "—")</span>
                </div>
                <hr />
                <div class="text-center">
                    <small class="text-muted d-block mb-1">Montant TTC</small>
                    <span class="fs-4 fw-bold text-primary">@devis?.MontantTTC.ToString("N2") @devis?.Devise</span>
                </div>
                <div class="mt-3">
                    <small class="text-muted d-block mb-1">Lignes</small>
                    <span class="badge bg-primary rounded-pill">@devis?.Lignes.Count ligne(s)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulaire de conversion -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient bg-success bg-opacity-10 border-0 rounded-top-4 py-3">
                <h6 class="fw-semibold mb-0 text-success"><i class="bi bi-file-earmark-check me-2"></i>Paramètres du
                    Contrat</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="DevisConvertirEnContrat" method="post">
                    <input type="hidden" asp-for="DevisId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DateDebutContrat" class="form-label fw-medium">Date de début <span
                                    class="text-danger">*</span></label>
                            <input asp-for="DateDebutContrat" type="date" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateFinContrat" class="form-label fw-medium">Date de fin</label>
                            <input asp-for="DateFinContrat" type="date" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ModeleFacturation" class="form-label fw-medium">Modèle de facturation <span
                                    class="text-danger">*</span></label>
                            <select asp-for="ModeleFacturation" class="form-select rounded-3" required>
                                <option value="@RefCodes.ModeleFacturation.Forfait">Forfait</option>
                                <option value="Regie">Régie</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FrequenceFacturation" class="form-label fw-medium">Fréquence de
                                facturation</label>
                            <select asp-for="FrequenceFacturation" class="form-select rounded-3">
                                <option value="">-- Sélectionner --</option>
                                <option value="@RefCodes.Frequence.Mensuelle">Mensuelle</option>
                                <option value="Trimestrielle">Trimestrielle</option>
                                <option value="Semestrielle">Semestrielle</option>
                                <option value="@RefCodes.Frequence.Annuelle">Annuelle</option>
                                <option value="Ponctuelle">Ponctuelle</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium">Clauses spécifiques</label>
                        <textarea asp-for="ClausesSpecifiques" class="form-control rounded-3" rows="3"
                            placeholder="Clauses spécifiques au contrat..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium">Notes</label>
                        <textarea asp-for="Notes" class="form-control rounded-3" rows="2"
                            placeholder="Notes supplémentaires..."></textarea>
                    </div>

                    <!-- Lignes du devis avec liaison service -->
                    <div class="border rounded-3 p-3 mb-4">
                        <h6 class="fw-semibold mb-3"><i class="bi bi-list-ul me-2"></i>Lignes du devis — Liaison service
                            déclaratif</h6>
                        <p class="text-muted small mb-3">Vous pouvez optionnellement associer chaque ligne à un service
                            déclaratif du client.</p>
                        @if (devis?.Lignes?.Any() == true)
                        {
                            @for (int i = 0; i < devis.Lignes.Count; i++)
                            {
                                var l = devis.Lignes.OrderBy(x => x.Ordre).ToList()[i];
                                <div class="border rounded-3 p-2 mb-2 bg-light bg-opacity-50">
                                    <div class="row g-2 align-items-center">
                                        <input type="hidden" name="LigneServiceOverrides[@i].LigneId" value="@l.Id" />
                                        <div class="col-md-1 text-center"><span
                                                class="badge bg-secondary rounded-pill">@l.Ordre</span></div>
                                        <div class="col-md-4"><span class="fw-semibold small">@l.Description</span></div>
                                        <div class="col-md-2"><span class="text-muted small">@l.TypeLigne</span></div>
                                        <div class="col-md-2 text-end"><span class="small">@l.MontantHT.ToString("N2") HT</span>
                                        </div>
                                        <div class="col-md-3">
                                            <select name="LigneServiceOverrides[@i].ServiceContratId"
                                                class="form-select form-select-sm rounded-3 service-select"
                                                data-selected="@l.ServiceContratId">
                                                <option value="">— Aucun service</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">Aucune ligne dans ce devis.</p>
                        }
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-3">
                        <a asp-action="DevisDetails" asp-route-id="@Model.DevisId"
                            class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                        <button type="submit" class="btn btn-success rounded-pill px-4"><i
                                class="bi bi-check-lg me-1"></i>Créer le Contrat</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const services = @Html.Raw(clientServicesJson);
        const noServiceOption = services.length === 0
            ? '<option value="">— Aucun service déclaratif configuré</option>'
            : '<option value="">— Aucun service</option>';
        document.querySelectorAll('.service-select').forEach(sel => {
            const prev = sel.dataset.selected || '';
            sel.innerHTML = noServiceOption +
                services.map(s => `<option value="${s.id}" ${s.id == prev ? 'selected' : ''}>${s.label}</option>`).join('');
        });
    })();
</script>