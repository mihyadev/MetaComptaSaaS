@model ConvertDevisEnContratDto
@{
    ViewData["Title"] = "Convertir le Devis en Contrat";
    var devis = ViewBag.Devis as DevisDto;
    var typeServiceItems = (ViewData["Ref_TYPE_SERVICE"] as List<ReferenceDataDto>) ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-arrow-right-circle text-success me-2"></i>Convertir en Contrat</h4>
        <p class="text-muted mb-0">Devis <code>@devis?.Reference</code> → Contrat commercial (conversion directe)</p>
    </div>
    <a asp-action="DevisDetails" asp-route-id="@Model.DevisId" class="btn btn-outline-secondary rounded-pill"><i
            class="bi bi-arrow-left me-1"></i>Retour au Devis</a>
</div>

<div class="row g-4">
    <!-- Résumé du devis -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient bg-primary bg-opacity-10 border-0 rounded-top-4 py-3">
                <h6 class="fw-semibold mb-0 text-primary"><i class="bi bi-file-earmark-text me-2"></i>Devis source</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Référence</small>
                    <span class="fw-semibold">@devis?.Reference</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Client</small>
                    <span class="fw-semibold">@devis?.ClientName</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Objet</small>
                    <span>@(devis?.Objet ?? "—")</span>
                </div>
                <hr />
                <div class="text-center">
                    <small class="text-muted d-block mb-1">Montant TTC</small>
                    <span class="fs-4 fw-bold text-primary">@devis?.MontantTTC.ToString("N2") @devis?.Devise</span>
                </div>
                <div class="mt-3">
                    <small class="text-muted d-block mb-1">Lignes</small>
                    <span class="badge bg-primary rounded-pill">@devis?.Lignes.Count ligne(s)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulaire de conversion -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient bg-success bg-opacity-10 border-0 rounded-top-4 py-3">
                <h6 class="fw-semibold mb-0 text-success"><i class="bi bi-file-earmark-check me-2"></i>Paramètres du
                    Contrat</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="DevisConvertirEnContrat" method="post">
                    <input type="hidden" asp-for="DevisId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DateDebutContrat" class="form-label fw-medium">Date de début <span
                                    class="text-danger">*</span></label>
                            <input asp-for="DateDebutContrat" type="date" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateFinContrat" class="form-label fw-medium">Date de fin</label>
                            <input asp-for="DateFinContrat" type="date" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium">Clauses spécifiques</label>
                        <textarea asp-for="ClausesSpecifiques" class="form-control rounded-3" rows="3"
                            placeholder="Clauses spécifiques au contrat..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium">Notes</label>
                        <textarea asp-for="Notes" class="form-control rounded-3" rows="2"
                            placeholder="Notes supplémentaires..."></textarea>
                    </div>

                    <!-- Services inclus -->
                    <div class="border-0 mb-4">
                        <h6 class="fw-semibold mb-3 text-info"><i class="bi bi-check2-circle me-2"></i>Services inclus dans le contrat</h6>
                        @{ var cvVD = new ViewDataDictionary(ViewData); cvVD["typeServiceItems"] = typeServiceItems; cvVD["checkedServices"] = new List<ContratServiceActiveLine>(); cvVD["prefix"] = "cv"; }
                        @await Html.PartialAsync("_ServicesPicker", null, cvVD)
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-3">
                        <a asp-action="DevisDetails" asp-route-id="@Model.DevisId"
                            class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                        <button type="submit" class="btn btn-success rounded-pill px-4"><i
                                class="bi bi-check-lg me-1"></i>Créer le Contrat</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

