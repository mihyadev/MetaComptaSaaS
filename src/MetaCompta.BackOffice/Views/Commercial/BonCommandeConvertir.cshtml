@model ConvertBonCommandeEnContratDto
@{
    ViewData["Title"] = "Convertir en Contrat Commercial";
    var bonCommande = ViewBag.BonCommande as BonCommandeDto;
    var typeServiceItems = (ViewData["Ref_TYPE_SERVICE"] as List<ReferenceDataDto>) ?? new();
    var employees = ViewBag.Employees as List<CabinetEmployeeDto> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-arrow-right-circle text-primary me-2"></i>Convertir en Contrat</h4>
        <p class="text-muted mb-0">Bon de commande → Contrat commercial</p>
    </div>
    <a asp-action="BonCommandeDetails" asp-route-id="@Model.BonCommandeId" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-arrow-left me-1"></i>Retour au BC</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="BonCommandeConvertir" method="post">
                    <input type="hidden" asp-for="BonCommandeId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DateDebutContrat" class="form-label">Date de début <span class="text-danger">*</span></label>
                            <input asp-for="DateDebutContrat" type="date" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateFinContrat" class="form-label">Date de fin</label>
                            <input asp-for="DateFinContrat" type="date" class="form-control rounded-3" />
                        </div>
                    </div>



                    <div class="mb-3">
                        <label class="form-label">Clauses spécifiques</label>
                        <textarea asp-for="ClausesSpecifiques" class="form-control rounded-3" rows="3" placeholder="Clauses spécifiques au contrat..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control rounded-3" rows="2" placeholder="Notes supplémentaires..."></textarea>
                    </div>

                    <!-- Services inclus -->
                    <div class="border-0 mb-4">
                        <h6 class="fw-semibold mb-3 text-info"><i class="bi bi-check2-circle me-2"></i>Périmètre (packs)</h6>
                        @{
                            var bcVD = new ViewDataDictionary(ViewData);
                            bcVD["typeServiceItems"] = typeServiceItems;
                            bcVD["checkedServices"] = new List<ContratServiceActiveLine>();
                            bcVD["ServiceGroups"] = ViewData["ServiceGroups"] ?? ViewBag.ServiceGroups;
                            bcVD["prefix"] = "bc";
                        }
                        @await Html.PartialAsync("_ServicesPicker", null, bcVD)
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-3">
                        <a asp-action="BonCommandeDetails" asp-route-id="@Model.BonCommandeId" class="btn btn-outline-secondary rounded-pill">Annuler</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Créer le Contrat</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

