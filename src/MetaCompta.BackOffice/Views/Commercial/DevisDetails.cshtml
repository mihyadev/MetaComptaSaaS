@model DevisDto
@{
    ViewData["Title"] = $"Devis {Model.Reference}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-text text-primary me-2"></i>Devis @Model.Reference</h4>
        <p class="text-muted mb-0">@Model.ClientName — @(Model.Objet ?? "Sans objet")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Statut == RefCodes.StatutDevis.Brouillon)
        {
            <a asp-action="DevisEdit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill"><i
                    class="bi bi-pencil me-1"></i>Modifier</a>
            <form asp-action="DevisSoumettre" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-warning rounded-pill"><i class="bi bi-send me-1"></i>Soumettre</button>
            </form>
            <form asp-action="DevisSupprimer" asp-route-id="@Model.Id" method="post" class="d-inline"
                onsubmit="return confirm('Supprimer ce devis ?')">
                <button type="submit" class="btn btn-outline-danger rounded-pill"><i
                        class="bi bi-trash me-1"></i>Supprimer</button>
            </form>
        }
        @if (Model.Statut == "Soumis")
        {
            <form asp-action="DevisApprouver" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success rounded-pill"><i
                        class="bi bi-check-circle me-1"></i>Approuver</button>
            </form>
            <button type="button" class="btn btn-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#rejetModal"><i
                    class="bi bi-x-circle me-1"></i>Rejeter</button>
        }
        @if (Model.PeutConvertir)
        {
            <form asp-action="DevisConvertir" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-info rounded-pill text-white"><i
                        class="bi bi-arrow-right-circle me-1"></i>Convertir en BC</button>
            </form>
            <a asp-action="DevisConvertirEnContrat" asp-route-id="@Model.Id" class="btn btn-success rounded-pill"><i
                    class="bi bi-file-earmark-check me-1"></i>Convertir en Contrat</a>
        }
        <form asp-action="DevisDupliquer" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-info rounded-pill"><i
                    class="bi bi-copy me-1"></i>Dupliquer</button>
        </form>
        <a asp-action="Devis" class="btn btn-outline-secondary rounded-pill"><i
                class="bi bi-arrow-left me-1"></i>Retour</a>
    </div>
</div>

<!-- Info Card -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted">Client</label>
                        <p class="fw-semibold mb-2">@Model.ClientName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted">Statut</label>
                        <p class="mb-2">
                            @{
                                var badgeClass = Model.Statut switch
                                {
                                    RefCodes.StatutDevis.Brouillon => "secondary",
                                    "Soumis" => "warning",
                                    RefCodes.StatutDevis.Approuve => "success",
                                    "Rejete" => "danger",
                                    _
                                    => "dark"
                                    };
                            }
                            <span class="badge bg-@badgeClass rounded-pill fs-6">@Model.Statut</span>
                        </p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Date d'émission</label>
                        <p class="mb-2">@Model.DateEmission.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Date de validité</label>
                        <p class="mb-2">@(Model.DateValidite?.ToString("dd/MM/yyyy") ?? "Non définie")</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Version</label>
                        <p class="mb-2">v@Model.Version</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ConditionsParticulieres))
                    {
                        <div class="col-12">
                            <label class="form-label small text-muted">Conditions particulières</label>
                            <p class="mb-2">@Model.ConditionsParticulieres</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.MotifRejet))
                    {
                        <div class="col-12">
                            <div class="alert alert-danger mb-0"><strong>Motif du rejet :</strong> @Model.MotifRejet</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center">
                <h6 class="text-muted mb-3">Montants</h6>
                <div class="mb-2"><span class="text-muted">HT:</span> <span
                        class="fw-semibold">@Model.MontantHT.ToString("N2") @Model.Devise</span></div>
                @if (Model.MontantRemise > 0)
                {
                    <div class="mb-2"><span class="text-muted">Remise:</span> <span
                            class="text-danger">-@Model.MontantRemise.ToString("N2")</span></div>
                }
                <div class="mb-2"><span class="text-muted">TVA:</span> <span>@Model.MontantTVA.ToString("N2")</span>
                </div>
                <hr />
                <div><span class="text-muted">TTC:</span> <span
                        class="fw-bold fs-5 text-primary">@Model.MontantTTC.ToString("N2") @Model.Devise</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Lignes -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-semibold"><i class="bi bi-list-ul me-2"></i>Lignes du devis (@Model.Lignes.Count)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Service décl.</th>
                        <th class="text-end">Qté</th>
                        <th class="text-end">Prix Unit. HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">Montant TTC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lignes.OrderBy(x => x.Ordre))
                    {
                        <tr>
                            <td class="ps-3">@l.Ordre</td>
                            <td>
                                <div class="fw-semibold">@l.Description</div>
                                @if (!string.IsNullOrWhiteSpace(l.TypeService))
                                {
                                    <small class="text-muted">@l.TypeService</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark">@l.TypeLigne</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(l.ServiceContratLibelle))
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info"><i
                                            class="bi bi-link-45deg me-1"></i>@l.ServiceContratLibelle</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">@l.Quantite @l.Unite</td>
                            <td class="text-end">@l.PrixUnitaireHT.ToString("N2")</td>
                            <td class="text-end">@l.TauxTVA%</td>
                            <td class="text-end fw-semibold">@l.MontantHT.ToString("N2")</td>
                            <td class="text-end fw-semibold">@l.MontantTTC.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Historique -->
@if (Model.Historique.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="fw-semibold"><i class="bi bi-clock-history me-2"></i>Historique</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Action</th>
                            <th>Statut</th>
                            <th>Utilisateur</th>
                            <th>Commentaire</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Historique)
                        {
                            <tr>
                                <td class="ps-3"><small>@h.DateAction.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td class="fw-semibold">@h.Action</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(h.AncienStatut))
                                    {
                                        <span class="badge bg-secondary rounded-pill">@h.AncienStatut</span>
                                        <i class="bi bi-arrow-right mx-1"></i>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(h.NouveauStatut))
                                    {
                                        <span class="badge bg-primary rounded-pill">@h.NouveauStatut</span>
                                    }
                                </td>
                                <td>@h.UserName</td>
                                <td><small class="text-muted">@h.Commentaire</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Modal Rejet -->
<div class="modal fade" id="rejetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <form asp-action="DevisRejeter" asp-route-id="@Model.Id" method="post">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Rejeter le devis</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Motif du rejet *</label>
                    <textarea name="motif" class="form-control" rows="3" required
                        placeholder="Indiquez la raison du rejet..."></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill"
                        data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger rounded-pill"><i
                            class="bi bi-x-circle me-1"></i>Rejeter</button>
                </div>
            </form>
        </div>
    </div>
</div>