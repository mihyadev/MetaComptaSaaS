@using MetaCompta.Domain.Common
@using System.Text.Json
@{
    var typeServiceItems = (ViewData["typeServiceItems"] as List<ReferenceDataDto>) ?? new();
    var checkedServices = (ViewData["checkedServices"] as List<ContratServiceActiveLine>) ?? new();
    var prefix = (ViewData["prefix"] as string) ?? "svc";
    var groups = (ViewData["ServiceGroups"] as IReadOnlyList<ContractServiceGroups.ContractServiceGroup>)
        ?? ContractServiceGroups.All;

    var refPairs = typeServiceItems.Select(s => (s.Code, s.Label)).ToList();
    var groupsJson = JsonSerializer.Serialize(groups.Select(g => new
    {
        id = g.GroupId,
        title = g.Title,
        shortTitle = g.ShortTitle,
        reference = g.ReferenceNote,
        color = g.Color,
        codes = g.AttachedTypeServiceCodes.Select(c => new
        {
            code = c,
            label = ContractServiceGroups.LabelForCode(c, refPairs)
        }).ToList(),
        info = g.InfoItems.Select(i => new
        {
            n = i.Number,
            label = i.Label,
            period = i.Periodicite
        }).ToList()
    }));
    var checkedCodesJson = JsonSerializer.Serialize(
        checkedServices.Select(s => s.TypeService ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).ToList()
    );
    // Always camelCase so JS (wfMeta / renderWfAffectation) can read stepOrder / assignedToUserIds.
    var checkedMetaJson = JsonSerializer.Serialize(
        checkedServices
            .Where(s => !string.IsNullOrWhiteSpace(s.TypeService))
            .Select(s => new
            {
                code = s.TypeService,
                workflowTemplateId = s.WorkflowTemplateId,
                primaryAssigneeUserId = s.PrimaryAssigneeUserId,
                stepAssignments = (s.StepAssignments ?? new List<ContratWorkflowStepAssignmentDto>())
                    .Select(st => new
                    {
                        stepOrder = st.StepOrder,
                        assignedToUserId = st.AssignedToUserId,
                        assignedToUserIds = st.AssignedToUserIds
                            ?? (string.IsNullOrWhiteSpace(st.AssignedToUserId)
                                ? new List<string>()
                                : new List<string> { st.AssignedToUserId! }),
                        assignedToRoleNames = st.AssignedToRoleNames ?? new List<string>()
                    })
                    .ToList()
            })
            .ToList()
    );
}

<div id="@(prefix)Picker" class="svc-picker">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <span class="badge rounded-pill bg-dark text-white px-3 py-2" id="@(prefix)CountBadge">0 pack</span>
            <span class="small text-body-secondary ms-2">Cochez les packs métier du contrat.</span>
        </div>
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="spcProposeAll_@(prefix)()">Tout cocher</button>
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="spcClearAll_@(prefix)()">Tout décocher</button>
        </div>
    </div>
    <div class="vstack gap-3" id="@(prefix)Families"></div>
    <div id="@(prefix)Hidden"></div>
</div>

<script>
(function () {
    var pfx = '@prefix';
    var GROUPS = @Html.Raw(groupsJson);
    var CHECKED_CODES = @Html.Raw(checkedCodesJson);
    var CHECKED_META = @Html.Raw(checkedMetaJson);

    var checkedCodes = new Set();
    CHECKED_CODES.forEach(function (c) { if (c) checkedCodes.add(String(c).toUpperCase()); });

    // Optional WF meta restored on edit (code -> { templateId, assigneeId, stepAssignments })
    var wfMeta = {};
    (CHECKED_META || []).forEach(function (m) {
        if (!m || !m.code) return;
        var steps = (m.stepAssignments || m.StepAssignments || []).map(function (st) {
            if (!st) return null;
            var users = st.assignedToUserIds || st.AssignedToUserIds || [];
            if ((!users || !users.length) && (st.assignedToUserId || st.AssignedToUserId)) {
                users = [st.assignedToUserId || st.AssignedToUserId];
            }
            return {
                stepOrder: st.stepOrder != null ? st.stepOrder : st.StepOrder,
                assignedToUserIds: users,
                assignedToRoleNames: st.assignedToRoleNames || st.AssignedToRoleNames || []
            };
        }).filter(Boolean);
        wfMeta[String(m.code).toUpperCase()] = {
            workflowTemplateId: m.workflowTemplateId || m.WorkflowTemplateId || null,
            primaryAssigneeUserId: m.primaryAssigneeUserId || m.PrimaryAssigneeUserId || null,
            stepAssignments: steps
        };
    });

    function esc(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function codeKey(c) { return String(c || '').toUpperCase(); }

    function groupSelectedCount(g) {
        return (g.codes || []).filter(function (x) { return checkedCodes.has(codeKey(x.code)); }).length;
    }

    function isGroupOn(g) {
        var total = (g.codes || []).length;
        if (total === 0) return false;
        return groupSelectedCount(g) === total;
    }

    function selectedPackCount() {
        return GROUPS.filter(isGroupOn).length;
    }

    function updateBadge() {
        var n = selectedPackCount();
        var b = document.getElementById(pfx + 'CountBadge');
        if (b) b.textContent = n + (n <= 1 ? ' pack' : ' packs');
    }

    function proposeGroup(g) {
        (g.codes || []).forEach(function (x) { checkedCodes.add(codeKey(x.code)); });
    }

    function clearGroup(g) {
        (g.codes || []).forEach(function (x) { checkedCodes.delete(codeKey(x.code)); });
    }

    function notifyChange() {
        updateBadge();
        try {
            document.dispatchEvent(new CustomEvent('svc-picker-change', {
                detail: { prefix: pfx, selection: window['spcGetSelection_' + pfx]() }
            }));
        } catch (e) { /* ignore */ }
    }

    function render() {
        var root = document.getElementById(pfx + 'Families');
        if (!root) return;
        root.innerHTML = '';

        GROUPS.forEach(function (g) {
            var total = (g.codes || []).length;
            var on = isGroupOn(g);
            var color = g.color || 'primary';
            var infoId = pfx + '_info_' + g.id;

            var card = document.createElement('div');
            card.className = 'svc-group card border-0 shadow-sm rounded-4 border-start border-4 border-' + color
                + (on ? ' bg-' + color + '-subtle bg-opacity-25' : '');
            card.setAttribute('data-group-id', g.id);

            var head = document.createElement('div');
            head.className = 'card-body py-3 px-3';

            var top = document.createElement('div');
            top.className = 'd-flex flex-wrap align-items-start justify-content-between gap-2';

            var checkId = pfx + '_pack_' + g.id;
            var checkWrap = document.createElement('div');
            checkWrap.className = 'form-check form-check-lg m-0 flex-shrink-0 pt-1';

            var chk = document.createElement('input');
            chk.type = 'checkbox';
            chk.className = 'form-check-input border-' + color;
            chk.id = checkId;
            chk.checked = on;
            chk.addEventListener('change', function () {
                if (chk.checked) proposeGroup(g); else clearGroup(g);
                render();
            });

            var checkLabel = document.createElement('label');
            checkLabel.className = 'form-check-label visually-hidden';
            checkLabel.setAttribute('for', checkId);
            checkLabel.textContent = 'Inclure ' + (g.shortTitle || g.id);
            checkWrap.appendChild(chk);
            checkWrap.appendChild(checkLabel);

            var titleBlock = document.createElement('label');
            titleBlock.className = 'flex-grow-1 mb-0';
            titleBlock.setAttribute('for', checkId);
            titleBlock.style.cursor = 'pointer';
            titleBlock.innerHTML =
                '<div class="fw-semibold">' + esc(g.title) + '</div>' +
                '<div class="small text-body-secondary mt-1">' +
                '<span class="badge rounded-pill bg-' + color + '-subtle text-' + color + '-emphasis border me-1">' +
                (on ? 'Inclus' : 'Non inclus') + '</span>' +
                ((g.info || []).length) + ' formalité(s) catalogue</div>';

            var actions = document.createElement('div');
            actions.className = 'd-flex flex-wrap align-items-center gap-1';

            var infoBtn = document.createElement('button');
            infoBtn.type = 'button';
            infoBtn.className = 'btn btn-sm btn-outline-' + color + ' rounded-circle';
            infoBtn.title = 'Voir le catalogue des formalités';
            infoBtn.setAttribute('data-bs-toggle', 'collapse');
            infoBtn.setAttribute('data-bs-target', '#' + infoId);
            infoBtn.setAttribute('aria-expanded', 'false');
            infoBtn.innerHTML = '<i class="bi bi-info-lg"></i>';
            infoBtn.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); });

            actions.appendChild(infoBtn);
            top.appendChild(checkWrap);
            top.appendChild(titleBlock);
            top.appendChild(actions);
            head.appendChild(top);
            card.appendChild(head);

            var collapse = document.createElement('div');
            collapse.className = 'collapse';
            collapse.id = infoId;
            var body = document.createElement('div');
            body.className = 'card-body pt-0 border-top';

            if (g.info && g.info.length) {
                var table = document.createElement('div');
                table.className = 'table-responsive';
                var html = '<table class="table table-sm align-middle mb-2" style="font-size:0.82rem;">' +
                    '<thead class="table-light"><tr><th style="width:3rem;">N°</th><th>Déclaration / formalité</th><th>Périodicité ou événement</th></tr></thead><tbody>';
                g.info.forEach(function (row) {
                    html += '<tr><td class="text-body-secondary">' + esc(row.n) + '</td><td>' + esc(row.label) +
                        '</td><td class="text-body-secondary">' + esc(row.period) + '</td></tr>';
                });
                html += '</tbody></table>';
                table.innerHTML = html;
                body.appendChild(table);
            }

            var note = document.createElement('div');
            note.className = 'small text-body-secondary fst-italic';
            note.textContent = g.reference || '';
            body.appendChild(note);

            collapse.appendChild(body);
            card.appendChild(collapse);
            root.appendChild(card);
        });
        notifyChange();
    }

    window['spcProposeAll_' + pfx] = function () {
        GROUPS.forEach(proposeGroup);
        render();
    };
    window['spcSelectAll_' + pfx] = window['spcProposeAll_' + pfx];
    window['spcClearAll_' + pfx] = function () {
        checkedCodes.clear();
        render();
    };
    window['spcGetCodes_' + pfx] = function () {
        var list = [];
        var emitted = new Set();
        GROUPS.forEach(function (g) {
            (g.codes || []).forEach(function (x) {
                var code = codeKey(x.code);
                if (!checkedCodes.has(code) || emitted.has(code)) return;
                emitted.add(code);
                list.push({ code: code, label: x.label || code, group: g.shortTitle || g.id, groupId: g.id });
            });
        });
        return list;
    };
    window['spcGetWfMeta_' + pfx] = function () { return wfMeta; };
    window['spcSetWfMeta_' + pfx] = function (code, templateId, assigneeId, stepAssignments) {
        var k = codeKey(code);
        var prev = wfMeta[k] || {};
        wfMeta[k] = {
            workflowTemplateId: templateId || null,
            primaryAssigneeUserId: assigneeId || null,
            stepAssignments: stepAssignments != null ? stepAssignments : (prev.stepAssignments || [])
        };
    };
    window['spcSerialize_' + pfx] = function () {
        var hid = document.getElementById(pfx + 'Hidden');
        if (!hid) return;
        hid.innerHTML = '';
        var idx = 0;
        var emitted = new Set();
        GROUPS.forEach(function (g) {
            (g.codes || []).forEach(function (x) {
                var code = codeKey(x.code);
                if (!checkedCodes.has(code) || emitted.has(code)) return;
                emitted.add(code);
                function h(name, val) {
                    if (val === null || val === undefined || val === '') return;
                    var inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'ServicesActives[' + idx + '].' + name;
                    inp.value = val;
                    hid.appendChild(inp);
                }
                h('TypeService', code);
                h('LibelleService', x.label || code);
                h('AutoGenererDeclarations', 'true');
                var meta = wfMeta[code];
                if (meta) {
                    if (meta.workflowTemplateId) h('WorkflowTemplateId', String(meta.workflowTemplateId));
                    if (meta.primaryAssigneeUserId) h('PrimaryAssigneeUserId', String(meta.primaryAssigneeUserId));
                    (meta.stepAssignments || []).forEach(function (st, si) {
                        if (!st || st.stepOrder == null) return;
                        h('StepAssignments[' + si + '].StepOrder', String(st.stepOrder));
                        (st.assignedToUserIds || []).forEach(function (uid, ui) {
                            h('StepAssignments[' + si + '].AssignedToUserIds[' + ui + ']', uid);
                        });
                        (st.assignedToRoleNames || []).forEach(function (rn, ri) {
                            h('StepAssignments[' + si + '].AssignedToRoleNames[' + ri + ']', rn);
                        });
                    });
                }
                idx++;
            });
        });
    };
    window['spcGetSelection_' + pfx] = function () {
        var domains = [];
        var seen = new Set();
        GROUPS.forEach(function (g) {
            if (isGroupOn(g) && !seen.has(g.id)) {
                seen.add(g.id);
                domains.push(g.shortTitle || g.id);
            }
        });
        return { count: checkedCodes.size, packs: selectedPackCount(), domains: domains, codes: window['spcGetCodes_' + pfx]() };
    };

    render();
    var picker = document.getElementById(pfx + 'Picker');
    if (picker) {
        var form = picker.closest('form');
        if (form) form.addEventListener('submit', function () { window['spcSerialize_' + pfx](); }, true);
    }
}());
</script>
