@{
    ViewData["Title"] = "Accueil";
    Layout = "_Layout";
    var userName = ViewBag.UserName as string ?? "Utilisateur";
    var cabinetName = ViewBag.CabinetName as string ?? "Cabinet";
    var hasClient = (bool)(ViewBag.HasClient ?? false);
    var selectedClientName = ViewBag.SelectedClientName as string ?? "";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Bonjour" : hour < 18 ? "Bon après-midi" : "Bonsoir";
}

<div class="text-center mb-4">
    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2 mb-2">@cabinetName</span>
    <h1 class="h2 fw-bold mb-1">@greeting, @userName</h1>
    <p class="text-body-secondary mb-0">Où souhaitez-vous travailler&nbsp;?</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-warning" id="gwDossier">
            <div class="card-body p-4">
                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2 mb-3">
                    <i class="bi bi-folder2-open me-1"></i>Dossier client
                </span>
                <h2 class="h4 fw-bold">Entrer dans un dossier</h2>
                <p class="text-body-secondary">Recherchez un client, activez son contexte, puis ouvrez ses déclarations et missions.</p>

                @if (hasClient)
                {
                    <div class="alert alert-success py-2 rounded-pill d-inline-flex align-items-center gap-2 mb-3">
                        <span class="badge rounded-circle text-bg-success">&nbsp;</span>
                        Client actif&nbsp;: <strong>@selectedClientName</strong>
                    </div>
                }

                <div class="input-group mb-2">
                    <span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" id="wsClientSearch" placeholder="Nom, raison sociale ou ICE…" autocomplete="off" />
                </div>
                <div class="list-group shadow-sm rounded-3 d-none" id="wsClientResults" style="max-height:240px;overflow-y:auto;"></div>

                @if (hasClient)
                {
                    <a class="btn btn-warning rounded-pill mt-3" href="@Url.Action("Index", "Declarations")">
                        Ouvrir le dossier de @selectedClientName
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                }
                else
                {
                    <p class="small text-body-secondary mt-3 mb-0">
                        <i class="bi bi-mouse me-1"></i>Cliquez un client pour ouvrir son dossier fiscal
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-primary">
            <div class="card-body p-4 d-flex flex-column">
                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2 mb-3">
                    <i class="bi bi-building me-1"></i>Cabinet
                </span>
                <h2 class="h4 fw-bold">Gestion interne</h2>
                <p class="text-body-secondary">Pilot, commercial, équipes, planification et pilotage du cabinet.</p>
                <div class="bg-primary-subtle rounded-3 p-3 mb-3">
                    <div class="fw-bold text-primary">@cabinetName</div>
                    <div class="small text-body-secondary">Espace administration</div>
                </div>
                <a href="@Url.Action("EnterCabinet", "Home")" class="btn btn-primary rounded-pill mt-auto align-self-start">
                    Accéder au cabinet
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    var searchInput = document.getElementById('wsClientSearch');
    var resultsBox = document.getElementById('wsClientResults');
    var debounceTimer = null;

    searchInput.addEventListener('focus', function() {
        if (searchInput.value.length > 0) {
            resultsBox.classList.remove('d-none');
        } else {
            loadClients('');
        }
    });

    searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function() {
            loadClients(searchInput.value);
        }, 250);
    });

    document.addEventListener('click', function(e) {
        if (!e.target.closest('#gwDossier')) {
            resultsBox.classList.add('d-none');
        }
    });

    function loadClients(query) {
        resultsBox.innerHTML = '<div class="list-group-item text-center text-body-secondary py-3"><div class="spinner-border spinner-border-sm"></div></div>';
        resultsBox.classList.remove('d-none');
        $.get('@Url.Action("SearchClients", "Clients")', { q: query }, function(data) {
            if (!data || data.length === 0) {
                resultsBox.innerHTML = '<div class="list-group-item text-center text-body-secondary">Aucun client trouvé</div>';
                return;
            }
            var currentId = '@(ViewBag.HasClient == true ? Context.Session.GetString("SelectedClientId") : "")';
            var html = '';
            data.forEach(function(c) {
                var initials = (c.raisonSociale || '??').substring(0, 2).toUpperCase();
                var isActive = c.id.toString() === currentId;
                html += '<button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3' + (isActive ? ' active' : '') + '" data-id="' + c.id + '" data-name="' + (c.raisonSociale || '').replace(/"/g, '&quot;') + '">';
                html += '<span class="badge rounded-circle text-bg-primary">' + initials + '</span>';
                html += '<span class="flex-grow-1 text-start"><span class="fw-semibold d-block">' + c.raisonSociale + '</span>';
                html += '<span class="small opacity-75">' + (c.ice || '') + (c.formeJuridique ? ' — ' + c.formeJuridique : '') + '</span></span>';
                if (isActive) html += '<i class="bi bi-check-circle-fill"></i>';
                html += '</button>';
            });
            resultsBox.innerHTML = html;
            resultsBox.querySelectorAll('[data-id]').forEach(function(item) {
                item.addEventListener('click', function() {
                    var id = item.dataset.id;
                    var name = item.dataset.name;
                    if (typeof window.mcSelectClient === 'function') {
                        window.mcSelectClient(id, name);
                    }
                });
            });
        });
    }

    loadClients('');
})();
</script>
}
