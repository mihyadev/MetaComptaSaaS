@{
    ViewData["Title"] = "Erreur";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MetaCompta - Erreur</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="text-center px-3">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 5rem;"></i>
        </div>
        <h1 class="fw-bold mb-3" style="font-size: 2.5rem;">Oops ! Une erreur est survenue</h1>
        <p class="text-muted mb-4" style="font-size: 1.1rem;">
            Nous sommes désolés, quelque chose s'est mal passé.<br />
            Veuillez réessayer ou contacter l'administrateur si le problème persiste.
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="/" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-house me-2"></i> Retour à l'accueil
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary btn-lg px-4">
                <i class="bi bi-arrow-left me-2"></i> Page précédente
            </button>
        </div>
        <div class="mt-5">
            <small class="text-muted">© 2026 MetaCompta - Cabinet Fiduciaire</small>
        </div>
    </div>
</body>

</html>
