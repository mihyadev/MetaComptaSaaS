@using MetaCompta.Application.DTOs
@model DashboardDto
@{
    ViewData["Title"] = "Tableau de Bord";
    var userName = ViewBag.UserName as string ?? "Utilisateur";
    var userRole = ViewBag.UserRole as string ?? "";
    var cabinetName = ViewBag.CabinetName as string ?? "";
    var deadlines = Model.ProchainsDelais ?? new List<DeclarationDto>();
    var notifications = Model.NotificationsRecentes ?? new List<NotificationDto>();
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Bienvenue, @userName</h4>
    <p class="text-muted mb-0">@cabinetName @(string.IsNullOrEmpty(userRole) ? "" : "- " + userRole)</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid var(--mc-primary);">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">Clients Actifs</div><div class="stat-value">@Model.TotalClientsActifs</div></div>
                <div class="stat-icon" style="background:rgba(37,99,235,0.1);color:var(--mc-primary);"><i class="bi bi-building"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid var(--mc-accent);">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">Declarations du Mois</div><div class="stat-value">@Model.DeclarationsMoisEnCours</div></div>
                <div class="stat-icon" style="background:rgba(245,158,11,0.1);color:var(--mc-accent);"><i class="bi bi-file-earmark-text"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid #ef4444;">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">En Attente</div><div class="stat-value">@Model.DeclarationsEnAttente</div></div>
                <div class="stat-icon" style="background:rgba(239,68,68,0.1);color:#ef4444;"><i class="bi bi-exclamation-triangle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid var(--mc-secondary);">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">Soumises</div><div class="stat-value">@Model.DeclarationsSoumises</div></div>
                <div class="stat-icon" style="background:rgba(5,150,105,0.1);color:var(--mc-secondary);"><i class="bi bi-check-circle"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 px-4 pt-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-event text-danger me-2"></i>Prochains Delais</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 mc-table">
                        <thead class="table-light">
                            <tr><th class="ps-4">Client</th><th>Type</th><th>Periode</th><th>Date Limite</th><th>Jours Restants</th></tr>
                        </thead>
                        <tbody>
                            @if (deadlines.Any())
                            {
                                @foreach (var d in deadlines.Take(10))
                                {
                                    var badgeClass = d.DaysUntilDeadline <= 3 ? "bg-danger" : d.DaysUntilDeadline <= 7 ? "bg-warning text-dark" : "bg-info";
                                    <tr>
                                        <td class="ps-4 fw-semibold">@d.ClientName</td>
                                        <td><span class="badge bg-primary-subtle text-primary rounded-pill">@d.Type</span></td>
                                        <td>@d.Periode</td>
                                        <td>@(d.DateLimite.ToString("dd/MM/yyyy"))</td>
                                        <td><span class="badge @badgeClass rounded-pill">@d.DaysUntilDeadline j</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">Aucun delai a venir</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 px-4 pt-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-bell text-warning me-2"></i>Notifications</h6>
            </div>
            <div class="card-body">
                @if (notifications.Any())
                {
                    @foreach (var n in notifications.Take(8))
                    {
                        <div class="d-flex align-items-start mb-3">
                            <i class="bi bi-circle-fill text-primary me-2 mt-1" style="font-size:0.5rem;"></i>
                            <div>
                                <div class="small fw-semibold">@n.Titre</div>
                                <div class="small text-muted">@n.Message</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center mb-0">Aucune notification</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-lightning text-warning me-2"></i>Acces Rapide</h6>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Clients" class="btn btn-outline-primary rounded-pill px-3"><i class="bi bi-building me-1"></i>Clients</a>
            <a href="/Employees" class="btn btn-outline-success rounded-pill px-3"><i class="bi bi-people me-1"></i>Employes</a>
            <a href="/Declarations" class="btn btn-outline-info rounded-pill px-3"><i class="bi bi-file-earmark-text me-1"></i>Declarations</a>
            <a href="/Payroll" class="btn btn-outline-warning rounded-pill px-3"><i class="bi bi-cash me-1"></i>Paie</a>
        </div>
    </div>
</div>