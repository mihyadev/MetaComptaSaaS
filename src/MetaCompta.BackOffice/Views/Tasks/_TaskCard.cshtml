@model MetaCompta.Application.DTOs.TaskItemDto
@{
    var priorityClass = Model.Priorite switch
    {
        "Urgente" => "danger",
        "Haute" => "warning",
        "Moyenne" => "info",
        _ => "secondary"
    };
    var priorityIcon = Model.Priorite switch
    {
        "Urgente" => "bi-fire",
        "Haute" => "bi-arrow-up-circle-fill",
        "Moyenne" => "bi-dash-circle",
        _ => "bi-arrow-down-circle"
    };
    var isOverdue = Model.DateEcheance.HasValue && Model.DateEcheance.Value < DateTime.Now && Model.Statut != "Termine";
    var hasDeclaration = Model.DeclarationId.HasValue;
    var currentUserId = Context.Session.GetString("UserId") ?? "";
    var heldByOther = !string.IsNullOrEmpty(Model.AssigneA)
        && !string.IsNullOrEmpty(currentUserId)
        && !string.Equals(Model.AssigneA, currentUserId, StringComparison.OrdinalIgnoreCase)
        && Model.Statut != "Termine" && Model.Statut != "Annule";
    var heldByMe = !string.IsNullOrEmpty(Model.AssigneA)
        && string.Equals(Model.AssigneA, currentUserId, StringComparison.OrdinalIgnoreCase)
        && Model.Statut != "Termine" && Model.Statut != "Annule";
}

<a href="@Url.Action("Details", "Tasks", new { id = Model.Id })" class="text-decoration-none d-block mb-2 task-card-link">
    <div class="card border-0 shadow-sm task-card @(isOverdue ? "task-card-overdue" : "")" style="border-left: 4px solid var(--bs-@priorityClass) !important;">
        <div class="card-body p-3">
            <!-- Priority + Title -->
            <div class="d-flex align-items-start gap-2 mb-2">
                <i class="bi @priorityIcon text-@priorityClass mt-1" style="font-size: 0.8rem;" title="@Model.Priorite"></i>
                <h6 class="mb-0 text-dark flex-grow-1" style="font-size: 0.85rem; line-height: 1.4;">@Model.Titre</h6>
                @if (heldByMe)
                {
                    <i class="bi bi-lock-fill text-success" title="À votre charge" style="font-size:0.85rem;"></i>
                }
                else if (heldByOther)
                {
                    <i class="bi bi-lock-fill text-warning" title="Prise par @(Model.AssignedToUserName ?? "un autre collaborateur")" style="font-size:0.85rem;"></i>
                }
            </div>

            <!-- Declaration badge -->
            @if (hasDeclaration)
            {
                <div class="mb-2 d-flex flex-wrap gap-1 align-items-center">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 d-inline-flex align-items-center gap-1" style="font-size: 0.7rem;">
                        <i class="bi bi-file-earmark-ruled"></i>
                        @Model.DeclarationType @Model.DeclarationPeriode
                    </span>
                    @if (!string.IsNullOrEmpty(Model.DeclarationStatut))
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.65rem;">@Model.DeclarationStatut</span>
                    }
                </div>
                @if (Model.WorkflowTotalSteps.GetValueOrDefault() > 0)
                {
                    var pct = Model.WorkflowProgressPercent;
                    <div class="mb-2">
                        <div class="d-flex justify-content-between" style="font-size:0.65rem;color:var(--monday-muted);font-weight:600;">
                            <span>Avancement</span>
                            <span>@pct.ToString("0.#")%</span>
                        </div>
                        <div class="progress" style="height:4px;background:#eef0f6;">
                            <div class="progress-bar" style="width:@(pct.ToString(System.Globalization.CultureInfo.InvariantCulture))%;background:linear-gradient(90deg,#0073ea,#6161ff);"></div>
                        </div>
                    </div>
                }
            }

            <!-- Client -->
            @if (!string.IsNullOrEmpty(Model.ClientNom))
            {
                <div class="text-muted mb-2" style="font-size: 0.75rem;"><i class="bi bi-building me-1"></i>@Model.ClientNom</div>
            }

            <!-- Footer: assignee + due date -->
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (!string.IsNullOrEmpty(Model.AssignedToUserName))
                    {
                        <div class="d-inline-flex align-items-center gap-1 bg-light rounded-pill px-2 py-1" style="font-size: 0.7rem;">
                            @if (heldByOther || heldByMe)
                            {
                                <i class="bi bi-lock-fill @(heldByMe ? "text-success" : "text-warning")" style="font-size:0.65rem;"></i>
                            }
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:18px;height:18px;font-size:0.55rem;">
                                @Model.AssignedToUserName?.Substring(0, 1).ToUpper()
                            </div>
                            <span class="text-dark">@Model.AssignedToUserName</span>
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (Model.CommentCount > 0)
                    {
                        <span class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-chat-dots"></i> @Model.CommentCount</span>
                    }
                    @if (Model.DateEcheance.HasValue)
                    {
                        <span class="@(isOverdue ? "text-danger fw-bold" : "text-muted")" style="font-size: 0.7rem;">
                            <i class="bi bi-clock me-1"></i>@Model.DateEcheance.Value.ToString("dd MMM")
                            @if (isOverdue) { <i class="bi bi-exclamation-triangle-fill"></i> }
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</a>
