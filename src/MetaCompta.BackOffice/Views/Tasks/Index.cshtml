@model MetaCompta.Application.DTOs.PagedResult<MetaCompta.Application.DTOs.TaskItemDto>
@{
    ViewData["Title"] = "Tâches";
    var clients = ViewBag.Clients as IEnumerable<MetaCompta.Application.DTOs.ClientDto>;
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-list-task me-2"></i>Tâches</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item active">Tâches</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Create", "Tasks")" class="btn btn-mc-primary">
        <i class="bi bi-plus-circle me-1"></i> Nouvelle tâche
    </a>
</div>

<!-- Quick Links -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a href="@Url.Action("Index", "Tasks")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-list-task"></i></div>
                <div>
                    <div class="fw-semibold text-dark">Toutes les tâches</div>
                    <div class="text-muted small">Vue complète</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("MyTasks", "Tasks")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-person-check"></i></div>
                <div>
                    <div class="fw-semibold text-dark">Mes tâches</div>
                    <div class="text-muted small">Assignées à moi</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("Overdue", "Tasks")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="fw-semibold text-dark">En retard</div>
                    <div class="text-muted small">Tâches échues</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Filters -->
<div class="mc-card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Statut</label>
                <select name="statut" class="form-select">
                    <option value="">Tous</option>
                    <option value="ATraiter" selected="@(ViewBag.Statut?.ToString() == "ATraiter")">À traiter</option>
                    <option value="@RefCodes.StatutTache.EnCours" selected="@(ViewBag.Statut?.ToString() == RefCodes.StatutTache.EnCours)">En cours</option>
                    <option value="Terminee" selected="@(ViewBag.Statut?.ToString() == "Terminee")">Terminée</option>
                    <option value="EnRetard" selected="@(ViewBag.Statut?.ToString() == "EnRetard")">En retard</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Recherche</label>
                <input type="text" name="search" class="form-control" value="@ViewBag.Search"
                    placeholder="Titre de la tâche..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-mc-primary w-100"><i class="bi bi-search me-1"></i>
                    Filtrer</button>
            </div>
        </form>
    </div>
</div>

<!-- Tasks Table -->
<div class="mc-card">
    <div class="card-header"><i class="bi bi-check2-square me-2"></i>Liste des tâches (@(Model?.TotalCount ?? 0))</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mc-table mb-0">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Client</th>
                        <th>Assignée à</th>
                        <th>Priorité</th>
                        <th>Échéance</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        foreach (var task in Model.Items)
                        {
                            <tr>
                                <td class="fw-medium">@task.Titre</td>
                                <td>@task.ClientNom</td>
                                <td>@task.AssigneA</td>
                                <td><span class="badge badge-@task.Priorite?.ToLower()">@task.Priorite</span></td>
                                <td>
                                    @if (task.DateEcheance.HasValue)
                                    {
                                        var isOverdue = task.DateEcheance.Value < DateTime.Now;
                                        <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                            @(task.DateEcheance.Value.ToString("dd/MM/yyyy"))
                                            @if (isOverdue)
                                            {
                                                <i class="bi bi-exclamation-triangle-fill ms-1"></i>
                                            }
                                        </span>
                                    }
                                </td>
                                <td><span class="badge badge-@task.Statut?.ToLower()">@task.Statut</span></td>
                                <td>
                                    <a href="@Url.Action("Details", "Tasks", new { id = task.Id })"
                                        class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-clipboard-check fs-1 d-block mb-2"></i>
                                Aucune tâche trouvée.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
