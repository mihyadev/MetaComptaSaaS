@model MetaCompta.Application.DTOs.PagedResult<MetaCompta.Application.DTOs.TaskItemDto>
@{
    var isMyTasks = ViewBag.IsMyTasks == true;
    ViewData["Title"] = isMyTasks
        ? "Mes tâches"
        : (ViewBag.IsClientSpace == true ? "Tâches client" : "Gestion des Taches");
    var clients = ViewBag.Clients as IEnumerable<MetaCompta.Application.DTOs.ClientDto>;
    var tasks = Model?.Items ?? new List<MetaCompta.Application.DTOs.TaskItemDto>();
    var afaire = tasks.Where(t => t.Statut == "AFaire").ToList();
    var encours = tasks.Where(t => t.Statut == "EnCours").ToList();
    var attente = tasks.Where(t => t.Statut == "EnAttenteRevision").ToList();
    var termine = tasks.Where(t => t.Statut == "Termine").ToList();
    var overdueCount = tasks.Count(t => t.DateEcheance.HasValue && t.DateEcheance.Value < DateTime.Now && t.Statut != "Termine" && t.Statut != "Annule");
    var withDecl = tasks.Count(t => t.DeclarationId.HasValue);
    var clientLabel = ViewBag.SelectedClientName as string;
}

<style>
    .task-card { transition: transform 0.15s, box-shadow 0.15s; border-radius: 10px !important; }
    .task-card:hover { transform: translateY(-2px); box-shadow: var(--monday-shadow-lg) !important; }
    .task-card-overdue { background: color-mix(in srgb, var(--monday-red) 6%, var(--monday-surface)) !important; }
    .task-card-link:hover { text-decoration: none !important; }
    .kanban-col { background: var(--monday-bg); border: 1px solid var(--monday-border); border-radius: 12px; min-height: 400px; }
    .kanban-col-header { padding: 1rem; border-radius: 12px 12px 0 0; }
    .kanban-col-body { padding: 0.75rem; max-height: 65vh; overflow-y: auto; }
    .kanban-col-body::-webkit-scrollbar { width: 4px; }
    .kanban-col-body::-webkit-scrollbar-thumb { background: var(--monday-border); border-radius: 4px; }
    .stat-pill { border-radius: 16px; padding: 1rem 1.25rem; background: var(--monday-surface); border: 1px solid var(--monday-border); transition: transform 0.15s; }
    .stat-pill:hover { transform: translateY(-2px); box-shadow: var(--monday-shadow); }
</style>

<!-- Header -->
<div class="page-header">
    <div>
        <h2 class="mb-1"><i class="bi bi-kanban me-2"></i>@(isMyTasks ? "Mes tâches" : (ViewBag.IsClientSpace == true ? "Tâches client" : "Gestion des Taches"))</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                @if (!string.IsNullOrEmpty(clientLabel))
                {
                    <li class="breadcrumb-item active">@clientLabel</li>
                }
                <li class="breadcrumb-item active">@(isMyTasks ? "Assignées à moi" : (ViewBag.AssignedToKind as string == "Client" ? "Tâches assignées au client" : "Taches"))</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("MyTasks", "Tasks")" class="btn btn-outline-primary btn-sm"><i class="bi bi-person-check me-1"></i>Mes taches</a>
        <a href="@Url.Action("Overdue", "Tasks")" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-exclamation-triangle me-1"></i>En retard
            @if (overdueCount > 0) { <span class="badge bg-danger ms-1">@overdueCount</span> }
        </a>
        @if (ViewBag.CanTaskCreate as bool? ?? false)
        {
            <a href="@Url.Action("Create", "Tasks")" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nouvelle tache</a>
        }
    </div>
</div>

<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col">
        <div class="stat-pill d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:42px;height:42px;background:linear-gradient(135deg,#e8f0fe,#d2e3fc);">
                <i class="bi bi-inbox-fill text-primary"></i>
            </div>
            <div>
                <div class="fs-4 fw-bold text-primary lh-1">@afaire.Count</div>
                <div class="text-muted" style="font-size:0.75rem;">A faire</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-pill d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:42px;height:42px;background:linear-gradient(135deg,#e0f7fa,#b2ebf2);">
                <i class="bi bi-play-circle-fill text-info"></i>
            </div>
            <div>
                <div class="fs-4 fw-bold text-info lh-1">@encours.Count</div>
                <div class="text-muted" style="font-size:0.75rem;">En cours</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-pill d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:42px;height:42px;background:linear-gradient(135deg,#fff8e1,#ffe082);">
                <i class="bi bi-hourglass-split text-warning"></i>
            </div>
            <div>
                <div class="fs-4 fw-bold text-warning lh-1">@attente.Count</div>
                <div class="text-muted" style="font-size:0.75rem;">En attente</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-pill d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:42px;height:42px;background:linear-gradient(135deg,#e8f5e9,#a5d6a7);">
                <i class="bi bi-check-circle-fill text-success"></i>
            </div>
            <div>
                <div class="fs-4 fw-bold text-success lh-1">@termine.Count</div>
                <div class="text-muted" style="font-size:0.75rem;">Terminees</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stat-pill d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:42px;height:42px;background:linear-gradient(135deg,#f3e5f5,#ce93d8);">
                <i class="bi bi-file-earmark-ruled text-purple" style="color:#9c27b0;"></i>
            </div>
            <div>
                <div class="fs-4 fw-bold lh-1" style="color:#9c27b0;">@withDecl</div>
                <div class="text-muted" style="font-size:0.75rem;">Declarations liees</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="mc-card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Statut</label>
                <select name="statut" class="form-select form-select-sm">
                    <option value="">Tous les statuts</option>
                    <option value="AFaire" selected="@(ViewBag.Statut?.ToString() == "AFaire")">A faire</option>
                    <option value="EnCours" selected="@(ViewBag.Statut?.ToString() == "EnCours")">En cours</option>
                    <option value="EnAttenteRevision" selected="@(ViewBag.Statut?.ToString() == "EnAttenteRevision")">En attente</option>
                    <option value="Termine" selected="@(ViewBag.Statut?.ToString() == "Termine")">Termine</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Client</label>
                @if (ViewBag.IsClientSpace == true && ViewBag.ClientId != null)
                {
                    <input type="hidden" name="clientId" value="@ViewBag.ClientId" />
                }
                <select name="@(ViewBag.IsClientSpace == true ? null : "clientId")" class="form-select form-select-sm" @(ViewBag.IsClientSpace == true ? "disabled" : null)>
                    @if (ViewBag.IsClientSpace != true)
                    {
                        <option value="">Tous les clients</option>
                    }
                    @if (clients != null)
                    {
                        foreach (var c in clients)
                        {
                            <option value="@c.Id" selected="@(ViewBag.ClientId?.ToString() == c.Id.ToString())">@c.RaisonSociale</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filtrer</button>
            </div>
            <div class="col-auto">
                <a href="@Url.Action("Index", "Tasks")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg me-1"></i>Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Kanban Board -->
<div class="row g-3">
    <!-- A Faire -->
    <div class="col-lg-3 col-md-6">
        <div class="kanban-col h-100">
            <div class="kanban-col-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, rgba(13,110,253,0.06), transparent);">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width:8px;height:8px;"></div>
                    <strong style="font-size:0.85rem;">A faire</strong>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">@afaire.Count</span>
            </div>
            <div class="kanban-col-body">
                @foreach (var task in afaire)
                {
                    @await Html.PartialAsync("_TaskCard", task)
                }
                @if (!afaire.Any())
                {
                    <div class="text-center text-muted py-5" style="font-size:0.8rem;">
                        <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                        Aucune tache
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- En Cours -->
    <div class="col-lg-3 col-md-6">
        <div class="kanban-col h-100">
            <div class="kanban-col-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, rgba(13,202,240,0.06), transparent);">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-info d-flex align-items-center justify-content-center" style="width:8px;height:8px;"></div>
                    <strong style="font-size:0.85rem;">En cours</strong>
                </div>
                <span class="badge bg-info bg-opacity-10 text-info rounded-pill">@encours.Count</span>
            </div>
            <div class="kanban-col-body">
                @foreach (var task in encours)
                {
                    @await Html.PartialAsync("_TaskCard", task)
                }
                @if (!encours.Any())
                {
                    <div class="text-center text-muted py-5" style="font-size:0.8rem;">
                        <i class="bi bi-play-circle fs-2 d-block mb-2 opacity-50"></i>
                        Aucune tache
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- En Attente -->
    <div class="col-lg-3 col-md-6">
        <div class="kanban-col h-100">
            <div class="kanban-col-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, rgba(255,193,7,0.06), transparent);">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center" style="width:8px;height:8px;"></div>
                    <strong style="font-size:0.85rem;">En attente</strong>
                </div>
                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">@attente.Count</span>
            </div>
            <div class="kanban-col-body">
                @foreach (var task in attente)
                {
                    @await Html.PartialAsync("_TaskCard", task)
                }
                @if (!attente.Any())
                {
                    <div class="text-center text-muted py-5" style="font-size:0.8rem;">
                        <i class="bi bi-hourglass fs-2 d-block mb-2 opacity-50"></i>
                        Aucune tache
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- Termine -->
    <div class="col-lg-3 col-md-6">
        <div class="kanban-col h-100">
            <div class="kanban-col-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, rgba(25,135,84,0.06), transparent);">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width:8px;height:8px;"></div>
                    <strong style="font-size:0.85rem;">Termine</strong>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill">@termine.Count</span>
            </div>
            <div class="kanban-col-body">
                @foreach (var task in termine)
                {
                    @await Html.PartialAsync("_TaskCard", task)
                }
                @if (!termine.Any())
                {
                    <div class="text-center text-muted py-5" style="font-size:0.8rem;">
                        <i class="bi bi-check-circle fs-2 d-block mb-2 opacity-50"></i>
                        Aucune tache
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model != null && Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "Tasks", new { page = i, statut = ViewBag.Statut, clientId = ViewBag.ClientId })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
