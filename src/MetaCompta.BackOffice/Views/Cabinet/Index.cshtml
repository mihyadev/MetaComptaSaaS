@model MetaCompta.Application.DTOs.PagedResult<MetaCompta.Application.DTOs.CabinetEmployeeDto>
@{
    ViewData["Title"] = "Employés du cabinet";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-people me-2"></i>Employés du cabinet</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item">Cabinet</li>
                <li class="breadcrumb-item active">Employés</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="@Url.Action("CreateEmployee", "Cabinet")" class="btn btn-mc-primary">
            <i class="bi bi-plus-lg me-1"></i>Nouvel employé
        </a>
    </div>
</div>

<!-- Quick Navigation -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a href="@Url.Action("Index", "Cabinet")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people text-primary fs-4"></i>
                <span class="fw-semibold text-dark">Employés</span>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("Roles", "Cabinet")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock text-warning fs-4"></i>
                <span class="fw-semibold text-dark">Rôles</span>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("Equipes", "Cabinet")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-success fs-4"></i>
                <span class="fw-semibold text-dark">Équipes</span>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("AuditLogs", "Cabinet")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-danger fs-4"></i>
                <span class="fw-semibold text-dark">Historique</span>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("EditCabinet", "Cabinet")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-building-gear text-info fs-4"></i>
                <span class="fw-semibold text-dark">Info Cabinet</span>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("Profile", "Cabinet")" class="mc-card d-block text-decoration-none p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-secondary fs-4"></i>
                <span class="fw-semibold text-dark">Mon Profil</span>
            </div>
        </a>
    </div>
</div>

<!-- Filters -->
<div class="mc-card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Département</label>
                <select name="departement" class="form-select">
                    <option value="">Tous</option>
                    <option value="Comptabilite" selected="@(ViewBag.Departement?.ToString() == "Comptabilite")">
                        Comptabilité</option>
                    <option value="Fiscal" selected="@(ViewBag.Departement?.ToString() == "Fiscal")">Fiscal</option>
                    <option value="Social" selected="@(ViewBag.Departement?.ToString() == "Social")">Social</option>
                    <option value="Juridique" selected="@(ViewBag.Departement?.ToString() == "Juridique")">Juridique
                    </option>
                    <option value="Direction" selected="@(ViewBag.Departement?.ToString() == "Direction")">Direction
                    </option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Recherche</label>
                <input type="text" name="search" class="form-control" value="@ViewBag.Search"
                    placeholder="Nom, email..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-mc-primary w-100"><i class="bi bi-search me-1"></i>
                    Filtrer</button>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="mc-card">
    <div class="card-header"><i class="bi bi-table me-2"></i>Employés (@(Model?.TotalCount ?? 0))</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mc-table mb-0">
                <thead>
                    <tr>
                        <th>Nom complet</th>
                        <th>Email</th>
                        <th>Département</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Date embauche</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        foreach (var emp in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="stat-icon bg-primary bg-opacity-10 text-primary"
                                            style="width:35px;height:35px;font-size:0.8rem;">
                                            @emp.NomComplet?.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-medium">@emp.NomComplet</span>
                                    </div>
                                </td>
                                <td>@emp.Email</td>
                                <td><span class="badge bg-light text-dark">@emp.Departement</span></td>
                                <td>@emp.Role</td>
                                <td><span class="badge @(emp.EstActif ? "bg-success" : "bg-secondary")">@(emp.EstActif ? "Actif" : "Inactif")</span></td>
                                <td>@(emp.DateEmbauche?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("EmployeeDetails", "Cabinet", new { id = emp.Id })"
                                            class="btn btn-outline-primary" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="@Url.Action("EditEmployee", "Cabinet", new { id = emp.Id })"
                                            class="btn btn-outline-warning" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-action="ToggleEmployee" asp-route-id="@emp.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                class="btn @(emp.EstActif ? "btn-outline-secondary" : "btn-outline-success")"
                                                title="@(emp.EstActif ? "Désactiver" : "Activer")">
                                                <i class="bi @(emp.EstActif ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2"></i>
                                Aucun employé trouvé.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>