@model MetaCompta.Application.DTOs.PagedResult<MetaCompta.Application.DTOs.RoleDto>
@{
    ViewData["Title"] = "Rôles & Permissions";
    var claimsByDomain = ViewBag.ClaimsByDomain as Dictionary<string, List<string>> ?? new Dictionary<string, List<string>>();
    var canRoleManage = ViewBag.CanCabinetRoleManage as bool? ?? false;
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-shield-lock me-2"></i>Rôles & Permissions</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Cabinet")">Cabinet</a></li>
                <li class="breadcrumb-item active">Rôles</li>
            </ol>
        </nav>
    </div>
    <div>
        @if (canRoleManage)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                <i class="bi bi-plus-lg me-1"></i>Nouveau rôle
            </button>
        }
    </div>
</div>

<div class="row g-4">
    @if (Model?.Items != null && Model.Items.Any())
    {
        foreach (var role in Model.Items)
        {
            <div class="col-md-4">
                <div class="mc-card p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-shield-lock"></i></div>
                        <div>
                            <h5 class="mb-0">@role.Nom</h5>
                            <span class="text-muted small">@role.Description</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Nombre d'utilisateurs</span>
                        <span class="fw-bold text-dark">@role.NombreUtilisateurs</span>
                    </div>
                    @if (role.Permissions != null && role.Permissions.Any())
                    {
                        <div class="mt-3">
                            <div class="fw-semibold small mb-2">Permissions :</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var perm in role.Permissions.Take(5))
                                {
                                    <span class="badge bg-light text-dark" style="font-size:0.7rem;">@perm</span>
                                }
                                @if (role.Permissions.Count() > 5)
                                {
                                    <span class="badge bg-secondary" style="font-size:0.7rem;">+@(role.Permissions.Count() - 5) autres</span>
                                }
                            </div>
                        </div>
                    }
                    <div class="mt-3 text-end">
                        @if (canRoleManage)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal" data-bs-target="#editPermsModal_@role.Id.Replace("-","")">
                                <i class="bi bi-pencil me-1"></i>Permissions
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (canRoleManage)
            {
            <!-- Edit Permissions Modal -->
            <div class="modal fade" id="editPermsModal_@role.Id.Replace("-","")" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <form method="post" asp-action="UpdateRolePermissions">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roleId" value="@role.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="bi bi-shield-lock me-2"></i>Permissions — @role.Nom</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                                <div class="row g-3">
                                    @foreach (var domain in claimsByDomain.OrderBy(d => d.Key))
                                    {
                                        <div class="col-md-6">
                                            <h6 class="fw-bold text-capitalize mb-2">
                                                <i class="bi bi-folder2 me-1 text-muted"></i>@domain.Key
                                            </h6>
                                            @foreach (var claim in domain.Value)
                                            {
                                                <div class="form-check ms-3">
                                                    <input type="checkbox" class="form-check-input"
                                                           name="permissions" value="@claim"
                                                           @(role.Permissions?.Contains(claim) == true ? "checked" : "") />
                                                    <label class="form-check-label small">@claim</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>Enregistrer
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            }
        }
    }
    else
    {
        <div class="col-12">
            <div class="mc-card p-4 text-center text-muted">
                <i class="bi bi-shield fs-1 d-block mb-2"></i>
                Aucun rôle configuré.
            </div>
        </div>
    }
</div>

@if (canRoleManage)
{
<!-- Create Role Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-action="CreateRole">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Nouveau rôle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Nom du rôle <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" required placeholder="Ex: Comptable" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            <input type="text" name="description" class="form-control" placeholder="Description du rôle" />
                        </div>
                    </div>
                    <h6 class="fw-bold mb-3"><i class="bi bi-shield-lock me-1"></i>Permissions</h6>
                    <div style="max-height: 40vh; overflow-y: auto;">
                        <div class="row g-3">
                            @foreach (var domain in claimsByDomain.OrderBy(d => d.Key))
                            {
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-capitalize mb-2">
                                        <i class="bi bi-folder2 me-1 text-muted"></i>@domain.Key
                                    </h6>
                                    @foreach (var claim in domain.Value)
                                    {
                                        <div class="form-check ms-3">
                                            <input type="checkbox" class="form-check-input" name="permissions" value="@claim" />
                                            <label class="form-check-label small">@claim</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Créer le rôle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
}
