@model MetaCompta.Application.DTOs.CabinetEditDto
@{
    ViewData["Title"] = "Informations du cabinet";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-building-gear me-2"></i>Informations du cabinet</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Cabinet")">Cabinet</a></li>
                <li class="breadcrumb-item active">Informations</li>
            </ol>
        </nav>
    </div>
</div>

<form method="post" asp-action="EditCabinet">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="mc-card mb-4">
                <div class="card-header"><i class="bi bi-building me-2"></i>Identification</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Name" class="form-label">Nom du cabinet <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ICE" class="form-label">ICE</label>
                            <input asp-for="ICE" class="form-control" placeholder="Identifiant Commun de l'Entreprise" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="IF" class="form-label">Identifiant Fiscal</label>
                            <input asp-for="IF" class="form-control" placeholder="IF" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RC" class="form-label">Registre de Commerce</label>
                            <input asp-for="RC" class="form-control" placeholder="RC" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mc-card mb-4">
                <div class="card-header"><i class="bi bi-geo-alt me-2"></i>Coordonnées</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Address" class="form-label">Adresse</label>
                            <input asp-for="Address" class="form-control" placeholder="Adresse complète" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label">Ville</label>
                            <input asp-for="City" class="form-control" placeholder="Ex: Casablanca" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Téléphone</label>
                            <input asp-for="Phone" class="form-control" placeholder="+212 5XX XXX XXX" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="mc-card mb-4">
                <div class="card-header"><i class="bi bi-image me-2"></i>Logo</div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" alt="Logo" class="img-fluid rounded mb-3" style="max-height:120px;" />
                    }
                    else
                    {
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;">
                            <i class="bi bi-building"></i>
                        </div>
                    }
                    <label asp-for="LogoUrl" class="form-label">URL du logo</label>
                    <input asp-for="LogoUrl" class="form-control" placeholder="https://..." />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-3">
        <a href="@Url.Action("Index", "Cabinet")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
        <button type="submit" class="btn btn-mc-primary">
            <i class="bi bi-check-lg me-1"></i>Enregistrer
        </button>
    </div>
</form>
