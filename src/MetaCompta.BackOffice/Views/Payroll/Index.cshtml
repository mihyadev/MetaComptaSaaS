@using MetaCompta.Application.DTOs
@model List<PayrollPeriodDto>
@{
    ViewData["Title"] = "Paie";
    var client = ViewBag.Client as ClientDto;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-cash-stack text-primary me-2"></i>Gestion de la Paie</h4>
        <p class="text-muted mb-0">@Model.Count periodes de paie</p>
    </div>
    <button type="button" class="btn btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#initModal"><i class="bi bi-plus-circle me-1"></i> Initialiser Periode</button>
</div>

@if (client != null)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 rounded-3">
        <i class="bi bi-building fs-5"></i>
        <div>
            <strong>@client.RaisonSociale</strong>
            @if (!string.IsNullOrEmpty(client.ICE)) { <span class="ms-2 text-muted small">ICE: @client.ICE</span> }
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 mc-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Periode</th>
                        <th class="text-center">Employes</th>
                        <th class="text-end">Brut Global</th>
                        <th class="text-end">Net Global</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            var moisNoms = new[] { "", "Jan", "Fev", "Mar", "Avr", "Mai", "Jun", "Jul", "Aou", "Sep", "Oct", "Nov", "Dec" };
                            var label = (p.Month >= 1 && p.Month <= 12 ? moisNoms[p.Month] : p.Month.ToString()) + " " + p.Year;
                            var statusBadge = p.Status == RefCodes.StatutPaie.Valide ? "bg-success-subtle text-success" : p.Status == RefCodes.StatutPaie.Calcule ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning";
                            <tr>
                                <td class="ps-4 fw-semibold">@label</td>
                                <td class="text-center"><span class="badge bg-primary-subtle text-primary rounded-pill">@p.TotalEmployees</span></td>
                                <td class="text-end">@(p.TotalBrutGlobal.HasValue ? p.TotalBrutGlobal.Value.ToString("N0") : "-") MAD</td>
                                <td class="text-end">@(p.TotalNetPay.HasValue ? p.TotalNetPay.Value.ToString("N0") : "-") MAD</td>
                                <td><span class="badge @statusBadge rounded-pill">@p.Status</span></td>
                                <td class="text-center">
                                    <a asp-action="Period" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-eye me-1"></i>Voir</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-cash-stack display-4 d-block mb-2 opacity-25"></i>
                            <p class="mb-0">Aucune periode de paie pour ce client.</p>
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="initModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Initialiser une Periode</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Initialize" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Annee</label>
                            <input name="annee" type="number" class="form-control" value="@DateTime.Now.Year" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Mois</label>
                            <input name="mois" type="number" class="form-control" min="1" max="12" value="@DateTime.Now.Month" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle me-1"></i>Initialiser</button>
                </div>
            </form>
        </div>
    </div>
</div>