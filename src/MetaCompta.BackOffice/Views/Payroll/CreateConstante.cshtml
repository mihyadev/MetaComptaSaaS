@using MetaCompta.Application.DTOs
@model ConstanteGlobaleDto
@{
    ViewData["Title"] = "Nouvelle Constante";
    var canPayrollEdit = ViewBag.CanPayrollEdit as bool? ?? false;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
            <li class="breadcrumb-item"><a href="/Payroll"><i class="bi bi-cash-stack me-1"></i>Paie</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Constantes","Payroll")">Constantes & Taux</a></li>
            <li class="breadcrumb-item active">Cr&#233;ation</li>
        </ol>
    </nav>
    <h4 class="fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Nouvelle Constante</h4>
    <p class="text-muted mb-0">Ajoutez un param&#232;tre, taux ou plafond au syst&#232;me de paie.</p>
</div>

<form asp-action="CreateConstante" method="post">
    @Html.AntiForgeryToken()

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0 px-4">
            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-info-circle me-1"></i> Informations</h6>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Code" class="form-label fw-semibold">Code <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control rounded-pill font-monospace" placeholder="ex: TAUX_CNSS_SAL" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Libelle" class="form-label fw-semibold">Libell&#233; <span class="text-danger">*</span></label>
                    <input asp-for="Libelle" class="form-control rounded-pill" placeholder="ex: Taux CNSS Salarial" />
                    <span asp-validation-for="Libelle" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Categorie" class="form-label fw-semibold">Cat&#233;gorie</label>
                    <select asp-for="Categorie" class="form-select rounded-pill">
                        <option value="">-- Choisir --</option>
                        <option value="CNSS">CNSS</option>
                        <option value="AMO">AMO</option>
                        <option value="IR">IR</option>
                        <option value="CIMR">CIMR</option>
                        <option value="Plafond">Plafond</option>
                        <option value="General">G&#233;n&#233;ral</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0 px-4">
            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-calculator me-1"></i> Valeur & P&#233;riode</h6>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Valeur" class="form-label fw-semibold">Valeur <span class="text-danger">*</span></label>
                    <input asp-for="Valeur" type="number" step="0.0001" class="form-control rounded-pill font-monospace" placeholder="0.0000" />
                    <span asp-validation-for="Valeur" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DateEffet" class="form-label fw-semibold">Date d'effet</label>
                    <input asp-for="DateEffet" type="date" class="form-control rounded-pill" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DateFin" class="form-label fw-semibold">Date de fin</label>
                    <input asp-for="DateFin" type="date" class="form-control rounded-pill" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold d-block">&#160;</label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="Actif" class="form-check-input" type="checkbox" checked />
                        <label asp-for="Actif" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body px-4 py-3">
            <label asp-for="Description" class="form-label fw-semibold">Description</label>
            <input asp-for="Description" class="form-control rounded-pill" placeholder="Description optionnelle" />
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        @if (canPayrollEdit)
        {
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-check-lg me-1"></i> Cr&#233;er la constante
            </button>
        }
        <a asp-action="Constantes" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Annuler
        </a>
    </div>
</form>