@using MetaCompta.Application.DTOs
@using MetaCompta.Domain.Common
@model PayrollPeriodDto
@{
    var moisNoms = new[] { "", "Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre" };
    var moisLabel = Model != null && Model.Month >= 1 && Model.Month <= 12 ? moisNoms[Model.Month] : "—";
    ViewData["Title"] = Model != null ? $"Paie — {moisLabel} {Model.Year}" : "Période introuvable";
    var paySlips = ViewBag.PaySlips as List<PaySlipDto> ?? new List<PaySlipDto>();
    var isBrouillon = Model?.Status == RefCodes.StatutPaie.Brouillon;
    var isCalcule = Model?.Status == RefCodes.StatutPaie.Calcule || Model?.Status == RefCodes.StatutPaie.EnCours;
    var isValide = Model?.Status == RefCodes.StatutPaie.Validee || Model?.Status == RefCodes.StatutPaie.Valide || Model?.Status == RefCodes.StatutPaie.Cloturee;
    var statusBadge = isValide ? "bg-success" : isCalcule ? "bg-info" : "bg-warning text-dark";
    var statusLabel = isValide ? "Validée" : isCalcule ? "Calculée" : "Brouillon";
    var totalCNSSSalarial = paySlips.Sum(s => s.CotisationCNSS);
    var totalAMOSalarial = paySlips.Sum(s => s.CotisationAMO);
    var totalCIMR = paySlips.Sum(s => s.CotisationCIMR);
    var totalIR = paySlips.Sum(s => s.IR);
    var totalCNSSPatronal = paySlips.Sum(s => s.CNSSPatronal);
    var totalAMOPatronal = paySlips.Sum(s => s.AMOPatronal);
    var totalFP = paySlips.Sum(s => s.FormationProfessionnelle);
    var totalBrut = paySlips.Sum(s => s.SalaireBrut);
    var totalNet = paySlips.Sum(s => s.SalaireNet);
    var totalRetenues = totalCNSSSalarial + totalAMOSalarial + totalCIMR + totalIR;
    var totalChargesPatr = totalCNSSPatronal + totalAMOPatronal + totalFP;
}

@* ══════════════════════════════════════════════════════════════ *@
@* GUARD: Period not found                                        *@
@* ══════════════════════════════════════════════════════════════ *@
@if (Model == null)
{
    <div class="text-center py-5">
        <i class="bi bi-exclamation-triangle display-1 text-warning d-block mb-3"></i>
        <h4 class="fw-bold">Période introuvable</h4>
        <p class="text-muted mb-4">La période de paie demandée n'existe pas ou a été supprimée.</p>
        <a asp-action="Index" class="btn btn-primary rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i>Retour à la liste</a>
    </div>
    return;
}

@* ══════════════════════════════════════════════════════════════ *@
@* HEADER: Breadcrumb + Title + Actions                           *@
@* ══════════════════════════════════════════════════════════════ *@
<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a href="/Payroll"><i class="bi bi-cash-stack me-1"></i>Paie</a></li>
                <li class="breadcrumb-item active">@moisLabel @Model.Year</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i>@Model.ClientName — @moisLabel @Model.Year
        </h4>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge @statusBadge rounded-pill px-3 py-2" style="font-size:0.85rem;">
                <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;vertical-align:middle;"></i>@statusLabel
            </span>
            <span class="text-muted small">@paySlips.Count employé(s)</span>
            @if (Model.DateValidation.HasValue)
            {
                <span class="text-muted small">| Validée le @Model.DateValidation.Value.ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (isBrouillon)
        {
            <form asp-action="Calculate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-primary rounded-pill px-3" onclick="return confirm('Lancer le calcul de paie pour tous les employés ?')">
                    <i class="bi bi-calculator me-1"></i> Calculer la Paie
                </button>
            </form>
        }
        @if (isCalcule)
        {
            <form asp-action="Calculate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-arrow-repeat me-1"></i> Recalculer
                </button>
            </form>
            <form asp-action="Validate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success rounded-pill px-3" onclick="return confirm('Valider définitivement cette paie ? Cette action est irréversible.')">
                    <i class="bi bi-check-circle me-1"></i> Valider la Paie
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════ *@
@* KPI CARDS                                                      *@
@* ══════════════════════════════════════════════════════════════ *@
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid var(--mc-primary);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Employés</div>
                    <div class="stat-value">@paySlips.Count</div>
                </div>
                <div class="stat-icon" style="background:rgba(37,99,235,.1);color:var(--mc-primary);"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid #f59e0b;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Brut Global</div>
                    <div class="stat-value">@totalBrut.ToString("N2") <small class="text-muted fw-normal">MAD</small></div>
                </div>
                <div class="stat-icon" style="background:rgba(245,158,11,.1);color:#f59e0b;"><i class="bi bi-cash"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid #059669;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Net à Payer</div>
                    <div class="stat-value">@totalNet.ToString("N2") <small class="text-muted fw-normal">MAD</small></div>
                </div>
                <div class="stat-icon" style="background:rgba(5,150,105,.1);color:#059669;"><i class="bi bi-wallet2"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid #ef4444;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Charges Patronales</div>
                    <div class="stat-value">@totalChargesPatr.ToString("N2") <small class="text-muted fw-normal">MAD</small></div>
                </div>
                <div class="stat-icon" style="background:rgba(239,68,68,.1);color:#ef4444;"><i class="bi bi-building"></i></div>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════ *@
@* GUARD: No payslips                                             *@
@* ══════════════════════════════════════════════════════════════ *@
@if (!paySlips.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-3 d-block mb-3 text-muted opacity-50"></i>
            <h5 class="fw-bold">Aucun bulletin de paie</h5>
            <p class="text-muted mb-0">Cette période ne contient aucun employé. Vérifiez que des employés actifs existent pour ce client.</p>
        </div>
    </div>
    return;
}

@* ══════════════════════════════════════════════════════════════ *@
@* TABS: Bulletins | Cotisations | Charges Patronales             *@
@* ══════════════════════════════════════════════════════════════ *@
<ul class="nav nav-tabs mb-0" id="periodTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="tab-bulletins" data-bs-toggle="tab" data-bs-target="#pane-bulletins" type="button" role="tab">
            <i class="bi bi-people me-1"></i> Bulletins de Paie <span class="badge bg-primary ms-1">@paySlips.Count</span>
        </button>
    </li>
    @if (isCalcule || isValide)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="tab-cotisations" data-bs-toggle="tab" data-bs-target="#pane-cotisations" type="button" role="tab">
                <i class="bi bi-pie-chart me-1"></i> Cotisations
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="tab-charges" data-bs-toggle="tab" data-bs-target="#pane-charges" type="button" role="tab">
                <i class="bi bi-building me-1"></i> Charges Patronales
            </button>
        </li>
    }
</ul>

<div class="tab-content">
    @* ────────────── TAB 1: Bulletins de Paie ────────────── *@
    <div class="tab-pane fade show active" id="pane-bulletins" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-4 rounded-top-0 border-top">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 mc-datatable" id="payslipsTable" style="width:100%;">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Employé</th>
                                <th>Matricule</th>
                                <th class="text-end">Salaire Base</th>
                                <th class="text-end">Primes</th>
                                <th class="text-end">H. Supp</th>
                                <th class="text-end">Brut</th>
                                <th class="text-end">Retenues</th>
                                <th class="text-end fw-bold">Net à Payer</th>
                                <th class="text-center" data-orderable="false">Détail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slip in paySlips)
                            {
                                var totalRetSlip = slip.CotisationCNSS + slip.CotisationAMO + slip.CotisationCIMR + slip.IR;
                                <tr class="slip-row" data-slip-id="@slip.Id">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width:36px;height:36px;font-size:0.8rem;font-weight:600;">
                                                @(slip.EmployeeName?.Length > 0 ? slip.EmployeeName[0].ToString().ToUpper() : "?")
                                            </div>
                                            <div>
                                                <div class="fw-semibold" style="font-size:0.9rem;">@slip.EmployeeName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code class="text-muted">@(slip.Matricule ?? "—")</code></td>
                                    <td class="text-end">@slip.SalaireBase.ToString("N2")</td>
                                    <td class="text-end">@slip.PrimesFixesTotales.ToString("N2")</td>
                                    <td class="text-end">@slip.MontantHeuresSupp.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@slip.SalaireBrut.ToString("N2")</td>
                                    <td class="text-end text-danger">@totalRetSlip.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">@slip.SalaireNet.ToString("N2")</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill btn-detail"
                                                data-bs-toggle="modal" data-bs-target="#modalDetail"
                                                data-slip="@System.Text.Json.JsonSerializer.Serialize(slip)">
                                            <i class="bi bi-eye me-1"></i>Voir
                                        </button>
                                        @if (isBrouillon || isCalcule)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning rounded-pill ms-1"
                                                    data-bs-toggle="modal" data-bs-target="#modalVars"
                                                    data-emp-id="@slip.EmployeeId"
                                                    data-emp-name="@slip.EmployeeName"
                                                    data-hs25="@slip.HeuresSupp25"
                                                    data-hs50="@slip.HeuresSupp50"
                                                    data-hs100="@slip.HeuresSupp100"
                                                    data-primes="@slip.PrimesExceptionnelles"
                                                    data-avances="@slip.AvancesSalaire"
                                                    data-absences="@slip.AbsencesNonRemunerees">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td class="ps-3" colspan="2">TOTAUX</td>
                                <td class="text-end">@paySlips.Sum(s => s.SalaireBase).ToString("N2")</td>
                                <td class="text-end">@paySlips.Sum(s => s.PrimesFixesTotales).ToString("N2")</td>
                                <td class="text-end">@paySlips.Sum(s => s.MontantHeuresSupp).ToString("N2")</td>
                                <td class="text-end">@totalBrut.ToString("N2")</td>
                                <td class="text-end text-danger">@totalRetenues.ToString("N2")</td>
                                <td class="text-end text-success">@totalNet.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ────────────── TAB 2: Cotisations ────────────── *@
    @if (isCalcule || isValide)
    {
        <div class="tab-pane fade" id="pane-cotisations" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 rounded-top-0 border-top">
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <h6 class="fw-bold text-danger mb-3"><i class="bi bi-person-dash me-2"></i>Retenues Salariales</h6>
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-muted">CNSS Salariale (4.48%)</td><td class="text-end fw-semibold">@totalCNSSSalarial.ToString("N2") MAD</td></tr>
                                    <tr><td class="text-muted">AMO Salariale (2.26%)</td><td class="text-end fw-semibold">@totalAMOSalarial.ToString("N2") MAD</td></tr>
                                    <tr><td class="text-muted">CIMR</td><td class="text-end fw-semibold">@totalCIMR.ToString("N2") MAD</td></tr>
                                    <tr><td class="text-muted">IR (Impôt sur le Revenu)</td><td class="text-end fw-semibold">@totalIR.ToString("N2") MAD</td></tr>
                                </tbody>
                                <tfoot>
                                    <tr class="border-top"><td class="fw-bold">Total Retenues Salariales</td><td class="text-end fw-bold text-danger">@totalRetenues.ToString("N2") MAD</td></tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="col-lg-6">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-building me-2"></i>Charges Patronales</h6>
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-muted">CNSS Patronale (8.98%)</td><td class="text-end fw-semibold">@totalCNSSPatronal.ToString("N2") MAD</td></tr>
                                    <tr><td class="text-muted">AMO Patronale (4.11%)</td><td class="text-end fw-semibold">@totalAMOPatronal.ToString("N2") MAD</td></tr>
                                    <tr><td class="text-muted">Formation Professionnelle (1.6%)</td><td class="text-end fw-semibold">@totalFP.ToString("N2") MAD</td></tr>
                                </tbody>
                                <tfoot>
                                    <tr class="border-top"><td class="fw-bold">Total Charges Patronales</td><td class="text-end fw-bold text-primary">@totalChargesPatr.ToString("N2") MAD</td></tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="mt-4 p-3 bg-light rounded-3 text-center">
                        <span class="text-muted">Coût total employeur :</span>
                        <span class="fs-5 fw-bold text-dark ms-2">@((totalBrut + totalChargesPatr).ToString("N2")) MAD</span>
                    </div>
                </div>
            </div>
        </div>

        @* ────────────── TAB 3: Charges Patronales par Employé ────────────── *@
        <div class="tab-pane fade" id="pane-charges" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 rounded-top-0 border-top">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 mc-datatable" id="chargesTable" style="width:100%;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Employé</th>
                                    <th>Matricule</th>
                                    <th class="text-end">Brut</th>
                                    <th class="text-end">CNSS Pat.</th>
                                    <th class="text-end">AMO Pat.</th>
                                    <th class="text-end">Form. Prof.</th>
                                    <th class="text-end fw-bold">Total Charges</th>
                                    <th class="text-end fw-bold">Coût Employeur</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slip in paySlips)
                                {
                                    var coutTotal = slip.SalaireBrut + slip.TotalChargesPatronales;
                                    <tr>
                                        <td class="ps-3 fw-semibold">@slip.EmployeeName</td>
                                        <td><code class="text-muted">@(slip.Matricule ?? "—")</code></td>
                                        <td class="text-end">@slip.SalaireBrut.ToString("N2")</td>
                                        <td class="text-end">@slip.CNSSPatronal.ToString("N2")</td>
                                        <td class="text-end">@slip.AMOPatronal.ToString("N2")</td>
                                        <td class="text-end">@slip.FormationProfessionnelle.ToString("N2")</td>
                                        <td class="text-end fw-bold text-danger">@slip.TotalChargesPatronales.ToString("N2")</td>
                                        <td class="text-end fw-bold">@coutTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr class="fw-bold">
                                    <td class="ps-3" colspan="2">TOTAUX</td>
                                    <td class="text-end">@totalBrut.ToString("N2")</td>
                                    <td class="text-end">@totalCNSSPatronal.ToString("N2")</td>
                                    <td class="text-end">@totalAMOPatronal.ToString("N2")</td>
                                    <td class="text-end">@totalFP.ToString("N2")</td>
                                    <td class="text-end text-danger">@totalChargesPatr.ToString("N2")</td>
                                    <td class="text-end">@((totalBrut + totalChargesPatr).ToString("N2"))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ══════════════════════════════════════════════════════════════ *@
@* MODAL: Employee Pay Slip Detail                                *@
@* ══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalDetail" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4">
            <div class="modal-header bg-primary bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-text me-2"></i>Bulletin de Paie — <span id="detailEmpName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailBody">
                <!-- Filled by JS -->
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-outline-primary rounded-pill" onclick="printBulletin()"><i class="bi bi-printer me-1"></i>Imprimer</button>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════ *@
@* MODAL: Edit Variables                                          *@
@* ══════════════════════════════════════════════════════════════ *@
@if (isBrouillon || isCalcule)
{
    <div class="modal fade" id="modalVars" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content rounded-4">
                <form asp-action="UpdateVariables" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="periodId" value="@Model.Id" />
                    <input type="hidden" name="dto.EmployeeId" id="varEmpId" />
                    <div class="modal-header border-0 bg-warning bg-opacity-10">
                        <h5 class="modal-title fw-bold"><i class="bi bi-sliders me-2"></i>Variables de Paie — <span id="varEmpName"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info rounded-3 small mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Modifiez les éléments variables du mois. Le calcul (brut, CNSS, AMO, IR, net) sera automatique.
                        </div>
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-clock-history me-1"></i>Heures Supplémentaires</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Heures à 25%</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                    <input type="number" step="0.5" min="0" name="dto.HeuresSupp25" id="varHs25" class="form-control" />
                                    <span class="input-group-text">h</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Heures à 50%</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                    <input type="number" step="0.5" min="0" name="dto.HeuresSupp50" id="varHs50" class="form-control" />
                                    <span class="input-group-text">h</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Heures à 100%</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                    <input type="number" step="0.5" min="0" name="dto.HeuresSupp100" id="varHs100" class="form-control" />
                                    <span class="input-group-text">h</span>
                                </div>
                            </div>
                        </div>
                        <h6 class="fw-bold text-success mb-3"><i class="bi bi-plus-circle me-1"></i>Primes & Indemnités</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Primes Exceptionnelles</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-gift"></i></span>
                                    <input type="number" step="0.01" min="0" name="dto.PrimesExceptionnelles" id="varPrimes" class="form-control" />
                                    <span class="input-group-text">MAD</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Avances sur Salaire</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-arrow-down-circle"></i></span>
                                    <input type="number" step="0.01" min="0" name="dto.AvancesSalaire" id="varAvances" class="form-control" />
                                    <span class="input-group-text">MAD</span>
                                </div>
                            </div>
                        </div>
                        <h6 class="fw-bold text-danger mb-3"><i class="bi bi-dash-circle me-1"></i>Absences</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Jours d'Absence Non Rémunérée</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-calendar-x"></i></span>
                                    <input type="number" step="0.5" min="0" name="dto.AbsencesNonRemunerees" id="varAbsences" class="form-control" />
                                    <span class="input-group-text">jours</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-warning rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
$(function () {
    // ── DataTable custom init (override global to control this table) ──
    if ($.fn.DataTable && !$.fn.DataTable.isDataTable('#payslipsTable')) {
        $('#payslipsTable').DataTable({
            pageLength: 15,
            lengthMenu: [[10, 15, 25, 50, -1], [10, 15, 25, 50, "Tous"]],
            order: [[0, 'asc']],
            language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/fr-FR.json' },
            dom: "<'row align-items-center mb-3'<'col-md-4'l><'col-md-8 text-end'f>>" +
                 "<'row'<'col-12'tr>>" +
                 "<'row mt-3'<'col-md-5'i><'col-md-7 text-end'p>>",
            columnDefs: [{ targets: -1, orderable: false, searchable: false }],
            drawCallback: function () {
                // Show/hide tfoot based on whether all data is visible
                var api = this.api();
                var total = api.rows().count();
                var filtered = api.rows({ search: 'applied' }).count();
                $(this).find('tfoot').toggle(filtered === total);
            }
        });
    }

    // ── Variables modal: fill inputs ──
    var modalVars = document.getElementById('modalVars');
    if (modalVars) {
        modalVars.addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            $('#varEmpId').val(btn.dataset.empId);
            $('#varEmpName').text(btn.dataset.empName);
            $('#varHs25').val(parseFloat(btn.dataset.hs25) || 0);
            $('#varHs50').val(parseFloat(btn.dataset.hs50) || 0);
            $('#varHs100').val(parseFloat(btn.dataset.hs100) || 0);
            $('#varPrimes').val(parseFloat(btn.dataset.primes) || 0);
            $('#varAvances').val(parseFloat(btn.dataset.avances) || 0);
            $('#varAbsences').val(parseFloat(btn.dataset.absences) || 0);
        });
    }

    // ── Detail modal: build bulletin ──
    var modalDetail = document.getElementById('modalDetail');
    if (modalDetail) {
        modalDetail.addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            try {
                var s = JSON.parse(btn.dataset.slip);
                $('#detailEmpName').text(s.EmployeeName || s.employeeName || '—');
                var totalRet = (s.CotisationCNSS||s.cotisationCNSS||0) + (s.CotisationAMO||s.cotisationAMO||0) + (s.CotisationCIMR||s.cotisationCIMR||0) + (s.IR||s.ir||0);
                var totalChP = (s.CNSSPatronal||s.cnssPatronal||0) + (s.AMOPatronal||s.amoPatronal||0) + (s.FormationProfessionnelle||s.formationProfessionnelle||0);
                var f = function(v) { return (v||0).toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}); };

                var html = '<div id="bulletinPrint">';

                // ── Gains ──
                html += '<h6 class="fw-bold text-success border-bottom pb-2 mb-3"><i class="bi bi-plus-circle me-2"></i>Gains</h6>';
                html += '<table class="table table-sm table-borderless mb-4"><tbody>';
                html += '<tr><td class="text-muted">Salaire de Base</td><td class="text-end fw-semibold">' + f(s.SalaireBase||s.salaireBase) + ' MAD</td></tr>';
                html += '<tr><td class="text-muted">Primes Fixes Totales</td><td class="text-end fw-semibold">' + f(s.PrimesFixesTotales||s.primesFixesTotales) + ' MAD</td></tr>';
                if ((s.HeuresSupp25||s.heuresSupp25||0) > 0 || (s.HeuresSupp50||s.heuresSupp50||0) > 0 || (s.HeuresSupp100||s.heuresSupp100||0) > 0) {
                    html += '<tr><td class="text-muted ps-3">› Heures Supp 25% : ' + f(s.HeuresSupp25||s.heuresSupp25) + ' h</td><td></td></tr>';
                    html += '<tr><td class="text-muted ps-3">› Heures Supp 50% : ' + f(s.HeuresSupp50||s.heuresSupp50) + ' h</td><td></td></tr>';
                    html += '<tr><td class="text-muted ps-3">› Heures Supp 100% : ' + f(s.HeuresSupp100||s.heuresSupp100) + ' h</td><td></td></tr>';
                    html += '<tr><td class="text-muted">Montant Heures Supp</td><td class="text-end fw-semibold">' + f(s.MontantHeuresSupp||s.montantHeuresSupp) + ' MAD</td></tr>';
                }
                if ((s.PrimesExceptionnelles||s.primesExceptionnelles||0) > 0) {
                    html += '<tr><td class="text-muted">Primes Exceptionnelles</td><td class="text-end fw-semibold">' + f(s.PrimesExceptionnelles||s.primesExceptionnelles) + ' MAD</td></tr>';
                }
                html += '</tbody>';
                html += '<tfoot><tr class="border-top"><td class="fw-bold">Salaire Brut Global</td><td class="text-end fw-bold text-success">' + f(s.SalaireBrut||s.salaireBrut) + ' MAD</td></tr></tfoot>';
                html += '</table>';

                // ── Retenues Salariales ──
                html += '<h6 class="fw-bold text-danger border-bottom pb-2 mb-3"><i class="bi bi-dash-circle me-2"></i>Retenues Salariales</h6>';
                html += '<table class="table table-sm table-borderless mb-4"><tbody>';
                html += '<tr><td class="text-muted">CNSS Salariale (4.48%)</td><td class="text-end fw-semibold">' + f(s.CotisationCNSS||s.cotisationCNSS) + ' MAD</td></tr>';
                html += '<tr><td class="text-muted">AMO Salariale (2.26%)</td><td class="text-end fw-semibold">' + f(s.CotisationAMO||s.cotisationAMO) + ' MAD</td></tr>';
                if ((s.CotisationCIMR||s.cotisationCIMR||0) > 0)
                    html += '<tr><td class="text-muted">CIMR</td><td class="text-end fw-semibold">' + f(s.CotisationCIMR||s.cotisationCIMR) + ' MAD</td></tr>';
                html += '<tr><td class="text-muted">IR (Impôt sur le Revenu)</td><td class="text-end fw-semibold">' + f(s.IR||s.ir) + ' MAD</td></tr>';
                if ((s.AvancesSalaire||s.avancesSalaire||0) > 0)
                    html += '<tr><td class="text-muted">Avances sur Salaire</td><td class="text-end fw-semibold">' + f(s.AvancesSalaire||s.avancesSalaire) + ' MAD</td></tr>';
                if ((s.AbsencesNonRemunerees||s.absencesNonRemunerees||0) > 0)
                    html += '<tr><td class="text-muted">Absences Non Rémunérées (' + f(s.AbsencesNonRemunerees||s.absencesNonRemunerees) + ' j)</td><td class="text-end fw-semibold">—</td></tr>';
                html += '</tbody>';
                html += '<tfoot><tr class="border-top"><td class="fw-bold">Total Retenues</td><td class="text-end fw-bold text-danger">' + f(totalRet) + ' MAD</td></tr></tfoot>';
                html += '</table>';

                // ── Net ──
                html += '<div class="p-3 bg-success bg-opacity-10 rounded-3 text-center mb-4">';
                html += '<span class="text-muted">Net à Payer</span><br/>';
                html += '<span class="fs-3 fw-bold text-success">' + f(s.SalaireNet||s.salaireNet) + ' MAD</span>';
                html += '</div>';

                // ── Charges Patronales ──
                html += '<h6 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-building me-2"></i>Charges Patronales</h6>';
                html += '<table class="table table-sm table-borderless mb-0"><tbody>';
                html += '<tr><td class="text-muted">CNSS Patronale (8.98%)</td><td class="text-end fw-semibold">' + f(s.CNSSPatronal||s.cnssPatronal) + ' MAD</td></tr>';
                html += '<tr><td class="text-muted">AMO Patronale (4.11%)</td><td class="text-end fw-semibold">' + f(s.AMOPatronal||s.amoPatronal) + ' MAD</td></tr>';
                html += '<tr><td class="text-muted">Formation Professionnelle (1.6%)</td><td class="text-end fw-semibold">' + f(s.FormationProfessionnelle||s.formationProfessionnelle) + ' MAD</td></tr>';
                html += '</tbody>';
                html += '<tfoot><tr class="border-top"><td class="fw-bold">Total Charges Patronales</td><td class="text-end fw-bold text-primary">' + f(totalChP) + ' MAD</td></tr></tfoot>';
                html += '</table>';

                html += '</div>';
                $('#detailBody').html(html);
            } catch (ex) {
                $('#detailBody').html('<div class="alert alert-danger">Erreur lors du chargement du bulletin.</div>');
            }
        });
    }
});

// ── Print bulletin ──
function printBulletin() {
    var content = document.getElementById('bulletinPrint');
    if (!content) return;
    var empName = document.getElementById('detailEmpName').textContent;
    var w = window.open('', '_blank', 'width=800,height=900');
    w.document.write('<!DOCTYPE html><html><head><title>Bulletin de Paie — ' + empName + '</title>');
    w.document.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">');
    w.document.write('<style>body{padding:30px;font-size:14px;} table{margin-bottom:1rem;} .fw-bold{font-weight:700!important;} .text-end{text-align:right!important;} .text-muted{color:#6c757d!important;} .fw-semibold{font-weight:600!important;} .border-top{border-top:1px solid #dee2e6!important;} @@media print{body{padding:15px;}}</style>');
    w.document.write('</head><body>');
    w.document.write('<h4 class="mb-1">Bulletin de Paie</h4>');
    w.document.write('<p class="text-muted mb-4">' + empName + ' — @(moisLabel) @(Model.Year)</p>');
    w.document.write(content.innerHTML);
    w.document.write('<hr class="my-4"/><p class="text-muted small text-center">Document généré le ' + new Date().toLocaleDateString('fr-FR') + '</p>');
    w.document.write('</body></html>');
    w.document.close();
    setTimeout(function(){ w.print(); }, 500);
}
</script>
}