@using MetaCompta.Application.DTOs
@model DepartmentCreateDto
@{
    ViewData["Title"] = "Modifier le Département";
    var departmentId = (int)ViewBag.DepartmentId;
    var employees = ViewBag.Employees as List<CabinetEmployeeDto> ?? new List<CabinetEmployeeDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a asp-action="Index">Départements</a></li>
                <li class="breadcrumb-item active">Modifier</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0"><i class="bi bi-pencil text-primary me-2"></i>Modifier le Département</h4>
    </div>
    <a asp-action="Details" asp-route-id="@departmentId" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Retour</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mc-card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@departmentId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nom du département *</label>
                            <input asp-for="Name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Code *</label>
                            <input asp-for="Code" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Responsable</label>
                            <select asp-for="HeadOfDepartmentUserId" class="form-select">
                                <option value="">— Aucun —</option>
                                @foreach (var e in employees)
                                {
                                    <option value="@e.Id">@e.FirstName @e.LastName (@e.Email)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Details" asp-route-id="@departmentId" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                        @if (ViewBag.CanDepartmentEdit as bool? ?? false)
                        {
                            <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-circle me-2"></i>Mettre à jour</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

