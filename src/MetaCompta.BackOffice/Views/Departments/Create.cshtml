@using MetaCompta.Application.DTOs
@model DepartmentCreateDto
@{
    ViewData["Title"] = "Nouveau Département";
    var employees = ViewBag.Employees as List<CabinetEmployeeDto> ?? new List<CabinetEmployeeDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-plus-circle text-primary me-2"></i>Nouveau Département</h4>
        <p class="text-muted mb-0">Créer un nouveau département dans le cabinet</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Retour</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mc-card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nom du département *</label>
                            <input asp-for="Name" class="form-control" placeholder="Ex: Comptabilité" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Code *</label>
                            <input asp-for="Code" class="form-control" placeholder="Ex: COMPTA" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Description du département..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Responsable</label>
                            <select asp-for="HeadOfDepartmentUserId" class="form-select">
                                <option value="">— Aucun —</option>
                                @foreach (var e in employees)
                                {
                                    <option value="@e.Id">@e.FirstName @e.LastName (@e.Email)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                        <button type="submit" class="btn btn-mc-primary rounded-pill px-4"><i class="bi bi-check-circle me-2"></i>Créer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
