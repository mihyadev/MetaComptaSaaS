@using MetaCompta.Application.DTOs
@using MetaCompta.Domain.Common
@model ClientDto
@{
    ViewData["Title"] = "Details Client - " + Model.RaisonSociale;
    var services = Model.ServicesFiduciaires ?? new List<ServiceContratDto>();
    var refFormes = ViewData["Ref_FORME_JURIDIQUE"] as List<ReferenceDataDto> ?? new();
    var refStatuts = ViewData["Ref_STATUT_CLIENT"] as List<ReferenceDataDto> ?? new();
    var refTva = ViewData["Ref_TYPE_TVA"] as List<ReferenceDataDto> ?? new();
    var contratsValides = ViewBag.ContratsValides as List<ContratCommercialDto> ?? new();
    var allContrats = ViewBag.AllContrats as List<ContratCommercialDto> ?? new();
    var clientUsers = ViewBag.ClientUsers as List<ClientUserDto> ?? new();
    var wfTemplates = ViewBag.WorkflowTemplates as List<WorkflowTemplateDto> ?? new();
    var wfInstances = ViewBag.WorkflowInstances as List<WorkflowInstanceDto> ?? new();
    var wfPendingSteps = ViewBag.WorkflowPendingSteps as List<WorkflowStepInstanceDto> ?? new();
    var wfConfigs = ViewBag.WorkflowConfigs as List<ClientWorkflowConfigDto> ?? new();
    var activeTemplates = wfTemplates.Where(t => t.IsActive).OrderBy(t => t.DeclarationType).ThenBy(t => t.Name).ToList();
    var cabinetTemplates = activeTemplates
        .Where(t => t.ClientId == null && !t.Name.Contains("(ancien)", StringComparison.OrdinalIgnoreCase))
        .OrderBy(t => t.DeclarationType).ThenBy(t => t.Name)
        .ToList();
    var canWfConfigure = ViewBag.CanWorkflowConfigure as bool? ?? false;
    var cabinetEmployees = ViewBag.CabinetEmployees as List<CabinetEmployeeDto> ?? new();
    var departments = ViewBag.Departments as List<DepartmentDto> ?? new();
    var wfInProgress = wfInstances.Count(i => string.Equals(i.Status, "InProgress", StringComparison.OrdinalIgnoreCase)
        || string.Equals(i.Status, "Active", StringComparison.OrdinalIgnoreCase));
    var wfCompleted = wfInstances.Count(i => string.Equals(i.Status, "Completed", StringComparison.OrdinalIgnoreCase));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a href="/Clients">Clients</a></li>
                <li class="breadcrumb-item active">@Model.RaisonSociale</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0"><i class="bi bi-building text-primary me-2"></i>@Model.RaisonSociale</h4>
    </div>
    <div class="btn-group">
        @if (ViewBag.CanClientEdit as bool? ?? false)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-3"><i
                    class="bi bi-pencil me-1"></i> Modifier</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i>
            Retour</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid var(--primary);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Employes</div>
                    <div class="stat-value">@Model.EmployeeCount</div>
                </div>
                <div class="stat-icon" style="background:rgba(14,165,233,0.1);color:var(--primary);"><i
                        class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid var(--secondary);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Declarations</div>
                    <div class="stat-value">@Model.DeclarationCount</div>
                </div>
                <div class="stat-icon" style="background:rgba(16,185,129,0.1);color:var(--secondary);"><i
                        class="bi bi-file-earmark-text"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid var(--warning);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Services Actifs</div>
                    <div class="stat-value">@(services.Count(s => s.Actif))</div>
                </div>
                <div class="stat-icon" style="background:rgba(245,158,11,0.1);color:var(--warning);"><i
                        class="bi bi-briefcase"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="border-left:4px solid #8b5cf6;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Statut</div>
                    <div class="stat-value" style="font-size:1rem;">@Model.Statut</div>
                </div>
                <div class="stat-icon" style="background:rgba(139,92,246,0.1);color:#8b5cf6;"><i
                        class="bi bi-check-circle"></i></div>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-pills mb-3" id="clientTabs" role="tablist">
    <li class="nav-item"><a class="nav-link active rounded-pill" data-bs-toggle="pill" href="#tabIdentite">Identite</a>
    </li>
    <li class="nav-item"><a class="nav-link rounded-pill" data-bs-toggle="pill" href="#tabContact">Contact</a></li>
    <li class="nav-item"><a class="nav-link rounded-pill" data-bs-toggle="pill" href="#tabFiscal">Fiscal</a></li>
    <li class="nav-item">
        <a class="nav-link rounded-pill" data-bs-toggle="pill" href="#tabServices">
            Services
            <span class="badge bg-info bg-opacity-10 text-info ms-1 rounded-pill" style="font-size:0.68rem;">
                <i class="bi bi-shield-check"></i> Contrat
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill" data-bs-toggle="pill" href="#tabWorkflow">
            <i class="bi bi-lightning-charge-fill me-1" style="color:#7c3aed;"></i>Workflow
            @if (wfInstances.Any(i => i.Status == "InProgress"))
            {
                <span class="badge bg-success bg-opacity-10 text-success ms-1 rounded-pill"
                    style="font-size:0.62rem;">@wfInstances.Count(i => i.Status == "InProgress") en cours</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill" data-bs-toggle="pill" href="#tabUsers">
            <i class="bi bi-people-fill me-1" style="color:#0891b2;"></i>Utilisateurs Extranet
            <span class="badge bg-info bg-opacity-10 text-info ms-1 rounded-pill" style="font-size:0.62rem;">@clientUsers.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill" data-bs-toggle="pill" href="#tabContrats">
            <i class="bi bi-file-earmark-text-fill me-1" style="color:#d97706;"></i>Contrats
            <span class="badge bg-warning bg-opacity-10 text-warning ms-1 rounded-pill" style="font-size:0.62rem;">@allContrats.Count</span>
        </a>
    </li>
</ul>

<div class="tab-content">
    <!-- ??????????? IDENTITE ??????????? -->
    <div class="tab-pane fade show active" id="tabIdentite">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label text-muted small">Raison Sociale</label>
                        <div class="fw-semibold">@Model.RaisonSociale</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Forme Juridique</label>
                        <div>@(Model.FormeJuridique ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Capital Social</label>
                        <div>@(Model.CapitalSocial.HasValue? Model.CapitalSocial.Value.ToString("N0") + " MAD" : "-")
                        </div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">ICE</label>
                        <div>@(Model.ICE ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">IF</label>
                        <div>@(Model.IF ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">RC</label>
                        <div>@(Model.RC ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">CNSS</label>
                        <div>@(Model.NumeroCNSS ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Patente</label>
                        <div>@(Model.NumeroPatente ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Secteur</label>
                        <div>@(Model.SecteurActivite ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Date Creation</label>
                        <div>@(Model.DateCreation.HasValue? Model.DateCreation.Value.ToString("dd/MM/yyyy") : "-")
                        </div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Debut Activite</label>
                        <div>@(Model.DateDebutActivite.HasValue ? Model.DateDebutActivite.Value.ToString("dd/MM/yyyy") :
                                                        "-")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ??????????? CONTACT ??????????? -->
    <div class="tab-pane fade" id="tabContact">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label text-muted small">Adresse Siege</label>
                        <div>@(Model.AdresseSiegeSocial ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Ville</label>
                        <div>@(Model.VilleSiegeSocial ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Telephone</label>
                        <div>@(Model.TelephonePrincipal ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Email</label>
                        <div>@(Model.EmailPrincipal ?? "-")</div>
                    </div>
                    <div class="col-12">
                        <hr />
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Contact Nom</label>
                        <div>@(Model.ContactNom ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Fonction</label>
                        <div>@(Model.ContactFonction ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Tel Contact</label>
                        <div>@(Model.ContactTelephone ?? "-")</div>
                    </div>
                    <div class="col-md-3"><label class="form-label text-muted small">Email Contact</label>
                        <div>@(Model.ContactEmail ?? "-")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ??????????? FISCAL ??????????? -->
    <div class="tab-pane fade" id="tabFiscal">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label text-muted small">Type TVA</label>
                        <div>@Model.TypeTVA</div>
                    </div>
                    <div class="col-md-4"><label class="form-label text-muted small">Mois Cloture Exercice</label>
                        <div>@Model.MoisClotureExercice</div>
                    </div>
                    <div class="col-md-4"><label class="form-label text-muted small">Date Debut Contrat</label>
                        <div>@(Model.DateDebutContrat.HasValue ? Model.DateDebutContrat.Value.ToString("dd/MM/yyyy") :
                                                        "-")</div>
                    </div>
                    <div class="col-md-4"><label class="form-label text-muted small">Manager Principal</label>
                        <div>@(Model.ManagerPrincipalName ?? "-")</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.NotesInternes))
                {
                    <hr />
                    <label class="form-label text-muted small">Notes Internes</label>
                    <div class="p-3 bg-light rounded-3">@Model.NotesInternes</div>
                }
            </div>
        </div>
    </div>

    <!-- ??????????? SERVICES ??????????? -->
    <div class="tab-pane fade" id="tabServices">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="alert alert-info border-0 rounded-3 py-2 px-3 mb-3"
                    style="font-size:0.85rem; background: linear-gradient(135deg, rgba(37,99,235,0.05), rgba(124,58,237,0.05));">
                    <i class="bi bi-shield-check me-1"></i>
                    Les services fiduciaires sont <strong>activ&#233;s automatiquement</strong> lors de la validation
                    d'un
                    <a href="/Commercial" class="fw-semibold text-decoration-none">Contrat Commercial</a>.
                </div>
                @if (!services.Any() && contratsValides.Any())
                {
                    <div class="alert alert-warning border-0 rounded-3 py-2 px-3 mb-3 d-flex align-items-center justify-content-between"
                        style="font-size:0.85rem;">
                        <span>
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Ce client poss&#232;de @contratsValides.Count contrat(s) valid&#233;(s) mais <strong>aucun
                                service actif</strong>.
                        </span>
                        <div class="d-flex gap-1">
                            @if (ViewBag.CanCommercialEdit as bool? ?? false)
                            {
                                @foreach (var contrat in contratsValides)
                                {
                                    <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 btn-sync-services"
                                        data-contrat-id="@contrat.Id" data-contrat-ref="@contrat.Reference">
                                        <i class="bi bi-arrow-repeat me-1"></i> Sync @contrat.Reference
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 mc-table">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Service</th>
                                <th>Cat&#233;gorie</th>
                                <th>Frequence</th>
                                <th>Debut</th>
                                <th>Fin</th>
                                <th class="text-end">Tarif</th>
                                <th>Actif</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (services.Any())
                            {
                                @foreach (var svc in services)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold">@(svc.LibelleService ?? svc.TypeService)</td>
                                        <td><span class="badge bg-light text-dark rounded-pill">@(svc.Categorie ?? "-")</span>
                                        </td>
                                        <td>@svc.Frequence</td>
                                        <td>@svc.DateDebut.ToString("dd/MM/yyyy")</td>
                                        <td>@(svc.DateFin.HasValue? svc.DateFin.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td class="text-end">@(svc.HonorairesMensuels.HasValue ?
                                                                            svc.HonorairesMensuels.Value.ToString("N0") + " MAD/mois" :
                                                                        (svc.HonorairesAnnuels.HasValue ? svc.HonorairesAnnuels.Value.ToString("N0") + "                                    MAD/an" : "-"))</td>
                                        <td>
                                            @if (svc.Actif)
                                            {
                                                <span class="badge bg-success-subtle text-success">Actif</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-secondary">Inactif</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <div class="text-muted"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Aucun service
                                            actif.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════ WORKFLOW ═══════════ -->
    <div class="tab-pane fade" id="tabWorkflow">

        <!-- Summary cards -->
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body text-center py-3">
                        <div style="font-size:1.6rem; font-weight:800; color:#4f46e5;">@wfInstances.Count</div>
                        <div class="text-muted" style="font-size:0.78rem;">Workflows total</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body text-center py-3">
                        <div style="font-size:1.6rem; font-weight:800; color:#059669;">@wfInProgress</div>
                        <div class="text-muted" style="font-size:0.78rem;">En cours</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body text-center py-3">
                        <div style="font-size:1.6rem; font-weight:800; color:#2563eb;">@wfCompleted</div>
                        <div class="text-muted" style="font-size:0.78rem;">Terminés</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Styles Personnaliser (Builder) -->
        <style>
            #wfCustomizePanel .builder-card { border: 0; border-radius: 16px; box-shadow: var(--monday-shadow); }
            #wfCustomizePanel .step-card { background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 16px; margin-bottom: 1rem; position: relative; overflow: hidden; }
            #wfCustomizePanel .step-card.collapsed-step .step-body { display: none; }
            #wfCustomizePanel .step-card.collapsed-step .step-header { border-bottom: 0; }
            #wfCustomizePanel .step-card.collapsed-step .chevron-icon { transform: rotate(-90deg); }
            #wfCustomizePanel .step-num { width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.82rem; color: #fff; background: var(--monday-blue); flex-shrink: 0; }
            #wfCustomizePanel .step-header { display: flex; align-items: center; gap: 0.7rem; cursor: pointer; padding: 0.9rem 1.1rem; background: var(--monday-bg); border-bottom: 1px solid var(--monday-border); }
            #wfCustomizePanel .step-header h6 { margin: 0; font-size: 0.9rem; font-weight: 700; color: var(--monday-text); }
            #wfCustomizePanel .step-type-badge { font-size: 0.68rem; padding: 3px 10px; border-radius: 20px; font-weight: 700; background: color-mix(in srgb, var(--monday-blue) 12%, var(--monday-surface)); color: var(--monday-blue); border: 1px solid var(--monday-border); }
            #wfCustomizePanel .assign-badge { font-size: 0.68rem; padding: 3px 10px; border-radius: 20px; background: color-mix(in srgb, var(--monday-green) 12%, var(--monday-surface)); color: var(--monday-green); font-weight: 600; border: 1px solid var(--monday-border); }
            #wfCustomizePanel .sla-badge { font-size: 0.68rem; padding: 3px 10px; border-radius: 20px; background: color-mix(in srgb, var(--monday-orange) 12%, var(--monday-surface)); color: var(--monday-orange); font-weight: 600; border: 1px solid var(--monday-border); }
            #wfCustomizePanel .chevron-icon { transition: transform .25s ease; font-size: 0.9rem; color: var(--monday-muted); }
            #wfCustomizePanel .step-body { padding: 1.1rem; background: var(--monday-surface); }
            #wfCustomizePanel .field-section { background: var(--monday-bg); border: 1px solid var(--monday-border); border-radius: 12px; padding: 0.75rem 1rem; margin-bottom: 0.65rem; }
            #wfCustomizePanel .field-section-title { font-size: 0.72rem; font-weight: 800; color: var(--monday-blue); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.55rem; display: flex; align-items: center; gap: 0.4rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--monday-border); }
            #wfCustomizePanel .form-label-sm { font-size: 0.74rem; font-weight: 600; color: var(--monday-muted); margin-bottom: 0.2rem; display: block; }
            #wfCustomizePanel .tpl-mini { display: flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.8rem; border: 1px solid var(--monday-border); border-radius: 12px; margin-bottom: 0.45rem; cursor: pointer; font-size: 0.8rem; text-decoration: none; background: var(--monday-surface); color: inherit; width: 100%; text-align: left; }
            #wfCustomizePanel .tpl-mini.active { background: color-mix(in srgb, var(--monday-blue) 8%, var(--monday-surface)); border-color: var(--monday-blue); }
            #wfCustomizePanel .tpl-mini .tpl-type { font-size: 0.65rem; padding: 2px 7px; border-radius: 10px; font-weight: 700; flex-shrink: 0; }
            #wfCustomizePanel .chk-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.45rem; }
            #wfCustomizePanel .chk-item { display: flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.65rem; background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 10px; font-size: 0.74rem; font-weight: 600; color: var(--monday-text); cursor: pointer; }
            #wfCustomizePanel .chk-item input:checked ~ span { color: var(--monday-blue); font-weight: 700; }
            #wfCustomizePanel .chk-item .form-check-input { width: 1rem; height: 1rem; margin: 0; }
            #wfCustomizePanel .section-title { font-size: 0.8rem; font-weight: 800; color: var(--monday-text); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.6rem; }
            #wfCustomizePanel .section-title i { font-size: 0.9rem; color: var(--monday-blue); }
            #wfCustomizePanel .btn-add-step { border: 2px dashed var(--monday-border); border-radius: 14px; padding: 1rem; text-align: center; color: var(--monday-blue); font-weight: 700; font-size: 0.85rem; background: transparent; cursor: pointer; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
            #wfCustomizePanel .btn-delete-step { width: 26px; height: 26px; border-radius: 8px; border: 1px solid var(--monday-border); background: var(--monday-surface); color: var(--monday-red); display: flex; align-items: center; justify-content: center; font-size: 0.72rem; cursor: pointer; }
            #wfCustomizePanel .client-copy-banner { background: color-mix(in srgb, var(--monday-green) 10%, var(--monday-surface)); border: 1px solid var(--monday-border); border-radius: 12px; padding: 0.65rem 0.9rem; font-size: 0.78rem; font-weight: 600; color: var(--monday-text); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
            #wfCustomizePanel .cron-freq-btn, #wfCustomizePanel .cron-day-btn, #wfCustomizePanel .cron-month-btn { border: 1px solid var(--monday-border); border-radius: 10px; cursor: pointer; font-size: 0.76rem; font-weight: 600; color: var(--monday-text); background: var(--monday-surface); padding: 0.35rem 0.65rem; }
            #wfCustomizePanel .cron-freq-btn.active, #wfCustomizePanel .cron-day-btn.active, #wfCustomizePanel .cron-month-btn.active { background: var(--monday-blue); color: #fff; border-color: var(--monday-blue); }
            #wfCustomizePanel .cron-preview { background: color-mix(in srgb, var(--monday-green) 10%, var(--monday-surface)); border: 1px solid var(--monday-border); border-radius: 10px; padding: 0.5rem 0.85rem; margin-top: 0.6rem; display: flex; align-items: center; gap: 0.5rem; }
            #wfCustomizePanel .cron-preview-end { background: color-mix(in srgb, #e67e22 12%, var(--monday-surface)); border: 1px solid var(--monday-border); border-radius: 10px; padding: 0.5rem 0.85rem; margin-top: 0.45rem; display: flex; align-items: center; gap: 0.5rem; }
            #wfCustomizePanel .cron-preview-icon { width: 28px; height: 28px; border-radius: 8px; background: var(--monday-green); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
            #wfCustomizePanel .cron-preview-end .cron-preview-icon { background: #e67e22; }
            #wfCustomizePanel .cron-preview-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--monday-muted); margin-bottom: 0.1rem; }
            #wfCustomizePanel .cron-preview-text { font-size: 0.78rem; font-weight: 600; color: var(--monday-text); }
            #wfCustomizePanel .cron-preview-cron { font-size: 0.68rem; color: var(--monday-muted); font-family: monospace; }
            #wfCustomizePanel .life-panel { background: color-mix(in srgb, var(--monday-blue) 4%, var(--monday-surface)); border: 1px solid var(--monday-border); border-radius: 12px; padding: 0.85rem 1rem; margin-top: 0.35rem; }
            #wfCustomizePanel .life-panel .life-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--monday-muted); margin-bottom: 0.35rem; display: block; }
            #wfCustomizePanel .life-panel .life-offset-row { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: stretch; }
            #wfCustomizePanel .life-panel .life-unit { display: flex; align-items: center; background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 10px; overflow: hidden; min-height: 34px; }
            #wfCustomizePanel .life-panel .life-unit span { font-size: 0.72rem; font-weight: 600; color: var(--monday-muted); padding: 0 0.55rem; white-space: nowrap; }
            #wfCustomizePanel .employee-multi + .select2-container { width: 100% !important; }
            #wfCustomizePanel .select2-container--bootstrap-5 .select2-selection--multiple { min-height: 38px; }
            #wfCustomizePanel .life-panel .life-unit input { border: 0; width: 3.2rem; text-align: center; font-weight: 700; font-size: 0.85rem; background: transparent; padding: 0.3rem 0; }
            #wfCustomizePanel .life-panel .life-unit input:focus { outline: none; box-shadow: none; }
            #wfCustomizePanel .life-panel .life-plus { color: var(--monday-muted); font-weight: 700; align-self: center; padding: 0 0.15rem; }
            #wfCustomizePanel .period-template-box { margin-top: 0.35rem; border: 1px solid var(--monday-border); border-radius: 10px; overflow: hidden; background: var(--monday-surface); }
            #wfCustomizePanel .period-template-box .pt-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.45rem 0.75rem; background: color-mix(in srgb, var(--monday-blue) 6%, var(--monday-surface)); border-bottom: 1px solid var(--monday-border); }
            #wfCustomizePanel .period-template-box .pt-head span { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--monday-muted); }
            #wfCustomizePanel .period-template-box .pt-head strong { font-size: 0.78rem; color: var(--monday-text); }
            #wfCustomizePanel .period-template-box table { width: 100%; margin: 0; font-size: 0.75rem; }
            #wfCustomizePanel .period-template-box th, #wfCustomizePanel .period-template-box td { padding: 0.28rem 0.5rem; border-bottom: 1px solid var(--monday-border); vertical-align: middle; }
            #wfCustomizePanel .period-template-box th { color: var(--monday-muted); font-weight: 600; font-size: 0.65rem; text-transform: uppercase; }
            #wfCustomizePanel .period-template-box .pt-scroll { max-height: 260px; overflow-y: auto; }
            #wfCustomizePanel .period-template-box input[type="text"], #wfCustomizePanel .period-template-box input[type="number"], #wfCustomizePanel .period-template-box select { border: 1px solid var(--monday-border); border-radius: 6px; padding: 0.2rem 0.35rem; font-size: 0.75rem; background: var(--monday-surface); }
            #wfCustomizePanel .period-template-box input[type="text"] { width: 100%; }
            #wfCustomizePanel .period-template-box .pt-md-row { display: flex; align-items: center; gap: 0.25rem; }
            #wfCustomizePanel .period-template-box .pt-md-row input[type="number"] { width: 3.2rem; text-align: center; font-weight: 700; }
            #wfCustomizePanel .period-template-box .pt-yyyy { font-size: 0.72rem; font-weight: 700; color: var(--monday-blue); white-space: nowrap; }
            #wfCustomizePanel .period-template-box .pt-del { border: 0; background: transparent; color: var(--monday-muted); padding: 0.15rem 0.35rem; cursor: pointer; }
        </style>

        <!-- 1) Affectation / personnaliser (FORM FIRST) -->
        @if (canWfConfigure)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h6 class="fw-bold mb-0" id="wfAffectFormTitle"><i class="bi bi-plus-circle text-success me-2"></i>Affecter / personnaliser un workflow</h6>
                            <p class="text-muted mb-0" style="font-size:0.78rem;">Associez un modèle cabinet — une copie est créée pour ce client.</p>
                        </div>
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3 btn-wf-customize"
                                data-type="All"
                                data-type-label="Tous types"
                                data-template=""
                                data-sla="1.0"
                                data-valclient="true"
                                data-docs="true"
                                data-auto="true"
                                data-active="true"
                                data-assignee="">
                            <i class="bi bi-sliders me-1"></i>Ouvrir le Personnaliser
                        </button>
                    </div>
                    <form asp-action="SaveWorkflowAffectation" method="post" id="clientWfAffectForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ClientId" value="@Model.Id" />
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Type de déclaration</label>
                                <select name="DeclarationType" id="wfAffectType" class="form-select">
                                    <option value="All">Tous types</option>
                                    @foreach (var e in DeclarationServiceCatalog.All)
                                    {
                                        <option value="@e.DeclarationType">@e.DisplayName (@e.DeclarationType)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Modèle de workflow (cabinet)</label>
                                <select name="WorkflowTemplateId" id="wfAffectTemplate" class="form-select">
                                    <option value="" data-type="">— Choisir un modèle —</option>
                                    @foreach (var t in cabinetTemplates)
                                    {
                                        <option value="@t.Id" data-type="@(t.DeclarationType ?? "")">@t.Name (@(t.DeclarationType ?? "?"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Responsable principal</label>
                                <select name="PrimaryAssigneeUserId" id="wfAffectAssignee" class="form-select">
                                    <option value="">— Non défini —</option>
                                    @foreach (var emp in cabinetEmployees)
                                    {
                                        <option value="@emp.Id">@emp.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">Multiplicateur SLA</label>
                                <input name="SLAMultiplier" id="wfAffectSla" type="number" step="0.1" min="0.1" max="5" class="form-control" value="1.0" />
                            </div>
                            <div class="col-md-2">
                                <div class="form-check form-switch">
                                    <input name="ClientValidationEnabled" type="checkbox" class="form-check-input" value="true" checked id="wfValClient" />
                                    <label class="form-check-label" for="wfValClient">Valid. client</label>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-check form-switch">
                                    <input name="DocumentRequestEnabled" type="checkbox" class="form-check-input" value="true" checked id="wfDocs" />
                                    <label class="form-check-label" for="wfDocs">Docs</label>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-check form-switch">
                                    <input name="AutoStartWorkflow" type="checkbox" class="form-check-input" value="true" checked id="wfAuto" />
                                    <label class="form-check-label" for="wfAuto">Auto-start</label>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-check form-switch">
                                    <input name="IsActive" type="checkbox" class="form-check-input" value="true" checked id="wfActive" />
                                    <label class="form-check-label" for="wfActive">Actif</label>
                                </div>
                            </div>
                            <div class="col-md-12 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" id="wfAffectReset" style="display:none;">
                                    Nouvelle affectation
                                </button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4">
                                    <i class="bi bi-check-lg me-1"></i>Affecter au client
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- Personnaliser panel (hidden until click) -->
        <div id="wfCustomizePanel" style="display:none;" class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-0"><i class="bi bi-kanban-fill text-primary me-2"></i>Personnaliser le workflow</h4>
                    <p class="text-muted mb-0" style="font-size:0.82rem;" id="wfCustomizeSubtitle">Une copie est créée pour ce client — modifiez les étapes librement.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="#" id="wfCustOpenBuilder" class="btn btn-outline-secondary rounded-pill px-3" target="_blank" rel="noopener">
                        <i class="bi bi-tools me-1"></i>Ouvrir dans le Builder
                    </a>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" id="wfCustomizeClose">
                        <i class="bi bi-x-lg me-1"></i>Fermer
                    </button>
                </div>
            </div>

            <form asp-action="SaveClientWorkflowCustomization" method="post" id="wfCustomizeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClientId" value="@Model.Id" />
                <input type="hidden" name="DeclarationType" id="wfCustType" />
                <input type="hidden" name="SourceTemplateId" id="wfCustSourceTemplateId" value="" />
                <input type="hidden" name="WorkflowTemplateId" id="wfCustTemplateId" value="" />

                <div class="row g-3">
                    <div class="col-lg-3">
                        <div class="card builder-card">
                            <div class="card-body">
                                <h6 class="fw-bold mb-1" style="font-size:0.82rem;"><i class="bi bi-collection text-primary me-1"></i>Modèles cabinet</h6>
                                <p class="text-muted mb-3" style="font-size:0.72rem;">Choisir un modèle crée / ouvre la copie de ce client.</p>
                                <div id="wfCustTplList">
                                    @{
                                        var typeColorsCust = new Dictionary<string, (string bg, string fg)> {
                                            ["TVA"] = ("#dbeafe", "#2563eb"),
                                            ["IS"] = ("#fce7f3", "#be185d"),
                                            ["IR"] = ("#ede9fe", "#7c3aed"),
                                            ["CNSS"] = ("#d1fae5", "#059669"),
                                            ["Paie"] = ("#fef3c7", "#d97706"),
                                            ["Juridique"] = ("#fee2e2", "#dc2626"),
                                            ["Comptabilite"] = ("#e0f2fe", "#0284c7"),
                                            ["IR_SALAIRES"] = ("#f5f3ff", "#6d28d9"),
                                            ["All"] = ("#f1f5f9", "#475569")
                                        };
                                    }
                                    @foreach (var t in cabinetTemplates)
                                    {
                                        var tc = typeColorsCust.ContainsKey(t.DeclarationType ?? "") ? typeColorsCust[t.DeclarationType!] : typeColorsCust["All"];
                                        <button type="button" class="tpl-mini wf-cust-tpl"
                                                data-id="@t.Id"
                                                data-type="@(t.DeclarationType ?? "")"
                                                data-name="@t.Name"
                                                data-steps="@t.StepCount">
                                            <span class="tpl-type" style="background:@tc.bg; color:@tc.fg;">@(t.DeclarationType ?? "All")</span>
                                            <span class="fw-semibold text-dark" style="font-size:0.78rem;">@t.Name</span>
                                            <span class="ms-auto text-muted" style="font-size:0.65rem;">@t.StepCount ét.</span>
                                        </button>
                                    }
                                </div>
                                @if (!cabinetTemplates.Any())
                                {
                                    <div class="text-center text-muted py-3" style="font-size:0.8rem;"><i class="bi bi-inbox d-block mb-1" style="font-size:1.3rem;"></i>Aucun modèle</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-9">
                        <div id="wfCustCopyBanner" class="client-copy-banner" style="display:none;">
                            <i class="bi bi-person-check-fill text-success"></i>
                            <span id="wfCustCopyBannerText">Copie workflow de ce client</span>
                        </div>

                        <div class="card builder-card mb-3">
                            <div class="card-body">
                                <div class="section-title"><i class="bi bi-gear-fill"></i>Configuration générale (ce client)</div>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label-sm">Type de déclaration</label>
                                        <input type="text" class="form-control form-control-sm" id="wfCustTypeLabel" readonly />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label-sm">Nom du workflow (copie client)</label>
                                        <input type="text" name="TemplateName" id="wfCustTemplateName" class="form-control form-control-sm" placeholder="Nom de la copie client" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label-sm">Description</label>
                                        <input type="text" name="TemplateDescription" id="wfCustTemplateDesc" class="form-control form-control-sm" placeholder="Description…" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label-sm">Multiplicateur SLA</label>
                                        <input name="SLAMultiplier" id="wfCustSla" type="number" step="0.1" min="0.1" max="5" class="form-control form-control-sm" value="1.0" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label-sm">Responsable principal</label>
                                        <select name="PrimaryAssigneeUserId" id="wfCustAssignee" class="form-select form-select-sm">
                                            <option value="">— Non défini —</option>
                                            @foreach (var emp in cabinetEmployees)
                                            {
                                                <option value="@emp.Id">@emp.FullName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end">
                                        <div class="chk-grid w-100" style="grid-template-columns:1fr 1fr;">
                                            <label class="chk-item">
                                                <input type="hidden" name="IsActive" value="false" />
                                                <input name="IsActive" type="checkbox" class="form-check-input" value="true" id="wfCustActive" />
                                                <span>Actif</span>
                                            </label>
                                            <label class="chk-item">
                                                <input type="hidden" name="AutoStartWorkflow" value="false" />
                                                <input name="AutoStartWorkflow" type="checkbox" class="form-check-input" value="true" id="wfCustAuto" />
                                                <span>Auto-start</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label-sm">Options</label>
                                        <div class="chk-grid">
                                            <label class="chk-item">
                                                <input type="hidden" name="ClientValidationEnabled" value="false" />
                                                <input name="ClientValidationEnabled" type="checkbox" class="form-check-input" value="true" id="wfCustVal" />
                                                <span>Valid. client</span>
                                            </label>
                                            <label class="chk-item">
                                                <input type="hidden" name="DocumentRequestEnabled" value="false" />
                                                <input name="DocumentRequestEnabled" type="checkbox" class="form-check-input" value="true" id="wfCustDocs" />
                                                <span>Demande docs</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card builder-card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="section-title mb-0"><i class="bi bi-list-ol"></i>Étapes du workflow (modifiable)</div>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2" id="wfCustStepCount" style="font-size:0.78rem;">0 étapes</span>
                                </div>
                                <div id="wfCustomizeSteps"></div>
                                <button type="button" class="btn-add-step mt-2" id="wfCustAddStep">
                                    <i class="bi bi-plus-lg"></i> Ajouter une étape
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" id="wfCustomizeClose2">Annuler</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-check-lg me-1"></i>Enregistrer la copie client
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- 2) Table: all workflows attached to this client -->
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-person-gear text-primary me-2"></i>Workflows attachés à ce client</h6>
                    <span class="badge bg-primary-subtle text-primary rounded-pill">@wfConfigs.Count</span>
                </div>

                @if (wfConfigs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 mc-table" style="font-size:0.82rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Type</th>
                                    <th>Workflow (copie client)</th>
                                    <th>Responsable</th>
                                    <th class="text-center">Valid. client</th>
                                    <th class="text-center">Docs</th>
                                    <th>SLA</th>
                                    <th class="text-center">Auto-start</th>
                                    <th class="text-center">Actif</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cfg in wfConfigs)
                                {
                                    var typeLabel = DeclarationServiceCatalog.Get(cfg.DeclarationType)?.DisplayName ?? cfg.DeclarationType;
                                    <tr>
                                        <td class="ps-3"><span class="badge bg-primary-subtle text-primary rounded-pill">@typeLabel</span></td>
                                        <td class="fw-semibold">@(cfg.WorkflowTemplateName ?? "Auto")</td>
                                        <td class="small">@(cfg.PrimaryAssigneeName ?? "—")</td>
                                        <td class="text-center">@(cfg.ClientValidationEnabled ? "Oui" : "Non")</td>
                                        <td class="text-center">@(cfg.DocumentRequestEnabled ? "Oui" : "Non")</td>
                                        <td><span class="badge bg-info-subtle text-info rounded-pill">x@(cfg.SLAMultiplier)</span></td>
                                        <td class="text-center">@(cfg.AutoStartWorkflow ? "Oui" : "Non")</td>
                                        <td class="text-center">
                                            @if (cfg.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill">Actif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill">Inactif</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3 text-nowrap">
                                            @if (canWfConfigure)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 btn-wf-customize"
                                                    style="font-size:0.7rem;"
                                                    data-type="@cfg.DeclarationType"
                                                    data-type-label="@typeLabel"
                                                    data-template="@(cfg.WorkflowTemplateId?.ToString() ?? "")"
                                                    data-template-name="@(cfg.WorkflowTemplateName ?? "")"
                                                    data-sla="@cfg.SLAMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-valclient="@(cfg.ClientValidationEnabled ? "true" : "false")"
                                                    data-docs="@(cfg.DocumentRequestEnabled ? "true" : "false")"
                                                    data-auto="@(cfg.AutoStartWorkflow ? "true" : "false")"
                                                    data-active="@(cfg.IsActive ? "true" : "false")"
                                                    data-assignee="@(cfg.PrimaryAssigneeUserId ?? "")">
                                                    <i class="bi bi-sliders me-1"></i>Personnaliser
                                                </button>
                                            }
                                            @if (cfg.WorkflowTemplateId.HasValue)
                                            {
                                                <form asp-controller="Workflow" asp-action="StartWorkflow" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="WorkflowTemplateId" value="@cfg.WorkflowTemplateId.Value" />
                                                    <input type="hidden" name="ClientId" value="@Model.Id" />
                                                    <input type="hidden" name="DeclarationType" value="@cfg.DeclarationType" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-2"
                                                            style="font-size:0.7rem;"
                                                            onclick="return confirm('Démarrer le workflow \'@(cfg.WorkflowTemplateName ?? "sélectionné")\' pour ce client ?')">
                                                        <i class="bi bi-play-fill me-1"></i>Démarrer
                                                    </button>
                                                </form>
                                            }
                                            @if (canWfConfigure)
                                            {
                                                <form asp-action="DeleteWorkflowAffectation" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="configId" value="@cfg.Id" />
                                                    <input type="hidden" name="clientId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2"
                                                            style="font-size:0.7rem;"
                                                            title="Retirer cette affectation"
                                                            onclick="return confirm('Retirer le workflow \'@(cfg.WorkflowTemplateName ?? typeLabel)\' de ce client ?\nLes instances déjà lancées ne seront pas annulées.')">
                                                        <i class="bi bi-trash3 me-1"></i>Supprimer
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3 mb-0" style="font-size:0.85rem;">
                        <i class="bi bi-inbox d-block mb-1" style="font-size:1.5rem;"></i>
                        Aucun workflow attaché. Utilisez le formulaire ci-dessus pour en affecter un.
                    </div>
                }
            </div>
        </div>

        <!-- Tous les workflows -->

        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-collection-fill text-primary me-2"></i>Instances lancées pour ce client</h6>
                    <a href="@Url.Action("Instances", "Workflow", new { clientId = Model.Id })"
                        class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size:0.75rem;">Voir tout</a>
                </div>
                @if (wfInstances.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 mc-table" style="font-size:0.82rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Workflow</th>
                                    <th>Type</th>
                                    <th>Statut</th>
                                    <th>Étape</th>
                                    <th>Démarré</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inst in wfInstances.OrderByDescending(i => i.StartedAt).Take(20))
                                {
                                    var statusBadge = inst.Status switch
                                    {
                                        "InProgress" or "Active" => "bg-success-subtle text-success",
                                        "Completed" => "bg-primary-subtle text-primary",
                                        "Cancelled" => "bg-danger-subtle text-danger",
                                        "Paused" => "bg-warning-subtle text-warning",
                                        _ => "bg-secondary-subtle text-secondary"
                                    };
                                    var statusLabel = inst.Status switch
                                    {
                                        "InProgress" or "Active" => "En cours",
                                        "Completed" => "Terminé",
                                        "Cancelled" => "Annulé",
                                        "Paused" => "En pause",
                                        _ => inst.Status
                                    };
                                    <tr>
                                        <td class="ps-3 fw-semibold">@inst.WorkflowTemplateName</td>
                                        <td><span class="badge bg-light text-dark rounded-pill">@inst.DeclarationType</span></td>
                                        <td><span class="badge @statusBadge rounded-pill">@statusLabel</span></td>
                                        <td>@(inst.CurrentStepName ?? "-")</td>
                                        <td>@inst.StartedAt.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end pe-3">
                                            <a href="@Url.Action("InstanceDetails", "Workflow", new { id = inst.Id })"
                                                class="btn btn-sm btn-outline-primary rounded-pill px-2"
                                                style="font-size:0.7rem;"><i class="bi bi-eye me-1"></i>Détails</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3" style="font-size:0.85rem;">
                        <i class="bi bi-inbox d-block mb-1" style="font-size:1.5rem;"></i>
                        Aucun workflow lancé pour ce client.
                    </div>
                }
            </div>
        </div>

        <!-- Pending steps -->
        @if (wfPendingSteps.Any())
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="bi bi-hourglass-split text-warning me-2"></i>Étapes en attente</h6>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 mc-table" style="font-size:0.82rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Étape</th>
                                    <th>Workflow</th>
                                    <th>Assigné à</th>
                                    <th>SLA</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var step in wfPendingSteps)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@step.StepName</td>
                                        <td>@step.WorkflowInstanceId</td>
                                        <td>@(step.AssignedToUserName ?? "Non assigné")</td>
                                        <td>@(step.DueDate.HasValue ? step.DueDate.Value.ToString("dd/MM HH:mm") : "-")</td>
                                        <td class="text-end pe-3">
                                            <a href="@Url.Action("InstanceDetails", "Workflow", new { id = step.WorkflowInstanceId })"
                                                class="btn btn-sm btn-outline-success rounded-pill px-2"
                                                style="font-size:0.7rem;"><i class="bi bi-arrow-right-circle me-1"></i>Traiter</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

