@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/workflow-cron.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.btn-sync-services').forEach(btn => {
            btn.addEventListener('click', async function () {
                const contratId = this.dataset.contratId;
                const original = this.innerHTML;
                this.disabled = true;
                this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Sync...';
                try {
                    const resp = await fetch('@Url.Action("SyncServicesFromContrat", "Clients")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                        body: 'contratId=' + contratId
                    });
                    const data = await resp.json();
                    if (data.success) { location.reload(); }
                    else { alert(data.message || 'Erreur.'); this.disabled = false; this.innerHTML = original; }
                } catch { alert('Erreur r\u00e9seau.'); this.disabled = false; this.innerHTML = original; }
            });
        });

        (function activateWorkflowTab() {
            var params = new URLSearchParams(window.location.search);
            var want = (params.get('tab') || '').toLowerCase() === 'workflow'
                || (window.location.hash || '').toLowerCase() === '#tabworkflow';
            if (!want) return;
            var trigger = document.querySelector('a[href="#tabWorkflow"]');
            if (trigger && window.bootstrap) {
                var tab = new bootstrap.Tab(trigger);
                tab.show();
            } else if (trigger) {
                trigger.click();
            }
        })();

        (function filterWfTemplates() {
            var typeSel = document.getElementById('wfAffectType');
            var tplSel = document.getElementById('wfAffectTemplate');
            if (!typeSel || !tplSel) return;
            var allOptions = Array.prototype.map.call(tplSel.options, function (o) {
                return { value: o.value, text: o.text, type: (o.getAttribute('data-type') || '').toUpperCase() };
            });
            function refresh() {
                var want = (typeSel.value || '').toUpperCase();
                var keep = tplSel.value;
                tplSel.innerHTML = '';
                allOptions.forEach(function (opt) {
                    if (!opt.value || want === 'ALL' || !opt.type || opt.type === want) {
                        var o = document.createElement('option');
                        o.value = opt.value;
                        o.textContent = opt.text;
                        o.setAttribute('data-type', opt.type);
                        tplSel.appendChild(o);
                    }
                });
                if (Array.prototype.some.call(tplSel.options, function (o) { return o.value === keep; })) {
                    tplSel.value = keep;
                }
            }
            typeSel.addEventListener('change', refresh);
            window._wfRefreshTemplates = refresh;
        })();

        (function customizeAffectation() {
            var panel = document.getElementById('wfCustomizePanel');
            var stepsEl = document.getElementById('wfCustomizeSteps');
            var stepCountBadge = document.getElementById('wfCustStepCount');
            var subtitle = document.getElementById('wfCustomizeSubtitle');
            var closeBtn = document.getElementById('wfCustomizeClose');
            var closeBtn2 = document.getElementById('wfCustomizeClose2');
            var tplHidden = document.getElementById('wfCustTemplateId');
            var sourceHidden = document.getElementById('wfCustSourceTemplateId');
            var nameInput = document.getElementById('wfCustTemplateName');
            var descInput = document.getElementById('wfCustTemplateDesc');
            var slaInput = document.getElementById('wfCustSla');
            var builderLink = document.getElementById('wfCustOpenBuilder');
            var copyBanner = document.getElementById('wfCustCopyBanner');
            var copyBannerText = document.getElementById('wfCustCopyBannerText');
            var ensureUrl = '@Url.Action("EnsureClientWorkflow", "Clients")';
            var builderUrlBase = '@Url.Action("Builder", "Workflow")';
            var clientId = @Model.Id;
            var antiforgery = document.querySelector('#wfCustomizeForm input[name="__RequestVerificationToken"]')?.value
                || document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || '';
            var currentDeclType = 'All';
            var employees = [
@foreach (var emp in cabinetEmployees)
{
                @: { id: '@emp.Id', name: '@Html.Raw((emp.FullName ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))', first: '@Html.Raw((emp.FirstName ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))', last: '@Html.Raw((emp.LastName ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))', role: '@Html.Raw((emp.Role ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))' },
}
            ];
            var departments = [
@foreach (var d in departments)
{
                @: { id: @d.Id, name: '@Html.Raw((d.Name ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))' },
}
            ];
            var stepTypes = [
                { v: 'Initialisation', l: 'Initialisation' },
                { v: 'DemandePieces', l: 'Demande pièces' },
                { v: 'Collecte', l: 'Collecte' },
                { v: 'Saisie', l: 'Saisie' },
                { v: 'Controle', l: 'Contrôle' },
                { v: 'ValidationInterne', l: 'Valid. interne' },
                { v: 'ValidationClient', l: 'Valid. client' },
                { v: 'DepotSoumission', l: 'Dépôt' },
                { v: 'Paiement', l: 'Paiement' },
                { v: 'Rapprochement', l: 'Rapprochement' },
                { v: 'ClotureArchivage', l: 'Clôture' }
            ];
            var assignTypes = [
                { v: 'Employee', l: 'Employé' },
                { v: 'Role', l: 'Rôle' },
                { v: 'Department', l: 'Département' },
                { v: 'Client', l: 'Client' },
                { v: 'AutoSystem', l: 'Automatique' }
            ];
            var roles = ['Gerant', 'Manager', 'Collaborateur', 'Assistant', 'Stagiaire'];

            function setCheck(id, on) {
                var el = document.getElementById(id);
                if (el) el.checked = !!on;
            }

            function esc(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            window._wfCustSyncStepPanels = function (card) {
                if (!card) return;
                var typeSel = card.querySelector('.step-type-select');
                var type = typeSel ? typeSel.value : '';
                var isInit = type === 'Initialisation';
                var isCloture = type === 'ClotureArchivage';
                var echeance = card.querySelector('.echeance-section');
                var lifecycle = card.querySelector('.lifecycle-section');
                var anchorHidden = card.querySelector('.deadline-anchor-hidden');
                var applyHidden = card.querySelector('.apply-ddl-hidden');
                var lifeModeHidden = card.querySelector('.lifecycle-mode-hidden');
                if (anchorHidden) anchorHidden.value = isCloture ? 'None' : 'CalendrierMaroc';
                if (applyHidden) applyHidden.value = isInit ? 'true' : 'false';
                if (lifeModeHidden) lifeModeHidden.value = isInit ? 'PeriodEnd' : 'None';
                if (echeance) {
                    var hide = isCloture || isInit;
                    echeance.style.display = hide ? 'none' : '';
                    echeance.querySelectorAll('input,select,textarea').forEach(function (el) { el.disabled = hide; });
                }
                if (lifecycle) {
                    lifecycle.style.display = isInit ? '' : 'none';
                    lifecycle.querySelectorAll('input,select,textarea').forEach(function (el) { el.disabled = !isInit; });
                }
                syncRelancePanel(card);
            };

            function optList(items, selected, valueKey, labelKey) {
                valueKey = valueKey || 'v';
                labelKey = labelKey || 'l';
                return items.map(function (it) {
                    var v = typeof it === 'string' ? it : it[valueKey];
                    var l = typeof it === 'string' ? it : it[labelKey];
                    return '<option value="' + esc(v) + '"' + (String(v) === String(selected || '') ? ' selected' : '') + '>' + esc(l) + '</option>';
                }).join('');
            }

            function empMultiOpts(selectedIds) {
                var selected = {};
                (selectedIds || []).forEach(function (id) { if (id) selected[String(id)] = true; });
                return employees.map(function (e) {
                    var label = e.name + (e.role ? (' — ' + e.role) : '');
                    return '<option value="' + esc(e.id) + '" data-first="' + esc(e.first) + '" data-last="' + esc(e.last) + '" data-role="' + esc(e.role) + '"'
                        + (selected[e.id] ? ' selected' : '') + '>' + esc(label) + '</option>';
                }).join('');
            }

            function deptOpts(selected) {
                var html = '<option value="">--</option>';
                departments.forEach(function (d) {
                    html += '<option value="' + d.id + '"' + (String(d.id) === String(selected || '') ? ' selected' : '') + '>' + esc(d.name) + '</option>';
                });
                return html;
            }

            function destroyEmployeeSelect2(root) {
                if (!window.jQuery) return;
                jQuery(root || document).find('select.employee-multi').each(function () {
                    if (jQuery(this).hasClass('select2-hidden-accessible')) jQuery(this).select2('destroy');
                });
            }

            function initEmployeeSelect2(root) {
                if (!window.jQuery || !jQuery.fn.select2) return;
                jQuery(root || document).find('select.employee-multi').each(function () {
                    var $el = jQuery(this);
                    if ($el.hasClass('select2-hidden-accessible')) return;
                    $el.select2({
                        theme: 'bootstrap-5',
                        width: '100%',
                        placeholder: $el.data('placeholder') || 'Rechercher par prénom ou nom...',
                        allowClear: true,
                        closeOnSelect: false
                    });
                });
            }

            function labelOf(list, v) {
                for (var i = 0; i < list.length; i++) {
                    if (list[i].v === v) return list[i].l;
                }
                return v || '';
            }

            function setActiveTpl(sourceId) {
                document.querySelectorAll('#wfCustTplList .wf-cust-tpl').forEach(function (btn) {
                    btn.classList.toggle('active', btn.getAttribute('data-id') === String(sourceId));
                });
                if (sourceHidden) sourceHidden.value = sourceId || '';
            }

            function updateBuilderLink(templateId) {
                if (!builderLink) return;
                if (templateId) {
                    builderLink.href = builderUrlBase + '/' + encodeURIComponent(templateId);
                    builderLink.classList.remove('disabled');
                } else {
                    builderLink.href = '#';
                    builderLink.classList.add('disabled');
                }
            }

            function filterTplList(declType) {
                currentDeclType = declType || 'All';
                var type = currentDeclType.toLowerCase();
                var firstMatch = '';
                var firstAll = '';
                document.querySelectorAll('#wfCustTplList .wf-cust-tpl').forEach(function (btn) {
                    var ot = (btn.getAttribute('data-type') || '').toLowerCase();
                    var match = !ot || ot === 'all' || ot === type || type === 'all';
                    btn.style.display = match ? '' : 'none';
                    if (match && !firstMatch && ot === type) firstMatch = btn.getAttribute('data-id');
                    if (match && !firstAll && (!ot || ot === 'all')) firstAll = btn.getAttribute('data-id');
                });
                return { firstMatch: firstMatch, firstAll: firstAll };
            }

            function syncStepHeaders(card) {
                var name = card.querySelector('.step-name-input')?.value || 'Étape';
                var type = card.querySelector('.step-type-select')?.value || '';
                var assign = card.querySelector('.assign-select')?.value || '';
                var sla = card.querySelector('.step-sla-input')?.value;
                var h = card.querySelector('h6');
                if (h) h.textContent = name;
                var tb = card.querySelector('.step-type-badge');
                if (tb) tb.textContent = labelOf(stepTypes, type);
                var ab = card.querySelector('.assign-badge');
                if (ab) ab.innerHTML = '<i class="bi bi-person-fill me-1"></i>' + esc(labelOf(assignTypes, assign));
                var sb = card.querySelector('.sla-badge');
                if (sb) {
                    if (sla) { sb.style.display = ''; sb.innerHTML = '<i class="bi bi-clock me-1"></i>' + esc(sla) + ' h'; }
                    else sb.style.display = 'none';
                }
            }

            function toggleAssignFields(sel) {
                var card = sel.closest('.step-card');
                if (!card) return;
                var v = sel.value;
                card.querySelectorAll('.assign-employee-field').forEach(function (el) { el.classList.toggle('d-none', v !== 'Employee'); });
                card.querySelectorAll('.assign-role-field').forEach(function (el) { el.classList.toggle('d-none', v !== 'Role'); });
                card.querySelectorAll('.assign-dept-field').forEach(function (el) { el.classList.toggle('d-none', v !== 'Department'); });
                if (v === 'Employee') initEmployeeSelect2(card);
                if (window.WfCron) WfCron.syncInitScheduleVisibility(card);
            }

            function syncInitCronSlot(card) {
                if (!card || !window.WfCron) return;
                var type = card.querySelector('.step-type-select')?.value || '';
                var assign = card.querySelector('.assign-select')?.value || '';
                var slot = card.querySelector('.init-cron-slot');
                if (!slot) return;
                var isInitAuto = type === 'Initialisation' && assign === 'AutoSystem';
                if (!isInitAuto) {
                    slot.innerHTML = '';
                    return;
                }
                if (slot.querySelector('.schedule-section')) {
                    WfCron.syncInitScheduleVisibility(card);
                    return;
                }
                var prefix = '';
                var nameEl = card.querySelector('[name^="Steps["][name$=".Name"]');
                if (nameEl) prefix = nameEl.name.replace(/\.Name$/, '');
                else prefix = 'Steps[' + (card.dataset.index || 0) + ']';
                var cron = slot.getAttribute('data-cron') || '';
                var cronDesc = slot.getAttribute('data-cron-desc') || '';
                var actionCfg = slot.getAttribute('data-action-cfg') || '';
                slot.innerHTML = WfCron.cronBuilderHtml(prefix, cron, cronDesc);
                if (actionCfg) {
                    var cfgInput = slot.querySelector('.action-config-input');
                    if (cfgInput) cfgInput.value = actionCfg;
                }
                var builder = slot.querySelector('.cron-builder');
                if (builder) WfCron.parseCronToUI(builder);
                WfCron.syncInitScheduleVisibility(card);
            }

            function reindexSteps() {
                var cards = stepsEl.querySelectorAll('.step-card');
                if (stepCountBadge) stepCountBadge.textContent = cards.length + ' étape' + (cards.length !== 1 ? 's' : '');
                cards.forEach(function (card, i) {
                    var num = card.querySelector('.step-num');
                    if (num) num.textContent = String(i + 1);
                    card.querySelectorAll('[name^="Steps["]').forEach(function (input) {
                        input.name = input.name.replace(/Steps\[\d+]/, 'Steps[' + i + ']');
                    });
                    var order = card.querySelector('.step-order-input');
                    if (order) order.value = String(i);
                    card.dataset.index = String(i);
                });
            }

            function selectedUserIds(s) {
                var list = s.assignedToUserIdList || s.AssignedToUserIdList || [];
                if (list && list.length) return list.map(String);
                var csv = s.assignedToUserIds || s.AssignedToUserIds || '';
                if (typeof csv === 'string' && csv) {
                    return csv.split(',').map(function (x) { return x.trim(); }).filter(Boolean);
                }
                if (Array.isArray(csv) && csv.length) return csv.map(String);
                var one = s.assignedToUserId || s.AssignedToUserId || '';
                return one ? [String(one)] : [];
            }

            function buildStepCard(s, index) {
                s = s || {};
                var name = s.name || s.Name || ('Étape ' + (index + 1));
                var stepType = s.stepType || s.StepType || 'Initialisation';
                var assign = s.assignmentType || s.AssignmentType || 'Employee';
                var sla = s.slaHours != null ? s.slaHours : (s.SLAHours != null ? s.SLAHours : '');
                var desc = s.description || s.Description || '';
                var lifeAction = s.actionOnLifecycleEnd || s.ActionOnLifecycleEnd || 'ClotureDeclaration';
                var isCloture = stepType === 'ClotureArchivage';
                var isInit = stepType === 'Initialisation';
                var hideEcheance = isCloture || isInit;
                var userIds = selectedUserIds(s);
                var role = s.assignedToRoleName || s.AssignedToRoleName || '';
                var deptId = s.assignedToDepartmentId != null ? s.assignedToDepartmentId : (s.AssignedToDepartmentId != null ? s.AssignedToDepartmentId : '');
                var isClient = !!(s.isClientStep || s.IsClientStep) || assign === 'Client';
                var isRequired = s.isRequired != null ? s.isRequired : (s.IsRequired != null ? s.IsRequired : true);
                var isBlocking = s.isBlocking != null ? s.isBlocking : (s.IsBlocking != null ? s.IsBlocking : true);
                var cronExpr = s.cronExpression || s.CronExpression || '';
                var cronDesc = s.cronDescription || s.CronDescription || '';
                var actionCfg = s.actionConfigJson || s.ActionConfigJson || '';
                var isScheduled = !!(s.isScheduled || s.IsScheduled);
                var triggerSource = s.triggerSource || s.TriggerSource || '';
                var maxRetries = s.maxRetries != null ? s.maxRetries : (s.MaxRetries != null ? s.MaxRetries : 0);
                var retryHours = s.retryIntervalHours != null ? s.retryIntervalHours : (s.RetryIntervalHours != null ? s.RetryIntervalHours : null);
                var onMax = s.onMaxRetriesAction || s.OnMaxRetriesAction || 'Suspend';
                var retryDays = retryHours > 0 ? Math.max(1, Math.round(retryHours / 24)) : 15;
                var isRelanceType = stepType === 'Relance';
                var relanceEnabled = maxRetries > 0 || isRelanceType;
                var hideRelance = isInit || isCloture;
                var p = 'Steps[' + index + ']';
                var isInitAuto = stepType === 'Initialisation' && assign === 'AutoSystem';
                var stepTypeOpts = optList(stepTypes, stepType);
                if (isRelanceType) {
                    stepTypeOpts += '<option value="Relance" selected>Relance (obsolète → utiliser config ci-dessous)</option>';
                }

                var html = '<div class="step-card collapsed-step" data-index="' + index + '">'
                    + '<div class="step-header" onclick="if(!event.target.closest(\'.btn-delete-step\')) this.parentElement.classList.toggle(\'collapsed-step\')">'
                    + '<span class="step-num">' + (index + 1) + '</span>'
                    + '<h6>' + esc(name) + '</h6>'
                    + '<span class="step-type-badge">' + esc(labelOf(stepTypes, stepType) || stepType) + '</span>'
                    + '<span class="assign-badge"><i class="bi bi-person-fill me-1"></i>' + esc(labelOf(assignTypes, assign)) + '</span>'
                    + '<span class="sla-badge"' + (sla === '' ? ' style="display:none"' : '') + '><i class="bi bi-clock me-1"></i>' + esc(sla) + ' h</span>'
                    + '<span class="ms-auto d-flex align-items-center gap-2">'
                    + '<button type="button" class="btn-delete-step" title="Supprimer" onclick="event.stopPropagation();window._wfCustRemoveStep(this)"><i class="bi bi-trash3"></i></button>'
                    + '<i class="bi bi-chevron-down chevron-icon"></i></span></div>'
                    + '<div class="step-body">'
                    + '<input type="hidden" class="step-order-input" name="' + p + '.StepOrder" value="' + index + '" />'
                    + '<div class="field-section"><div class="field-section-title"><i class="bi bi-tag-fill"></i>Identification</div><div class="row g-2">'
                    + '<div class="col-md-5"><label class="form-label-sm">Nom de l\'étape</label>'
                    + '<input type="text" name="' + p + '.Name" value="' + esc(name) + '" class="form-control form-control-sm step-name-input" /></div>'
                    + '<div class="col-md-7"><label class="form-label-sm">Type d\'étape</label>'
                    + '<select name="' + p + '.StepType" class="form-select form-select-sm step-type-select" onchange="window._wfCustSyncStepPanels && window._wfCustSyncStepPanels(this.closest(\'.step-card\'))">' + stepTypeOpts + '</select></div>'
                    + '<div class="col-12"><label class="form-label-sm">Description</label>'
                    + '<input type="text" name="' + p + '.Description" value="' + esc(desc) + '" class="form-control form-control-sm" placeholder="Description de l\'étape…" /></div>'
                    + '</div></div>'
                    + '<input type="hidden" name="' + p + '.DeadlineAnchor" value="' + (isCloture ? 'None' : 'CalendrierMaroc') + '" class="deadline-anchor-hidden" />'
                    + '<input type="hidden" name="' + p + '.ApplyDeadlineToDeclaration" value="' + (isInit ? 'true' : 'false') + '" class="apply-ddl-hidden" />'
                    + '<input type="hidden" name="' + p + '.LifecycleEndMode" value="' + (isInit ? 'PeriodEnd' : 'None') + '" class="lifecycle-mode-hidden" />'
                    + '<div class="field-section echeance-section"' + (hideEcheance ? ' style="display:none"' : '') + '><div class="field-section-title"><i class="bi bi-hourglass-split"></i>Délai de traitement</div><div class="row g-2">'
                    + '<div class="col-md-4"><label class="form-label-sm">Délai interne (heures)</label>'
                    + '<input type="number" name="' + p + '.SLAHours" value="' + esc(sla) + '" class="form-control form-control-sm step-sla-input" min="0" placeholder="24"' + (hideEcheance ? ' disabled' : '') + ' />'
                    + '<div class="form-text">Temps imparti pour cette étape (ex. réception documents client).</div></div></div></div>'
                    + '<div class="field-section"><div class="field-section-title"><i class="bi bi-person-fill-gear"></i>Assignation / partie</div><div class="row g-2">'
                    + '<div class="col-md-4"><label class="form-label-sm">Type d\'assignation</label>'
                    + '<select name="' + p + '.AssignmentType" class="form-select form-select-sm assign-select">' + optList(assignTypes, assign) + '</select></div>'
                    + '<div class="col-md-8 assign-employee-field' + (assign !== 'Employee' ? ' d-none' : '') + '"><label class="form-label-sm">Employés (partie)</label>'
                    + '<select name="' + p + '.AssignedToUserIds" class="form-select form-select-sm employee-multi" multiple data-placeholder="Rechercher par prénom ou nom...">' + empMultiOpts(userIds) + '</select></div>'
                    + '<div class="col-md-4 assign-role-field' + (assign !== 'Role' ? ' d-none' : '') + '"><label class="form-label-sm">Rôle</label>'
                    + '<select name="' + p + '.AssignedToRoleName" class="form-select form-select-sm"><option value="">--</option>' + optList(roles, role) + '</select></div>'
                    + '<div class="col-md-4 assign-dept-field' + (assign !== 'Department' ? ' d-none' : '') + '"><label class="form-label-sm">Département</label>'
                    + '<select name="' + p + '.AssignedToDepartmentId" class="form-select form-select-sm">' + deptOpts(deptId) + '</select></div>'
                    + '<div class="col-12"><div class="chk-grid" style="grid-template-columns:repeat(3,1fr);">'
                    + '<label class="chk-item"><input type="hidden" name="' + p + '.IsClientStep" value="false" /><input type="checkbox" class="form-check-input" name="' + p + '.IsClientStep" value="true"' + (isClient ? ' checked' : '') + ' /><span>Étape client</span></label>'
                    + '<label class="chk-item"><input type="hidden" name="' + p + '.IsRequired" value="false" /><input type="checkbox" class="form-check-input" name="' + p + '.IsRequired" value="true"' + (isRequired ? ' checked' : '') + ' /><span>Obligatoire</span></label>'
                    + '<label class="chk-item"><input type="hidden" name="' + p + '.IsBlocking" value="false" /><input type="checkbox" class="form-check-input" name="' + p + '.IsBlocking" value="true"' + (isBlocking ? ' checked' : '') + ' /><span>Bloquant</span></label>'
                    + '</div></div></div></div>'
                    + '<div class="init-cron-slot" data-cron="' + esc(cronExpr) + '" data-cron-desc="' + esc(cronDesc) + '" data-action-cfg="' + esc(actionCfg) + '" data-scheduled="' + (isScheduled ? '1' : '0') + '" data-trigger="' + esc(triggerSource) + '"></div>'
                    + '<div class="field-section relance-config-section' + (hideRelance ? ' d-none' : '') + '" data-relance-panel>'
                    + '<div class="field-section-title"><i class="bi bi-arrow-repeat"></i>Relances automatiques / échéance client</div>'
                    + '<label class="chk-item mb-2"><input type="checkbox" class="form-check-input relance-enable"' + (relanceEnabled ? ' checked' : '') + ' />'
                    + '<span>Activer les relances si cette étape n\'est pas terminée</span></label>'
                    + '<div class="relance-fields' + (relanceEnabled ? '' : ' d-none') + '">'
                    + '<div class="alert alert-info py-2 px-3 small mb-2 mt-1 rounded-3">Ex. réception documents client → après <strong>N jours</strong> une relance, jusqu\'à <strong>N fois</strong>, puis action.</div>'
                    + '<div class="row g-2 mt-1">'
                    + '<div class="col-md-3"><label class="form-label-sm">1ʳᵉ relance après (jours)</label>'
                    + '<input type="number" class="form-control form-control-sm relance-days-input" value="' + retryDays + '" min="1" placeholder="15"' + (relanceEnabled ? '' : ' disabled') + ' />'
                    + '<input type="hidden" name="' + p + '.RetryIntervalHours" class="relance-hours-input" value="' + (retryHours > 0 ? retryHours : retryDays * 24) + '" /></div>'
                    + '<div class="col-md-3"><label class="form-label-sm">Nombre de relances</label>'
                    + '<input type="number" ' + (relanceEnabled ? 'name="' + p + '.MaxRetries" ' : '') + 'class="form-control form-control-sm relance-max-input" min="0" value="' + (relanceEnabled ? (maxRetries > 0 ? maxRetries : 3) : 0) + '"' + (relanceEnabled ? '' : ' disabled') + ' /></div>'
                    + '<div class="col-md-3"><label class="form-label-sm">Action à chaque relance</label>'
                    + '<select class="form-select form-select-sm" disabled><option selected>Renvoyer la relance client</option></select></div>'
                    + '<div class="col-md-3"><label class="form-label-sm">Après N relances</label>'
                    + '<select name="' + p + '.OnMaxRetriesAction" class="form-select form-select-sm relance-onmax-input"' + (relanceEnabled ? '' : ' disabled') + '>'
                    + '<option value="Suspend"' + (onMax === 'Suspend' ? ' selected' : '') + '>Suspendre la déclaration</option>'
                    + '<option value="EscalateToManager"' + (onMax === 'EscalateToManager' ? ' selected' : '') + '>Escalader au manager</option>'
                    + '<option value="NextStep"' + (onMax === 'NextStep' ? ' selected' : '') + '>Passer à l\'étape suivante</option>'
                    + '<option value="Cancel"' + (onMax === 'Cancel' ? ' selected' : '') + '>Annuler le workflow</option>'
                    + '</select></div></div></div>'
                    + (relanceEnabled ? '' : '<input type="hidden" name="' + p + '.MaxRetries" value="0" class="relance-max-fallback" />')
                    + '</div>';

                if (isInitAuto && window.WfCron) {
                    // placeholder filled after insert via syncInitCronSlot
                } else if (!isInitAuto && (cronExpr || isScheduled)) {
                    html += '<input type="hidden" name="' + p + '.CronExpression" class="cron-input" value="' + esc(cronExpr) + '" />'
                        + '<input type="hidden" name="' + p + '.CronDescription" class="cron-desc-input" value="' + esc(cronDesc) + '" />'
                        + '<input type="hidden" name="' + p + '.IsScheduled" value="' + (isScheduled ? 'true' : 'false') + '" />'
                        + '<input type="hidden" name="' + p + '.TriggerSource" value="' + esc(triggerSource || 'Manual') + '" />'
                        + (actionCfg ? '<input type="hidden" name="' + p + '.ActionConfigJson" value="' + esc(actionCfg) + '" />' : '');
                }

                html += '</div></div>';
                return html;
            }

            function syncRelanceDaysToHours(card) {
                if (!card) return;
                var days = card.querySelector('.relance-days-input');
                var hours = card.querySelector('.relance-hours-input');
                if (!days || !hours || days.disabled) return;
                var d = Math.max(1, parseInt(days.value || '15', 10) || 15);
                days.value = d;
                hours.value = d * 24;
            }

            function toggleRelanceConfig(chk) {
                var card = chk.closest('.step-card');
                if (!card) return;
                var on = !!chk.checked;
                var fields = card.querySelector('.relance-fields');
                var maxIn = card.querySelector('.relance-max-input');
                var days = card.querySelector('.relance-days-input');
                var onMax = card.querySelector('.relance-onmax-input');
                var fallback = card.querySelector('.relance-max-fallback');
                if (fields) fields.classList.toggle('d-none', !on);
                [maxIn, days, onMax].forEach(function (el) { if (el) el.disabled = !on; });
                if (on) {
                    if (fallback) fallback.remove();
                    if (maxIn) {
                        if (!maxIn.name) {
                            var idx = card.dataset.index || '0';
                            maxIn.name = 'Steps[' + idx + '].MaxRetries';
                        }
                        if (!maxIn.value || maxIn.value === '0') maxIn.value = '3';
                    }
                    if (days && (!days.value || days.value === '0')) days.value = '15';
                    syncRelanceDaysToHours(card);
                } else {
                    if (maxIn) {
                        maxIn.value = '0';
                        maxIn.removeAttribute('name');
                    }
                    var panel = card.querySelector('[data-relance-panel]');
                    var idx2 = card.dataset.index || '0';
                    var fb = card.querySelector('.relance-max-fallback');
                    if (!fb && panel) {
                        fb = document.createElement('input');
                        fb.type = 'hidden';
                        fb.className = 'relance-max-fallback';
                        panel.appendChild(fb);
                    }
                    if (fb) {
                        fb.name = 'Steps[' + idx2 + '].MaxRetries';
                        fb.value = '0';
                    }
                    var hours = card.querySelector('.relance-hours-input');
                    if (hours) hours.value = '0';
                }
            }

            function syncRelancePanel(card) {
                if (!card) return;
                var typeSel = card.querySelector('.step-type-select');
                var type = typeSel ? typeSel.value : '';
                var panel = card.querySelector('[data-relance-panel]');
                var hide = type === 'Initialisation' || type === 'ClotureArchivage';
                if (panel) panel.classList.toggle('d-none', hide);
                if (!hide) {
                    var enable = card.querySelector('.relance-enable');
                    if (enable) toggleRelanceConfig(enable);
                }
            }

            function renderEditableSteps(steps) {
                var list = steps || [];
                if (!list.length) {
                    stepsEl.innerHTML = '<div class="text-center text-muted py-3" style="font-size:0.85rem;">Aucune étape — ajoutez-en ci-dessous.</div>';
                    if (stepCountBadge) stepCountBadge.textContent = '0 étapes';
                    return;
                }
                destroyEmployeeSelect2(stepsEl);
                var html = '';
                list.forEach(function (s, i) { html += buildStepCard(s, i); });
                stepsEl.innerHTML = html;
                bindStepCardEvents();
                reindexSteps();
                initEmployeeSelect2(stepsEl);
            }

            function bindStepCardEvents() {
                stepsEl.querySelectorAll('.step-card').forEach(function (card) {
                    card.querySelectorAll('.step-name-input, .step-type-select, .assign-select, .step-sla-input').forEach(function (el) {
                        el.addEventListener('input', function () { syncStepHeaders(card); });
                        el.addEventListener('change', function () { syncStepHeaders(card); });
                    });
                    var as = card.querySelector('.assign-select');
                    if (as) as.addEventListener('change', function () { toggleAssignFields(as); syncInitCronSlot(card); syncStepHeaders(card); });
                    var ts = card.querySelector('.step-type-select');
                    if (ts) ts.addEventListener('change', function () {
                        window._wfCustSyncStepPanels(card);
                        syncInitCronSlot(card);
                        syncStepHeaders(card);
                    });
                    var enable = card.querySelector('.relance-enable');
                    if (enable) enable.addEventListener('change', function () { toggleRelanceConfig(enable); });
                    var days = card.querySelector('.relance-days-input');
                    if (days) {
                        days.addEventListener('change', function () { syncRelanceDaysToHours(card); });
                        days.addEventListener('input', function () { syncRelanceDaysToHours(card); });
                    }
                    syncInitCronSlot(card);
                    syncRelancePanel(card);
                });
            }

            window._wfCustRemoveStep = function (btn) {
                var card = btn.closest('.step-card');
                if (card) {
                    destroyEmployeeSelect2(card);
                    card.remove();
                }
                reindexSteps();
            };

            function applyClientTemplate(data, sourceId) {
                var id = data.id || data.Id;
                var name = data.name || data.Name || '';
                var desc = data.description || data.Description || '';
                var steps = data.steps || data.Steps || [];
                if (tplHidden) tplHidden.value = id || '';
                if (sourceHidden) sourceHidden.value = sourceId || '';
                if (nameInput) nameInput.value = name;
                if (descInput) descInput.value = desc || '';
                updateBuilderLink(id);
                if (copyBanner) copyBanner.style.display = '';
                if (copyBannerText) copyBannerText.textContent = 'Copie client #' + id + ' — ' + name + ' (modifiable sans toucher au modèle cabinet)';
                if (subtitle) subtitle.textContent = 'Copie pour ce client — modifiez les étapes, SLA et assignations puis enregistrez.';
                renderEditableSteps(steps);
            }

            function ensureAndLoad(sourceId) {
                if (!sourceId) {
                    stepsEl.innerHTML = '<div class="text-center text-muted py-4">Sélectionnez un modèle cabinet.</div>';
                    return;
                }
                setActiveTpl(sourceId);
                stepsEl.innerHTML = '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Création / chargement de la copie client…</div>';
                fetch(ensureUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiforgery,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        clientId: clientId,
                        sourceTemplateId: parseInt(sourceId, 10),
                        declarationType: currentDeclType || 'All'
                    })
                })
                    .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                    .then(function (res) {
                        if (!res.ok || !res.j || !res.j.success || !res.j.data) {
                            throw new Error((res.j && res.j.message) || 'Clone impossible');
                        }
                        applyClientTemplate(res.j.data, sourceId);
                    })
                    .catch(function (err) {
                        stepsEl.innerHTML = '<div class="text-danger text-center py-4">' + esc(err.message || 'Erreur') + '</div>';
                    });
            }

            function openPanel(btn) {
                if (!panel) return;
                var type = btn.getAttribute('data-type') || 'All';
                var typeLabel = btn.getAttribute('data-type-label') || type;
                var template = btn.getAttribute('data-template') || '';
                var sla = btn.getAttribute('data-sla') || '1.0';
                var assignee = btn.getAttribute('data-assignee') || '';

                var typeHidden = document.getElementById('wfCustType');
                if (typeHidden) typeHidden.value = type;
                var typeLabelEl = document.getElementById('wfCustTypeLabel');
                if (typeLabelEl) typeLabelEl.value = typeLabel;
                if (slaInput) slaInput.value = sla;
                var assigneeSel = document.getElementById('wfCustAssignee');
                if (assigneeSel) assigneeSel.value = assignee;

                setCheck('wfCustVal', btn.getAttribute('data-valclient') === 'true');
                setCheck('wfCustDocs', btn.getAttribute('data-docs') === 'true');
                setCheck('wfCustAuto', btn.getAttribute('data-auto') === 'true');
                setCheck('wfCustActive', btn.getAttribute('data-active') === 'true');

                var picks = filterTplList(type);
                // Prefer existing client copy id if present; else matching cabinet source
                var sourceId = template || picks.firstMatch || picks.firstAll || '';
                // If template is already a client copy, still pass as source — Ensure returns it as-is
                panel.style.display = '';
                ensureAndLoad(sourceId);
                panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function closePanel() {
                if (panel) panel.style.display = 'none';
            }

            document.querySelectorAll('.btn-wf-customize').forEach(function (btn) {
                btn.addEventListener('click', function () { openPanel(btn); });
            });

            document.querySelectorAll('#wfCustTplList .wf-cust-tpl').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    currentDeclType = document.getElementById('wfCustType')?.value || btn.getAttribute('data-type') || 'All';
                    ensureAndLoad(btn.getAttribute('data-id'));
                });
            });

            var addBtn = document.getElementById('wfCustAddStep');
            if (addBtn) {
                addBtn.addEventListener('click', function () {
                    var i = stepsEl.querySelectorAll('.step-card').length;
                    var wrap = document.createElement('div');
                    wrap.innerHTML = buildStepCard({ name: 'Nouvelle étape', stepType: 'Saisie', assignmentType: 'Employee', slaHours: 24, isRequired: true, isBlocking: true }, i);
                    var card = wrap.firstElementChild;
                    stepsEl.appendChild(card);
                    bindStepCardEvents();
                    reindexSteps();
                    card.classList.remove('collapsed-step');
                    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                });
            }

            if (closeBtn) closeBtn.addEventListener('click', closePanel);
            if (closeBtn2) closeBtn2.addEventListener('click', closePanel);

            var custForm = document.getElementById('wfCustomizeForm');
            if (custForm) {
                custForm.addEventListener('submit', function (e) {
                    stepsEl.querySelectorAll('.step-card').forEach(syncRelanceDaysToHours);
                    if (!window.WfCron) return;
                    var err = WfCron.validateInitSteps(stepsEl);
                    if (err) {
                        e.preventDefault();
                        alert(err);
                    }
                });
            }

            var affectForm = document.getElementById('clientWfAffectForm');
            var title = document.getElementById('wfAffectFormTitle');
            var resetBtn = document.getElementById('wfAffectReset');
            if (resetBtn && affectForm) {
                resetBtn.addEventListener('click', function () {
                    affectForm.reset();
                    setCheck('wfValClient', true);
                    setCheck('wfDocs', true);
                    setCheck('wfAuto', true);
                    setCheck('wfActive', true);
                    if (window._wfRefreshTemplates) window._wfRefreshTemplates();
                    if (title) title.innerHTML = '<i class="bi bi-plus-circle text-success me-1"></i>Affecter / personnaliser un template';
                    resetBtn.style.display = 'none';
                });
            }
        })();

    </script>
    @Html.AntiForgeryToken()
}
