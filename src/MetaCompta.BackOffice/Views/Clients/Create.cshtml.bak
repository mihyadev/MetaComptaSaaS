@model ClientCreateDto
@{
    ViewData["Title"] = "Nouveau Client";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a href="/Clients">Clients</a></li>
                <li class="breadcrumb-item active">Nouveau Client</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle text-primary me-2"></i>Créer un Nouveau Client</h4>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Retour
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger rounded-3 mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @Html.ValidationSummary(true)
    </div>
}

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0 pt-3 px-4">
            <ul class="nav nav-pills" id="clientTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#identity" type="button">
                        <i class="bi bi-building me-1"></i> Identité
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#contact" type="button">
                        <i class="bi bi-person me-1"></i> Contact
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#fiscal" type="button">
                        <i class="bi bi-calculator me-1"></i> Fiscal
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-3" data-bs-toggle="pill" data-bs-target="#service" type="button">
                        <i class="bi bi-briefcase me-1"></i> Service
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body px-4">
            <div class="tab-content">
                <!-- Identity Tab -->
                <div class="tab-pane fade show active" id="identity">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Raison Sociale <span class="text-danger">*</span></label>
                            <input type="text" name="RaisonSociale" class="form-control" value="@Model?.RaisonSociale" required placeholder="Ex: ABC Consulting SARL" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Forme Juridique <span class="text-danger">*</span></label>
                            <select name="FormeJuridique" class="form-select" required>
                                <option value="">— Sélectionner —</option>
                                @{ var fj = Model?.FormeJuridique; }
                                <option value="SARL" selected="@(fj == "SARL")">SARL</option>
                                <option value="SA" selected="@(fj == "SA")">SA</option>
                                <option value="SNC" selected="@(fj == "SNC")">SNC</option>
                                <option value="SCS" selected="@(fj == "SCS")">SCS</option>
                                <option value="SCA" selected="@(fj == "SCA")">SCA</option>
                                <option value="Auto-Entrepreneur" selected="@(fj == "Auto-Entrepreneur")">Auto-Entrepreneur</option>
                                <option value="Personne Physique" selected="@(fj == "Personne Physique")">Personne Physique</option>
                                <option value="Association" selected="@(fj == "Association")">Association</option>
                                <option value="Coopérative" selected="@(fj == "Coopérative")">Coopérative</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">ICE <span class="text-danger">*</span></label>
                            <input type="text" name="ICE" class="form-control" value="@Model?.ICE" required placeholder="15 chiffres" maxlength="15" />
                            <small class="text-muted">Identifiant Commun de l'Entreprise</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">IF <span class="text-danger">*</span></label>
                            <input type="text" name="IF" class="form-control" value="@Model?.IF" required placeholder="Identifiant Fiscal" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">RC</label>
                            <input type="text" name="RC" class="form-control" value="@Model?.RC" placeholder="Registre du Commerce" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">CNSS</label>
                            <input type="text" name="CNSS" class="form-control" value="@Model?.CNSS" placeholder="Numéro CNSS" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Capital (MAD)</label>
                            <input type="number" step="0.01" name="Capital" class="form-control" value="@Model?.Capital" placeholder="0.00" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Date de Création</label>
                            <input type="date" name="DateCreation" class="form-control" value="@Model?.DateCreation?.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>

                <!-- Contact Tab -->
                <div class="tab-pane fade" id="contact">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Responsable / Gérant</label>
                            <input type="text" name="Responsable" class="form-control" value="@Model?.Responsable" placeholder="Nom complet du gérant" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Email</label>
                            <input type="email" name="Email" class="form-control" value="@Model?.Email" placeholder="contact@societe.ma" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Téléphone</label>
                            <input type="tel" name="Telephone" class="form-control" value="@Model?.Telephone" placeholder="+212 6XX-XXXXXX" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Fax</label>
                            <input type="tel" name="Fax" class="form-control" value="@Model?.Fax" placeholder="+212 5XX-XXXXXX" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Adresse</label>
                            <textarea name="Adresse" class="form-control" rows="2" placeholder="Adresse complète">@Model?.Adresse</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Ville</label>
                            <select name="Ville" class="form-select">
                                <option value="">— Sélectionner —</option>
                                @foreach (var v in new[] { "Casablanca", "Rabat", "Marrakech", "Fès", "Tanger", "Agadir", "Meknès", "Oujda", "Kénitra", "Tétouan", "Salé", "Nador", "Mohammédia", "El Jadida", "Béni Mellal", "Khouribga", "Settat", "Safi", "Laâyoune", "Dakhla" })
                                {
                                    <option value="@v" @(Model?.Ville == v ? "selected" : "")>@v</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Code Postal</label>
                            <input type="text" name="CodePostal" class="form-control" value="@Model?.CodePostal" placeholder="Ex: 20000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Site Web</label>
                            <input type="url" name="SiteWeb" class="form-control" value="@Model?.SiteWeb" placeholder="https://www.societe.ma" />
                        </div>
                    </div>
                </div>

                <!-- Fiscal Tab -->
                <div class="tab-pane fade" id="fiscal">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Régime TVA</label>
                            <select name="RegimeTVA" class="form-select">
                                <option value="">— Sélectionner —</option>
                                <option value="Mensuel" @(Model?.RegimeTVA == "Mensuel" ? "selected" : "")>Mensuel (Débit)</option>
                                <option value="Trimestriel" @(Model?.RegimeTVA == "Trimestriel" ? "selected" : "")>Trimestriel (Encaissement)</option>
                                <option value="Exonéré" @(Model?.RegimeTVA == "Exonéré" ? "selected" : "")>Exonéré</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Régime IS</label>
                            <select name="RegimeIS" class="form-select">
                                <option value="">— Sélectionner —</option>
                                <option value="Normal" @(Model?.RegimeIS == "Normal" ? "selected" : "")>Normal</option>
                                <option value="Simplifié" @(Model?.RegimeIS == "Simplifié" ? "selected" : "")>Simplifié</option>
                                <option value="Forfaitaire" @(Model?.RegimeIS == "Forfaitaire" ? "selected" : "")>Forfaitaire</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Taxe Professionnelle</label>
                            <input type="text" name="TaxeProfessionnelle" class="form-control" value="@Model?.TaxeProfessionnelle" placeholder="N° TP" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Début Exercice Comptable</label>
                            <input type="date" name="ExerciceComptableDebut" class="form-control" value="@(Model?.ExerciceComptableDebut?.ToString("yyyy-MM-dd") ?? DateTime.Now.Year + "-01-01")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Fin Exercice Comptable</label>
                            <input type="date" name="ExerciceComptableFin" class="form-control" value="@(Model?.ExerciceComptableFin?.ToString("yyyy-MM-dd") ?? DateTime.Now.Year + "-12-31")" />
                        </div>
                    </div>
                </div>

                <!-- Service Tab -->
                <div class="tab-pane fade" id="service">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Date Début Contrat</label>
                            <input type="date" name="DateDebutContrat" class="form-control" value="@Model?.DateDebutContrat?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Honoraires Mensuels (MAD)</label>
                            <input type="number" step="0.01" name="HonorairesMensuels" class="form-control" value="@Model?.HonorairesMensuels" placeholder="0.00" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Services Souscrits</label>
                            <div class="row g-2">
                                @foreach (var s in new[] { "Comptabilité", "Fiscalité (TVA, IS, IR)", "Social (CNSS, AMO)", "Paie", "Juridique", "Conseil", "Audit" })
                                {
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="svc_@s.Replace(" ", "")" name="ServicesList" value="@s"
                                                   @(Model?.ServicesSouscrits?.Contains(s) == true ? "checked" : "") />
                                            <label class="form-check-label" for="svc_@s.Replace(" ", "")">@s</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Notes</label>
                            <textarea name="Notes" class="form-control" rows="3" placeholder="Notes internes sur le dossier client...">@Model?.Notes</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit Footer -->
        <div class="card-footer bg-transparent border-0 px-4 py-3 d-flex justify-content-between">
            <div>
                <button type="button" class="btn btn-outline-secondary me-2" id="prevTab" style="display:none;">
                    <i class="bi bi-arrow-left me-1"></i> Précédent
                </button>
                <button type="button" class="btn btn-primary" id="nextTab">
                    Suivant <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
            <button type="submit" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-check-lg me-1"></i> Enregistrer le Client
            </button>
        </div>
    </div>
</form>

@section Scripts {
<script>
$(function() {
    var tabs = ['#identity', '#contact', '#fiscal', '#service'];
    var currentTab = 0;
    var tabButtons = $('#clientTabs .nav-link');

    function updateNav() {
        $('#prevTab').toggle(currentTab > 0);
        $('#nextTab').toggle(currentTab < tabs.length - 1);
    }
    updateNav();

    $('#nextTab').click(function() {
        if (currentTab < tabs.length - 1) { currentTab++; tabButtons.eq(currentTab).tab('show'); updateNav(); }
    });
    $('#prevTab').click(function() {
        if (currentTab > 0) { currentTab--; tabButtons.eq(currentTab).tab('show'); updateNav(); }
    });
    tabButtons.on('shown.bs.tab', function(e) {
        currentTab = tabButtons.index(e.target);
        updateNav();
    });
});
</script>
}
