@using MetaCompta.Application.DTOs
@model ClientCreateDto
@{
    ViewData["Title"] = "Modifier client";
    var clientId = ViewBag.ClientId as int? ?? 0;
    ViewBag.IsEdit = true;
}

<div class="client-form-page">
    <div class="page-header mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Modifier le client</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Clients")">Clients</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Details", "Clients", new { id = clientId })">Détail</a></li>
                    <li class="breadcrumb-item active">Modifier</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Details", "Clients", new { id = clientId })" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Corrigez les points suivants :</strong>
            <div class="mt-2">@Html.ValidationSummary(false, "", new { @class = "mb-0 text-danger" })</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@clientId" method="post" id="formEditClient" novalidate>
        @Html.AntiForgeryToken()
        <partial name="_ClientFormBody" model="Model" />
    </form>
</div>
