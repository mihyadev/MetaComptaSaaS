@model ClientCreateDto
@{
    ViewData["Title"] = "Nouveau Client";
}

<div class="page-header mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-plus-circle text-primary me-2"></i>Créer un Nouveau Client</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Clients")">Clients</a></li>
                <li class="breadcrumb-item active">Nouveau client</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Index", "Clients")" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Erreur de validation :</strong>
        @Html.ValidationSummary(true)
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mc-card mb-4" id="bnifImportCard">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Création depuis BNIF DGI</h5>
                <p class="text-muted mb-0 small">
                    Importez le <strong>Bulletin de Notification du N° d'Identification Fiscale</strong>
                    (PDF officiel tax.gov.ma / SIMPL). Les champs du formulaire seront préremplis — vous validez ensuite.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <label class="btn btn-outline-danger rounded-pill px-3 mb-0" for="bnifFileInput">
                    <i class="bi bi-upload me-1"></i> Charger un BNIF PDF
                </label>
                <input type="file" id="bnifFileInput" accept="application/pdf,.pdf" class="d-none" />
                <button type="button" class="btn btn-link text-muted text-decoration-none small" id="bnifSkipBtn">
                    Ou remplir le formulaire manuellement
                </button>
            </div>
        </div>
        <div id="bnifStatus" class="mt-3" style="display:none;"></div>
    </div>
</div>

<form method="post" asp-action="Create" id="formCreateClient" novalidate>
    @Html.AntiForgeryToken()

    <div id="wizardStepAlert" class="alert alert-danger rounded-3 mb-3" role="alert"></div>
    <!-- Wizard Progress Bar -->
    <div class="mc-card mb-4">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center" id="wizardProgress">
                <div class="wizard-step active" data-step="0">
                    <div class="wizard-step-circle"><i class="bi bi-building"></i></div>
                    <span class="wizard-step-label">Identité</span>
                </div>
                <div class="wizard-connector"></div>
                <div class="wizard-step" data-step="1">
                    <div class="wizard-step-circle"><i class="bi bi-person-lines-fill"></i></div>
                    <span class="wizard-step-label">Contact</span>
                </div>
                <div class="wizard-connector"></div>
                <div class="wizard-step" data-step="2">
                    <div class="wizard-step-circle"><i class="bi bi-calculator"></i></div>
                    <span class="wizard-step-label">Fiscal</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 1: Identity -->
    <div class="mc-card step-panel" id="step0">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 px-4 pt-4 pb-0">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-building"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Identité de l'Entreprise</h5>
                <small class="text-muted">Informations légales et administratives du client</small>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Raison Sociale <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-building text-muted"></i></span>
                        <input type="text" name="RaisonSociale" id="RaisonSociale" class="form-control border-start-0" value="@Model?.RaisonSociale"
                            required placeholder="Ex: ABC Consulting SARL" />
                    </div>
                    <div class="invalid-feedback d-block field-error" data-for="RaisonSociale"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Forme Juridique</label>
                    <select name="FormeJuridique" class="form-select">
                        <option value="">— Sélectionner —</option>
                        <option value="SARL">SARL</option>
                        <option value="SA">SA</option>
                        <option value="SNC">SNC</option>
                        <option value="SCS">SCS</option>
                        <option value="SCA">SCA</option>
                        <option value="Auto-Entrepreneur">Auto-Entrepreneur</option>
                        <option value="Personne Physique">Personne Physique</option>
                        <option value="Association">Association</option>
                        <option value="Coopérative">Coopérative</option>
                    </select>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">ICE <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-fingerprint text-muted"></i></span>
                        <input type="text" name="ICE" id="ICE" class="form-control border-start-0" value="@Model?.ICE" required
                            placeholder="15 chiffres" maxlength="15" inputmode="numeric" />
                    </div>
                    <div class="form-text">Identifiant Commun de l'Entreprise (15 chiffres)</div>
                    <div class="invalid-feedback d-block field-error" data-for="ICE"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">IF <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-hash text-muted"></i></span>
                        <input type="text" name="IF" id="IF" class="form-control border-start-0" value="@Model?.IF" required
                            placeholder="Identifiant Fiscal" />
                    </div>
                    <div class="invalid-feedback d-block field-error" data-for="IF"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">RC</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-journal-text text-muted"></i></span>
                        <input type="text" name="RC" class="form-control border-start-0" value="@Model?.RC"
                            placeholder="Registre du Commerce" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">N° CNSS</label>
                    <input type="text" name="NumeroCNSS" class="form-control" value="@Model?.NumeroCNSS"
                        placeholder="Numéro CNSS" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">N° Patente</label>
                    <input type="text" name="NumeroPatente" class="form-control" value="@Model?.NumeroPatente"
                        placeholder="Numéro Patente" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Capital Social (MAD)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="CapitalSocial" class="form-control"
                            value="@Model?.CapitalSocial" placeholder="0.00" />
                        <span class="input-group-text bg-light">MAD</span>
                    </div>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Secteur d'Activité</label>
                    <input type="text" name="SecteurActivite" class="form-control" value="@Model?.SecteurActivite"
                        placeholder="Ex: Technologies, Commerce..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Code Activité</label>
                    <input type="text" name="CodeActivite" class="form-control" value="@Model?.CodeActivite"
                        placeholder="Code activité" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Date Création</label>
                    <input type="date" name="DateCreation" class="form-control"
                        value="@(Model?.DateCreation?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Contact -->
    <div class="mc-card step-panel" id="step1" style="display:none;">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 px-4 pt-4 pb-0">
            <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-person-lines-fill"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Coordonnées &amp; Contact</h5>
                <small class="text-muted">Adresse, téléphone, email et personne de contact</small>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label fw-semibold">Adresse Siège Social</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                        <textarea name="AdresseSiegeSocial" class="form-control border-start-0" rows="2"
                            placeholder="Adresse complète du siège social">@Model?.AdresseSiegeSocial</textarea>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Ville</label>
                    <select name="VilleSiegeSocial" class="form-select">
                        <option value="">— Sélectionner —</option>
                        <option value="Casablanca">Casablanca</option>
                        <option value="Rabat">Rabat</option>
                        <option value="Marrakech">Marrakech</option>
                        <option value="Fès">Fès</option>
                        <option value="Tanger">Tanger</option>
                        <option value="Agadir">Agadir</option>
                        <option value="Meknès">Meknès</option>
                        <option value="Oujda">Oujda</option>
                        <option value="Kénitra">Kénitra</option>
                        <option value="Tétouan">Tétouan</option>
                        <option value="Salé">Salé</option>
                        <option value="Nador">Nador</option>
                        <option value="Mohammédia">Mohammédia</option>
                        <option value="El Jadida">El Jadida</option>
                        <option value="Béni Mellal">Béni Mellal</option>
                        <option value="Khouribga">Khouribga</option>
                        <option value="Settat">Settat</option>
                        <option value="Safi">Safi</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Téléphone Principal</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                        <input type="tel" name="TelephonePrincipal" class="form-control border-start-0"
                            value="@Model?.TelephonePrincipal" placeholder="+212 5XX-XXXXXX" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Email Principal</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" name="EmailPrincipal" id="EmailPrincipal" class="form-control border-start-0"
                            value="@Model?.EmailPrincipal" placeholder="contact@societe.ma" />
                    </div>
                    <div class="invalid-feedback d-block field-error" data-for="EmailPrincipal"></div>
                </div>

                <div class="col-12">
                    <div class="d-flex align-items-center gap-2 mt-2 mb-1">
                        <i class="bi bi-person-badge text-primary"></i>
                        <span class="fw-semibold">Personne de Contact</span>
                        <hr class="flex-grow-1 opacity-25 my-0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Nom</label>
                    <input type="text" name="ContactNom" class="form-control" value="@Model?.ContactNom"
                        placeholder="Nom complet" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Fonction</label>
                    <input type="text" name="ContactFonction" class="form-control" value="@Model?.ContactFonction"
                        placeholder="Ex: Gérant" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Téléphone</label>
                    <input type="tel" name="ContactTelephone" class="form-control" value="@Model?.ContactTelephone"
                        placeholder="+212 6XX-XXXXXX" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" name="ContactEmail" id="ContactEmail" class="form-control" value="@Model?.ContactEmail"
                        placeholder="gerant@societe.ma" />
                    <div class="invalid-feedback d-block field-error" data-for="ContactEmail"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3: Fiscal — also includes contract info & notes -->
    <div class="mc-card step-panel" id="step2" style="display:none;">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 px-4 pt-4 pb-0">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-calculator"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Informations Fiscales</h5>
                <small class="text-muted">Régime TVA et exercice comptable</small>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Régime TVA</label>
                    <div class="d-flex gap-2 flex-wrap">
                        <input class="btn-check" type="radio" name="TypeTVA" id="tva_Mensuelle" value="@RefCodes.Frequence.Mensuelle" checked />
                        <label class="btn btn-outline-primary rounded-pill px-3" for="tva_Mensuelle">Mensuelle</label>
                        <input class="btn-check" type="radio" name="TypeTVA" id="tva_Trimestrielle" value="Trimestrielle" />
                        <label class="btn btn-outline-primary rounded-pill px-3" for="tva_Trimestrielle">Trimestrielle</label>
                        <input class="btn-check" type="radio" name="TypeTVA" id="tva_Exonere" value="Exonéré" />
                        <label class="btn btn-outline-primary rounded-pill px-3" for="tva_Exonere">Exonéré</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Mois de Clôture de l'Exercice</label>
                    <select name="MoisClotureExercice" class="form-select">
                        <option value="1">Janvier</option>
                        <option value="2">Février</option>
                        <option value="3">Mars</option>
                        <option value="4">Avril</option>
                        <option value="5">Mai</option>
                        <option value="6">Juin</option>
                        <option value="7">Juillet</option>
                        <option value="8">Août</option>
                        <option value="9">Septembre</option>
                        <option value="10">Octobre</option>
                        <option value="11">Novembre</option>
                        <option value="12" selected>Décembre</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Date Début Activité</label>
                    <input type="date" name="DateDebutActivite" class="form-control"
                        value="@(Model?.DateDebutActivite?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Date Début Contrat</label>
                    <input type="date" name="DateDebutContrat" class="form-control"
                        value="@(Model?.DateDebutContrat?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-01-01"))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Manager Principal <span class="text-muted fw-normal">(optionnel)</span></label>
                    <input type="text" name="ManagerPrincipalId" id="ManagerPrincipalId" class="form-control"
                        value="@Model?.ManagerPrincipalId" placeholder="Laisser vide si non assigné"
                        autocomplete="off" />
                    <div class="form-text">Identifiant utilisateur du cabinet uniquement. En cas de doute, laissez vide.</div>
                    <div class="invalid-feedback d-block field-error" data-for="ManagerPrincipalId"></div>
                </div>
            </div>

            <hr class="opacity-25 my-4" />

            <!-- Services info banner — Contract-driven architecture -->
            <div class="alert alert-info border-0 rounded-3 d-flex align-items-start gap-3 mb-4" style="background: linear-gradient(135deg, rgba(37,99,235,0.06), rgba(124,58,237,0.06));">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary flex-shrink-0" style="width:44px;height:44px;">
                    <i class="bi bi-briefcase"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-primary"><i class="bi bi-shield-check me-1"></i>Services Fiduciaires — Gestion par Contrat</h6>
                    <p class="mb-1" style="font-size:0.88rem;">
                        Les services fiduciaires (TVA, IS, IR, CNSS, Paie, Comptabilité…) sont <strong>activés automatiquement</strong>
                        lors de la <strong>validation d'un Contrat Commercial</strong>.
                    </p>
                    <p class="mb-0 text-muted" style="font-size:0.82rem;">
                        <i class="bi bi-arrow-right me-1"></i>
                        Après création du client, rendez-vous dans
                        <strong>Commercial → Contrats</strong> pour créer et valider un contrat.
                        Les services, fréquences et délais seront automatiquement configurés selon le calendrier fiscal marocain.
                    </p>
                </div>
            </div>

            <!-- Notes -->
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Notes Internes</label>
                    <textarea name="NotesInternes" class="form-control" rows="3"
                        placeholder="Informations confidentielles, observations, particularités du dossier...">@Model?.NotesInternes</textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="prevBtn" style="display:none;">
            <i class="bi bi-arrow-left me-1"></i> Précédent
        </button>
        <div class="ms-auto d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-4" id="nextBtn">
                Suivant <i class="bi bi-arrow-right ms-1"></i>
            </button>
            <button type="submit" class="btn btn-success rounded-pill px-4" id="submitBtn" style="display:none;">
                <i class="bi bi-check-lg me-1"></i> Enregistrer le Client
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <style>
        .wizard-step { text-align: center; flex: 0 0 auto; cursor: pointer; }
        .wizard-step-circle {
            width: 44px; height: 44px; border-radius: 50%;
            background: var(--monday-bg); color: var(--monday-muted);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 6px; font-size: 1.1rem;
            transition: all 0.3s ease; border: 2px solid var(--monday-border);
        }
        .wizard-step.active .wizard-step-circle {
            background: var(--monday-blue); color: #fff; border-color: var(--monday-blue);
        }
        .wizard-step.completed .wizard-step-circle { background: var(--monday-green); color: #fff; border-color: var(--monday-green); }
        .wizard-step.has-error .wizard-step-circle { background: #fce8eb; color: var(--monday-red); border-color: var(--monday-red); }
        .wizard-step-label { font-size: 0.75rem; color: var(--monday-muted); font-weight: 600; }
        .wizard-step.active .wizard-step-label { color: var(--monday-blue); }
        .wizard-step.completed .wizard-step-label { color: var(--monday-green); }
        .wizard-connector {
            flex: 1; height: 2px; background: var(--monday-border);
            margin: 0 8px; margin-bottom: 22px; transition: background 0.3s ease;
        }
        .wizard-connector.active { background: var(--monday-blue); }
        .step-panel { transition: opacity 0.3s ease; }
        .field-error:empty { display: none !important; }
        .is-invalid-field { border-color: var(--monday-red) !important; }
        #wizardStepAlert { display: none; }
    </style>
    <script>
        $(function () {
            var currentStep = 0;
            var totalSteps = 3;

            function clearFieldErrors() {
                $('.field-error').text('');
                $('.is-invalid-field').removeClass('is-invalid-field');
                $('#wizardStepAlert').hide().text('');
            }

            function setError(name, message) {
                var $input = $('[name="' + name + '"]');
                $input.addClass('is-invalid-field');
                $('.field-error[data-for="' + name + '"]').text(message);
            }

            function isEmail(v) {
                return !v || /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v);
            }

            function validateStep(step) {
                clearFieldErrors();
                var ok = true;
                var firstMsg = '';

                function fail(name, msg) {
                    ok = false;
                    if (!firstMsg) firstMsg = msg;
                    setError(name, msg);
                }

                if (step === 0) {
                    var rs = ($('#RaisonSociale').val() || '').trim();
                    var ice = ($('#ICE').val() || '').trim();
                    var iff = ($('#IF').val() || '').trim();
                    if (!rs) fail('RaisonSociale', 'La raison sociale est obligatoire.');
                    if (!ice) fail('ICE', "L'ICE est obligatoire.");
                    else if (!/^\d{15}$/.test(ice)) fail('ICE', "L'ICE doit contenir exactement 15 chiffres.");
                    if (!iff) fail('IF', "L'identifiant fiscal (IF) est obligatoire.");
                }
                else if (step === 1) {
                    var email = ($('#EmailPrincipal').val() || '').trim();
                    var cemail = ($('#ContactEmail').val() || '').trim();
                    if (email && !isEmail(email)) fail('EmailPrincipal', "L'email principal n'est pas valide.");
                    if (cemail && !isEmail(cemail)) fail('ContactEmail', "L'email du contact n'est pas valide.");
                }
                else if (step === 2) {
                    var mois = parseInt($('[name="MoisClotureExercice"]').val(), 10);
                    if (!(mois >= 1 && mois <= 12)) {
                        fail('MoisClotureExercice', 'Le mois de clôture doit être entre 1 et 12.');
                    }
                    // Manager: empty is OK; non-empty free text is allowed but user is warned via placeholder.
                    // Backend will reject invalid IDs with a clear French message.
                }

                if (!ok) {
                    $('#wizardStepAlert')
                        .text(firstMsg || 'Corrigez les erreurs de cette section avant de continuer.')
                        .show();
                    $('.wizard-step[data-step="' + step + '"]').addClass('has-error');
                } else {
                    $('.wizard-step[data-step="' + step + '"]').removeClass('has-error');
                }
                return ok;
            }

            function showStep(step) {
                $('.step-panel').hide();
                $('#step' + step).fadeIn(200);
                currentStep = step;

                $('.wizard-step').each(function () {
                    var s = parseInt($(this).data('step'));
                    $(this).removeClass('active completed');
                    if (s === step) $(this).addClass('active');
                    else if (s < step) $(this).addClass('completed');
                });
                $('.wizard-connector').each(function (i) {
                    $(this).toggleClass('active', i < step);
                });

                $('#prevBtn').toggle(step > 0);
                $('#nextBtn').toggle(step < totalSteps - 1);
                $('#submitBtn').toggle(step === totalSteps - 1);
            }

            $('#nextBtn').click(function () {
                if (!validateStep(currentStep)) return;
                if (currentStep < totalSteps - 1) showStep(currentStep + 1);
            });
            $('#prevBtn').click(function () {
                if (currentStep > 0) showStep(currentStep - 1);
            });
            $('.wizard-step').click(function () {
                var target = parseInt($(this).data('step'));
                if (target > currentStep && !validateStep(currentStep)) return;
                // When jumping forward multiple steps, validate each intermediate
                if (target > currentStep) {
                    for (var s = currentStep; s < target; s++) {
                        if (!validateStep(s)) { showStep(s); return; }
                    }
                }
                showStep(target);
            });

            $('#formCreateClient').on('submit', function (e) {
                for (var s = 0; s < totalSteps; s++) {
                    if (!validateStep(s)) {
                        e.preventDefault();
                        showStep(s);
                        return false;
                    }
                }
                // Normalize empty manager to avoid FK ""
                var $mgr = $('#ManagerPrincipalId');
                if ($mgr.length && !($mgr.val() || '').trim()) $mgr.val('');
            });

            function setSelectOrInput(name, value) {
                if (value == null || value === '') return;
                var $el = $('[name="' + name + '"]');
                if (!$el.length) return;
                if ($el.is('select')) {
                    var matched = false;
                    $el.find('option').each(function () {
                        if (($(this).val() || '').toLowerCase() === String(value).toLowerCase()
                            || ($(this).text() || '').toLowerCase() === String(value).toLowerCase()) {
                            $el.val($(this).val());
                            matched = true;
                            return false;
                        }
                    });
                    if (!matched) {
                        // try contains
                        $el.find('option').each(function () {
                            var v = ($(this).val() || '').toLowerCase();
                            if (v && String(value).toLowerCase().indexOf(v) >= 0) {
                                $el.val($(this).val());
                                return false;
                            }
                        });
                    }
                } else {
                    $el.val(value);
                }
            }

            function applyBnifData(data) {
                if (!data) return;
                setSelectOrInput('RaisonSociale', data.raisonSociale || data.RaisonSociale);
                setSelectOrInput('ICE', data.ice || data.ICE);
                setSelectOrInput('IF', data.iF || data.IF || data.if);
                setSelectOrInput('RC', data.rc || data.RC);
                setSelectOrInput('NumeroPatente', data.numeroPatente || data.NumeroPatente);
                setSelectOrInput('FormeJuridique', data.formeJuridique || data.FormeJuridique);
                setSelectOrInput('SecteurActivite', data.secteurActivite || data.SecteurActivite);
                setSelectOrInput('AdresseSiegeSocial', data.adresseSiegeSocial || data.AdresseSiegeSocial);
                setSelectOrInput('VilleSiegeSocial', data.villeSiegeSocial || data.VilleSiegeSocial);
                var dc = data.dateCreation || data.DateCreation;
                if (dc) {
                    var d = new Date(dc);
                    if (!isNaN(d.getTime())) {
                        var iso = d.toISOString().slice(0, 10);
                        $('[name="DateCreation"]').val(iso);
                    }
                }
                showStep(0);
            }

            $('#bnifSkipBtn').on('click', function () {
                $('#bnifStatus').hide();
                $('html, body').animate({ scrollTop: $('#formCreateClient').offset().top - 80 }, 300);
            });

            $('#bnifFileInput').on('change', function () {
                var file = this.files && this.files[0];
                if (!file) return;
                var $status = $('#bnifStatus');
                $status.show().html('<div class="alert alert-info mb-0 py-2"><i class="bi bi-hourglass-split me-1"></i>Lecture du BNIF…</div>');

                var fd = new FormData();
                fd.append('file', file);
                var token = $('#formCreateClient input[name="__RequestVerificationToken"]').val();
                fd.append('__RequestVerificationToken', token);

                $.ajax({
                    url: '@Url.Action("ParseBnif", "Clients")',
                    method: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false
                }).done(function (res) {
                    if (!res || !res.success) {
                        var msg = (res && res.message) ? res.message : 'Import BNIF échoué.';
                        $status.html('<div class="alert alert-warning mb-0 py-2"><i class="bi bi-exclamation-triangle me-1"></i>' + msg + '</div>');
                        return;
                    }
                    applyBnifData(res.data);
                    var warn = (res.warnings || []).join(' ');
                    $status.html(
                        '<div class="alert alert-success mb-0 py-2">' +
                        '<i class="bi bi-check-circle me-1"></i>' + (res.message || 'BNIF importé.') +
                        (warn ? '<div class="small mt-1 text-muted">' + warn + '</div>' : '') +
                        '<div class="small mt-1">Vérifiez Identité → Contact → Fiscal, puis Enregistrer.</div></div>'
                    );
                    $('html, body').animate({ scrollTop: $('#formCreateClient').offset().top - 80 }, 300);
                }).fail(function () {
                    $status.html('<div class="alert alert-danger mb-0 py-2"><i class="bi bi-x-circle me-1"></i>Erreur serveur lors de la lecture du BNIF.</div>');
                }).always(function () {
                    $('#bnifFileInput').val('');
                });
            });

            // If server returned validation errors, jump to the section that owns them
            @{
                var serverInvalid = !ViewData.ModelState.IsValid;
                var serverKeysCsv = serverInvalid
                    ? string.Join(",", ViewData.ModelState.Where(kv => kv.Value?.Errors.Count > 0).Select(kv => kv.Key))
                    : "";
                var jumpStep = 0;
                if (serverInvalid)
                {
                    var sk = serverKeysCsv.Split(',', StringSplitOptions.RemoveEmptyEntries);
                    if (sk.Any(k => k is "EmailPrincipal" or "ContactEmail" or "AdresseSiegeSocial" or "VilleSiegeSocial" or "TelephonePrincipal" or "ContactNom" or "ContactFonction" or "ContactTelephone"))
                        jumpStep = 1;
                    if (sk.Any(k => k is "TypeTVA" or "MoisClotureExercice" or "DateDebutContrat" or "ManagerPrincipalId" or "NotesInternes")
                        && !sk.Any(k => k is "RaisonSociale" or "ICE" or "IF" or "RC" or "NumeroCNSS"))
                        jumpStep = 2;
                    if (sk.Any(k => k is "RaisonSociale" or "ICE" or "IF" or "RC" or "NumeroCNSS" or "NumeroPatente"))
                        jumpStep = 0;
                }
            }
            @if (serverInvalid)
            {
                <text>
                showStep(@jumpStep);
                $('#wizardStepAlert').text('Corrigez les erreurs affichées puis réessayez.').show();
                </text>
                foreach (var entry in ViewData.ModelState.Where(kv => !string.IsNullOrEmpty(kv.Key) && kv.Value?.Errors.Count > 0))
                {
                    var msg = entry.Value!.Errors[0].ErrorMessage?.Replace("\\", "\\\\").Replace("'", "\\'") ?? "";
                    <text>setError('@entry.Key', '@Html.Raw(msg)');</text>
                }
            }
            else
            {
                <text>showStep(0);</text>
            }
        });
    </script>
}
