@model IEnumerable<MetaCompta.Application.DTOs.GrandLivreDto>
@{
    ViewData["Title"] = "Grand livre";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
    var list = Model?.ToList() ?? new();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-warning text-dark rounded-3 p-3 lh-1"><i class="bi bi-book fs-4"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-0">Grand livre</h1>
            <div class="text-body-secondary small">Mouvements validés · @list.Count compte(s)</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("Balance")" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-upload me-1"></i> Importer soldes d'ouverture
        </a>
        <a href="@Url.Action("DownloadTemplateSoldesOuverture")" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-file-earmark-text me-1"></i> Modèle CSV
        </a>
        <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-printer me-1"></i> Imprimer</button>
    </div>
</div>

@if (client != null)
{
    <div class="alert border-0 shadow-sm rounded-4 bg-warning-subtle text-warning-emphasis mb-3 py-2 px-3">
        <i class="bi bi-building me-1"></i>@client.RaisonSociale
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small text-muted">Du</label><input type="date" name="dateDebut" class="form-control rounded-3" value="@(ViewBag.DateDebut is DateTime dd ? dd.ToString("yyyy-MM-dd") : "")" /></div>
            <div class="col-md-3"><label class="form-label small text-muted">Au</label><input type="date" name="dateFin" class="form-control rounded-3" value="@(ViewBag.DateFin is DateTime df ? df.ToString("yyyy-MM-dd") : "")" /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100 rounded-pill">Filtrer</button></div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 border-start border-4 border-warning">
    <div class="table-responsive">
        <table class="table mc-table mb-0">
            <thead><tr><th>Compte</th><th>Libellé</th><th class="text-end">Débit</th><th class="text-end">Crédit</th><th class="text-end">Solde D</th><th class="text-end">Solde C</th></tr></thead>
            <tbody>
            @if (list.Any())
            {
                foreach (var g in list)
                {
                    <tr>
                        <td><code>@g.NumeroCompte</code></td>
                        <td>@g.LibelleCompte</td>
                        <td class="text-end">@g.TotalDebit.ToString("N2")</td>
                        <td class="text-end">@g.TotalCredit.ToString("N2")</td>
                        <td class="text-end">@(g.SoldeDebiteur > 0 ? g.SoldeDebiteur.ToString("N2") : "")</td>
                        <td class="text-end">@(g.SoldeCrediteur > 0 ? g.SoldeCrediteur.ToString("N2") : "")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Aucun mouvement validé sur la période.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
