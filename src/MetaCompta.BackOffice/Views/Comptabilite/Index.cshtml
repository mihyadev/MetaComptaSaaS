@model MetaCompta.Application.DTOs.ComptaDashboardDto
@{
    ViewData["Title"] = "Comptabilité";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
    var canCreate = ViewBag.CanComptabiliteCreate as bool? ?? false;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-primary text-white rounded-3 p-3 lh-1"><i class="bi bi-kanban fs-4"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-0">Tenue comptable</h1>
            <div class="text-body-secondary small">Board CRM · @(client?.RaisonSociale ?? "Dossier client") · PCGM</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (canCreate)
        {
            <a href="@Url.Action("CreateEcriture")" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i> Nouvelle écriture
            </a>
        }
        <a href="@Url.Action("Exercices")" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-calendar3 me-1"></i> Exercices
        </a>
        @if (ViewBag.CanComptabiliteCloture == true && ViewBag.HasOpenExercice == true)
        {
            <a href="@Url.Action("Cloture")" class="btn btn-outline-danger rounded-pill px-3">
                <i class="bi bi-lock me-1"></i> Clôturer
            </a>
        }
        <a href="@Url.Action("PlanComptable")" class="btn btn-outline-primary rounded-pill px-3">Plan PCGM</a>
    </div>
</div>

@if (client != null)
{
    <div class="alert border-0 shadow-sm rounded-4 bg-primary-subtle text-primary-emphasis mb-4 py-2 px-3 d-flex align-items-center gap-2 flex-wrap">
        <i class="bi bi-building"></i>
        <strong>@client.RaisonSociale</strong>
        <span class="text-muted">@client.FormeJuridique</span>
        @if (ViewBag.ExerciceAnnee is int exoAnnee)
        {
            <span class="vr mx-1 d-none d-md-inline"></span>
            <span class="badge rounded-pill text-bg-light border">
                Exercice @exoAnnee
                <span class="text-muted fw-normal">· @(ViewBag.ExerciceStatut ?? "Ouvert")</span>
            </span>
        }
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl">
        <a href="@Url.Action("PlanComptable")" class="text-decoration-none">
            <div class="stat-card border-start border-4 border-primary h-100">
                <div class="stat-label">Comptes actifs</div>
                <div class="stat-value">@Model.ComptesCount</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <a href="@Url.Action("Journaux")" class="text-decoration-none">
            <div class="stat-card border-start border-4 border-info h-100">
                <div class="stat-label">Journaux</div>
                <div class="stat-value">@Model.JournauxCount</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <a href="@Url.Action("Ecritures", new { statut = "Brouillon" })" class="text-decoration-none">
            <div class="stat-card border-start border-4 border-warning h-100">
                <div class="stat-label">Brouillons</div>
                <div class="stat-value">@Model.EcrituresBrouillon</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <a href="@Url.Action("Ecritures", new { statut = "Validee" })" class="text-decoration-none">
            <div class="stat-card border-start border-4 border-success h-100">
                <div class="stat-label">Validées</div>
                <div class="stat-value">@Model.EcrituresValidees</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <a href="@Url.Action("Rapprochements")" class="text-decoration-none">
            <div class="stat-card border-start border-4 border-secondary h-100">
                <div class="stat-label">Rappro. en cours</div>
                <div class="stat-value">@Model.RapprochementsEnCours</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    @{
        var tiles = new (string Title, string Desc, string Action, string Icon, string Soft)[] {
            ("Écritures", "Saisie, validation, export", "Ecritures", "bi-pencil-square", "bg-primary-subtle text-primary"),
            ("Plan comptable", "PCGM · import / export CSV", "PlanComptable", "bi-diagram-3", "bg-info-subtle text-info"),
            ("Journaux", "AC VE BQ CA OD…", "Journaux", "bi-journal-bookmark", "bg-success-subtle text-success"),
            ("Grand livre", "Mouvements par compte", "GrandLivre", "bi-book", "bg-warning-subtle text-warning"),
            ("Balance", "Soldes & export", "Balance", "bi-symmetry-horizontal", "bg-danger-subtle text-danger"),
            ("Rapprochements", "Banque vs compta", "Rapprochements", "bi-bank", "bg-secondary-subtle text-secondary"),
        };
    }
    @foreach (var t in tiles)
    {
        <div class="col-md-6 col-xl-4">
            <a href="@Url.Action(t.Action)" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift">
                    <div class="card-body d-flex gap-3 align-items-start p-4">
                        <span class="rounded-3 p-3 lh-1 @t.Soft"><i class="bi @t.Icon fs-4"></i></span>
                        <div>
                            <div class="fw-bold text-dark">@t.Title</div>
                            <div class="small text-body-secondary">@t.Desc</div>
                        </div>
                        <i class="bi bi-chevron-right ms-auto text-muted align-self-center"></i>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
