@model MetaCompta.Application.DTOs.PagedResult<MetaCompta.Application.DTOs.EcritureComptableDto>
@{
    ViewData["Title"] = "Écritures comptables";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-journal-text me-2"></i>Écritures comptables</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item">Comptabilité</li>
                <li class="breadcrumb-item active">Écritures</li>
            </ol>
        </nav>
    </div>
    @if (ViewBag.CanComptabiliteCreate as bool? ?? false)
    {
        <a href="@Url.Action("CreateEcriture", "Comptabilite")" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nouvelle écriture
        </a>
    }
</div>

@if (client != null)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
        <i class="bi bi-building fs-5"></i>
        <div><strong>@client.RaisonSociale</strong> <span class="text-muted ms-2">@client.FormeJuridique</span></div>
    </div>
}

<!-- Filters -->
<div class="mc-card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Journal</label>
                <select name="journal" class="form-select">
                    <option value="">Tous</option>
                    <option value="AC" @(ViewBag.Journal?.ToString() == "AC" ? "selected" : "")>Achats (AC)</option>
                    <option value="VE" @(ViewBag.Journal?.ToString() == "VE" ? "selected" : "")>Ventes (VE)</option>
                    <option value="BQ" @(ViewBag.Journal?.ToString() == "BQ" ? "selected" : "")>Banque (BQ)</option>
                    <option value="CA" @(ViewBag.Journal?.ToString() == "CA" ? "selected" : "")>Caisse (CA)</option>
                    <option value="OD" @(ViewBag.Journal?.ToString() == "OD" ? "selected" : "")>OD</option>
                    <option value="SA" @(ViewBag.Journal?.ToString() == "SA" ? "selected" : "")>Salaires (SA)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Recherche</label>
                <input type="text" name="search" class="form-control" value="@ViewBag.Search" placeholder="Libellé, numéro pièce, compte..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Filtrer</button>
            </div>
        </form>
    </div>
</div>

<!-- Écritures Table -->
<div class="mc-card">
    <div class="card-header"><i class="bi bi-table me-2"></i>Écritures (@(Model?.TotalCount ?? 0))</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mc-table mb-0">
                <thead>
                    <tr>
                        <th>N° Pièce</th>
                        <th>Date</th>
                        <th>Journal</th>
                        <th>Compte</th>
                        <th>Libellé</th>
                        <th class="text-end">Débit</th>
                        <th class="text-end">Crédit</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        foreach (var e in Model.Items)
                        {
                            <tr>
                                <td class="fw-medium">@e.NumeroPiece</td>
                                <td>@(e.DateEcriture.ToString("dd/MM/yyyy"))</td>
                                <td><span class="badge bg-info text-dark">@e.Journal</span></td>
                                <td><code>@e.NumCompte</code> <small class="text-muted">@e.LibelleCompte</small></td>
                                <td>@e.Libelle</td>
                                <td class="text-end @(e.TotalDebit > 0 ? "text-success fw-medium" : "")">@(e.TotalDebit > 0 ? e.TotalDebit.ToString("N2") : "")</td>
                                <td class="text-end @(e.TotalCredit > 0 ? "text-danger fw-medium" : "")">@(e.TotalCredit > 0 ? e.TotalCredit.ToString("N2") : "")</td>
                                <td><span class="badge @(e.Statut == "Validé" ? "bg-success" : "bg-warning text-dark")">@e.Statut</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-journal fs-1 d-block mb-2"></i>
                                Aucune écriture trouvée.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model != null && Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Ecritures", new { page = p, journal = ViewBag.Journal, search = ViewBag.Search })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
