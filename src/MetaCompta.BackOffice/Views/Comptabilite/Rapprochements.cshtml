@model IEnumerable<MetaCompta.Application.DTOs.RapprochementBancaireDto>
@{
    ViewData["Title"] = "Rapprochements bancaires";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
    var canCreate = ViewBag.CanComptabiliteCreate as bool? ?? false;
    var list = Model?.ToList() ?? new();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-secondary text-white rounded-3 p-3 lh-1"><i class="bi bi-bank fs-4"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-0">Rapprochements</h1>
            <div class="text-body-secondary small">Banque vs comptabilité · @list.Count</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("DownloadTemplateRapprochements")" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-file-earmark-text me-1"></i> Modèle CSV
        </a>
        @if (canCreate)
        {
            <button type="button" class="btn btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalImportRapprochements">
                <i class="bi bi-upload me-1"></i> Importer CSV
            </button>
            <button class="btn btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalNouveauRapprochement">
                <i class="bi bi-plus-lg me-1"></i> Nouveau
            </button>
        }
    </div>
</div>

@if (client != null)
{
    <div class="alert border-0 shadow-sm rounded-4 bg-secondary-subtle text-secondary-emphasis mb-3 py-2 px-3">
        <i class="bi bi-building me-1"></i>@client.RaisonSociale
    </div>
}

<div class="card border-0 shadow-sm rounded-4 border-start border-4 border-secondary">
    <div class="table-responsive">
        <table class="table mc-table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Compte</th>
                    <th>Période</th>
                    <th class="text-end">Solde banque</th>
                    <th class="text-end">Solde compta</th>
                    <th class="text-end">Écart</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (list.Any())
            {
                foreach (var r in list)
                {
                    <tr>
                        <td class="fw-medium">@r.CompteBancaire</td>
                        <td>@r.Periode</td>
                        <td class="text-end">@r.SoldeBanque.ToString("N2")</td>
                        <td class="text-end">@r.SoldeCompta.ToString("N2")</td>
                        <td class="text-end fw-bold @(r.Ecart == 0 ? "text-success" : "text-danger")">@r.Ecart.ToString("N2")</td>
                        <td><span class="badge rounded-pill @(r.EstRapproche ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">@(r.EstRapproche ? "Rapproché" : "En cours")</span></td>
                        <td class="text-end">
                            @if (!r.EstRapproche && canCreate)
                            {
                                <form method="post" asp-action="MarkRapproche" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="soldeBanque" value="@r.SoldeBanque" />
                                    <input type="hidden" name="soldeCompta" value="@r.SoldeCompta" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill">Marquer rapproché</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Aucun rapprochement.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalNouveauRapprochement" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="CreateRapprochement" class="modal-content rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="clientId" value="@(client?.Id ?? 0)" />
            <div class="modal-header border-0"><h5 class="modal-title">Nouveau rapprochement</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Compte bancaire</label><input name="compteBancaire" class="form-control rounded-3" value="5141 - Banque" required /></div>
                <div class="mb-3"><label class="form-label">Période (AAAA-MM)</label><input name="periode" class="form-control rounded-3" placeholder="2026-07" required /></div>
                <div class="mb-3"><label class="form-label">Solde relevé (optionnel)</label><input name="soldeBanque" type="number" step="0.01" class="form-control rounded-3" /></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary rounded-pill">Créer</button>
            </div>
        </form>
    </div>
</div>

@if (canCreate)
{
<div class="modal fade" id="modalImportRapprochements" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="ImportRapprochements" enctype="multipart/form-data" class="modal-content rounded-4">
            @Html.AntiForgeryToken()
            <div class="modal-header border-0">
                <h5 class="modal-title">Importer rapprochements CSV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Colonnes : <code>CompteBancaire;Periode;SoldeBanque;Libelle</code></p>
                <a href="@Url.Action("DownloadTemplateRapprochements")" class="small d-inline-block mb-3"><i class="bi bi-download me-1"></i>Télécharger le modèle</a>
                <input type="file" name="file" accept=".csv,text/csv" class="form-control rounded-3 mb-3" />
                <label class="form-label">Ou coller le CSV</label>
                <textarea name="csvText" class="form-control rounded-3 font-monospace" rows="4" placeholder="5141;2026-06;12500.00;BQ CIH juin"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary rounded-pill">Importer</button>
            </div>
        </form>
    </div>
</div>
}
