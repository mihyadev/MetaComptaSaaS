@model MetaCompta.Application.DTOs.ExerciceCloturePrecheckDto
@{
    ViewData["Title"] = $"Clôture exercice {Model.Annee}";
    var canForce = ViewBag.CanComptabiliteCloture == true;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-danger text-white rounded-3 p-3 lh-1"><i class="bi bi-lock-fill fs-4"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-0">Clôture exercice @Model.Annee</h1>
            <div class="text-body-secondary small">Wizard Sage · contrôles · report à nouveau · ouverture N+1</div>
        </div>
    </div>
    <a class="btn btn-outline-secondary rounded-pill px-3" asp-action="Exercices">
        <i class="bi bi-arrow-left me-1"></i> Retour aux exercices
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 fw-bold pt-3 px-4">1. Contrôles pré-clôture</div>
            <div class="card-body p-0 px-2 pb-2">
                <table class="table table-sm mb-0 align-middle mc-table">
                    <thead>
                        <tr>
                            <th style="width:2.5rem;"></th>
                            <th>Contrôle</th>
                            <th>Détail</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.Checks)
                    {
                        <tr>
                            <td class="text-center">
                                @if (c.Ok)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                }
                            </td>
                            <td class="fw-semibold">@c.Label</td>
                            <td class="small @(c.Ok ? "text-muted" : "text-danger")">@c.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 fw-bold pt-3 px-4">2. Aperçu report à nouveau (AN)</div>
            <div class="card-body p-0" style="max-height:22rem; overflow:auto;">
                @if (Model.AnPreview.Count == 0)
                {
                    <p class="text-muted p-4 mb-0">Aucun solde de bilan à reporter.</p>
                }
                else
                {
                    <table class="table table-sm mb-0 mc-table">
                        <thead>
                            <tr>
                                <th>Compte</th>
                                <th class="text-end">Débit</th>
                                <th class="text-end">Crédit</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var l in Model.AnPreview)
                        {
                            <tr>
                                <td><code>@l.NumCompte</code> <span class="text-muted small">@l.Libelle</span></td>
                                <td class="text-end">@(l.SoldeDebiteur > 0 ? l.SoldeDebiteur.ToString("N2") : "")</td>
                                <td class="text-end">@(l.SoldeCrediteur > 0 ? l.SoldeCrediteur.ToString("N2") : "")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form asp-action="Cloturer" method="post" class="card border-0 shadow-sm rounded-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ExerciceId" value="@Model.ExerciceId" />
    <div class="card-header bg-white border-0 fw-bold pt-3 px-4">3. Confirmation</div>
    <div class="card-body px-4 pb-4">
        @if (!Model.CanCloturer)
        {
            <div class="alert alert-warning rounded-3">
                Des contrôles bloquants sont en échec. Corrigez-les, ou forcez la clôture avec une justification (audit).
            </div>
        }
        else
        {
            <div class="alert alert-success rounded-3 mb-3">
                Tous les contrôles sont OK. Vous pouvez clôturer et reporter les AN sur N+1.
            </div>
        }

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" name="ApprouverANouveaux" value="true" id="approveAn" checked />
            <label class="form-check-label" for="approveAn">J'approuve le report à nouveau (AN) ci-dessus</label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" name="OuvrirExerciceSuivant" value="true" id="openNext" checked />
            <label class="form-check-label" for="openNext">Ouvrir automatiquement l'exercice suivant (N+1)</label>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="RolloverServices" value="true" id="rolloverSvc" checked />
            <label class="form-check-label" for="rolloverSvc">Reporter les services contrat actifs vers N+1</label>
        </div>

        @if (!Model.CanCloturer && canForce)
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="ForceWithReason" value="true" id="forceClose" />
                <label class="form-check-label" for="forceClose">Forcer la clôture malgré les alertes</label>
            </div>
            <div class="mb-3">
                <label class="form-label" for="forceReason">Justification (obligatoire si forcé)</label>
                <textarea class="form-control rounded-3" name="ForceReason" id="forceReason" rows="2" placeholder="Motif de dérogation..."></textarea>
            </div>
        }

        <button type="submit" class="btn btn-danger rounded-pill px-4" @(Model.CanCloturer || canForce ? "" : "disabled")>
            <i class="bi bi-lock-fill me-1"></i> Clôturer l'exercice @Model.Annee
        </button>
    </div>
</form>
