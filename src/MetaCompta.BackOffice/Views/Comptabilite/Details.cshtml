@model MetaCompta.Application.DTOs.EcritureDetailDto
@{
    ViewData["Title"] = "Écriture " + Model.NumeroPiece;
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
    var canCreate = ViewBag.CanComptabiliteCreate as bool? ?? false;
    var canEdit = ViewBag.CanComptabiliteEdit as bool? ?? false;
    var isDraft = Model.Statut is "Brouillon";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-primary text-white rounded-3 p-3 lh-1"><i class="bi bi-receipt fs-4"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-0">@Model.NumeroPiece</h1>
            <div class="text-body-secondary small">@Model.Journal · @Model.DateEcriture.ToString("dd/MM/yyyy") · <span class="badge rounded-pill @(isDraft ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success-emphasis")">@Model.Statut</span></div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("Ecritures")" class="btn btn-outline-secondary rounded-pill">Retour</a>
        @if (isDraft && canCreate)
        {
            <form method="post" asp-action="ValidateEcriture" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success rounded-pill"><i class="bi bi-check-lg me-1"></i> Valider</button>
            </form>
        }
        @if (isDraft && canEdit)
        {
            <a href="@Url.Action("EditEcriture", new { id = Model.Id })" class="btn btn-primary rounded-pill"><i class="bi bi-pencil me-1"></i> Modifier</a>
        }
    </div>
</div>

@if (client != null)
{
    <div class="alert border-0 shadow-sm rounded-4 bg-primary-subtle text-primary-emphasis mb-3 py-2 px-3">
        <i class="bi bi-building me-1"></i>@client.RaisonSociale
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="stat-card border-start border-4 border-primary"><div class="stat-label">Débit</div><div class="stat-value">@Model.TotalDebit.ToString("N2")</div></div></div>
    <div class="col-md-3"><div class="stat-card border-start border-4 border-danger"><div class="stat-label">Crédit</div><div class="stat-value">@Model.TotalCredit.ToString("N2")</div></div></div>
    <div class="col-md-6"><div class="stat-card border-start border-4 border-info"><div class="stat-label">Libellé</div><div class="fw-semibold">@(Model.Libelle ?? "—")</div><div class="small text-muted">Réf. @(Model.Reference ?? "—")</div></div></div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-transparent border-0 pt-3 px-4 fw-semibold"><i class="bi bi-list-ol me-1"></i> Lignes</div>
    <div class="table-responsive">
        <table class="table mc-table mb-0">
            <thead><tr><th>Compte</th><th>Libellé</th><th class="text-end">Débit</th><th class="text-end">Crédit</th></tr></thead>
            <tbody>
            @foreach (var l in Model.Lignes)
            {
                <tr>
                    <td><code>@l.NumCompte</code></td>
                    <td>@l.LibelleCompte</td>
                    <td class="text-end">@(l.Debit > 0 ? l.Debit.ToString("N2") : "")</td>
                    <td class="text-end">@(l.Credit > 0 ? l.Credit.ToString("N2") : "")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
