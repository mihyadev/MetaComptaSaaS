@model IEnumerable<MetaCompta.Application.DTOs.BalanceAgeeDto>
@{
    ViewData["Title"] = "Balance âgée";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
    var list = Model?.ToList() ?? new();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-dark text-white rounded-3 p-3 lh-1"><i class="bi bi-hourglass-split fs-4"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-0">Balance âgée</h1>
            <div class="text-body-secondary small">Auxiliaires clients / fournisseurs</div>
        </div>
    </div>
</div>

@if (client != null)
{
    <div class="alert border-0 shadow-sm rounded-4 bg-dark-subtle text-dark-emphasis mb-3 py-2 px-3">
        <i class="bi bi-building me-1"></i>@client.RaisonSociale
    </div>
}

<div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4">
    <i class="bi bi-hourglass display-4 text-muted"></i>
    <h5 class="mt-3">Bientôt disponible</h5>
    <p class="text-muted mb-0 col-md-8 mx-auto">
        La balance âgée réelle (lettrage auxiliaires) arrive en Phase 2.
        En Phase 1, utilisez le grand livre et la balance générale.
    </p>
    <div class="mt-3">
        <a href="@Url.Action("Balance")" class="btn btn-outline-primary rounded-pill">Ouvrir la balance</a>
    </div>
</div>
