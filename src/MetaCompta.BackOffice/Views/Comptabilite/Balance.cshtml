@model IEnumerable<MetaCompta.Application.DTOs.BalanceDto>
@{
    ViewData["Title"] = "Balance";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
    var canCreate = ViewBag.CanComptabiliteCreate as bool? ?? false;
    var list = Model?.ToList() ?? new();
    var totD = list.Sum(x => x.TotalDebit);
    var totC = list.Sum(x => x.TotalCredit);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="bg-danger text-white rounded-3 p-3 lh-1"><i class="bi bi-symmetry-horizontal fs-4"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-0">Balance</h1>
            <div class="text-body-secondary small">Soldes validés · @list.Count compte(s)</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("DownloadTemplateSoldesOuverture")" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-file-earmark-text me-1"></i> Modèle soldes d'ouverture
        </a>
        @if (canCreate)
        {
            <button type="button" class="btn btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalImportOuverture">
                <i class="bi bi-upload me-1"></i> Importer soldes d'ouverture
            </button>
        }
        <a href="@Url.Action("ExportBalance", new { dateDebut = ViewBag.DateDebut, dateFin = ViewBag.DateFin })" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-download me-1"></i> CSV</a>
        <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-printer me-1"></i> Imprimer</button>
    </div>
</div>

@if (client != null)
{
    <div class="alert border-0 shadow-sm rounded-4 bg-danger-subtle text-danger-emphasis mb-3 py-2 px-3">
        <i class="bi bi-building me-1"></i>@client.RaisonSociale
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="stat-card border-start border-4 border-success"><div class="stat-label">Total débit</div><div class="stat-value">@totD.ToString("N2")</div></div></div>
    <div class="col-md-4"><div class="stat-card border-start border-4 border-danger"><div class="stat-label">Total crédit</div><div class="stat-value">@totC.ToString("N2")</div></div></div>
    <div class="col-md-4"><div class="stat-card border-start border-4 border-primary"><div class="stat-label">Écart</div><div class="stat-value">@((totD - totC).ToString("N2"))</div></div></div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small text-muted">Du</label><input type="date" name="dateDebut" class="form-control rounded-3" value="@(ViewBag.DateDebut is DateTime dd ? dd.ToString("yyyy-MM-dd") : "")" /></div>
            <div class="col-md-3"><label class="form-label small text-muted">Au</label><input type="date" name="dateFin" class="form-control rounded-3" value="@(ViewBag.DateFin is DateTime df ? df.ToString("yyyy-MM-dd") : "")" /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100 rounded-pill">Filtrer</button></div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 border-start border-4 border-danger">
    <div class="table-responsive">
        <table class="table mc-table mb-0">
            <thead><tr><th>Compte</th><th>Libellé</th><th class="text-end">Débit</th><th class="text-end">Crédit</th><th class="text-end">Solde D</th><th class="text-end">Solde C</th></tr></thead>
            <tbody>
            @if (list.Any())
            {
                foreach (var b in list)
                {
                    <tr>
                        <td><code>@b.NumeroCompte</code></td>
                        <td>@b.LibelleCompte</td>
                        <td class="text-end">@b.TotalDebit.ToString("N2")</td>
                        <td class="text-end">@b.TotalCredit.ToString("N2")</td>
                        <td class="text-end">@(b.SoldeDebiteur > 0 ? b.SoldeDebiteur.ToString("N2") : "")</td>
                        <td class="text-end">@(b.SoldeCrediteur > 0 ? b.SoldeCrediteur.ToString("N2") : "")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Balance vide — validez des écritures ou importez les soldes d'ouverture.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (canCreate)
{
<div class="modal fade" id="modalImportOuverture" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="ImportSoldesOuverture" enctype="multipart/form-data" class="modal-content rounded-4">
            @Html.AntiForgeryToken()
            <div class="modal-header border-0">
                <h5 class="modal-title">Importer soldes d'ouverture</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">
                    Colonnes : <code>NumCompte;Libelle;SoldeDebiteur;SoldeCrediteur</code><br />
                    Crée une OD validée « À-nouveaux » au <strong>DateDebut</strong> de l'exercice (total débit = total crédit).
                </p>
                <a href="@Url.Action("DownloadTemplateSoldesOuverture")" class="small d-inline-block mb-3"><i class="bi bi-download me-1"></i>Télécharger le modèle</a>
                <input type="file" name="file" accept=".csv,text/csv" class="form-control rounded-3 mb-3" />
                <label class="form-label">Ou coller le CSV</label>
                <textarea name="csvText" class="form-control rounded-3 font-monospace" rows="5" placeholder="5141;Banque;10000;0&#10;1111;Capital;0;10000"></textarea>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary rounded-pill">Importer</button>
            </div>
        </form>
    </div>
</div>
}
