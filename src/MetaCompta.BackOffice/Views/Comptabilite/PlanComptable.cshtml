@model List<MetaCompta.Application.DTOs.CompteComptableDto>
@{
    ViewData["Title"] = "Plan comptable PCGM";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-diagram-3 me-2"></i>Plan comptable PCGM</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item">Comptabilité</li>
                <li class="breadcrumb-item active">Plan comptable</li>
            </ol>
        </nav>
    </div>
    @if (ViewBag.CanComptabiliteCreate as bool? ?? false)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCompte">
            <i class="bi bi-plus-circle me-1"></i> Ajouter un compte
        </button>
    }
</div>

@if (client != null)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
        <i class="bi bi-building fs-5"></i>
        <div><strong>@client.RaisonSociale</strong> — plan seedé / personnalisable</div>
    </div>
}

<div class="mc-card mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Recherche</label>
                <input type="text" name="search" class="form-control" value="@ViewBag.Search" placeholder="Numéro ou libellé…" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Filtrer</button>
            </div>
        </form>
    </div>
</div>

<div class="mc-card">
    <div class="card-header"><i class="bi bi-table me-2"></i>Comptes (@(Model?.Count ?? 0))</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mc-table mb-0">
                <thead>
                    <tr>
                        <th>Classe</th>
                        <th>N°</th>
                        <th>Libellé</th>
                        <th>Nature</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@c.Classe</span></td>
                                <td><code>@c.Numero</code></td>
                                <td>@c.Libelle</td>
                                <td>@c.Nature</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Aucun compte. Ouvrez cette page pour seed PCGM.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCompte" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CreateCompte">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClientId" value="@(client?.Id ?? 0)" />
                <div class="modal-header">
                    <h5 class="modal-title">Nouveau compte</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Numéro</label>
                        <input name="Numero" class="form-control" required maxlength="20" placeholder="Ex: 6118" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Libellé</label>
                        <input name="Libelle" class="form-control" required maxlength="300" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Classe (optionnel)</label>
                        <input name="Classe" class="form-control" maxlength="5" placeholder="Déduit du 1er chiffre si vide" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Créer</button>
                </div>
            </form>
        </div>
    </div>
</div>
