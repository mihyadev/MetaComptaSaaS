@{
    ViewData["Title"] = "Intégrations API";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-plug me-2"></i>Intégrations API</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Parametres")">Paramètres</a></li>
                <li class="breadcrumb-item active">Intégrations</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row g-4">
    <!-- DGI -->
    <div class="col-md-4">
        <div class="mc-card p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-building"></i></div>
                <div>
                    <h6 class="mb-0">Simpl-TVA (DGI)</h6>
                    <span class="text-muted small">Direction Générale des Impôts</span>
                </div>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small text-muted">Statut</span>
                    <span class="badge bg-warning">Non configuré</span>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-gear me-1"></i> Configurer</button>
        </div>
    </div>

    <!-- CNSS -->
    <div class="col-md-4">
        <div class="mc-card p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-shield-check"></i></div>
                <div>
                    <h6 class="mb-0">CNSS (DAMANCOM)</h6>
                    <span class="text-muted small">Caisse Nationale de Sécurité Sociale</span>
                </div>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small text-muted">Statut</span>
                    <span class="badge bg-warning">Non configuré</span>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-gear me-1"></i> Configurer</button>
        </div>
    </div>

    <!-- Banque -->
    <div class="col-md-4">
        <div class="mc-card p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-bank"></i></div>
                <div>
                    <h6 class="mb-0">Relevés bancaires</h6>
                    <span class="text-muted small">Import automatique des relevés</span>
                </div>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small text-muted">Statut</span>
                    <span class="badge bg-warning">Non configuré</span>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-gear me-1"></i> Configurer</button>
        </div>
    </div>

    <!-- Email -->
    <div class="col-md-4">
        <div class="mc-card p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-envelope"></i></div>
                <div>
                    <h6 class="mb-0">Serveur SMTP</h6>
                    <span class="text-muted small">Envoi d'emails et notifications</span>
                </div>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small text-muted">Statut</span>
                    <span class="badge bg-warning">Non configuré</span>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-gear me-1"></i> Configurer</button>
        </div>
    </div>

    <!-- Stockage -->
    <div class="col-md-4">
        <div class="mc-card p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-cloud"></i></div>
                <div>
                    <h6 class="mb-0">Stockage Cloud</h6>
                    <span class="text-muted small">Azure Blob / S3</span>
                </div>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small text-muted">Statut</span>
                    <span class="badge bg-warning">Non configuré</span>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-gear me-1"></i> Configurer</button>
        </div>
    </div>
</div>
