@using MetaCompta.Application.DTOs
@using MetaCompta.Domain.Common
@{
    // Self-contained step work actions — usable from Declaration Details and Tasks/Details.
    var declaration  = ViewBag.ActionBarDeclaration as DeclarationDto;
    var wfInstance   = ViewBag.ActionBarWorkflow as WorkflowInstanceDto;
    var wfStep       = ViewBag.ActionBarCurrentStep as WorkflowStepInstanceDto;
    var userRole     = ViewBag.ActionBarUserRole as string ?? "";
    var userId       = ViewBag.ActionBarUserId as string ?? "";
    var isClientPortal = (bool)(ViewBag.ActionBarIsClientPortal ?? false);
    var claimController = ViewBag.StepWorkClaimController as string ?? "Declarations";
    var claimRedirectId = ViewBag.StepWorkClaimRedirectId as int?;

    if (declaration == null) { return; }

    var statut = declaration.Statut ?? "";
    var type   = declaration.Type ?? "";
    var declId = declaration.Id;

    var hasWorkflow     = wfInstance != null;
    var wfActive        = hasWorkflow && wfInstance!.Status == "Active";
    var hasCurrentStep  = wfStep != null;
    var stepAssignment  = hasCurrentStep ? (wfStep!.AssignmentType ?? "") : "";
    var isMyStep        = hasCurrentStep
                          && !string.IsNullOrEmpty(wfStep!.AssignedToUserId)
                          && string.Equals(wfStep.AssignedToUserId, userId, StringComparison.OrdinalIgnoreCase);
    var isClientStep    = hasCurrentStep && wfStep!.IsClientStep;
    var stepType        = hasCurrentStep ? (wfStep!.StepType ?? "") : "";
    var stepStatus      = hasCurrentStep ? (wfStep!.Status ?? "") : "";
    var isManagerOverride = userRole is "Gerant" or "Manager" or "Admin" or "SuperAdmin";

    var canActOnStep = false;
    if (wfActive && hasCurrentStep)
    {
        if (stepAssignment == "AutoSystem") canActOnStep = false;
        else if (isClientStep) canActOnStep = isClientPortal;
        else if (isMyStep || isManagerOverride) canActOnStep = true;
    }
    else if (!wfActive)
        canActOnStep = true;

    var stepHeldByOther = hasCurrentStep
        && !string.IsNullOrEmpty(wfStep!.AssignedToUserId)
        && !isMyStep;
    // Claim when unclaimed (or eligible on list) and not held by someone else
    var canClaimStep = wfActive && hasCurrentStep && !isClientStep && stepAssignment != "AutoSystem"
                       && !isMyStep && !stepHeldByOther
                       && stepStatus != "Completed" && stepStatus != "Skipped";
    var canForceClaim = wfActive && hasCurrentStep && !isClientStep && stepAssignment != "AutoSystem"
                       && !isMyStep && stepHeldByOther && isManagerOverride
                       && stepStatus != "Completed" && stepStatus != "Skipped";

    var permEdit = ViewBag.CanEditDeclaration as bool? ?? false;
    var permValidate = ViewBag.CanValidateDeclaration as bool? ?? false;
    var permSubmit = ViewBag.CanSubmitDeclaration as bool? ?? false;
    var permWfAdvance = ViewBag.CanWorkflowAdvance as bool? ?? false;

    // Holders with Edit|Submit may run late-step status actions (Payée / SIMPL / …)
    var canStatusPayOrSubmit = permEdit || permSubmit;
    var canStatusValidate = permEdit || permValidate;

    var canEdit = permEdit && (statut == RefCodes.StatutDeclaration.Brouillon
               || statut == RefCodes.StatutDeclaration.ACompleter
               || statut == RefCodes.StatutDeclaration.EnCours
               || statut == RefCodes.StatutDeclaration.EnPreparation
               || statut == RefCodes.StatutDeclaration.CreeeParSysteme
               || statut == RefCodes.StatutDeclaration.DocumentsDemandes
               || statut == RefCodes.StatutDeclaration.DocumentsRecus
               || statut == RefCodes.StatutDeclaration.ControleEnCours
               || statut == RefCodes.StatutDeclaration.EnAttenteCorrection
               || statut == RefCodes.StatutDeclaration.CalculTVA
               || statut == RefCodes.StatutDeclaration.ACorriger);

    var canComplete = permEdit && (statut == RefCodes.StatutDeclaration.Brouillon
                    || statut == RefCodes.StatutDeclaration.ACompleter
                    || statut == RefCodes.StatutDeclaration.EnPreparation
                    || statut == RefCodes.StatutDeclaration.DocumentsRecus)
                    && (!hasWorkflow || !wfActive || stepType is "Saisie" or "Collecte" or "Controle");
    var canValidate = canStatusValidate && (statut == RefCodes.StatutDeclaration.Completee
                    || statut == RefCodes.StatutDeclaration.EnRevision
                    || statut == RefCodes.StatutDeclaration.EnRevueSuperviseur
                    || statut == RefCodes.StatutDeclaration.CalculTVA)
                    && (!hasWorkflow || !wfActive || stepType is "Controle" or "ValidationInterne");
    var canSubmit = canStatusPayOrSubmit && (statut == RefCodes.StatutDeclaration.Validee || statut == RefCodes.StatutDeclaration.EnvoyeeSimplTva)
                  && (!hasWorkflow || !wfActive || stepType == "DepotSoumission");
    var canRequestDocs = permEdit && (statut == RefCodes.StatutDeclaration.CreeeParSysteme
                    || statut == RefCodes.StatutDeclaration.Brouillon
                    || statut == RefCodes.StatutDeclaration.DocumentsDemandes
                    || statut == RefCodes.StatutDeclaration.ACompleter
                    || statut == RefCodes.StatutDeclaration.EnAttenteCorrection);
    var canMarkDocsReceived = permEdit && (statut == RefCodes.StatutDeclaration.DocumentsDemandes || statut == RefCodes.StatutDeclaration.ACompleter);
    var canStartControle = permEdit && statut == RefCodes.StatutDeclaration.DocumentsRecus;
    var canAskCorrection = permEdit && (statut == RefCodes.StatutDeclaration.ControleEnCours || statut == RefCodes.StatutDeclaration.CalculTVA);
    var canRejectReview = canStatusValidate && (statut == RefCodes.StatutDeclaration.EnRevueSuperviseur || statut == RefCodes.StatutDeclaration.EnRevision);
    var canConfirmDeposit = canStatusPayOrSubmit && statut == RefCodes.StatutDeclaration.EnvoyeeSimplTva;
    var canRejectSimpl = canStatusPayOrSubmit && statut == RefCodes.StatutDeclaration.EnvoyeeSimplTva;
    var canMarkToPay = permEdit && statut == RefCodes.StatutDeclaration.Deposee;
    var canConfirmPay = canStatusPayOrSubmit && (statut == RefCodes.StatutDeclaration.APayer || statut == RefCodes.StatutDeclaration.Deposee);
    var canReconcile = permEdit && (statut == RefCodes.StatutDeclaration.Payee || statut == RefCodes.StatutDeclaration.Deposee);
    var canArchive = permEdit && statut == RefCodes.StatutDeclaration.Rapprochee;
    var canClose = permEdit && statut == RefCodes.StatutDeclaration.Archivee;

    if (wfActive && hasCurrentStep && !canActOnStep)
    {
        canEdit = canComplete = canValidate = canSubmit = false;
        canRequestDocs = canMarkDocsReceived = canStartControle = canAskCorrection = false;
        canRejectReview = canConfirmDeposit = canRejectSimpl = false;
        canMarkToPay = canConfirmPay = canReconcile = canArchive = canClose = false;
    }

    var canAdvanceWf = canActOnStep && (permWfAdvance || isMyStep) && stepStatus != "Completed" && stepStatus != "Skipped";
    var claimId = claimRedirectId ?? declId;
    var holderName = wfStep?.AssignedToUserName ?? "un autre collaborateur";
}

<div class="step-work-actions d-flex align-items-center gap-2 flex-wrap">
    @if (isMyStep && wfActive)
    {
        <span class="wf-btn" style="cursor:default;background:color-mix(in srgb, var(--monday-green) 12%, var(--monday-surface));color:var(--monday-green);border-color:transparent;" title="Vous tenez le verrou exclusif de cette étape">
            <i class="bi bi-lock-fill"></i> <span>À votre charge@(wfStep?.OpenTakeTakenAt != null ? $" depuis {wfStep.OpenTakeTakenAt:dd/MM HH:mm}" : "")</span>
        </span>
    }
    else if (stepHeldByOther && !isManagerOverride)
    {
        <span class="wf-btn" style="cursor:default;background:color-mix(in srgb, var(--monday-orange) 12%, var(--monday-surface));color:var(--monday-orange);border-color:transparent;" title="Verrou exclusif — un seul collaborateur à la fois">
            <i class="bi bi-lock-fill"></i> <span>Verrouillée — prise par @holderName@(wfStep?.OpenTakeTakenAt != null ? $" ({wfStep.OpenTakeTakenAt:dd/MM HH:mm})" : "")</span>
        </span>
    }
    else if (stepHeldByOther && isManagerOverride)
    {
        <span class="text-muted" style="font-size:0.75rem;">
            <i class="bi bi-lock-fill me-1"></i>Prise par <strong>@holderName</strong>
        </span>
    }

    @if (canClaimStep)
    {
        <form asp-action="ClaimWorkflowStep" asp-controller="@claimController" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            @if (claimController == "Tasks")
            {
                <input type="hidden" name="taskId" value="@claimId" />
            }
            else
            {
                <input type="hidden" name="declarationId" value="@declId" />
            }
            <input type="hidden" name="workflowInstanceId" value="@wfInstance!.Id" />
            <button type="submit" class="wf-btn wf-btn-start" title="Prendre cette étape (verrou exclusif)">
                <i class="bi bi-hand-index-thumb"></i> <span>Prendre / Ouvrir</span>
            </button>
        </form>
    }
    else if (canForceClaim)
    {
        <form asp-action="ClaimWorkflowStep" asp-controller="@claimController" method="post" class="d-inline-flex gap-1 align-items-center"
              onsubmit="return confirm('Forcer la reprise de cette étape ?');">
            @Html.AntiForgeryToken()
            @if (claimController == "Tasks")
            {
                <input type="hidden" name="taskId" value="@claimId" />
            }
            else
            {
                <input type="hidden" name="declarationId" value="@declId" />
            }
            <input type="hidden" name="workflowInstanceId" value="@wfInstance!.Id" />
            <input type="hidden" name="forceOverride" value="true" />
            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Motif reprise" required style="width:140px;font-size:0.7rem;" />
            <button type="submit" class="wf-btn wf-btn-skip" title="Forcer la reprise (Manager)">
                <i class="bi bi-shield-lock"></i> <span>Forcer reprise</span>
            </button>
        </form>
    }

    @if (canEdit)
    {
        var editAction = DeclarationServiceCatalog.GetEditAction(type);
        <a href="@Url.Action(editAction, "Declarations", new { id = declId })" class="wf-btn wf-btn-edit" title="Modifier / saisie">
            <i class="bi bi-pencil-square"></i> <span>@(type == "TVA" && (statut == RefCodes.StatutDeclaration.CalculTVA || stepType == "Saisie") ? "Saisie / Calcul TVA" : "Modifier")</span>
        </a>
    }

    @if (canRequestDocs)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.DocumentsDemandes" />
            <button type="submit" class="wf-btn wf-btn-edit"><i class="bi bi-folder-symlink"></i> <span>Demander docs</span></button>
        </form>
    }
    @if (canMarkDocsReceived)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.DocumentsRecus" />
            <button type="submit" class="wf-btn wf-btn-complete"><i class="bi bi-folder-check"></i> <span>Docs reçus</span></button>
        </form>
    }
    @if (canStartControle || canComplete)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.ControleEnCours" />
            <button type="submit" class="wf-btn wf-btn-complete"><i class="bi bi-search"></i> <span>Contrôler</span></button>
        </form>
    }
    @if (canAskCorrection)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.EnAttenteCorrection" />
            <button type="submit" class="wf-btn wf-btn-skip"><i class="bi bi-arrow-repeat"></i> <span>Correction</span></button>
        </form>
        @if (type == "TVA")
        {
            <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.CalculTVA" />
                <button type="submit" class="wf-btn wf-btn-edit"><i class="bi bi-calculator"></i> <span>Calculer</span></button>
            </form>
        }
    }
    @if (canValidate)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.Validee" />
            <button type="submit" class="wf-btn wf-btn-validate"><i class="bi bi-shield-check"></i> <span>Valider</span></button>
        </form>
    }
    @if (canRejectReview)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.ACorriger" />
            <button type="submit" class="wf-btn wf-btn-skip"><i class="bi bi-x-circle"></i> <span>À corriger</span></button>
        </form>
    }
    @if (canSubmit && statut == RefCodes.StatutDeclaration.Validee)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.EnvoyeeSimplTva" />
            <button type="submit" class="wf-btn wf-btn-submit"><i class="bi bi-cloud-upload"></i> <span>SIMPL-TVA</span></button>
        </form>
    }
    @if (canConfirmDeposit)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.Deposee" />
            <button type="submit" class="wf-btn wf-btn-validate"><i class="bi bi-send-check"></i> <span>Déposée</span></button>
        </form>
    }
    @if (canRejectSimpl)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.Rejetee" />
            <button type="submit" class="wf-btn wf-btn-skip"><i class="bi bi-x-octagon"></i> <span>Rejetée</span></button>
        </form>
    }
    @if (canMarkToPay)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.APayer" />
            <button type="submit" class="wf-btn wf-btn-edit"><i class="bi bi-cash"></i> <span>À payer</span></button>
        </form>
    }
    @if (canConfirmPay)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.Payee" />
            <button type="submit" class="wf-btn wf-btn-validate"><i class="bi bi-cash-coin"></i> <span>Payée</span></button>
        </form>
    }
    @if (canReconcile)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.Rapprochee" />
            <button type="submit" class="wf-btn wf-btn-complete"><i class="bi bi-link-45deg"></i> <span>Rapprocher</span></button>
        </form>
    }
    @if (canArchive)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.Archivee" />
            <button type="submit" class="wf-btn wf-btn-edit"><i class="bi bi-archive"></i> <span>Archiver</span></button>
        </form>
    }
    @if (canClose)
    {
        <form asp-action="ChangeStatus" asp-controller="Declarations" asp-route-id="@declId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="newStatut" value="@RefCodes.StatutDeclaration.Cloturee" />
            <button type="submit" class="wf-btn wf-btn-validate"><i class="bi bi-lock"></i> <span>Clôturer</span></button>
        </form>
    }

    @if (canAdvanceWf && wfInstance != null)
    {
        <form asp-action="AdvanceWorkflowStep" asp-controller="Declarations" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="declarationId" value="@declId" />
            <input type="hidden" name="workflowInstanceId" value="@wfInstance.Id" />
            <button type="submit" class="wf-btn wf-btn-advance" title="Terminer l'étape et avancer">
                <i class="bi bi-skip-forward-fill"></i> <span>Avancer l'étape</span>
            </button>
        </form>
    }
</div>
