@using MetaCompta.Application.DTOs
@model DeclarationTVADto
@{
    ViewData["Title"] = "Modifier Déclaration TVA";
    var declaration = ViewBag.Declaration as DeclarationDto;
    var client = ViewBag.Client as ClientDto;
    var cabinetName = ViewBag.CabinetName as string ?? "Cabinet Comptable";
    var lignes = Model.LignesFactures?.Where(l => l != null).ToList() ?? new List<TVALigneFactureDto>();
    var lignesVente = lignes.Where(l => string.Equals(l.TypeOperation, "Vente", StringComparison.OrdinalIgnoreCase)).ToList();
    var lignesAchat = lignes.Where(l => string.Equals(l.TypeOperation, "Achat", StringComparison.OrdinalIgnoreCase)).ToList();
}


<!-- Workflow Action Bar (generic, step-aware) -->
@await Html.PartialAsync("_WorkflowActionBar")

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a href="@Url.Action("TVA", "Declarations")">TVA</a></li>
                <li class="breadcrumb-item"><a href="/Declarations/Details/@Model.DeclarationId">Détails</a></li>
                <li class="breadcrumb-item active">Modifier TVA</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0"><i class="bi bi-pencil text-warning me-2"></i>Déclaration TVA — @(declaration?.Periode ?? "")</h4>
        <p class="text-muted small mb-0 mt-1">Maroc : saisissez les <strong>ventes</strong> (TVA facturée) et les <strong>achats</strong> (TVA récupérable).</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportTVAXml" asp-route-id="@Model.DeclarationId" class="btn btn-outline-success rounded-pill px-3" title="Exporter XML EDI Télédéclaration">
            <i class="bi bi-filetype-xml me-1"></i> Export XML EDI
        </a>
        <a asp-action="Details" asp-route-id="@Model.DeclarationId" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Retour</a>
    </div>
</div>

@* ═══ CABINET & CLIENT INFO ═══ *@
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 px-4 pt-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-building text-primary me-2"></i>Cabinet Comptable</h6>
            </div>
            <div class="card-body pt-2">
                <div class="fw-semibold text-primary">@cabinetName</div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 px-4 pt-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-person-badge text-info me-2"></i>Contribuable</h6>
            </div>
            <div class="card-body pt-2">
                <div class="row g-2">
                    <div class="col-md-6"><span class="text-muted small">Raison Sociale</span><div class="fw-semibold">@(client?.RaisonSociale ?? declaration?.ClientName ?? "-")</div></div>
                    <div class="col-md-3"><span class="text-muted small">ICE</span><div class="fw-semibold">@(client?.ICE ?? "-")</div></div>
                    <div class="col-md-3"><span class="text-muted small">IF</span><div class="fw-semibold">@(client?.IF ?? "-")</div></div>
                    <div class="col-md-3"><span class="text-muted small">RC</span><div>@(client?.RC ?? "-")</div></div>
                    <div class="col-md-3"><span class="text-muted small">Patente</span><div>@(client?.NumeroPatente ?? "-")</div></div>
                    <div class="col-md-3"><span class="text-muted small">CNSS</span><div>@(client?.NumeroCNSS ?? "-")</div></div>
                    <div class="col-md-3"><span class="text-muted small">Régime TVA</span><div>@(client?.TypeTVA ?? "-")</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ═══ RÉSUMÉ TVA — Règle Maroc ═══ *@
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-0 px-4 pt-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-calculator text-primary me-2"></i>Résumé TVA (Maroc)</h6>
        <p class="text-muted small mb-0 mt-1">
            <strong>TVA à payer = TVA facturée − TVA déductible</strong>
            (si déductible &gt; facturée → crédit de TVA, rien à payer).
        </p>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card bg-danger bg-opacity-10 border-0 rounded-3 p-3 h-100">
                    <h6 class="fw-semibold text-danger mb-2">
                        <i class="bi bi-arrow-up-circle me-1"></i>TVA Facturée (Ventes)
                    </h6>
                    <p class="small text-muted mb-3">TVA que vous facturez à vos clients sur vos ventes.</p>
                    <div class="row g-2">
                        <div class="col-6"><span class="text-muted small d-block">CA HT 20%</span><span class="fw-bold">@Model.CAHT_20.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">TVA 20%</span><span class="fw-bold text-danger">@Model.TVA_20.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">CA HT 14%</span><span class="fw-bold">@Model.CAHT_14.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">TVA 14%</span><span class="fw-bold text-danger">@Model.TVA_14.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">CA HT 10%</span><span class="fw-bold">@Model.CAHT_10.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">TVA 10%</span><span class="fw-bold text-danger">@Model.TVA_10.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">CA HT 7%</span><span class="fw-bold">@Model.CAHT_7.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">TVA 7%</span><span class="fw-bold text-danger">@Model.TVA_7.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">CA Exonéré</span><span class="fw-bold">@Model.CAExonere.ToString("N2")</span></div>
                        <div class="col-6"></div>
                        <div class="col-12 border-top pt-2 mt-2">
                            <span class="text-muted small d-block">Total TVA Facturée</span>
                            <span class="fw-bold text-danger fs-5">@Model.TVACollecteeTotale.ToString("N2") MAD</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-success bg-opacity-10 border-0 rounded-3 p-3 h-100">
                    <h6 class="fw-semibold text-success mb-2">
                        <i class="bi bi-arrow-down-circle me-1"></i>TVA Déductible (Achats)
                    </h6>
                    <p class="small text-muted mb-3">TVA payée à vos fournisseurs sur achats / charges éligibles.</p>
                    <div class="row g-2">
                        <div class="col-6"><span class="text-muted small d-block">Sur charges</span><span class="fw-bold text-success">@Model.TVARecuperableCharges.ToString("N2")</span></div>
                        <div class="col-6"><span class="text-muted small d-block">Sur immobilisations</span><span class="fw-bold text-success">@Model.TVARecuperableImmobilisations.ToString("N2")</span></div>
                        <div class="col-12 border-top pt-2 mt-2">
                            <span class="text-muted small d-block">Total TVA Déductible</span>
                            <span class="fw-bold text-success fs-5">@Model.TVARecuperableTotale.ToString("N2") MAD</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                @{
                    var soldePeriode = Model.TVACollecteeTotale - Model.TVARecuperableTotale;
                    var doitPayer = Model.TVANette > 0;
                    var soldeZero = Model.TVANette == 0;
                }
                <div class="card border-0 rounded-3 p-3 @(doitPayer ? "bg-danger bg-opacity-10" : soldeZero ? "bg-secondary bg-opacity-10" : "bg-success bg-opacity-10")">
                    <h6 class="fw-bold mb-3 text-center">
                        <i class="bi bi-bank me-1"></i>Calcul : TVA facturée − TVA déductible
                    </h6>
                    <div class="row align-items-center g-2 mb-3 text-center">
                        <div class="col-md-3">
                            <span class="text-muted small d-block">TVA Facturée</span>
                            <span class="fw-bold text-danger fs-5">@Model.TVACollecteeTotale.ToString("N2")</span>
                        </div>
                        <div class="col-md-1"><i class="bi bi-dash-lg fs-4"></i></div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">TVA Déductible</span>
                            <span class="fw-bold text-success fs-5">@Model.TVARecuperableTotale.ToString("N2")</span>
                        </div>
                        <div class="col-md-1"><i class="bi bi-equals fs-4"></i></div>
                        <div class="col-md-4">
                            <span class="text-muted small d-block">Solde période</span>
                            <span class="fw-bold fs-5 @(soldePeriode > 0 ? "text-danger" : soldePeriode < 0 ? "text-success" : "text-secondary")">@soldePeriode.ToString("N2") MAD</span>
                        </div>
                    </div>
                    @if (Model.CreditPrecedent != 0)
                    {
                        <div class="row align-items-center g-2 mb-3 text-center border-top pt-3">
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Solde période</span>
                                <span class="fw-bold">@soldePeriode.ToString("N2")</span>
                            </div>
                            <div class="col-md-1"><i class="bi bi-dash-lg fs-4"></i></div>
                            <div class="col-md-3">
                                <span class="text-muted small d-block">Crédit TVA reporté</span>
                                <span class="fw-bold text-success">@Model.CreditPrecedent.ToString("N2")</span>
                            </div>
                            <div class="col-md-1"><i class="bi bi-equals fs-4"></i></div>
                            <div class="col-md-3">
                                <span class="text-muted small d-block">Solde après crédit</span>
                                <span class="fw-bold @(doitPayer ? "text-danger" : soldeZero ? "text-secondary" : "text-success")">@Model.TVANette.ToString("N2")</span>
                            </div>
                        </div>
                    }
                    <div class="text-center border-top pt-3">
                        @if (doitPayer)
                        {
                            <div class="alert alert-danger mb-0 py-3">
                                <div class="fw-bold fs-5 mb-1"><i class="bi bi-exclamation-triangle me-1"></i>TVA À PAYER</div>
                                <div class="fs-3 fw-bold">@Model.TVAaPayer.ToString("N2") MAD</div>
                                <div class="small mt-1">
                                    Vous avez collecté <strong>@Model.TVACollecteeTotale.ToString("N2") MAD</strong> de TVA facturée auprès de vos clients,
                                    et vous pouvez déduire <strong>@Model.TVARecuperableTotale.ToString("N2") MAD</strong> déjà payés sur vos achats.
                                    Différence à verser à la DGI : <strong>@Model.TVAaPayer.ToString("N2") MAD</strong>.
                                </div>
                            </div>
                        }
                        else if (soldeZero)
                        {
                            <div class="alert alert-secondary mb-0 py-3">
                                <div class="fw-bold fs-5 mb-1"><i class="bi bi-check-circle me-1"></i>Solde nul</div>
                                <div class="small mt-1">TVA facturée = TVA déductible@(Model.CreditPrecedent != 0 ? " (après crédit reporté)" : ""). Rien à payer.</div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mb-0 py-3">
                                <div class="fw-bold fs-5 mb-1"><i class="bi bi-arrow-repeat me-1"></i>CRÉDIT DE TVA — rien à payer</div>
                                <div class="fs-3 fw-bold">@Model.CreditTVA.ToString("N2") MAD</div>
                                <div class="small mt-1">
                                    La TVA déductible (@Model.TVARecuperableTotale.ToString("N2") MAD) est supérieure à la TVA facturée (@Model.TVACollecteeTotale.ToString("N2") MAD).
                                    Ce crédit peut être reporté sur la période suivante selon les règles marocaines.
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ═══ SAISIE MANUELLE SIMPLE (Maroc) ═══ *@
<form asp-action="EditTVA" asp-route-id="@Model.DeclarationId" method="post" id="formAjustementsTva">
    @Html.AntiForgeryToken()
    <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-primary border-4">
        <div class="card-header bg-transparent border-0 px-4 pt-3">
            <h6 class="fw-bold mb-0"><i class="bi bi-sliders text-primary me-2"></i>Saisie manuelle TVA</h6>
            <p class="text-muted small mb-0 mt-1">
                <strong>TVA à payer = TVA facturée − TVA déductible − crédit déclaration précédente</strong>
            </p>
        </div>
        <div class="card-body">
            <div class="alert alert-light border py-2 mb-3" style="font-size:0.85rem;">
                <i class="bi bi-info-circle me-1"></i>
                Exemple : facturée 20 000 − déductible 12 000 = <strong>8 000 à payer</strong>.
                Si des factures sont saisies ci-dessous, elles remplacent automatiquement le côté concerné.
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label asp-for="TVACollecteeTotale" class="form-label fw-semibold text-danger">TVA Facturée</label>
                    <input asp-for="TVACollecteeTotale" class="form-control form-control-lg" type="number" step="0.01" min="0" id="inputTvaFacturee" />
                    <small class="text-muted">TVA collectée sur vos ventes</small>
                </div>
                <div class="col-md-3">
                    <label asp-for="TVARecuperableTotale" class="form-label fw-semibold text-success">TVA Déductible</label>
                    <input asp-for="TVARecuperableTotale" class="form-control form-control-lg" type="number" step="0.01" min="0" id="inputTvaDeductible" />
                    <small class="text-muted">TVA payée sur achats éligibles</small>
                </div>
                <div class="col-md-3">
                    <label asp-for="CreditPrecedent" class="form-label fw-semibold">Crédit déclaration précédente</label>
                    <input asp-for="CreditPrecedent" class="form-control form-control-lg" type="number" step="0.01" min="0" id="inputCreditPrecedent" />
                    <small class="text-muted">Crédit de TVA reporté (si existant)</small>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded-3 bg-light border text-center" id="previewSoldeBox">
                        <span class="text-muted small d-block">Résultat</span>
                        <span class="fw-bold fs-5" id="previewSoldeLabel">—</span>
                        <div class="fw-bold fs-4" id="previewSoldeMontant">0,00 MAD</div>
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i>Enregistrer le calcul
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
<script>
(function () {
    const facturee = document.getElementById('inputTvaFacturee');
    const deductible = document.getElementById('inputTvaDeductible');
    const credit = document.getElementById('inputCreditPrecedent');
    const label = document.getElementById('previewSoldeLabel');
    const montant = document.getElementById('previewSoldeMontant');
    const box = document.getElementById('previewSoldeBox');
    if (!facturee || !deductible || !credit) return;

    function fmt(n) {
        return n.toLocaleString('fr-MA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MAD';
    }
    function recalc() {
        const f = parseFloat(facturee.value) || 0;
        const d = parseFloat(deductible.value) || 0;
        const c = parseFloat(credit.value) || 0;
        const net = f - d - c;
        box.classList.remove('border-danger', 'border-success', 'border-secondary');
        if (net > 0) {
            label.textContent = 'TVA À PAYER';
            label.className = 'fw-bold fs-5 text-danger';
            montant.textContent = fmt(net);
            montant.className = 'fw-bold fs-4 text-danger';
            box.classList.add('border-danger');
        } else if (net < 0) {
            label.textContent = 'CRÉDIT DE TVA';
            label.className = 'fw-bold fs-5 text-success';
            montant.textContent = fmt(Math.abs(net));
            montant.className = 'fw-bold fs-4 text-success';
            box.classList.add('border-success');
        } else {
            label.textContent = 'Solde nul';
            label.className = 'fw-bold fs-5 text-secondary';
            montant.textContent = fmt(0);
            montant.className = 'fw-bold fs-4 text-secondary';
            box.classList.add('border-secondary');
        }
    }
    [facturee, deductible, credit].forEach(el => el.addEventListener('input', recalc));
    recalc();
})();
</script>

@* ═══════════════════════════════════════════════════════════════ *@
@* FACTURES DE VENTE — TVA FACTURÉE                                 *@
@* ═══════════════════════════════════════════════════════════════ *@
<div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-danger border-4">
    <div class="card-header bg-transparent border-0 px-4 pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h6 class="fw-bold mb-0 text-danger">
                <i class="bi bi-cart-check me-2"></i>Factures de vente — TVA Facturée
            </h6>
            <small class="text-muted">Opérations de vente / prestations clients (@lignesVente.Count ligne(s))</small>
        </div>
        <button class="btn btn-sm btn-danger rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#addLigneVenteForm">
            <i class="bi bi-plus-circle me-1"></i> Ajouter une facture de vente
        </button>
    </div>

    <div class="collapse" id="addLigneVenteForm">
        <div class="card-body border-top bg-danger bg-opacity-10">
            @{
                ViewData["DeclarationId"] = Model.DeclarationId;
                ViewData["TypeOperation"] = "Vente";
                ViewData["PartnerLabel"] = "Client";
                ViewData["SubmitLabel"] = "Ajouter la facture de vente";
                ViewData["SubmitClass"] = "btn-danger";
            }
            @await Html.PartialAsync("_TVALigneForm")
        </div>
    </div>

    <div class="card-body p-0">
        @{
            ViewData["DeclarationId"] = Model.DeclarationId;
            ViewData["EmptyMessage"] = "Aucune facture de vente. Ajoutez les factures clients pour calculer la TVA facturée.";
            ViewData["PartnerHeader"] = "Client";
            ViewData["OperationBadgeClass"] = "bg-danger-subtle text-danger";
            ViewData["OperationBadgeText"] = "Facturée";
            ViewData["ShowTotals"] = true;
            ViewData["TotalsLabel"] = "Total ventes";
            ViewData["TotalsClass"] = "text-danger";
        }
        @await Html.PartialAsync("_TVALignesTable", lignesVente)
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════ *@
@* FACTURES D'ACHAT — TVA RÉCUPÉRABLE                               *@
@* ═══════════════════════════════════════════════════════════════ *@
<div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-success border-4">
    <div class="card-header bg-transparent border-0 px-4 pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h6 class="fw-bold mb-0 text-success">
                <i class="bi bi-bag-check me-2"></i>Factures d’achat — TVA Déductible
            </h6>
            <small class="text-muted">Achats / charges fournisseurs (@lignesAchat.Count ligne(s))</small>
        </div>
        <button class="btn btn-sm btn-success rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#addLigneAchatForm">
            <i class="bi bi-plus-circle me-1"></i> Ajouter une facture d’achat (déductible)
        </button>
    </div>

    <div class="collapse" id="addLigneAchatForm">
        <div class="card-body border-top bg-success bg-opacity-10">
            @{
                ViewData["DeclarationId"] = Model.DeclarationId;
                ViewData["TypeOperation"] = "Achat";
                ViewData["PartnerLabel"] = "Fournisseur";
                ViewData["SubmitLabel"] = "Ajouter la facture d’achat";
                ViewData["SubmitClass"] = "btn-success";
            }
            @await Html.PartialAsync("_TVALigneForm")
        </div>
    </div>

    <div class="card-body p-0">
        @{
            ViewData["DeclarationId"] = Model.DeclarationId;
            ViewData["EmptyMessage"] = "Aucune facture d’achat. Ajoutez les factures fournisseurs pour la TVA déductible.";
            ViewData["PartnerHeader"] = "Fournisseur";
            ViewData["OperationBadgeClass"] = "bg-success-subtle text-success";
            ViewData["OperationBadgeText"] = "Déductible";
            ViewData["ShowTotals"] = true;
            ViewData["TotalsLabel"] = "Total achats (TVA déductible)";
            ViewData["TotalsClass"] = "text-success";
        }
        @await Html.PartialAsync("_TVALignesTable", lignesAchat)
    </div>
</div>

@* ═══ IMPORT LIGNES FROM CSV ═══ *@
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-0 px-4 pt-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-file-earmark-arrow-up text-info me-2"></i>Importer des lignes depuis un fichier CSV</h6>
        <a asp-action="DownloadTVATemplate" class="btn btn-sm btn-outline-primary rounded-pill px-3">
            <i class="bi bi-download me-1"></i> Télécharger le modèle CSV
        </a>
    </div>
    <div class="card-body">
        <div class="alert alert-info mb-3 py-2 small">
            <i class="bi bi-info-circle me-1"></i>
            <strong>Format attendu :</strong> Fichier CSV séparateur <code>;</code> — Colonnes :
            <code>TypePiece;NumeroFacture;DateFacture;FournisseurClient;ICE;IdentifiantFiscal;Description;MontantHT;TauxTVA;TypeOperation;Regime</code>
            <br/>
            <strong>TypeOperation :</strong> <code>Vente</code> = TVA facturée &nbsp;|&nbsp; <code>Achat</code> = TVA déductible
        </div>
        <form asp-action="ImportTVALignes" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="declarationId" value="@Model.DeclarationId" />
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label small fw-semibold">Fichier CSV</label>
                    <input type="file" name="fichierCSV" class="form-control" accept=".csv,.txt" required />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-info rounded-pill px-4 w-100">
                        <i class="bi bi-upload me-1"></i> Importer les lignes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@* ═══ EDI EXPORT SECTION ═══ *@
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-0 px-4 pt-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-filetype-xml text-success me-2"></i>Télédéclaration EDI — Export XML</h6>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Générez le fichier XML au format EDI pour la télédéclaration TVA auprès de la DGI (Simpl-TVA).
            Le fichier inclut : les informations du cabinet, du contribuable (ICE, IF, RC), le détail du CA par taux,
            la TVA facturée/récupérable, et toutes les lignes de factures.
        </p>
        <div class="d-flex gap-2">
            <a asp-action="ExportTVAXml" asp-route-id="@Model.DeclarationId" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-download me-1"></i> Télécharger XML EDI
            </a>
        </div>
    </div>
</div>
