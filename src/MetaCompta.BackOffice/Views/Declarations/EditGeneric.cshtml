@using MetaCompta.Application.DTOs
@using MetaCompta.Domain.Common
@model DeclarationDto
@{
    var entry = ViewBag.CatalogEntry as DeclarationServiceCatalog.Entry;
    var title = entry?.DisplayName ?? Model.Type;
    ViewData["Title"] = $"Modifier {title}";
    var declaration = ViewBag.Declaration as DeclarationDto ?? Model;
}

@await Html.PartialAsync("_WorkflowActionBar")

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a href="@Url.Action(DeclarationServiceCatalog.GetListAction(Model.Type), "Declarations")">@(DeclarationServiceCatalog.Get(Model.Type)?.DisplayName ?? Model.Type)</a></li>
                <li class="breadcrumb-item"><a href="/Declarations/Details/@Model.Id">Détails</a></li>
                <li class="breadcrumb-item active">Modifier</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0"><i class="bi bi-file-earmark-text text-primary me-2"></i>@title — @Model.Periode</h4>
        <p class="text-muted small mb-0 mt-1">
            Client : <strong>@Model.ClientName</strong>
            @if (entry != null)
            {
                <span class="mx-1">|</span>@entry.Frequency
            }
            <span class="mx-1">|</span>Échéance : @Model.DateLimite.ToString("dd/MM/yyyy")
        </p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Retour
    </a>
</div>

<div class="alert alert-info py-2 mb-4" style="font-size:0.85rem;">
    <i class="bi bi-info-circle me-1"></i>
    Même cycle que la TVA : <strong>contrat actif → saisie → workflow / Mes tâches → validation → dépôt</strong>.
    La saisie détaillée métier pour ce type sera enrichie progressivement ; vous pouvez déjà enregistrer les montants et avancer le workflow.
</div>

<form asp-action="EditGeneric" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-transparent border-0 px-4 pt-3">
            <h6 class="fw-bold mb-0"><i class="bi bi-calculator text-primary me-2"></i>Saisie — @title</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-danger">Montant à payer (MAD)</label>
                    <input name="montantDu" type="number" step="0.01" min="0" class="form-control form-control-lg"
                           value="@(Model.MontantDu?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                    <small class="text-muted">Montant dû à l’administration</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-success">Crédit / report (MAD)</label>
                    <input name="montantCredit" type="number" step="0.01" min="0" class="form-control form-control-lg"
                           value="@(Model.MontantCredit?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                    <small class="text-muted">Crédit éventuel à reporter</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Notes / commentaire</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Références, acomptes, observations…"></textarea>
                </div>
                @{
                    var typeHint = Model.Type?.ToUpperInvariant();
                }
                @if (typeHint == "ACOMPTES")
                {
                    <div class="col-12">
                        <div class="alert alert-light border mb-0 small d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span><strong>Acompte IS :</strong> en principe 25 % de l’IS de l’exercice précédent — échéances 31/03, 30/06, 30/09, 31/12.</span>
                            <form asp-action="SuggestAcompte" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">Suggérer 25% IS N-1</button>
                            </form>
                        </div>
                    </div>
                }
                else if (typeHint == "IR_SAL" || typeHint == "IR_SALAIRES")
                {
                    <div class="col-12">
                        <div class="alert alert-light border mb-0 small">
                            <strong>IR / Salaires :</strong> retenue à la source mensuelle sur salaires — cohérente avec la paie et le D.T.S (9421).
                        </div>
                    </div>
                }
                else if (typeHint == "DTS")
                {
                    <div class="col-12">
                        <div class="alert alert-light border mb-0 small">
                            <strong>D.T.S / État 9421 :</strong> déclaration annuelle des traitements et salaires — exercice Jan–Déc,
                            échéance <strong>31 mars N+1</strong> (portail DGI / SIMPL-Salaires). Saisie détaillée des lignes salariés à venir ; enregistrez déjà les montants et avancez le workflow.
                        </div>
                    </div>
                }
                else if (typeHint == "REG_IS" || typeHint == "DRF" || typeHint == "CM")
                {
                    <div class="col-12">
                        <div class="alert alert-light border mb-0 small d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span><strong>Clôture IS :</strong> régularisation = max(IS, CM) − acomptes ; dépôt D.R.F avant le 31 mars N+1.</span>
                            <form asp-action="SuggestRegIs" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">Calculer depuis liasse IS</button>
                            </form>
                        </div>
                    </div>
                }
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i>Enregistrer
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
