@using MetaCompta.Application.DTOs
@using MetaCompta.Domain.Common
@model PagedResult<DeclarationDto>
@{
    ViewData["Title"] = "Déclarations Fiscales & Sociales";
    var refTypes = ViewData["Ref_TYPE_DECLARATION"] as List<ReferenceDataDto> ?? new();
    var refStatuts = ViewData["Ref_STATUT_DECLARATION"] as List<ReferenceDataDto> ?? new();
    var hasActiveContract = ViewBag.HasActiveContract as bool? ?? false;
    var canCreate = ViewBag.CanCreateDeclaration as bool? ?? false;
    var canEdit = ViewBag.CanEditDeclaration as bool? ?? false;
    var reasonLabel = ViewBag.ContractAccessReasonLabel as string ?? "Mode consultation uniquement.";
    string? currentType = ViewBag.Type as string;

    var activeServicesJson = Context.Session.GetString("ActiveServices") ?? "[]";
    var activeServices = System.Text.Json.JsonSerializer.Deserialize<List<string>>(activeServicesJson) ?? new List<string>();
    bool HasClaimDomain(string domain) => PermissionHelper.HasAnyDomain(Context.Session, domain);
    bool HasService(string declarationType)
    {
        var entry = DeclarationServiceCatalog.Get(declarationType);
        if (entry == null) return false;
        return HasClaimDomain(entry.ClaimDomain) && DeclarationServiceCatalog.HasContractService(declarationType, activeServices);
    }

    var catalogForMenu = DeclarationServiceCatalog.ForMenu(activeServices)
        .Where(e => HasClaimDomain(e.ClaimDomain))
        .ToList();

    var sectionTitles = DeclarationServiceCatalog.All.ToDictionary(e => e.DeclarationType, e => e.DisplayName, StringComparer.OrdinalIgnoreCase);
    var pageTitle = currentType != null && sectionTitles.ContainsKey(currentType) ? sectionTitles[currentType] : "Déclarations Fiscales & Sociales";
    var pageSubtitle = currentType != null
        ? (DeclarationServiceCatalog.Get(currentType)?.Frequency ?? "") + " — même cycle contrat / workflow / tâches que la TVA"
        : "Suivi de toutes les déclarations du catalogue cabinet";
    var pageIcon = "bi-file-earmark-text text-primary";
    var btnColor = "btn-primary";
    var needsAnnee = DeclarationServiceCatalog.Get(currentType)?.NeedsAnneeFiscale == true;
    var hasServiceForType = currentType == null || HasService(currentType);
    var listAction = DeclarationServiceCatalog.GetListAction(currentType);
    var createAction = DeclarationServiceCatalog.GetCreateAction(currentType);
    string? statutFilter = ViewBag.Statut as string;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi @pageIcon me-2"></i>@pageTitle</h4>
        <p class="text-muted mb-0">@pageSubtitle</p>
    </div>
    <div>
        @if (canCreate && hasServiceForType)
        {
            @if (currentType != null)
            {
                @* -- SECTION-SPECIFIC: Direct create button (no dropdown) -- *@
                @if (needsAnnee)
                {
                    @* IS / IR => open modal for année fiscale *@
                    <button class="btn @btnColor rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createDeclarationModal">
                        <i class="bi bi-plus-circle me-2"></i> Nouvelle Déclaration @currentType
                    </button>
                }
                else
                {
                    @* TVA / CNSS => direct form submit, no modal needed *@
                    <form method="post" asp-action="@createAction" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn @btnColor rounded-pill px-4 shadow-sm">
                            <i class="bi bi-plus-circle me-2"></i> Nouvelle Déclaration @currentType
                        </button>
                    </form>
                }
            }
            else
            {
                @* -- HISTORIQUE: one create button per catalogue service on the contract -- *@
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var e in catalogForMenu)
                    {
                        if (e.NeedsAnneeFiscale)
                        {
                            <button class="btn btn-outline-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createDeclarationModal" onclick="setDeclarationType('@e.DeclarationType')">
                                <i class="bi bi-plus-circle me-1"></i> @e.DeclarationType
                            </button>
                        }
                        else
                        {
                            <form method="post" asp-action="@e.CreateAction" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-primary rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-plus-circle me-1"></i> @e.DeclarationType
                                </button>
                            </form>
                        }
                    }
                </div>
            }
        }
        else if (!hasActiveContract)
        {
            <span class="btn btn-outline-secondary rounded-pill px-4 disabled" title="@reasonLabel">
                <i class="bi bi-lock me-2"></i> Consultation
            </span>
        }
        else if (!canCreate)
        {
            <span class="btn btn-outline-secondary rounded-pill px-4 disabled" title="Permission declaration.create requise">
                <i class="bi bi-lock me-2"></i> Création non autorisée
            </span>
        }
        else
        {
            <span class="btn btn-outline-secondary rounded-pill px-4 disabled" title="Ce service n'est pas activé pour ce client">
                <i class="bi bi-lock me-2"></i> Service @currentType non activé
            </span>
        }
    </div>
</div>

@if (!hasActiveContract)
{
    <div class="alert alert-warning rounded-3 d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-5"></i>
        <div>
            <strong>Mode consultation.</strong> @reasonLabel
            <a href="@Url.Action("Contrats", "Commercial")" class="alert-link ms-1"><i class="bi bi-arrow-right me-1"></i>Gérer les contrats</a>
        </div>
    </div>
}
else if (!canCreate)
{
    <div class="alert alert-info rounded-3 d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-info-circle-fill text-info me-3 fs-5"></i>
        <div>
            <strong>Création désactivée.</strong> Votre rôle ne dispose pas de la permission <code>declaration.create</code>.
        </div>
    </div>
}

<!-- Stats Cards -->
@if (Model != null)
{
    var total = Model.TotalCount;
    var enAttente = Model.Items?.Count(d => d.Statut == RefCodes.StatutDeclaration.Brouillon
        || d.Statut == RefCodes.StatutDeclaration.EnCours
        || d.Statut == RefCodes.StatutDeclaration.ACompleter
        || d.Statut == RefCodes.StatutDeclaration.CreeeParSysteme
        || d.Statut == RefCodes.StatutDeclaration.DocumentsDemandes
        || d.Statut == RefCodes.StatutDeclaration.EnAttenteCorrection
        || d.Statut == RefCodes.StatutDeclaration.ACorriger) ?? 0;
    var validees = Model.Items?.Count(d => d.Statut == RefCodes.StatutDeclaration.Validee
        || d.Statut == RefCodes.StatutDeclaration.Soumise
        || d.Statut == RefCodes.StatutDeclaration.EnvoyeeSimplTva
        || d.Statut == RefCodes.StatutDeclaration.Deposee) ?? 0;
    var overdue = Model.Items?.Count(d => d.DateLimite < DateTime.Today
        && d.Statut != RefCodes.StatutDeclaration.Payee
        && d.Statut != RefCodes.StatutDeclaration.Soumise
        && d.Statut != RefCodes.StatutDeclaration.Deposee
        && d.Statut != RefCodes.StatutDeclaration.Cloturee
        && d.Statut != RefCodes.StatutDeclaration.Archivee) ?? 0;

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card" style="border-left: 4px solid var(--primary);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Total Déclarations</div>
                        <div class="stat-value">@total</div>
                    </div>
                    <div class="stat-icon" style="background: rgba(14,165,233,0.1); color: var(--primary);">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card" style="border-left: 4px solid var(--warning);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">En Attente / En Cours</div>
                        <div class="stat-value">@enAttente</div>
                    </div>
                    <div class="stat-icon" style="background: rgba(245,158,11,0.1); color: var(--warning);">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card" style="border-left: 4px solid var(--secondary);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Validées / Soumises</div>
                        <div class="stat-value">@validees</div>
                    </div>
                    <div class="stat-icon" style="background: rgba(16,185,129,0.1); color: var(--secondary);">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card" style="border-left: 4px solid var(--mc-danger);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">En Retard</div>
                        <div class="stat-value text-danger">@overdue</div>
                    </div>
                    <div class="stat-icon" style="background: rgba(220,38,38,0.1); color: var(--mc-danger);">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="@listAction" class="row g-2 align-items-end">
            @if (currentType == null)
            {
                @* Historique — type dropdown; Index redirects typed selections to list actions *@
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Type</label>
                    <select name="type" class="form-select">
                        <option value="">Tous les types</option>
                        @foreach (var e in DeclarationServiceCatalog.All)
                        {
                            <option value="@e.DeclarationType">@e.DisplayName</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Statut</label>
                <select name="statut" class="form-select">
                    <option value="">Tous les statuts</option>
                    @foreach (var st in refStatuts)
                    {
                        var sel = ViewBag.Statut?.ToString() == st.Code ? "selected" : "";
                        <option value="@st.Code" @sel>@st.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3"><i class="bi bi-funnel me-1"></i> Filtrer</button>
            </div>
            <div class="col-md-2">
                <a href="@Url.Action(listAction)" class="btn btn-outline-secondary w-100 rounded-3"><i class="bi bi-arrow-clockwise me-1"></i> Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<!-- Declarations Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 mc-table" id="declarationsTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Réf.</th>
                        <th>Client</th>
                        <th>Type</th>
                        <th>Période</th>
                        <th>Échéance</th>
                        <th class="text-end">Montant Dû</th>
                        <th>Statut</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        @foreach (var dec in Model.Items)
                        {
                            var refStat = refStatuts.FirstOrDefault(s => s.Code == dec.Statut);
                            var daysLeft = (dec.DateLimite - DateTime.Today).Days;
                            var isOverdue = daysLeft < 0 && dec.Statut != RefCodes.StatutDeclaration.Payee && dec.Statut != RefCodes.StatutDeclaration.Soumise;
                            var isUrgent = daysLeft >= 0 && daysLeft <= 5 && dec.Statut != RefCodes.StatutDeclaration.Payee && dec.Statut != RefCodes.StatutDeclaration.Soumise;

                            <tr class="@(isOverdue ? "table-danger" : isUrgent ? "table-warning" : "")">
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@dec.Id" class="fw-semibold text-decoration-none">#@dec.Id</a>
                                </td>
                                <td><span class="fw-medium">@dec.ClientName</span></td>
                                <td>
                                    @{
                                        var typeColor = dec.Type switch
                                        {
                                            RefCodes.TypeDeclaration.TVA => "bg-success-subtle text-success",
                                            RefCodes.TypeDeclaration.IS => "bg-primary-subtle text-primary",
                                            RefCodes.TypeDeclaration.IR => "bg-info-subtle text-info",
                                            RefCodes.TypeDeclaration.CNSS => "bg-warning-subtle text-warning",
                                            _ => "bg-secondary-subtle text-secondary"
                                        };
                                    }
                                    <span class="badge @typeColor rounded-pill">@dec.Type</span>
                                </td>
                                <td>@dec.Periode</td>
                                <td>
                                    <div class="@(isOverdue ? "text-danger fw-bold" : isUrgent ? "text-warning fw-semibold" : "")">
                                        @(dec.DateLimite.ToString("dd/MM/yyyy"))
                                    </div>
                                    @if (isOverdue)
                                    {
                                        <small class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>En retard (@Math.Abs(daysLeft) j.)</small>
                                    }
                                    else if (isUrgent)
                                    {
                                        <small class="text-warning"><i class="bi bi-clock me-1"></i>@daysLeft j. restants</small>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (dec.MontantDu.HasValue && dec.MontantDu > 0)
                                    {
                                        <span class="fw-bold">@(dec.MontantDu.Value.ToString("N2"))</span>
                                        <small class="text-muted d-block">MAD</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (refStat != null)
                                    {
                                        <span class="badge rounded-pill" style="background-color:@(refStat.CssClass ?? "#94a3b8");color:#fff;">
                                            <i class="bi @(refStat.Icone ?? "") me-1"></i>@refStat.Label
                                        </span>
                                    }
                                    else
                                    {
                                        var statusClass = RefCodes.StatutDeclaration.BadgeClass(dec.Statut);
                                        <span class="badge @statusClass rounded-pill">@RefCodes.StatutDeclaration.Label(dec.Statut)</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@dec.Id" class="btn btn-outline-primary" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (canEdit && hasActiveContract && (dec.Statut == RefCodes.StatutDeclaration.Brouillon || dec.Statut == RefCodes.StatutDeclaration.ACompleter || dec.Statut == RefCodes.StatutDeclaration.EnCours
                                            || dec.Statut == RefCodes.StatutDeclaration.CreeeParSysteme || dec.Statut == RefCodes.StatutDeclaration.DocumentsDemandes
                                            || dec.Statut == RefCodes.StatutDeclaration.DocumentsRecus || dec.Statut == RefCodes.StatutDeclaration.ControleEnCours
                                            || dec.Statut == RefCodes.StatutDeclaration.CalculTVA || dec.Statut == RefCodes.StatutDeclaration.ACorriger
                                            || dec.Statut == RefCodes.StatutDeclaration.EnAttenteCorrection))
                                        {
                                            var editAct = DeclarationServiceCatalog.GetEditAction(dec.Type);
                                            <a asp-action="@editAct" asp-route-id="@dec.Id" class="btn btn-outline-warning" title="Modifier"><i class="bi bi-pencil"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-text display-4 d-block mb-2 opacity-25"></i>
                                <p class="mb-2">Aucune déclaration trouvée.</p>
                                @if (canCreate && hasActiveContract && hasServiceForType)
                                {
                                    @if (currentType != null && !needsAnnee)
                                    {
                                        <form method="post" asp-action="@createAction" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @btnColor rounded-pill mt-1">
                                                <i class="bi bi-plus-circle me-1"></i> Créer une déclaration @currentType
                                            </button>
                                        </form>
                                    }
                                    else if (currentType != null && needsAnnee)
                                    {
                                        <button class="btn btn-sm @btnColor rounded-pill mt-1" data-bs-toggle="modal" data-bs-target="#createDeclarationModal">
                                            <i class="bi bi-plus-circle me-1"></i> Créer une déclaration @currentType
                                        </button>
                                    }
                                    else
                                    {
                                        <p class="text-muted small">Utilisez les sections TVA, IS, IR ou CNSS dans le menu pour créer une déclaration.</p>
                                    }
                                }
                                else if (!hasActiveContract)
                                {
                                    <span class="text-warning"><i class="bi bi-lock me-1"></i>Un contrat actif est requis pour créer des déclarations.</span>
                                }
                                else if (!canCreate)
                                {
                                    <span class="text-warning"><i class="bi bi-lock me-1"></i>Permission declaration.create requise.</span>
                                }
                                else
                                {
                                    <span class="text-warning"><i class="bi bi-lock me-1"></i>Le service @currentType n'est pas activé pour ce client.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model != null && Model.TotalPages > 1)
{
    <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action(listAction, new { page = Model.Page - 1, statut = statutFilter })">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action(listAction, new { page = i, statut = statutFilter })">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action(listAction, new { page = Model.Page + 1, statut = statutFilter })">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<!-- Create Declaration Modal (types needing année fiscale) -->
<div class="modal fade" id="createDeclarationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createModalTitle">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Nouvelle Déclaration @(currentType ?? "")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="@(currentType != null ? createAction : "Create")" id="createDeclForm">
                @Html.AntiForgeryToken()
                @if (currentType == null)
                {
                    <input type="hidden" name="type" id="createDeclType" value="IS" />
                }
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Année Fiscale <span class="text-danger">*</span></label>
                        <input type="number" name="anneeFiscale" id="anneeFiscaleInput" class="form-control" value="@DateTime.Now.Year" min="2020" max="2030" required />
                        <small class="text-muted">Année d'exercice pour la déclaration.</small>
                    </div>
                    <div class="alert alert-info rounded-3 mb-0" style="font-size:0.85rem;">
                        <i class="bi bi-info-circle me-1"></i>
                        La déclaration sera créée avec le statut <strong>À Compléter</strong>.
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i> Créer la Déclaration
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var createActionByType = {
@foreach (var e in DeclarationServiceCatalog.All)
{
        @:        '@e.DeclarationType': '@e.CreateAction',
}
    };
    function setDeclarationType(type) {
        var typeInput = document.getElementById('createDeclType');
        if (typeInput) typeInput.value = type;
        var form = document.getElementById('createDeclForm');
        if (form && createActionByType[type]) {
            form.setAttribute('action', '@Url.Content("~/Declarations/")' + createActionByType[type]);
        }
        var entryTitle = type;
        document.getElementById('createModalTitle').innerHTML = '<i class="bi bi-plus-circle text-primary me-2"></i>Nouvelle Déclaration ' + entryTitle;
    }
</script>
}
