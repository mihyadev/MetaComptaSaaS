@model EmployeeCreateDto
@{
    ViewData["Title"] = "Nouvel Employé";
    var clients = ViewBag.Clients as List<ClientDto> ?? new List<ClientDto>();
}

<div class="page-header mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-person-plus-fill text-primary me-2"></i>Créer un Nouvel Employé</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Employees")">Employés</a></li>
                <li class="breadcrumb-item active">Nouvel employé</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Index", "Employees")" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Erreur de validation :</strong>
        @Html.ValidationSummary(true)
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" asp-action="Create" id="formCreateEmployee">
    @Html.AntiForgeryToken()

    <!-- Wizard Progress Bar -->
    <div class="mc-card mb-4">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center" id="wizardProgress">
                <div class="wizard-step active" data-step="0">
                    <div class="wizard-step-circle"><i class="bi bi-person-vcard"></i></div>
                    <span class="wizard-step-label">Identité</span>
                </div>
                <div class="wizard-connector"></div>
                <div class="wizard-step" data-step="1">
                    <div class="wizard-step-circle"><i class="bi bi-briefcase"></i></div>
                    <span class="wizard-step-label">Professionnel</span>
                </div>
                <div class="wizard-connector"></div>
                <div class="wizard-step" data-step="2">
                    <div class="wizard-step-circle"><i class="bi bi-cash-stack"></i></div>
                    <span class="wizard-step-label">Rémunération</span>
                </div>
                <div class="wizard-connector"></div>
                <div class="wizard-step" data-step="3">
                    <div class="wizard-step-circle"><i class="bi bi-bank2"></i></div>
                    <span class="wizard-step-label">Banque</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 1: Identity -->
    <div class="mc-card step-panel" id="step0">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 px-4 pt-4 pb-0">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-person-vcard"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Identité Personnelle</h5>
                <small class="text-muted">Informations d'identité de l'employé</small>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Client / Entreprise <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-building text-muted"></i></span>
                        <select name="ClientId" class="form-select border-start-0" required>
                            <option value="">— Sélectionner un client —</option>
                            @foreach (var c in clients)
                            {
                                if (Model?.ClientId == c.Id)
                                {
                                    <option value="@c.Id" selected>@c.RaisonSociale</option>
                                }
                                else
                                {
                                    <option value="@c.Id">@c.RaisonSociale</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">CIN <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-fingerprint text-muted"></i></span>
                        <input type="text" name="CIN" class="form-control border-start-0" value="@Model?.CIN" required
                            placeholder="Ex: AB123456" />
                    </div>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nom <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" name="Nom" class="form-control border-start-0" value="@Model?.Nom" required
                            placeholder="Nom de famille" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Prénom <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" name="Prenom" class="form-control border-start-0" value="@Model?.Prenom" required
                            placeholder="Prénom" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Date de Naissance</label>
                    <input type="date" name="DateNaissance" class="form-control"
                        value="@(Model?.DateNaissance?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Lieu de Naissance</label>
                    <input type="text" name="LieuNaissance" class="form-control" value="@Model?.LieuNaissance"
                        placeholder="Ville de naissance" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Sexe</label>
                    <div class="d-flex gap-2 mt-1">
                        <input class="btn-check" type="radio" name="Sexe" id="sexe_M" value="M" @(Model?.Sexe == "M" ? "checked" : "") />
                        <label class="btn btn-outline-primary rounded-pill px-3" for="sexe_M"><i class="bi bi-gender-male me-1"></i>Masculin</label>
                        <input class="btn-check" type="radio" name="Sexe" id="sexe_F" value="F" @(Model?.Sexe == "F" ? "checked" : "") />
                        <label class="btn btn-outline-primary rounded-pill px-3" for="sexe_F"><i class="bi bi-gender-female me-1"></i>Féminin</label>
                    </div>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold">Adresse</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                        <textarea name="Adresse" class="form-control border-start-0" rows="2"
                            placeholder="Adresse complète de résidence">@Model?.Adresse</textarea>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Téléphone Portable</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-phone text-muted"></i></span>
                        <input type="tel" name="TelephonePortable" class="form-control border-start-0"
                            value="@Model?.TelephonePortable" placeholder="+212 6XX-XXXXXX" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" name="Email" class="form-control border-start-0" value="@Model?.Email"
                            placeholder="email@example.com" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Situation Familiale</label>
                    <select name="SituationFamiliale" class="form-select">
                        <option value="">— Sélectionner —</option>
                        <option value="Célibataire" @(Model?.SituationFamiliale == "Célibataire" ? "selected" : "")>Célibataire</option>
                        <option value="Marié" @(Model?.SituationFamiliale == "Marié" ? "selected" : "")>Marié(e)</option>
                        <option value="Divorcé" @(Model?.SituationFamiliale == "Divorcé" ? "selected" : "")>Divorcé(e)</option>
                        <option value="Veuf" @(Model?.SituationFamiliale == "Veuf" ? "selected" : "")>Veuf/Veuve</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Nombre d'Enfants à Charge</label>
                    <input type="number" name="NombreEnfantsACharge" class="form-control"
                        value="@Model?.NombreEnfantsACharge" min="0" />
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Professional -->
    <div class="mc-card step-panel" id="step1" style="display:none;">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 px-4 pt-4 pb-0">
            <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-briefcase"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Informations Professionnelles</h5>
                <small class="text-muted">Contrat, poste et département</small>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">N° CNSS</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                        <input type="text" name="NumeroCNSS" class="form-control border-start-0" value="@Model?.NumeroCNSS"
                            placeholder="Numéro CNSS" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Date d'Embauche <span class="text-danger">*</span></label>
                    <input type="date" name="DateEmbauche" class="form-control"
                        value="@(Model?.DateEmbauche.ToString("yyyy-MM-dd"))" required />
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Type de Contrat</label>
                    <select name="TypeContrat" class="form-select">
                        <option value="">— Sélectionner —</option>
                        <option value="CDI" @(Model?.TypeContrat == "CDI" ? "selected" : "")>CDI - Contrat à Durée Indéterminée</option>
                        <option value="CDD" @(Model?.TypeContrat == "CDD" ? "selected" : "")>CDD - Contrat à Durée Déterminée</option>
                        <option value="Intérim" @(Model?.TypeContrat == "Intérim" ? "selected" : "")>Intérim</option>
                        <option value="Stage" @(Model?.TypeContrat == "Stage" ? "selected" : "")>Stage</option>
                        <option value="Freelance" @(Model?.TypeContrat == "Freelance" ? "selected" : "")>Freelance</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Durée Contrat (mois)</label>
                    <div class="input-group">
                        <input type="number" name="DureeContratMois" class="form-control"
                            value="@Model?.DureeContratMois" placeholder="Pour CDD" min="1" />
                        <span class="input-group-text bg-light">mois</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Poste</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-workspace text-muted"></i></span>
                        <input type="text" name="Poste" class="form-control border-start-0" value="@Model?.Poste"
                            placeholder="Intitulé du poste" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Département</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-diagram-3 text-muted"></i></span>
                        <input type="text" name="Departement" class="form-control border-start-0" value="@Model?.Departement"
                            placeholder="Ex: Comptabilité, RH, Commercial..." />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3: Remuneration -->
    <div class="mc-card step-panel" id="step2" style="display:none;">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 px-4 pt-4 pb-0">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-cash-stack"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Rémunération</h5>
                <small class="text-muted">Salaire, primes et mode de paiement</small>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Salaire de Base <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-exchange text-muted"></i></span>
                        <input type="number" step="0.01" name="SalaireBase" class="form-control border-start-0"
                            value="@Model?.SalaireBase" required placeholder="0.00" />
                        <span class="input-group-text bg-light">MAD</span>
                    </div>
                    <div class="form-text">Salaire mensuel brut</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Mode de Paiement</label>
                    <div class="d-flex gap-2 flex-wrap mt-1">
                        <input class="btn-check" type="radio" name="ModePaiement" id="paye_virement" value="Virement" @(Model?.ModePaiement == "Virement" ? "checked" : "") />
                        <label class="btn btn-outline-success rounded-pill px-3" for="paye_virement"><i class="bi bi-bank me-1"></i>Virement</label>
                        <input class="btn-check" type="radio" name="ModePaiement" id="paye_especes" value="Espèces" @(Model?.ModePaiement == "Espèces" ? "checked" : "") />
                        <label class="btn btn-outline-success rounded-pill px-3" for="paye_especes"><i class="bi bi-cash me-1"></i>Espèces</label>
                        <input class="btn-check" type="radio" name="ModePaiement" id="paye_cheque" value="Chèque" @(Model?.ModePaiement == "Chèque" ? "checked" : "") />
                        <label class="btn btn-outline-success rounded-pill px-3" for="paye_cheque"><i class="bi bi-journal-check me-1"></i>Chèque</label>
                    </div>
                </div>

                <div class="col-12"><hr class="my-1 opacity-25" /></div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Prime d'Ancienneté (MAD)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="PrimeAnciennete" class="form-control"
                            value="@Model?.PrimeAnciennete" placeholder="0.00" />
                        <span class="input-group-text bg-light">MAD</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Indemnité de Transport (MAD)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="IndemniteTransport" class="form-control"
                            value="@Model?.IndemniteTransport" placeholder="0.00" />
                        <span class="input-group-text bg-light">MAD</span>
                    </div>
                </div>

                <!-- Summary Box -->
                <div class="col-12 mt-3">
                    <div class="rounded-3 p-3" style="background: linear-gradient(135deg, rgba(37,99,235,0.05), rgba(124,58,237,0.05)); border: 1px dashed rgba(37,99,235,0.2);">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span class="fw-semibold text-primary">Résumé Estimatif</span>
                        </div>
                        <small class="text-muted">Le salaire net sera calculé automatiquement après déduction CNSS, AMO et IR lors de la génération du bulletin de paie.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 4: Bank -->
    <div class="mc-card step-panel" id="step3" style="display:none;">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 px-4 pt-4 pb-0">
            <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-bank2"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Coordonnées Bancaires</h5>
                <small class="text-muted">RIB et informations de la banque pour le virement</small>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label fw-semibold">RIB (24 chiffres)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-credit-card-2-front text-muted"></i></span>
                        <input type="text" name="RIB" class="form-control border-start-0 font-monospace" value="@Model?.RIB"
                            placeholder="Relevé d'Identité Bancaire" maxlength="24" />
                    </div>
                    <div class="form-text">24 chiffres – obligatoire pour le paiement par virement</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nom de la Banque</label>
                    <select name="NomBanque" class="form-select">
                        <option value="">— Sélectionner —</option>
                        <option value="Attijariwafa Bank" @(Model?.NomBanque == "Attijariwafa Bank" ? "selected" : "")>Attijariwafa Bank</option>
                        <option value="BMCE Bank of Africa" @(Model?.NomBanque == "BMCE Bank of Africa" ? "selected" : "")>BMCE Bank of Africa</option>
                        <option value="Banque Populaire" @(Model?.NomBanque == "Banque Populaire" ? "selected" : "")>Banque Populaire</option>
                        <option value="BMCI" @(Model?.NomBanque == "BMCI" ? "selected" : "")>BMCI</option>
                        <option value="Société Générale Maroc" @(Model?.NomBanque == "Société Générale Maroc" ? "selected" : "")>Société Générale Maroc</option>
                        <option value="Crédit du Maroc" @(Model?.NomBanque == "Crédit du Maroc" ? "selected" : "")>Crédit du Maroc</option>
                        <option value="CIH Bank" @(Model?.NomBanque == "CIH Bank" ? "selected" : "")>CIH Bank</option>
                        <option value="Al Barid Bank" @(Model?.NomBanque == "Al Barid Bank" ? "selected" : "")>Al Barid Bank</option>
                        <option value="CFG Bank" @(Model?.NomBanque == "CFG Bank" ? "selected" : "")>CFG Bank</option>
                        <option value="Bank Al-Amal" @(Model?.NomBanque == "Bank Al-Amal" ? "selected" : "")>Bank Al-Amal</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Agence Bancaire</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo text-muted"></i></span>
                        <input type="text" name="AgenceBancaire" class="form-control border-start-0" value="@Model?.AgenceBancaire"
                            placeholder="Nom de l'agence" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="prevBtn" style="display:none;">
            <i class="bi bi-arrow-left me-1"></i> Précédent
        </button>
        <div class="ms-auto d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-4" id="nextBtn">
                Suivant <i class="bi bi-arrow-right ms-1"></i>
            </button>
            <button type="submit" class="btn btn-success rounded-pill px-4" id="submitBtn" style="display:none;">
                <i class="bi bi-check-lg me-1"></i> Créer l'Employé
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <style>
        .wizard-step { text-align: center; flex: 0 0 auto; cursor: pointer; }
        .wizard-step-circle {
            width: 44px; height: 44px; border-radius: 50%;
            background: #e9ecef; color: #6c757d;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 6px; font-size: 1.1rem;
            transition: all 0.3s ease; border: 2px solid transparent;
        }
        .wizard-step.active .wizard-step-circle {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: #fff; border-color: rgba(37, 99, 235, 0.3);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }
        .wizard-step.completed .wizard-step-circle { background: #059669; color: #fff; }
        .wizard-step-label { font-size: 0.75rem; color: #6c757d; font-weight: 600; }
        .wizard-step.active .wizard-step-label { color: #2563eb; }
        .wizard-step.completed .wizard-step-label { color: #059669; }
        .wizard-connector {
            flex: 1; height: 2px; background: #e9ecef;
            margin: 0 8px; margin-bottom: 22px; transition: background 0.3s ease;
        }
        .wizard-connector.active { background: linear-gradient(90deg, #059669, #2563eb); }
        .step-panel { transition: opacity 0.3s ease; }
    </style>
    <script>
        $(function () {
            var currentStep = 0, totalSteps = 4;
            function showStep(step) {
                $(".step-panel").hide(); $("#step" + step).fadeIn(200); currentStep = step;
                $(".wizard-step").each(function () {
                    var s = parseInt($(this).data("step"));
                    $(this).removeClass("active completed");
                    if (s === step) $(this).addClass("active"); else if (s < step) $(this).addClass("completed");
                });
                $(".wizard-connector").each(function (i) { $(this).toggleClass("active", i < step); });
                $("#prevBtn").toggle(step > 0); $("#nextBtn").toggle(step < totalSteps - 1); $("#submitBtn").toggle(step === totalSteps - 1);
            }
            $("#nextBtn").click(function () { if (currentStep < totalSteps - 1) showStep(currentStep + 1); });
            $("#prevBtn").click(function () { if (currentStep > 0) showStep(currentStep - 1); });
            $(".wizard-step").click(function () { showStep(parseInt($(this).data("step"))); });
            showStep(0);
        });
    </script>
}
