@model MetaCompta.Application.DTOs.DossierJuridiqueCreateDto
@{
    ViewData["Title"] = "Nouveau dossier juridique";
    var client = ViewBag.Client as MetaCompta.Application.DTOs.ClientDto;
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-plus-circle me-2"></i>Nouveau dossier juridique</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Juridique")">Juridique</a></li>
                <li class="breadcrumb-item active">Nouveau</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Index", "Juridique")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Retour
    </a>
</div>

<div class="mc-card">
    <div class="card-header"><i class="bi bi-pencil me-2"></i>Informations du dossier</div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Client</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                        <input type="text" class="form-control bg-light" value="@client?.RaisonSociale" readonly />
                        <input type="hidden" asp-for="ClientId" value="@client?.Id" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Type de dossier <span class="text-danger">*</span></label>
                    <select asp-for="TypeDossier" class="form-select">
                        <option value="">— Sélectionner —</option>
                        <option value="CreationSociete">Création société</option>
                        <option value="ModificationStatuts">Modification statuts</option>
                        <option value="PVAG">PV Assemblée Générale</option>
                        <option value="DepotLegal">Dépôt légal</option>
                        <option value="RC">Registre de commerce</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Objet <span class="text-danger">*</span></label>
                    <input asp-for="Objet" class="form-control" placeholder="Objet du dossier" />
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                        placeholder="Description détaillée..."></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Responsable</label>
                    <input asp-for="Responsable" class="form-control" placeholder="Nom du responsable" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Montant (MAD)</label>
                    <input asp-for="Montant" type="number" step="0.01" class="form-control" placeholder="0.00" />
                </div>
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"
                        placeholder="Notes supplémentaires..."></textarea>
                </div>
            </div>
            <div class="mt-4">
                @if (ViewBag.CanJuridiqueCreate as bool? ?? false)
                {
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Créer le
                        dossier</button>
                }
                <a href="@Url.Action("Index", "Juridique")" class="btn btn-outline-secondary ms-2">Annuler</a>
            </div>
        </form>
    </div>
</div>
