@model MetaCompta.Application.DTOs.EtatFiscalDto
@{
    ViewData["Title"] = "Détails de l'état fiscal";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-file-earmark-text me-2"></i>@Model.Reference</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Accueil</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "EtatsFiscaux")">États Fiscaux</a></li>
                <li class="breadcrumb-item active">Détails</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1"></i> Imprimer</button>
        <a href="@Url.Action("Index", "EtatsFiscaux", new { type = Model.TypeEtat })" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="mc-card">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>Informations</div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr><th class="text-muted" style="width:200px">Référence</th><td class="fw-medium">@Model.Reference</td></tr>
                    <tr><th class="text-muted">Client</th><td>@Model.ClientNom</td></tr>
                    <tr><th class="text-muted">Type d'état</th><td><span class="badge bg-light text-dark">@Model.TypeEtat</span></td></tr>
                    <tr><th class="text-muted">Exercice</th><td>@Model.Exercice</td></tr>
                    <tr><th class="text-muted">Statut</th><td><span class="badge badge-@Model.Statut?.ToLower()">@Model.Statut</span></td></tr>
                    <tr><th class="text-muted">Date génération</th><td>@(Model.DateGeneration?.ToString("dd/MM/yyyy HH:mm"))</td></tr>
                    @if (Model.DateValidation.HasValue)
                    {
                        <tr><th class="text-muted">Date validation</th><td>@(Model.DateValidation.Value.ToString("dd/MM/yyyy HH:mm"))</td></tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.ValidePar))
                    {
                        <tr><th class="text-muted">Validé par</th><td>@Model.ValidePar</td></tr>
                    }
                    @if (Model.MontantTotal > 0)
                    {
                        <tr><th class="text-muted">Montant total</th><td class="fw-bold text-primary">@(Model.MontantTotal?.ToString("N2")) MAD</td></tr>
                    }
                </table>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Donnees))
        {
            <div class="mc-card mt-4">
                <div class="card-header"><i class="bi bi-file-code me-2"></i>Données de l'état</div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded" style="max-height:400px;overflow:auto;font-size:0.8rem;">@Model.Donnees</pre>
                </div>
            </div>
        }
    </div>
    <div class="col-md-4">
        <div class="mc-card">
            <div class="card-header"><i class="bi bi-gear me-2"></i>Actions</div>
            <div class="card-body">
                @if (Model.Statut != RefCodes.StatutDocument.Valide && (ViewBag.CanDeclarationValidatePerm as bool? ?? false))
                {
                    <form method="post" action="@Url.Action("Validate", "EtatsFiscaux")" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-mc-success w-100">
                            <i class="bi bi-check-circle me-1"></i> Valider l'état
                        </button>
                    </form>
                }
                else if (Model.Statut == RefCodes.StatutDocument.Valide)
                {
                    <div class="alert alert-success mb-3">
                        <i class="bi bi-check-circle me-1"></i> Cet état a été validé.
                    </div>
                }

                <button class="btn btn-outline-primary w-100 mb-2">
                    <i class="bi bi-download me-1"></i> Télécharger PDF
                </button>
                <button class="btn btn-outline-secondary w-100">
                    <i class="bi bi-file-earmark-excel me-1"></i> Exporter Excel
                </button>
            </div>
        </div>
    </div>
</div>
