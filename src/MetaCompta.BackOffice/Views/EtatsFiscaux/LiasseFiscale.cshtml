@{
    ViewData["Title"] = "Liasse Fiscale - CGNC";
    var clientId = ViewBag.ClientId ?? 0;
    var exercice = ViewBag.Exercice ?? DateTime.Now.Year;
}

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Liasse Fiscale</h4>
            <small class="text-muted">Plan Comptable Marocain (CGNC) - Exercice @exercice</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <select class="form-select form-select-sm" style="width:120px" id="sel-exercice" onchange="changeExercice(this.value)">
                @for(int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                {
                    <option value="@y" @(y == (int)exercice ? "selected" : "")>@y</option>
                }
            </select>
            <button class="btn btn-sm btn-outline-primary" onclick="LiasseFiscale.UI.exportData()">
                <i class="bi bi-download"></i> Exporter
            </button>
            <button class="btn btn-sm btn-outline-success" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimer
            </button>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-3" id="liasseTabList" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pill-journal" data-bs-toggle="tab" data-bs-target="#tab-journal" type="button" role="tab">
                <i class="bi bi-journal-text"></i> Journal
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-grandlivre" data-bs-toggle="tab" data-bs-target="#tab-grandlivre" type="button" role="tab">
                <i class="bi bi-book"></i> Grand Livre
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-balance" data-bs-toggle="tab" data-bs-target="#tab-balance" type="button" role="tab">
                <i class="bi bi-calculator"></i> Balance
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-bilan" data-bs-toggle="tab" data-bs-target="#tab-bilan" type="button" role="tab">
                <i class="bi bi-columns-gap"></i> Bilan
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-cpc" data-bs-toggle="tab" data-bs-target="#tab-cpc" type="button" role="tab">
                <i class="bi bi-graph-up-arrow"></i> CPC
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-esg" data-bs-toggle="tab" data-bs-target="#tab-esg" type="button" role="tab">
                <i class="bi bi-bar-chart-line"></i> ESG
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-tf" data-bs-toggle="tab" data-bs-target="#tab-tf" type="button" role="tab">
                <i class="bi bi-cash-stack"></i> TF
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-etic" data-bs-toggle="tab" data-bs-target="#tab-etic" type="button" role="tab">
                <i class="bi bi-file-earmark-text"></i> ETIC
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pill-controls" data-bs-toggle="tab" data-bs-target="#tab-controls" type="button" role="tab">
                <i class="bi bi-shield-check"></i> Controles
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="liasseTabContent">
        <div class="tab-pane fade show active" id="tab-journal" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2">Chargement du journal...</p></div>
        </div>
        <div class="tab-pane fade" id="tab-grandlivre" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
        <div class="tab-pane fade" id="tab-balance" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
        <div class="tab-pane fade" id="tab-bilan" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
        <div class="tab-pane fade" id="tab-cpc" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
        <div class="tab-pane fade" id="tab-esg" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
        <div class="tab-pane fade" id="tab-tf" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
        <div class="tab-pane fade" id="tab-etic" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
        <div class="tab-pane fade" id="tab-controls" role="tabpanel">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/liasse-fiscale.css" />
    <script src="~/js/liasse-fiscale.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var clientId = @Html.Raw(clientId?.ToString() ?? "0");
            var exercice = @Html.Raw(exercice?.ToString() ?? new DateTime(DateTime.Now.Year,1,1).Year.ToString());
            LiasseFiscale.UI.init(clientId, exercice);

            // Re-render when tab is shown
            document.querySelectorAll('#liasseTabList button[data-bs-toggle="tab"]').forEach(function(btn){
                btn.addEventListener('shown.bs.tab', function(){
                    LiasseFiscale.UI.renderAll();
                });
            });
        });

        function changeExercice(val) {
            var url = new URL(window.location);
            url.searchParams.set('exercice', val);
            window.location.href = url.toString();
        }
    </script>
}