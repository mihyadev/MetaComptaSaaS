        [data-theme="dark"] .alert { background: #27272a; border-color: #3f3f46; color: #f4f4f5; }
        [data-theme="dark"] .stat-card { background: #27272a; border-color: #3f3f46; }
        [data-theme="dark"] .stat-card .stat-value { color: #f4f4f5; }
        [data-theme="dark"] .mc-card { background: #27272a; border-color: #3f3f46; }
        [data-theme="dark"] .mc-card .card-header { border-bottom-color: #3f3f46; color: #f4f4f5; }
        [data-theme="dark"] .mc-table td { color: #e4e4e7; }
