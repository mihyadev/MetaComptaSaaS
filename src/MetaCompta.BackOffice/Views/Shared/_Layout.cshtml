@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Global Client Context from Session
    var selectedClientId = Context.Session.GetString("SelectedClientId");
    var selectedClientName = Context.Session.GetString("SelectedClientName");
    var hasClient = !string.IsNullOrEmpty(selectedClientId);

    // Client-dependent controllers
    var clientControllers = new[] { "Declarations", "EtatsFiscaux", "Comptabilite", "Payroll", "Employees", "Juridique", "Documents" };
    var isClientSection = clientControllers.Contains(currentController);

    // Gateway = entry page (no menu). Elsewhere menu is dynamic: Cabinet vs Dossier Client.
    var isGateway = currentController == "Home" && string.Equals(currentAction, "Workspace", StringComparison.OrdinalIgnoreCase);
    var workspaceMode = Context.Session.GetString("WorkspaceMode");
    if (!isGateway && string.IsNullOrWhiteSpace(workspaceMode))
    {
        workspaceMode = (isClientSection && hasClient) ? "Client" : "Cabinet";
    }
    var showSidebar = !isGateway;
    var isClientMenu = showSidebar && workspaceMode == "Client" && hasClient;
    var isCabinetMenu = showSidebar && !isClientMenu;

    // Contract services → dossier menu (same codes as ContratCreate / _ServicesPicker)
    var activeServicesJson = Context.Session.GetString("ActiveServices") ?? "[]";
    var activeServices = System.Text.Json.JsonSerializer.Deserialize<List<string>>(activeServicesJson) ?? new List<string>();
    bool HasSvc(string code) => activeServices.Contains(code, StringComparer.OrdinalIgnoreCase);
    bool HasAny(params string[] codes) => codes.Any(HasSvc);
}
<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetaCompta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isGateway ? "gw-mode" : "")">
    @if (showSidebar)
    {
    <!-- SIDEBAR -->
    <nav class="mc-sidebar" id="sidebar" aria-label="Navigation principale">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-kanban-fill"></i></div>
            <div>
                <h4>MetaCompta</h4>
                <div class="brand-sub">@(Context.Session.GetString("CabinetName") ?? "Cabinet")</div>
            </div>
        </div>

        <div class="sidebar-client-context">
            @if (isClientMenu)
            {
                <div class="client-context-card" id="sidebarClientCard">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <div class="client-context-label mb-0"><i class="bi bi-folder2-open"></i> Dossier client</div>
                        <span class="mode-badge client">Client</span>
                    </div>
                    <div class="client-context-name" title="@selectedClientName">
                        <i class="bi bi-building" style="font-size:0.8rem; margin-right:0.25rem;"></i>@selectedClientName
                    </div>
                    <div class="client-context-hint"><i class="bi bi-info-circle"></i> Menu du dossier actif</div>
                </div>
            }
            else
            {
                <div class="client-context-card no-client" id="sidebarClientCard">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <div class="client-context-label mb-0"><i class="bi bi-building"></i> Espace cabinet</div>
                        <span class="mode-badge cabinet">Cabinet</span>
                    </div>
                    <div class="client-context-name">@(Context.Session.GetString("CabinetName") ?? "Gestion interne")</div>
                    <div class="client-context-hint"><i class="bi bi-info-circle"></i> Menu administration cabinet</div>
                </div>
            }
        </div>

        <a class="nav-switch-space" href="@Url.Action("Workspace", "Home")">
            <i class="bi bi-arrow-left-right"></i>
            <span>Changer d'espace</span>
        </a>

        <!-- Scrollable Nav -->
        <div class="sidebar-scroll">
            @if (isCabinetMenu)
            {
                var canNavClientList = ViewBag.CanClientList as bool? ?? false;
                var canNavClientCreate = ViewBag.CanClientCreate as bool? ?? false;
                var canNavCommercial = ViewBag.CanCommercialDetail as bool? ?? false;
                var canNavTasks = ViewBag.CanTaskDetail as bool? ?? false;
                var canNavWorkflow = (ViewBag.CanWorkflowView as bool? ?? false)
                    || (ViewBag.CanWorkflowMonitor as bool? ?? false)
                    || (ViewBag.CanWorkflowConfigure as bool? ?? false);
                var canNavDepartments = ViewBag.CanDepartmentView as bool? ?? false;
                var canNavCabinetEmp = ViewBag.CanCabinetEmployeeDetail as bool? ?? false;
                var canNavRoles = ViewBag.CanCabinetRoleManage as bool? ?? false;
                var canNavAudit = ViewBag.CanCabinetAuditView as bool? ?? false;
                var canNavReports = ViewBag.CanReportView as bool? ?? false;
                var canNavParams = ViewBag.CanSystemAdmin as bool? ?? false;
            <!-- A. CABINET ONLY -->
            <div class="nav-section">Cabinet <span class="section-line"></span></div>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link @(currentController == "Home" ? "active" : "")" href="@Url.Action("Index", "Home")"><i class="bi bi-grid-1x2-fill"></i> Tableau de bord</a></li>
                @if (canNavClientList)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Clients" && currentAction == "Index" ? "active" : "")" href="@Url.Action("Index", "Clients")"><i class="bi bi-buildings"></i> Clients</a></li>
                }
                @if (canNavClientCreate)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Clients" && currentAction == "Create" ? "active" : "")" href="@Url.Action("Create", "Clients")"><i class="bi bi-plus-circle"></i> Nouveau client</a></li>
                }
                @if (canNavCommercial)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Commercial" ? "active" : "")" href="@Url.Action("Contrats", "Commercial")"><i class="bi bi-file-earmark-medical"></i> Commercial / Contrats</a></li>
                }
            </ul>

            @if (canNavTasks)
            {
            <div class="nav-section">Planning &amp; T&#226;ches <span class="section-line"></span></div>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link @(currentController == "Planning" ? "active" : "")" href="@Url.Action("Index", "Planning")"><i class="bi bi-calendar-week"></i> Calendrier</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Tasks" && currentAction == "Index" ? "active" : "")" href="@Url.Action("Index", "Tasks")"><i class="bi bi-list-task"></i> Toutes les t&#226;ches <span class="nav-badge bg-warning bg-opacity-10 text-warning" id="badgeTasks">0</span></a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Tasks" && currentAction == "MyTasks" ? "active" : "")" href="@Url.Action("MyTasks", "Tasks")"><i class="bi bi-person-check"></i> Mes t&#226;ches</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Tasks" && currentAction == "Overdue" ? "active" : "")" href="@Url.Action("Overdue", "Tasks")"><i class="bi bi-exclamation-triangle"></i> T&#226;ches en retard <span class="nav-badge bg-danger bg-opacity-10 text-danger" id="badgeOverdue">0</span></a></li>
            </ul>
            }

            @if (canNavWorkflow || canNavDepartments)
            {
            <div class="nav-section">Workflows &amp; Organisation <span class="section-line"></span></div>
            <ul class="nav flex-column">
                @if (canNavWorkflow)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Workflow" && (currentAction == "Index" || currentAction == "Templates" || currentAction == "Builder") ? "active" : "")" href="@Url.Action("Index", "Workflow")"><i class="bi bi-diagram-3"></i> Workflows</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Workflow" && (currentAction == "Instances" || currentAction == "InstanceDetails") ? "active" : "")" href="@Url.Action("Instances", "Workflow")"><i class="bi bi-play-circle"></i> Instances</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Workflow" && currentAction == "MyTasks" ? "active" : "")" href="@Url.Action("MyTasks", "Workflow")"><i class="bi bi-ui-checks"></i> Mes &#233;tapes WF</a></li>
                @if (ViewBag.CanWorkflowConfigure as bool? ?? false)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Workflow" && currentAction == "Builder" ? "active" : "")" href="@Url.Action("Builder", "Workflow")"><i class="bi bi-tools"></i> Builder</a></li>
                @if (hasClient && int.TryParse(selectedClientId, out var affectClientIdCab))
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Clients" && currentAction == "Details" ? "active" : "")" href="@Url.Action("Details", "Clients", new { id = affectClientIdCab, tab = "workflow" })"><i class="bi bi-person-gear"></i> Affectation client</a></li>
                }
                else
                {
                <li class="nav-item"><a class="nav-link" href="@Url.Action("Workspace", "Home")" title="Sélectionnez d'abord un client"><i class="bi bi-person-gear"></i> Affectation client</a></li>
                }
                }
                }
                @if (canNavDepartments)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Departments" ? "active" : "")" href="@Url.Action("Index", "Departments")"><i class="bi bi-diagram-2"></i> D&#233;partements</a></li>
                }
            </ul>
            }

            @if (canNavCabinetEmp || canNavRoles || canNavAudit)
            {
            <div class="nav-section">Gestion du cabinet <span class="section-line"></span></div>
            <ul class="nav flex-column">
                @if (canNavCabinetEmp)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Cabinet" && currentAction == "Index" ? "active" : "")" href="@Url.Action("Index", "Cabinet")"><i class="bi bi-people"></i> Employ&#233;s</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Cabinet" && currentAction == "Equipes" ? "active" : "")" href="@Url.Action("Equipes", "Cabinet")"><i class="bi bi-people-fill"></i> &#201;quipes</a></li>
                }
                @if (canNavRoles)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Cabinet" && currentAction == "Roles" ? "active" : "")" href="@Url.Action("Roles", "Cabinet")"><i class="bi bi-shield-lock"></i> R&#244;les &amp; Permissions</a></li>
                }
                @if (canNavAudit)
                {
                <li class="nav-item"><a class="nav-link @(currentController == "Cabinet" && currentAction == "AuditLogs" ? "active" : "")" href="@Url.Action("AuditLogs", "Cabinet")"><i class="bi bi-clock-history"></i> Historique connexion</a></li>
                }
            </ul>
            }

            @if (canNavReports)
            {
            <div class="nav-section">Rapports <span class="section-line"></span></div>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link @(currentController == "Rapports" && ViewBag.TypeRapport?.ToString() == "Financier" ? "active" : "")" href="@Url.Action("Financiers", "Rapports")"><i class="bi bi-graph-up-arrow"></i> Financiers</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Rapports" && ViewBag.TypeRapport?.ToString() == "Fiscal" ? "active" : "")" href="@Url.Action("Fiscaux", "Rapports")"><i class="bi bi-file-earmark-bar-graph"></i> Fiscaux</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Rapports" && ViewBag.TypeRapport?.ToString() == "Social" ? "active" : "")" href="@Url.Action("Sociaux", "Rapports")"><i class="bi bi-file-earmark-medical"></i> Sociaux</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Rapports" && ViewBag.TypeRapport?.ToString() == "Activite" ? "active" : "")" href="@Url.Action("Activites", "Rapports")"><i class="bi bi-activity"></i> Activit&#233;s</a></li>
            </ul>
            }

            @if (canNavParams)
            {
            <div class="nav-section">Param&#232;tres <span class="section-line"></span></div>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link @(currentController == "Parametres" && currentAction == "Index" ? "active" : "")" href="@Url.Action("Index", "Parametres")"><i class="bi bi-gear"></i> Configuration</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Parametres" && currentAction == "Templates" ? "active" : "")" href="@Url.Action("Templates", "Parametres")"><i class="bi bi-file-earmark-ruled"></i> Mod&#232;les documents</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Parametres" && currentAction == "Notifications" ? "active" : "")" href="@Url.Action("Notifications", "Parametres")"><i class="bi bi-bell-fill"></i> Notifications</a></li>
                <li class="nav-item"><a class="nav-link @(currentController == "Parametres" && currentAction == "Integrations" ? "active" : "")" href="@Url.Action("Integrations", "Parametres")"><i class="bi bi-plug"></i> Int&#233;grations (API)</a></li>
            </ul>
            }
            }
            else if (isClientMenu)
            {
            <!-- B. DOSSIER CLIENT ONLY -->
            <div class="nav-section"><i class="bi bi-person-workspace me-1"></i> Dossier client
                @{
                    var accessMode = Context.Session.GetString("ContractAccessMode");
                    var isConsult = string.Equals(accessMode, "Consult", StringComparison.OrdinalIgnoreCase)
                        || (!(bool.TryParse(Context.Session.GetString("HasActiveContract"), out var hacLayout) && hacLayout)
                            && !string.IsNullOrEmpty(selectedClientId));
                }
                @if (isConsult && !string.IsNullOrEmpty(selectedClientId))
                {
                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis ms-1" style="font-size:0.65rem;">Consultation</span>
                }
                <span class="section-line"></span>
            </div>
            <div class="client-section-warning"><i class="bi bi-link-45deg"></i> Actions liées à <strong>@selectedClientName</strong></div>

            <ul class="nav flex-column">
                @{
                    // Contract services ∩ role claims — Socialiste must not see Comptabilité/Fiscalité just because the contrat includes them
                    var canFiscalTva = PermissionHelper.HasAnyDomain(Context.Session, "tva");
                    var canFiscalIr = PermissionHelper.HasAnyDomain(Context.Session, "ir");
                    var canFiscalIs = PermissionHelper.HasAnyDomain(Context.Session, "is");
                    var canFiscalAny = canFiscalTva || canFiscalIr || canFiscalIs;
                    var canCompta = PermissionHelper.HasAnyDomain(Context.Session, "comptabilite");
                    var canCnss = PermissionHelper.HasAnyDomain(Context.Session, "cnss");
                    var canPayroll = PermissionHelper.HasAnyDomain(Context.Session, "payroll")
                        || PermissionHelper.HasAnyDomain(Context.Session, "employee");
                    var canSocial = canCnss || canPayroll;
                    var canJuridique = PermissionHelper.HasAnyDomain(Context.Session, "juridique");
                    var canDocuments = PermissionHelper.HasAnyDomain(Context.Session, "document");
                    var canTasks = PermissionHelper.HasAnyDomain(Context.Session, "task");

                    var showComptaFam = canCompta && HasAny("COMPTABILITE", "TRESORERIE", "BILAN", "ETATSFISCAUX", "LIASSEFISCALE", "EG");
                    var showFiscalFam = canFiscalAny && HasAny("TVA", "IR_SAL", "IR", "RAS_FONC", "RAS_DIV", "DRF", "CM", "ACOMPTES", "REG_IS", "IS", "LIASSEFISCALE");
                    var showIsFam = canFiscalIs && HasAny("ACOMPTES", "REG_IS", "IS", "DRF", "CM", "LIASSEFISCALE");
                    var showSocialFam = canSocial && HasAny("CNSS", "DTS", "PAIE");
                    var showJuridiqueFam = canJuridique && HasAny("PV_AGO", "DEPOT_RC");
                    var declType = ViewBag.Type?.ToString();
                    var isFiscalDeclPage = currentController == "Declarations"
                        && !string.Equals(declType, "CNSS", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(declType, "DTS", StringComparison.OrdinalIgnoreCase);
                    bool DeclActive(string t)
                    {
                        if (string.Equals(declType, t, StringComparison.OrdinalIgnoreCase)) return true;
                        var listAct = DeclarationServiceCatalog.GetListAction(t);
                        return string.Equals(currentAction, listAct, StringComparison.OrdinalIgnoreCase);
                    }
                    bool CanDeclMenu(string declarationType)
                    {
                        var entry = DeclarationServiceCatalog.Get(declarationType);
                        if (entry == null) return false;
                        if (!DeclarationServiceCatalog.HasContractService(declarationType, activeServices)) return false;
                        return entry.ClaimDomain switch
                        {
                            "tva" => canFiscalTva,
                            "ir" => canFiscalIr,
                            "is" => canFiscalIs,
                            "cnss" => canCnss,
                            _ => canFiscalAny
                        };
                    }
                }

                @if (showFiscalFam || showIsFam)
                {
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#menuFiscalite" role="button"
                       aria-expanded="@(isFiscalDeclPage ? "true" : "false")">
                        <i class="bi bi-receipt"></i><span>Déclarations fiscales</span><i class="bi bi-chevron-down chevron-icon"></i>
                    </a>
                    <div class="collapse sidebar-submenu @(isFiscalDeclPage ? "show" : "")" id="menuFiscalite">
                        <ul class="nav flex-column">
                            @if (CanDeclMenu("TVA"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("TVA") ? "active" : "")" href="@Url.Action("TVA", "Declarations")"><i class="bi bi-receipt-cutoff"></i> TVA</a></li>
                            }
                            @if (CanDeclMenu("IR_SAL"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("IR_SAL") ? "active" : "")" href="@Url.Action("IrSalaires", "Declarations")"><i class="bi bi-person-lines-fill"></i> IR / Salaires</a></li>
                            }
                            @if (CanDeclMenu("IR"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("IR") ? "active" : "")" href="@Url.Action("IR", "Declarations")"><i class="bi bi-person-vcard"></i> IR — Revenu</a></li>
                            }
                            @if (CanDeclMenu("RAS_FONC"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("RAS_FONC") ? "active" : "")" href="@Url.Action("RasFoncier", "Declarations")"><i class="bi bi-house"></i> RAS / Foncier</a></li>
                            }
                            @if (CanDeclMenu("RAS_DIV"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("RAS_DIV") ? "active" : "")" href="@Url.Action("RasDividendes", "Declarations")"><i class="bi bi-pie-chart"></i> RAS / Dividendes</a></li>
                            }
                            @if (CanDeclMenu("IS"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("IS") ? "active" : "")" href="@Url.Action("IS", "Declarations")"><i class="bi bi-building"></i> Déclaration fiscale — Liasse</a></li>
                            }
                            @if (CanDeclMenu("DRF"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("DRF") ? "active" : "")" href="@Url.Action("DRF", "Declarations")"><i class="bi bi-file-earmark-ruled"></i> D.R.F</a></li>
                            }
                            @if (CanDeclMenu("CM"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("CM") ? "active" : "")" href="@Url.Action("CM", "Declarations")"><i class="bi bi-cash-coin"></i> Cotisation minimale</a></li>
                            }
                            @if (CanDeclMenu("ACOMPTES"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("ACOMPTES") ? "active" : "")" href="@Url.Action("Acomptes", "Declarations")"><i class="bi bi-calendar3"></i> Acomptes IS</a></li>
                            }
                            @if (CanDeclMenu("REG_IS"))
                            {
                                <li class="nav-item"><a class="nav-link @(DeclActive("REG_IS") ? "active" : "")" href="@Url.Action("RegIs", "Declarations")"><i class="bi bi-bank2"></i> Régularisation / Solde IS</a></li>
                            }
                            @if (canFiscalAny)
                            {
                            <li class="nav-item"><a class="nav-link @(currentController == "Declarations" && string.IsNullOrEmpty(declType) ? "active" : "")" href="@Url.Action("Index", "Declarations")"><i class="bi bi-clock-history"></i> Historique fiscal</a></li>
                            }
                        </ul>
                    </div>
                </li>
                }

                @if (showComptaFam)
                {
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#menuComptaEtats" role="button"
                       aria-expanded="@(currentController == "Comptabilite" || currentController == "EtatsFiscaux" ? "true" : "false")">
                        <i class="bi bi-calculator"></i><span>Comptabilité &amp; États</span><i class="bi bi-chevron-down chevron-icon"></i>
                    </a>
                    <div class="collapse sidebar-submenu @(currentController == "Comptabilite" || currentController == "EtatsFiscaux" ? "show" : "")" id="menuComptaEtats">
                        <ul class="nav flex-column">
                            @if (HasSvc("COMPTABILITE"))
                            {
                                <li class="nav-item"><a class="nav-link @(currentController == "Comptabilite" && currentAction == "Index" ? "active" : "")" href="@Url.Action("Index", "Comptabilite")"><i class="bi bi-kanban"></i> Tableau de bord</a></li>
                                <li class="nav-item"><a class="nav-link @(currentController == "Comptabilite" && currentAction == "Ecritures" ? "active" : "")" href="@Url.Action("Ecritures", "Comptabilite")"><i class="bi bi-pencil-square"></i> Tenue comptable</a></li>
                                <li class="nav-item"><a class="nav-link @(currentAction == "PlanComptable" ? "active" : "")" href="@Url.Action("PlanComptable", "Comptabilite")"><i class="bi bi-diagram-3"></i> Plan comptable</a></li>
                                <li class="nav-item"><a class="nav-link @(currentAction == "Journaux" ? "active" : "")" href="@Url.Action("Journaux", "Comptabilite")"><i class="bi bi-journal-bookmark"></i> Journaux</a></li>
                                <li class="nav-item"><a class="nav-link @(currentAction == "GrandLivre" ? "active" : "")" href="@Url.Action("GrandLivre", "Comptabilite")"><i class="bi bi-book"></i> Grand livre</a></li>
                                <li class="nav-item"><a class="nav-link @(currentAction == "Balance" ? "active" : "")" href="@Url.Action("Balance", "Comptabilite")"><i class="bi bi-symmetry-horizontal"></i> Balance</a></li>
                                <li class="nav-item"><a class="nav-link @(currentAction == "Rapprochements" ? "active" : "")" href="@Url.Action("Rapprochements", "Comptabilite")"><i class="bi bi-arrow-left-right"></i> Trésorerie &amp; rapprochements</a></li>
                                <li class="nav-item"><a class="nav-link @(currentAction == "BalanceAgee" ? "active" : "")" href="@Url.Action("BalanceAgee", "Comptabilite")"><i class="bi bi-hourglass-split"></i> Balance âgée</a></li>
                            }
                            else if (HasSvc("TRESORERIE"))
                            {
                                <li class="nav-item"><a class="nav-link @(currentAction == "Rapprochements" ? "active" : "")" href="@Url.Action("Rapprochements", "Comptabilite")"><i class="bi bi-arrow-left-right"></i> Trésorerie &amp; rapprochements</a></li>
                                <li class="nav-item"><a class="nav-link @(currentAction == "BalanceAgee" ? "active" : "")" href="@Url.Action("BalanceAgee", "Comptabilite")"><i class="bi bi-hourglass-split"></i> Balance âgée</a></li>
                            }
