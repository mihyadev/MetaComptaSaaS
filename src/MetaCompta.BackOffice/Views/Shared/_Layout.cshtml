                }
                else
                {
                <a href="@Url.Action("Workspace", "Home")" class="fw-semibold text-decoration-none text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-briefcase-fill text-primary"></i> MetaCompta
                </a>
                }
                @if (isClientMenu || (showSidebar && hasClient))
                {
                <div class="client-selector-wrapper context-selector" id="clientSelectorWrapper">
