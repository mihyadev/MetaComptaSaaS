                    </div>
                    <div class="client-selector-dropdown" id="clientDropdown" role="listbox">
                        <input type="text" class="client-search-input" id="clientSearchInput" placeholder="Rechercher un client (nom, ICE)..." autocomplete="off" />
                        <div class="client-list" id="clientList"><div class="text-center text-muted py-3" style="font-size:0.82rem;"><i class="bi bi-search"></i> Tapez pour rechercher...</div></div>
                        @if (hasClient)
                        {
                            <div class="client-clear-btn" id="clientClearBtn"><i class="bi bi-x-circle"></i> Retirer la s&#233;lection</div>
                        }
                    </div>
                </div>
                @if (hasClient)
                {
                    var selectedExercice = Context.Session.GetString("SelectedExercice");
                    var selectedExerciceStatut = Context.Session.GetString("SelectedExerciceStatut") ?? "Ouvert";
                    var selectedExerciceId = Context.Session.GetString("SelectedExerciceId");
                <div class="client-selector-wrapper context-selector exercice-selector-wrapper" id="exerciceSelectorWrapper">
                    <div class="client-selector-btn" id="exerciceSelectorBtn" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox">
