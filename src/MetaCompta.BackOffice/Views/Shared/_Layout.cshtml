                        </div>
                        <!-- 2. Menu Style -->
                        <div class="tp-section">
                            <div class="tp-section-title"><i class="bi bi-layout-sidebar-inset"></i> Style du menu</div>
                            <div class="tp-menu-styles">
                                <div class="tp-style-opt" data-menu="default">
                                    <div class="tp-style-icon"><div class="bar" style="width:80%;"></div><div class="bar" style="width:100%; opacity:0.4;"></div><div class="bar" style="width:65%; opacity:0.4;"></div></div>
                                    <span class="tp-style-name">Default</span>
                                </div>
                                <div class="tp-style-opt" data-menu="compact">
                                    <div class="tp-style-icon" style="gap:1px;"><div class="bar" style="width:75%; height:2px;"></div><div class="bar" style="width:90%; height:2px; opacity:0.4;"></div><div class="bar" style="width:60%; height:2px; opacity:0.4;"></div><div class="bar" style="width:80%; height:2px; opacity:0.4;"></div></div>
                                    <span class="tp-style-name">Compact</span>
                                </div>
                                <div class="tp-style-opt" data-menu="pill">
                                    <div class="tp-style-icon"><div class="bar" style="width:80%; border-radius:8px;"></div><div class="bar" style="width:100%; border-radius:8px; opacity:0.4;"></div><div class="bar" style="width:65%; border-radius:8px; opacity:0.4;"></div></div>
                                    <span class="tp-style-name">Pill</span>
                                </div>
                                <div class="tp-style-opt" data-menu="bordered">
                                    <div class="tp-style-icon" style="border-radius:2px;"><div class="bar" style="width:100%; border-radius:0; border-left:2px solid var(--mc-primary);"></div><div class="bar" style="width:100%; border-radius:0; opacity:0.4;"></div><div class="bar" style="width:100%; border-radius:0; opacity:0.4;"></div></div>
                                    <span class="tp-style-name">Bordure</span>
                                </div>
                                <div class="tp-style-opt" data-menu="spaced">
                                    <div class="tp-style-icon" style="gap:4px;"><div class="bar" style="width:85%;"></div><div class="bar" style="width:100%; opacity:0.4;"></div><div class="bar" style="width:70%; opacity:0.4;"></div></div>
                                    <span class="tp-style-name">Spacieux</span>
                                </div>
                                <div class="tp-style-opt" data-menu="minimal">
                                    <div class="tp-style-icon" style="border-color:transparent;"><div class="bar" style="width:2px; height:10px; position:absolute; left:0; border-radius:0 2px 2px 0;"></div><div class="bar" style="width:75%; opacity:0.6;"></div><div class="bar" style="width:90%; opacity:0.3;"></div><div class="bar" style="width:60%; opacity:0.3;"></div></div>
                                    <span class="tp-style-name">Minimal</span>
                                </div>
                                <div class="tp-style-opt" data-menu="glass">
                                    <div class="tp-style-icon" style="background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(139,92,246,0.05));"><div class="bar" style="width:80%; background:rgba(99,102,241,0.3);"></div><div class="bar" style="width:100%; opacity:0.2;"></div><div class="bar" style="width:65%; opacity:0.2;"></div></div>
                                    <span class="tp-style-name">Glass</span>
                                </div>
                            </div>
                        </div>
                        <!-- 3. Sidebar Width -->
                        <div class="tp-section">
                            <div class="tp-section-title"><i class="bi bi-arrows-expand"></i> Largeur du menu</div>
                            <div class="tp-width-opts">
                                <div class="tp-width-opt" data-width="narrow">
                                    <div class="tp-width-icon"><div class="wi-side" style="width:25%;"></div></div>
                                    <span class="tp-width-name">Ã‰troit</span>
                                </div>
                                <div class="tp-width-opt" data-width="default">
                                    <div class="tp-width-icon"><div class="wi-side" style="width:35%;"></div></div>
                                    <span class="tp-width-name">Normal</span>
                                </div>
                                <div class="tp-width-opt" data-width="wide">
                                    <div class="tp-width-icon"><div class="wi-side" style="width:45%;"></div></div>
                                    <span class="tp-width-name">Large</span>
                                </div>
                            </div>
                        </div>
                        <!-- Footer -->
                        <div class="tp-footer">
                            <button class="tp-reset-btn" id="tpResetBtn"><i class="bi bi-arrow-counterclockwise me-1"></i>RÃ©initialiser tout</button>
                        </div>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 p-0" data-bs-toggle="dropdown">
                        <div class="user-avatar">@(Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper() ?? "U")</div>
                        <div class="d-none d-md-block text-start">
                            <div class="fw-semibold text-dark" style="font-size:0.82rem;">@(Context.Session.GetString("UserName") ?? "Utilisateur")</div>
                            <div class="text-muted" style="font-size:0.68rem;">@(Context.Session.GetString("UserRole") ?? "")</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size:0.7rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Mon Profil</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("Index", "Parametres")"><i class="bi bi-gear me-2"></i> Paramètres</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right me-2"></i> Déconnexion</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="mc-content fade-in">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i><strong>@TempData["Error"]</strong>
                    @if (TempData["ErrorDetails"] != null)
                    {
                        <ul class="mb-0 mt-2" style="font-size:0.85rem; list-style:disc; padding-left:1.2rem;">
                            @foreach (var detail in ((string)TempData["ErrorDetails"]!).Split("|||"))
                            {
                                <li>@detail</li>
                            }
                        </ul>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <script>
        toastr.options = { positionClass: 'toast-top-right', closeButton: true, progressBar: true, timeOut: 4000 };
        $.extend($.fn.dataTable.defaults, { language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/fr-FR.json' }, pageLength: 20, responsive: true });
        $(function() { $('.mc-datatable').DataTable(); });
        setTimeout(function() { $('.alert-dismissible').alert('close'); }, 5000);

        // CLIENT SELECTION — global function used by Workspace page
        window.mcSelectClient = function(id, name) {
            $.post('@Url.Action("SetClientContext", "Clients")', { clientId: id }, function(res) {
                if (res.success) {
                    toastr.success('Client actif : ' + name);
                    document.dispatchEvent(new CustomEvent('clientSelected', { detail: { clientId: id, clientName: name } }));
                    var isWs = @(isWorkspacePage ? "true" : "false");
                    if (isWs) {
                        window.location.href = '@Url.Action("Index", "Declarations", null)';
                    } else {
                        window.location.reload();
                    }
                }
            });
        };
        window.mcClearClient = function() {
            $.post('@Url.Action("SetClientContext", "Clients")', { clientId: '' }, function(res) {
                if (res.success) { toastr.info('Client désélectionné'); window.location.reload(); }
            });
        };

        // â•â•â•â•â•â•â• THEME / CUSTOMIZATION SYSTEM â•â•â•â•â•â•â•
        (function() {
            var btn = document.getElementById('themePickerBtn');
            var panel = document.getElementById('themePickerPanel');
            var wrap = document.getElementById('themePickerWrap');
            var closeBtn = document.getElementById('tpClose');
            var resetBtn = document.getElementById('tpResetBtn');
            var root = document.documentElement;

            // â”€â”€ Apply functions â”€â”€
            function applyTheme(val) {
                if (val === 'default') root.removeAttribute('data-theme');
                else root.setAttribute('data-theme', val);
                if (panel) panel.querySelectorAll('.tp-color-opt').forEach(function(o) { o.classList.toggle('active', o.dataset.theme === val); });
            }
            function applyMenu(val) {
                if (val === 'default') root.removeAttribute('data-menu');
                else root.setAttribute('data-menu', val);
                if (panel) panel.querySelectorAll('.tp-style-opt').forEach(function(o) { o.classList.toggle('active', o.dataset.menu === val); });
            }
            function applyWidth(val) {
                if (val === 'default') root.removeAttribute('data-sidebar-width');
                else root.setAttribute('data-sidebar-width', val);
                if (panel) panel.querySelectorAll('.tp-width-opt').forEach(function(o) { o.classList.toggle('active', o.dataset.width === val); });
            }
            function save(key, val) {
                localStorage.setItem(key, val);
                document.cookie = key + '=' + val + ';path=/;max-age=31536000';
            }

            // â”€â”€ Initialize from localStorage â”€â”€
            applyTheme(localStorage.getItem('mc-theme') || 'default');
            applyMenu(localStorage.getItem('mc-menu') || 'default');
            applyWidth(localStorage.getItem('mc-width') || 'default');

            // â”€â”€ Toggle panel â”€â”€
            btn.addEventListener('click', function(e) { e.stopPropagation(); panel.classList.toggle('show'); });
            closeBtn.addEventListener('click', function() { panel.classList.remove('show'); });
            document.addEventListener('click', function(e) { if (!wrap.contains(e.target)) panel.classList.remove('show'); });

            // â”€â”€ Color theme clicks â”€â”€
            panel.querySelectorAll('.tp-color-opt').forEach(function(opt) {
                opt.addEventListener('click', function() {
                    var v = this.dataset.theme;
                    applyTheme(v); save('mc-theme', v);
                });
            });

            // â”€â”€ Menu style clicks â”€â”€
            panel.querySelectorAll('.tp-style-opt').forEach(function(opt) {
                opt.addEventListener('click', function() {
                    var v = this.dataset.menu;
                    applyMenu(v); save('mc-menu', v);
                });
            });

            // â”€â”€ Sidebar width clicks â”€â”€
            panel.querySelectorAll('.tp-width-opt').forEach(function(opt) {
                opt.addEventListener('click', function() {
                    var v = this.dataset.width;
                    applyWidth(v); save('mc-width', v);
                });
            });

            // â”€â”€ Reset All â”€â”€
            resetBtn.addEventListener('click', function() {
                applyTheme('default'); save('mc-theme', 'default');
                applyMenu('default'); save('mc-menu', 'default');
                applyWidth('default'); save('mc-width', 'default');
            });
        })();

        // â•â•â•â•â•â•â• GLOBAL CLIENT AUTO-FILL & LOCK FOR ALL FORMS â•â•â•â•â•â•â•
        window.mcSelectedClient = {
            id: '@(selectedClientId ?? "")',
            name: '@(selectedClientName?.Replace("'", "\\'") ?? "")'
        };

        $(function() {
            if (!window.mcSelectedClient.id) return;
            var cId = window.mcSelectedClient.id;
            var cName = window.mcSelectedClient.name;

            // â”€â”€ 1. All <select> with name="ClientId" or id="cfgClient" â”€â”€
            var selectors = [
                'select[name="ClientId"]',
                'select[id="ClientId"]',
                'select[name$=".ClientId"]',
                'select#cfgClient'
            ];

            $(selectors.join(',')).each(function() {
                var $sel = $(this);

                // Set value (add option if missing)
                if ($sel.find('option[value="' + cId + '"]').length > 0) {
                    $sel.val(cId);
                } else {
                    $sel.append('<option value="' + cId + '">' + cName + '</option>');
                    $sel.val(cId);
                }

                // Disable + hidden input for form submission
                $sel.prop('disabled', true);
                var inputName = $sel.attr('name');
                if (inputName) {
                    $sel.closest('form').find('input[type="hidden"][name="' + inputName + '"]').remove();
                    $sel.after('<input type="hidden" name="' + inputName + '" value="' + cId + '" />');
                }

                // Builder sync
                if ($sel.attr('id') === 'cfgClient') {
                    var fld = document.getElementById('fldClientId');
                    if (fld) fld.value = cId;
                }

                // Styling
                var $wrap = $sel.closest('.col-md-6, .col-md-3, .col-6, .mb-3').first();
                if (!$wrap.length) $wrap = $sel.parent();
                $wrap.addClass('mc-client-locked');
                if (!$wrap.find('.mc-client-locked-badge').length) {
                    $sel.after('<div class="mc-client-locked-badge"><i class="bi bi-lock"></i> SÃ©lection globale active</div>');
                }
            });

            // â”€â”€ 2. All <input name="clientId"> (Declarations, etc.) â”€â”€
            $('input[name="clientId"]').each(function() {
                var $inp = $(this);

                // Replace the raw number input with a nice disabled text showing name + id
                var $display = $('<input type="text" class="form-control" />');
                $display.val(cName + '  (#' + cId + ')');
                $display.prop('disabled', true);
                $display.attr('tabindex', '-1');

                // Hidden input to submit the actual value
                var $hidden = $('<input type="hidden" name="clientId" value="' + cId + '" />');

                $inp.after($hidden).after($display).remove();

                // Styling
                var $wrap = $display.closest('.col-md-3, .mb-3').first();
                if (!$wrap.length) $wrap = $display.parent();
                $wrap.addClass('mc-client-locked');
                if (!$wrap.find('.mc-client-locked-badge').length) {
                    $display.after('<div class="mc-client-locked-badge"><i class="bi bi-lock"></i> SÃ©lection globale active</div>');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


