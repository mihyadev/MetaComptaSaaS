                                    <span class="tp-color-name">Sand</span>
                                </div>
                                <div class="tp-color-opt" data-theme="mint">
                                    <div class="tp-color-swatch" style="border:1px solid #bbf7d0;"><div class="cs-side" style="background:#f0fdf4;"></div><div class="cs-top" style="background:#fff;"></div><div class="cs-body" style="background:#f0fdf4;"></div></div>
                                    <span class="tp-color-name">Mint</span>
