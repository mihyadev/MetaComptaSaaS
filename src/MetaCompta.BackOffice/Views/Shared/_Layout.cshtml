                                    <span class="tp-color-name">Charcoal</span>
                                </div>
                                <div class="tp-color-opt" data-theme="arctic">
                                    <div class="tp-color-swatch" style="border:1px solid #e0f2fe;"><div class="cs-side" style="background:#f0f9ff;"></div><div class="cs-top" style="background:#fff;"></div><div class="cs-body" style="background:#f8fafc;"></div></div>
                                    <span class="tp-color-name">Arctic</span>
