@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Global Client Context from Session
    var selectedClientId = Context.Session.GetString("SelectedClientId");
    var selectedClientName = Context.Session.GetString("SelectedClientName");
    var hasClient = !string.IsNullOrEmpty(selectedClientId);

    // Active services for selected client (stored in session on client selection)
    var activeServicesJson = Context.Session.GetString("ActiveServices") ?? "[]";
    var activeServices = System.Text.Json.JsonSerializer.Deserialize<List<string>>(activeServicesJson) ?? new List<string>();
    // If client has NO services configured yet, show everything (backwards compatible)
    var noServicesConfigured = hasClient && !activeServices.Any();
    bool HasService(params string[] codes) => noServicesConfigured || codes.Any(c => activeServices.Contains(c, StringComparer.OrdinalIgnoreCase));

    // Contract status: determines if declaration create/edit actions are allowed
    var hasActiveContract = bool.TryParse(Context.Session.GetString("HasActiveContract"), out var _hac) && _hac;
    // readOnlyDeclarations = client selected but no active contract â†’ view-only mode
    var readOnlyDeclarations = hasClient && !hasActiveContract;

    // Client-dependent controllers
    var clientControllers = new[] { "Declarations", "Documents", "Comptabilite", "Payroll", "Employees", "Juridique", "EtatsFiscaux", "Rapports" };
    var isClientSection = clientControllers.Contains(currentController);
    var isWorkspacePage = currentController == "Home" && currentAction == "Workspace";
}
