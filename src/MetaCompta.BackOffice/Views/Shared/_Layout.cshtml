                        @if (!string.IsNullOrEmpty(selectedExercice))
                        {
                            <span class="selected-name" id="selectedExerciceDisplay">Exercice @selectedExercice</span>
                            <span class="badge exo-statut-badge @(string.Equals(selectedExerciceStatut, "Ouvert", StringComparison.OrdinalIgnoreCase) ? "exo-ouvert" : "exo-cloture")" id="selectedExerciceStatutBadge">@selectedExerciceStatut</span>
                        }
                        else
                        {
                            <span class="no-selection" id="selectedExerciceDisplay">Exercice...</span>
                            <span class="badge exo-statut-badge d-none" id="selectedExerciceStatutBadge"></span>
                        }
                        <i class="bi bi-chevron-expand ms-auto text-muted" style="font-size:0.75rem;"></i>
                    </div>
                    <div class="client-selector-dropdown" id="exerciceDropdown" role="listbox">
                        <div class="client-list" id="exerciceList"><div class="text-center text-muted py-3" style="font-size:0.82rem;">Chargement...</div></div>
                        <div class="client-clear-btn text-primary" id="exerciceCreateBtn" role="button"><i class="bi bi-plus-circle"></i> Nouvel exercice</div>
                    </div>
                </div>
                <input type="hidden" id="selectedExerciceIdValue" value="@(selectedExerciceId ?? "")" />
                }
                }
                else
                {
                <div id="clientSelectorWrapper" style="display:none;">
                    <div id="clientSelectorBtn"></div>
                    <div id="clientDropdown">
                        <input type="text" id="clientSearchInput" />
                        <div class="client-list" id="clientList"></div>
                    </div>
                </div>
                }
            </div>
            <div class="user-menu">
                <div class="search-box d-none d-lg-block"><i class="bi bi-search"></i><input type="text" class="form-control" placeholder="Rechercher..." id="globalSearch" /></div>
                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none p-0" data-bs-toggle="dropdown"><i class="bi bi-translate fs-5 text-muted"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="?culture=fr-FR">&#127467;&#127479; Fran&#231;ais</a></li>
                        <li><a class="dropdown-item" href="?culture=ar-MA">&#127474;&#127462; &#1575;&#1604;&#1593;&#1585;&#1576;&#1610;&#1577;</a></li>
                        <li><a class="dropdown-item" href="?culture=en-US">&#127468;&#127463; English</a></li>
                    </ul>
                </div>
                <div class="notification-bell" id="notificationBell"><i class="bi bi-bell"></i><span class="badge bg-danger rounded-pill" id="notifCount" style="display:none;">0</span></div>
                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 p-0" data-bs-toggle="dropdown">
                        <div class="user-avatar">@(Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper() ?? "U")</div>
                        <div class="d-none d-md-block text-start">
                            <div class="fw-semibold text-dark" style="font-size:0.82rem;">@(Context.Session.GetString("UserName") ?? "Utilisateur")</div>
                            <div class="text-muted" style="font-size:0.68rem;">@(Context.Session.GetString("UserRole") ?? "")</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted" style="font-size:0.7rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Mon Profil</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("Index", "Parametres")"><i class="bi bi-gear me-2"></i> Param&#232;tres</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right me-2"></i> D&#233;connexion</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="mc-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i><strong>@TempData["Error"]</strong>
                    @if (TempData["ErrorDetails"] != null)
                    {
                        <ul class="mb-0 mt-2" style="font-size:0.85rem; list-style:disc; padding-left:1.2rem;">
                            @foreach (var detail in ((string)TempData["ErrorDetails"]!).Split("|||"))
                            {
                                <li>@detail</li>
                            }
                        </ul>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <!-- Modal Nouvel exercice -->
    <div class="modal fade" id="createExerciceModal" tabindex="-1" aria-labelledby="createExerciceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="createExerciceModalLabel"><i class="bi bi-calendar-plus text-primary me-2"></i>Nouvel exercice comptable</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="exoAnneeInput">Ann&#233;e</label>
                        <input type="number" class="form-control" id="exoAnneeInput" min="1990" max="2100" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="exoDebutInput">Date d&#233;but</label>
                            <input type="date" class="form-control" id="exoDebutInput" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="exoFinInput">Date fin</label>
                            <input type="date" class="form-control" id="exoFinInput" />
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0">Par d&#233;faut : 01/01 – 31/12. Vous pouvez d&#233;caler l&#8217;exercice (ex. 01/04 – 31/03).</p>
                    <div class="text-danger small mt-2 d-none" id="exoCreateError"></div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary rounded-pill" id="exoCreateSubmitBtn">Cr&#233;er et s&#233;lectionner</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <script>
        toastr.options = { positionClass: 'toast-top-right', closeButton: true, progressBar: true, timeOut: 4000 };
        $.extend($.fn.dataTable.defaults, { language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/fr-FR.json' }, pageLength: 20, responsive: true });
        $(function() { $('.mc-datatable').DataTable(); });
        setTimeout(function() { $('.alert-dismissible').alert('close'); }, 5000);

            // CLIENT SELECTOR
        (function() {
            var wrapper = document.getElementById('clientSelectorWrapper');
            var btn = document.getElementById('clientSelectorBtn');
            var dropdown = document.getElementById('clientDropdown');
            var searchInput = document.getElementById('clientSearchInput');
            var clientList = document.getElementById('clientList');
            var clearBtn = document.getElementById('clientClearBtn');
            var debounceTimer = null;
            if (!wrapper || !btn || !dropdown || !searchInput || !clientList) {
                // Gateway / no selector — still expose mcSelectClient for Workspace
                window.mcSelectClient = function(id, name) {
                    $.post('@Url.Action("SetClientContext", "Clients")', { clientId: id }, function(res) {
                        if (res.success) {
                            toastr.success('Client actif : ' + name);
                            window.location.href = '@Url.Action("Index", "Declarations")';
                        }
                    });
                };
                return;
            }

            // Exposed globally so Workspace client cards can reuse the same selection flow.
            window.mcSelectClient = function(id, name) {
                $.post('@Url.Action("SetClientContext", "Clients")', { clientId: id }, function(res) {
                    if (res.success) {
                        toastr.success('Client actif : ' + name);
                        var path = (window.location.pathname || '').toLowerCase();
                        var isWorkspace = path.indexOf('/home/workspace') !== -1 || path.endsWith('/workspace');
                        if (isWorkspace) {
                            window.location.href = '@Url.Action("Index", "Declarations")';
                        } else {
                            window.location.reload();
                        }
                    }
                });
            };

            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var isOpen = dropdown.classList.contains('show');
                dropdown.classList.toggle('show');
                btn.setAttribute('aria-expanded', !isOpen);
                if (!isOpen) { searchInput.value = ''; searchInput.focus(); loadClients(''); }
            });
            document.addEventListener('click', function(e) {
                if (!wrapper.contains(e.target)) { dropdown.classList.remove('show'); }
            });
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function() { loadClients(searchInput.value); }, 250);
            });

            function loadClients(query) {
                clientList.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
                $.get('@Url.Action("SearchClients", "Clients")', { q: query }, function(data) {
                    if (!data || data.length === 0) {
                        clientList.innerHTML = '<div class="text-center text-muted py-3" style="font-size:0.82rem;">Aucun client trouv&#233;</div>';
                        return;
                    }
                    var html = '';
                    var currentId = '@(selectedClientId ?? "")';
                    data.forEach(function(c) {
                        var initials = (c.raisonSociale || '??').substring(0,2).toUpperCase();
                        var sel = c.id.toString() === currentId;
                        html += '<div class="client-item ' + (sel ? 'selected' : '') + '" data-id="' + c.id + '" data-name="' + (c.raisonSociale||'').replace(/"/g,'&quot;') + '">';
                        html += '<div class="client-avatar">' + initials + '</div>';
                        html += '<div class="client-info"><div class="name">' + c.raisonSociale + '</div><div class="ice">' + (c.ice||'') + (c.formeJuridique ? ' - ' + c.formeJuridique : '') + '</div></div>';
                        if (sel) html += '<i class="bi bi-check-circle-fill text-primary"></i>';
                        html += '</div>';
                    });
                    clientList.innerHTML = html;
                    clientList.querySelectorAll('.client-item').forEach(function(item) {
                        item.addEventListener('click', function() { selectClient(item.dataset.id, item.dataset.name); });
                    });
                });
            }

            function selectClient(id, name) {
                window.mcSelectClient(id, name);
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    $.post('@Url.Action("SetClientContext", "Clients")', { clientId: '' }, function(res) {
                        if (res.success) {
                            toastr.info('Client désélectionné');
                            window.location.href = '@Url.Action("Workspace", "Home")';
                        }
                    });
                });
            }
            searchInput.addEventListener('keydown', function(e) { if (e.key === 'Escape') { dropdown.classList.remove('show'); btn.focus(); } });
        })();

        // EXERCICE SELECTOR
        (function() {
            var wrapper = document.getElementById('exerciceSelectorWrapper');
            if (!wrapper) return;
            var btn = document.getElementById('exerciceSelectorBtn');
            var dropdown = document.getElementById('exerciceDropdown');
            var list = document.getElementById('exerciceList');
            var createBtn = document.getElementById('exerciceCreateBtn');
            var display = document.getElementById('selectedExerciceDisplay');
            var badge = document.getElementById('selectedExerciceStatutBadge');
            var modalEl = document.getElementById('createExerciceModal');
            var modal = modalEl ? new bootstrap.Modal(modalEl) : null;

            function statutClass(st) {
                return (st || '').toLowerCase().indexOf('ouvert') >= 0 ? 'exo-ouvert' : 'exo-cloture';
            }

            function renderExercices(data) {
                if (!data || !data.length) {
                    list.innerHTML = '<div class="text-center text-muted py-3" style="font-size:0.82rem;">Aucun exercice</div>';
                    return;
                }
                var html = '';
                var currentId = (document.getElementById('selectedExerciceIdValue') || {}).value || '';
                data.forEach(function(e) {
                    var sel = e.id.toString() === currentId || e.selected;
                    html += '<div class="client-item ' + (sel ? 'selected' : '') + '" data-id="' + e.id + '" data-annee="' + e.annee + '" data-statut="' + (e.statut || '') + '">';
                    html += '<div class="client-avatar" style="background:linear-gradient(135deg,#00c875,#037f4c);font-size:0.7rem;">' + e.annee + '</div>';
                    html += '<div class="client-info"><div class="name">Exercice ' + e.annee + '</div>';
                    html += '<div class="ice">' + (e.dateDebut || '') + ' → ' + (e.dateFin || '') + '</div></div>';
                    html += '<span class="badge exo-statut-badge ' + statutClass(e.statut) + '">' + (e.statut || '') + '</span>';
                    if (sel) html += '<i class="bi bi-check-circle-fill text-primary ms-1"></i>';
                    html += '</div>';
                });
                list.innerHTML = html;
                list.querySelectorAll('.client-item').forEach(function(item) {
                    item.addEventListener('click', function() {
                        selectExercice(item.dataset.id, item.dataset.annee, item.dataset.statut);
                    });
                });
            }

            function loadExercices() {
                list.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
                $.get('@Url.Action("ListExercices", "Home")', function(data) { renderExercices(data); });
            }

            function selectExercice(id, annee, statut) {
                $.post('@Url.Action("SetExercice", "Home")', { exerciceId: id }, function(res) {
                    if (res && res.success) {
                        toastr.success('Exercice ' + (res.annee || annee) + ' sélectionné');
                        window.location.reload();
                    } else {
                        toastr.error((res && res.message) || 'Sélection impossible');
                    }
                });
            }

            function syncDatesFromYear() {
                var y = parseInt(document.getElementById('exoAnneeInput').value, 10);
                if (!y) return;
                document.getElementById('exoDebutInput').value = y + '-01-01';
                document.getElementById('exoFinInput').value = y + '-12-31';
            }

            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var isOpen = dropdown.classList.contains('show');
                dropdown.classList.toggle('show');
                btn.setAttribute('aria-expanded', !isOpen);
                if (!isOpen) loadExercices();
            });
            document.addEventListener('click', function(e) {
                if (!wrapper.contains(e.target)) dropdown.classList.remove('show');
            });

            if (createBtn && modal) {
                createBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    dropdown.classList.remove('show');
                    var next = new Date().getFullYear() + 1;
                    document.getElementById('exoAnneeInput').value = next;
                    syncDatesFromYear();
                    document.getElementById('exoCreateError').classList.add('d-none');
                    modal.show();
                });
            }
            var anneeInput = document.getElementById('exoAnneeInput');
            if (anneeInput) anneeInput.addEventListener('change', syncDatesFromYear);

            var submitBtn = document.getElementById('exoCreateSubmitBtn');
            if (submitBtn) {
                submitBtn.addEventListener('click', function() {
                    var err = document.getElementById('exoCreateError');
                    err.classList.add('d-none');
                    var payload = {
                        annee: parseInt(document.getElementById('exoAnneeInput').value, 10),
                        dateDebut: document.getElementById('exoDebutInput').value || null,
                        dateFin: document.getElementById('exoFinInput').value || null
                    };
                    if (!payload.annee) {
                        err.textContent = 'Année obligatoire.';
                        err.classList.remove('d-none');
                        return;
                    }
                    submitBtn.disabled = true;
                    $.ajax({
                        url: '@Url.Action("CreateExercice", "Home")',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function(res) {
                            submitBtn.disabled = false;
                            if (res && res.success) {
                                toastr.success(res.message || ('Exercice ' + res.annee + ' créé'));
                                if (modal) modal.hide();
                                window.location.reload();
                            } else {
                                err.textContent = (res && res.message) || 'Création impossible.';
                                err.classList.remove('d-none');
                            }
                        },
                        error: function(xhr) {
                            submitBtn.disabled = false;
                            err.textContent = (xhr.responseJSON && xhr.responseJSON.message) || 'Erreur serveur.';
                            err.classList.remove('d-none');
                        }
                    });
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

