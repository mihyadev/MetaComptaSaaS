                            <option value="ValidateDeclaration">ValidateDeclaration</option><option value="SubmitDeclaration">SubmitDeclaration</option>
                            <option value="SuspendDeclaration">SuspendDeclaration</option><option value="ArchiveDeclaration">ArchiveDeclaration</option>
                            <option value="RelanceClient">RelanceClient</option><option value="NotifyEmployee">NotifyEmployee</option><option value="NotifyClient">NotifyClient</option>
                            <option value="GeneratePDF">GeneratePDF</option><option value="ExportXML">ExportXML</option><option value="SendEmail">SendEmail</option>
