@using MetaCompta.Application.DTOs
@model WorkflowTemplateCreateDto
@{
    ViewData["Title"] = "Workflow Builder";
    var clients = ViewBag.Clients as List<ClientDto> ?? new List<ClientDto>();
    var departments = ViewBag.Departments as List<DepartmentDto> ?? new List<DepartmentDto>();
    var employees = ViewBag.Employees as List<CabinetEmployeeDto> ?? new List<CabinetEmployeeDto>();
    var allTemplates = ViewBag.AllTemplates as List<WorkflowTemplateDto> ?? new List<WorkflowTemplateDto>();
    var editTemplate = ViewBag.EditTemplate as WorkflowTemplateDto;
    var editId = ViewBag.EditTemplateId as int?;
    var isEditMode = editId.HasValue;

    var stepTypes = new[] { "Initialisation", "DemandePieces", "Collecte", "Saisie", "Controle", "ValidationInterne", "ValidationClient", "DepotSoumission", "Paiement", "Rapprochement", "ClotureArchivage" };
    var assignmentTypes = new[] { "Employee", "Role", "Department", "Client", "AutoSystem" };
    var priorities = new[] { "Faible", "Moyenne", "Haute", "Urgente" };
    var roles = new[] { "Gerant", "Manager", "Collaborateur", "Assistant", "Stagiaire" };
    var declTypes = new[] { "All", "TVA", "IS", "IR", "CNSS", "DTS", "IR_SALAIRES", "Paie", "Juridique", "Comptabilite" };
    var declStatuses = new[] { "Brouillon", "ACompleter", "EnCours", "EnPreparation", "Completee", "EnRevision", "Validee", "Soumise", "Payee", "Refusee", "Rejetee", "DocumentsDemandes", "DocumentsRecus", "Suspendue", "Archivee" };
    var actionTypes = new[] { "None", "CreateDeclaration", "CompleteDeclaration", "ValidateDeclaration", "SubmitDeclaration", "SuspendDeclaration", "ArchiveDeclaration", "ClotureDeclaration", "RelanceClient", "NotifyEmployee", "NotifyClient", "GeneratePDF", "ExportXML", "SendEmail", "CreateTask", "RequestDocuments", "ApproveByClient", "PaymentReminder" };
    var routingModes = new[] { "Sequential", "ConditionalBranch", "SkipToStep", "EndWorkflow" };
    var triggerSources = new[] { "Manual", "System", "Employee", "Client", "Extranet", "API", "Schedule" };
    var onMaxRetries = new[] { "NextStep", "Suspend", "Cancel", "SkipStep", "EscalateToManager" };

    var typeColors = new Dictionary<string, (string bg, string fg, string icon)> {
        ["TVA"] = ("#dbeafe", "#2563eb", "bi-receipt-cutoff"),
        ["IS"] = ("#fce7f3", "#be185d", "bi-building"),
        ["IR"] = ("#ede9fe", "#7c3aed", "bi-person-vcard"),
        ["CNSS"] = ("#d1fae5", "#059669", "bi-shield-plus"),
        ["DTS"] = ("#ecfdf5", "#047857", "bi-file-earmark-person"),
        ["Paie"] = ("#fef3c7", "#d97706", "bi-cash-stack"),
        ["Juridique"] = ("#fee2e2", "#dc2626", "bi-file-earmark-text"),
        ["Comptabilite"] = ("#e0f2fe", "#0284c7", "bi-journal-bookmark-fill"),
        ["IR_SALAIRES"] = ("#f5f3ff", "#6d28d9", "bi-people-fill"),
        ["All"] = ("#f1f5f9", "#475569", "bi-grid-3x3-gap-fill")
    };

    var stepTypeLabels = new Dictionary<string, string> {
        ["Initialisation"] = "Initialisation",
        ["DemandePieces"] = "Demande pièces",
        ["Relance"] = "Relance documents",
        ["Collecte"] = "Collecte",
        ["Saisie"] = "Saisie",
        ["Controle"] = "Contrôle",
        ["ValidationInterne"] = "Valid. interne",
        ["ValidationClient"] = "Valid. client",
        ["DepotSoumission"] = "Dépôt",
        ["Paiement"] = "Paiement",
        ["Rapprochement"] = "Rapprochement",
        ["ClotureArchivage"] = "Clôture"
    };
    var onMaxRetriesLabels = new Dictionary<string, string> {
        ["Suspend"] = "Suspendre la déclaration",
        ["EscalateToManager"] = "Escalader au manager",
        ["NextStep"] = "Passer à l'étape suivante",
        ["SkipStep"] = "Ignorer l'étape",
        ["Cancel"] = "Annuler le workflow"
    };

    var assignLabels = new Dictionary<string, string> {
        ["Employee"] = "Employé",
        ["Role"] = "Rôle",
        ["Department"] = "Département",
        ["Client"] = "Client",
        ["AutoSystem"] = "Automatique"
    };
}

<style>
    .builder-card { border: 0; border-radius: 16px; box-shadow: var(--monday-shadow); }
    .step-card { background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 16px; margin-bottom: 1rem; position: relative; overflow: hidden; }
    .step-card.collapsed-step .step-body { display: none; }
    .step-card.collapsed-step .step-header { border-bottom: 0; }
    .step-card.collapsed-step .chevron-icon { transform: rotate(-90deg); }
    .step-num { width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.82rem; color: #fff; background: var(--monday-blue); flex-shrink: 0; }
    .step-order-controls { display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
    .step-drag-handle { width: 28px; height: 34px; border: 0; background: transparent; color: var(--monday-muted); cursor: grab; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 1.1rem; padding: 0; }
    .step-drag-handle:hover { color: var(--monday-blue); background: color-mix(in srgb, var(--monday-blue) 10%, transparent); }
    .step-drag-handle:active { cursor: grabbing; }
    .step-num-input { width: 42px; height: 34px; border-radius: 10px; border: 1px solid var(--monday-border); background: var(--monday-blue); color: #fff; font-weight: 800; font-size: 0.82rem; text-align: center; padding: 0; -moz-appearance: textfield; appearance: textfield; }
    .step-num-input::-webkit-outer-spin-button, .step-num-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .step-num-input:focus { outline: 2px solid color-mix(in srgb, var(--monday-blue) 45%, #fff); outline-offset: 1px; }
    .step-move-btns { display: flex; flex-direction: column; gap: 1px; }
    .btn-move-step { width: 22px; height: 16px; border: 1px solid var(--monday-border); background: var(--monday-surface); color: var(--monday-muted); border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: 0.55rem; padding: 0; line-height: 1; cursor: pointer; }
    .btn-move-step:hover:not(:disabled) { color: var(--monday-blue); border-color: var(--monday-blue); }
    .btn-move-step:disabled { opacity: 0.35; cursor: not-allowed; }
    .step-card.step-ghost { opacity: 0.45; border: 2px dashed var(--monday-blue); background: color-mix(in srgb, var(--monday-blue) 6%, var(--monday-surface)); }
    .step-card.step-chosen { box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12); }
    .step-card.step-dragging { opacity: 0.95; }
    #stepsContainer.is-reordering .step-body { pointer-events: none; }
    .step-reorder-hint { font-size: 0.72rem; font-weight: 500; color: var(--monday-muted); text-transform: none; letter-spacing: 0; }
    .step-header { display: flex; align-items: center; gap: 0.7rem; cursor: pointer; padding: 0.9rem 1.1rem; background: var(--monday-bg); border-bottom: 1px solid var(--monday-border); }
    .step-header h6 { margin: 0; font-size: 0.9rem; font-weight: 700; color: var(--monday-text); }
    .step-type-badge { font-size: 0.68rem; padding: 3px 10px; border-radius: 20px; font-weight: 700; background: color-mix(in srgb, var(--monday-blue) 12%, var(--monday-surface)); color: var(--monday-blue); border: 1px solid var(--monday-border); }
    .assign-badge { font-size: 0.68rem; padding: 3px 10px; border-radius: 20px; background: color-mix(in srgb, var(--monday-green) 12%, var(--monday-surface)); color: var(--monday-green); font-weight: 600; border: 1px solid var(--monday-border); }
    .sla-badge { font-size: 0.68rem; padding: 3px 10px; border-radius: 20px; background: color-mix(in srgb, var(--monday-orange) 12%, var(--monday-surface)); color: var(--monday-orange); font-weight: 600; border: 1px solid var(--monday-border); }
    .chevron-icon { transition: transform .25s ease; font-size: 0.9rem; color: var(--monday-muted); }
    .step-body { padding: 1.1rem; background: var(--monday-surface); }
    .field-section { background: var(--monday-bg); border: 1px solid var(--monday-border); border-radius: 12px; padding: 0.75rem 1rem; margin-bottom: 0.65rem; }
    .field-section-title { font-size: 0.72rem; font-weight: 800; color: var(--monday-blue); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.55rem; display: flex; align-items: center; gap: 0.4rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--monday-border); }
    .form-label-sm { font-size: 0.74rem; font-weight: 600; color: var(--monday-muted); margin-bottom: 0.2rem; display: block; }
    .tpl-mini { display: flex; align-items: center; gap: 0.5rem; padding: 0.55rem 0.8rem; border: 1px solid var(--monday-border); border-radius: 12px; margin-bottom: 0.45rem; cursor: pointer; font-size: 0.8rem; text-decoration: none; }
    .tpl-mini.active { background: color-mix(in srgb, var(--monday-blue) 8%, var(--monday-surface)); border-color: var(--monday-blue); }
    .tpl-mini .tpl-type { font-size: 0.65rem; padding: 2px 7px; border-radius: 10px; font-weight: 700; }
    .chk-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem; }
    .chk-item { display: flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.65rem; background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 10px; font-size: 0.74rem; font-weight: 600; color: var(--monday-text); cursor: pointer; }
    .chk-item input:checked ~ span { color: var(--monday-blue); font-weight: 700; }
    .chk-item .form-check-input { width: 1rem; height: 1rem; margin: 0; }
    .btn-add-step { border: 2px dashed var(--monday-border); border-radius: 14px; padding: 1rem; text-align: center; color: var(--monday-blue); font-weight: 700; font-size: 0.85rem; background: transparent; cursor: pointer; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
    .section-title { font-size: 0.8rem; font-weight: 800; color: var(--monday-text); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.6rem; }
    .section-title i { font-size: 0.9rem; color: var(--monday-blue); }
    .field-section details summary { list-style: none; cursor: pointer; }
    .field-section details summary::-webkit-details-marker { display: none; }
    .field-section details[open] summary .toggle-hint { display: none; }
    .toggle-hint { font-size: 0.65rem; font-weight: 400; color: var(--monday-muted); text-transform: none; letter-spacing: 0; }
    .btn-delete-step { width: 26px; height: 26px; border-radius: 8px; border: 1px solid var(--monday-border); background: var(--monday-surface); color: var(--monday-red); display: flex; align-items: center; justify-content: center; font-size: 0.72rem; cursor: pointer; }
    .cron-builder { background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 12px; padding: 0.85rem 1rem; }
    .cron-freq-btn, .cron-day-btn, .cron-month-btn { border: 1px solid var(--monday-border); border-radius: 10px; cursor: pointer; font-size: 0.76rem; font-weight: 600; color: var(--monday-text); background: var(--monday-surface); }
    .cron-freq-btn.active, .cron-day-btn.active, .cron-month-btn.active { background: var(--monday-blue); color: #fff; border-color: var(--monday-blue); }
    .cron-day-btn { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.74rem; }
    .cron-preview { background: color-mix(in srgb, var(--monday-green) 10%, var(--monday-surface)); border: 1px solid var(--monday-border); border-radius: 10px; padding: 0.5rem 0.85rem; margin-top: 0.6rem; display: flex; align-items: center; gap: 0.5rem; }
    .cron-preview-end { background: color-mix(in srgb, #e67e22 12%, var(--monday-surface)); border: 1px solid var(--monday-border); border-radius: 10px; padding: 0.5rem 0.85rem; margin-top: 0.45rem; display: flex; align-items: center; gap: 0.5rem; }
    .cron-preview-icon { width: 28px; height: 28px; border-radius: 8px; background: var(--monday-green); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
    .cron-preview-end .cron-preview-icon { background: #e67e22; }
    .cron-preview-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--monday-muted); margin-bottom: 0.1rem; }
    .cron-preview-text { font-size: 0.78rem; font-weight: 600; color: var(--monday-text); }
    .cron-preview-cron { font-size: 0.68rem; color: var(--monday-muted); font-family: monospace; }
    .life-panel { background: color-mix(in srgb, var(--monday-blue) 4%, var(--monday-surface)); border: 1px solid var(--monday-border); border-radius: 12px; padding: 0.85rem 1rem; margin-top: 0.35rem; }
    .life-panel .life-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--monday-muted); margin-bottom: 0.35rem; display: block; }
    .life-panel .life-offset-row { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: stretch; }
    .life-panel .life-unit { display: flex; align-items: center; background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 10px; overflow: hidden; min-height: 34px; }
    .life-panel .life-unit span { font-size: 0.72rem; font-weight: 600; color: var(--monday-muted); padding: 0 0.55rem; white-space: nowrap; }
    .life-panel .life-unit input { border: 0; width: 3.2rem; text-align: center; font-weight: 700; font-size: 0.85rem; background: transparent; padding: 0.3rem 0; }
    .life-panel .life-unit input:focus { outline: none; box-shadow: none; }
    .life-panel .life-plus { color: var(--monday-muted); font-weight: 700; align-self: center; padding: 0 0.15rem; }
    .period-template-box { margin-top: 0.35rem; border: 1px solid var(--monday-border); border-radius: 10px; overflow: hidden; background: var(--monday-surface); }
    .period-template-box .pt-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.45rem 0.75rem; background: color-mix(in srgb, var(--monday-blue) 6%, var(--monday-surface)); border-bottom: 1px solid var(--monday-border); }
    .period-template-box .pt-head span { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--monday-muted); }
    .period-template-box .pt-head strong { font-size: 0.78rem; color: var(--monday-text); }
    .period-template-box table { width: 100%; margin: 0; font-size: 0.75rem; }
    .period-template-box th, .period-template-box td { padding: 0.28rem 0.5rem; border-bottom: 1px solid var(--monday-border); vertical-align: middle; }
    .period-template-box th { color: var(--monday-muted); font-weight: 600; font-size: 0.65rem; text-transform: uppercase; }
    .period-template-box tr:last-child td { border-bottom: 0; }
    .period-template-box .pt-scroll { max-height: 260px; overflow-y: auto; }
    .period-template-box input[type="text"], .period-template-box input[type="date"], .period-template-box input[type="number"], .period-template-box select { border: 1px solid var(--monday-border); border-radius: 6px; padding: 0.2rem 0.35rem; font-size: 0.75rem; background: var(--monday-surface); }
    .period-template-box input[type="text"] { width: 100%; }
    .period-template-box .pt-md-row { display: flex; align-items: center; gap: 0.25rem; flex-wrap: nowrap; }
    .period-template-box .pt-md-row input[type="number"] { width: 3.2rem; text-align: center; font-weight: 700; }
    .period-template-box .pt-md-row select { min-width: 5.5rem; }
    .period-template-box .pt-sep { color: var(--monday-muted); font-weight: 600; }
    .period-template-box .pt-yyyy { font-size: 0.72rem; font-weight: 700; color: var(--monday-blue); letter-spacing: .02em; white-space: nowrap; }
    .period-template-box .pt-del { border: 0; background: transparent; color: var(--monday-muted); padding: 0.15rem 0.35rem; cursor: pointer; }
    .period-template-box .pt-del:hover { color: #c0392b; }
    .period-template-box .pt-add { font-size: 0.72rem; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-kanban-fill text-primary me-2"></i>@(isEditMode ? "Modifier" : "Créer") le workflow cabinet</h4>
        <p class="text-muted mb-0" style="font-size:0.82rem;">Un modèle de base par type de déclaration. À l’affectation client, personnalisez depuis la fiche client → Workflow.</p>
    </div>
    <div class="d-flex gap-2">
        @if ((ViewBag.CanWorkflowCreate as bool? ?? false) || (ViewBag.CanSystemAdmin as bool? ?? false))
        {
            <form asp-action="SeedAllDefaultTemplates" asp-controller="Workflow" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="forceReset" value="true" />
                <button type="submit" class="btn btn-outline-danger rounded-pill px-3"
                        onclick="return confirm('Réinitialiser TOUS les workflows cabinet ?\n\n• Les anciens modèles seront archivés (ancien)\n• Un seul workflow propre sera recréé par type (TVA, IS, IR, CNSS…)\n• Les copies client ne sont pas supprimées')">
                    <i class="bi bi-arrow-clockwise me-1"></i>Réinitialiser &amp; recréer
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-3">
        <div class="card builder-card">
            <div class="card-body">
                <h6 class="fw-bold mb-2" style="font-size:0.82rem;"><i class="bi bi-collection text-primary me-1"></i>Base cabinet</h6>
                <p class="text-muted mb-3" style="font-size:0.72rem;">1 workflow actif par type</p>
                @if (allTemplates.Any())
                {
                    @foreach (var tpl in allTemplates)
                    {
                        var tc = typeColors.ContainsKey(tpl.DeclarationType) ? typeColors[tpl.DeclarationType] : typeColors["All"];
                        <a href="@Url.Action("Builder", "Workflow", new { id = tpl.Id })" class="tpl-mini @(editId == tpl.Id ? "active" : "")">
                            <span class="tpl-type" style="background:@tc.bg; color:@tc.fg;">@tpl.DeclarationType</span>
                            <span class="fw-semibold text-dark" style="font-size:0.78rem;">@tpl.Name</span>
                            <span class="ms-auto text-muted" style="font-size:0.65rem;">@tpl.StepCount ét.</span>
                        </a>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-3" style="font-size:0.8rem;"><i class="bi bi-inbox d-block mb-1" style="font-size:1.3rem;"></i>Aucun modèle</div>
                }
                <hr class="my-2"/>
                @if (ViewBag.CanWorkflowCreate as bool? ?? false)
                {
                    <a href="@Url.Action("Builder", "Workflow")" class="btn btn-sm btn-primary w-100 rounded-pill"><i class="bi bi-plus me-1"></i>Nouveau type</a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <form asp-action="BuilderSave" asp-controller="Workflow" method="post" id="builderForm">
            @Html.AntiForgeryToken()
            @if (isEditMode) { <input type="hidden" name="id" value="@editId" /> }
            <input type="hidden" name="ClientId" value="" />
            <input type="hidden" name="IsDefault" value="true" />

            <div class="card builder-card mb-3">
                <div class="card-body">
                    <div class="section-title"><i class="bi bi-gear-fill"></i>Configuration générale</div>
                    <div class="alert alert-light border py-2 px-3 mb-3" style="font-size:0.78rem;">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        Modèle <strong>cabinet</strong> (base). Après affectation, la personnalisation se fait sur le <strong>client</strong>.
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label-sm">Nom du workflow</label>
                            <input type="text" name="Name" value="@Model.Name" class="form-control form-control-sm" placeholder="Ex: TVA Mensuelle" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-sm">Type de déclaration</label>
                            @if (isEditMode)
                            {
                                <input type="hidden" name="DeclarationType" value="@Model.DeclarationType" />
                                <input type="text" class="form-control form-control-sm" value="@Model.DeclarationType" disabled />
                            }
                            else
                            {
                                <select name="DeclarationType" class="form-select form-select-sm">
                                    @foreach (var dt in declTypes) { <option value="@dt" selected="@(Model.DeclarationType == dt)">@dt</option> }
                                </select>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label-sm">Description</label>
                            <textarea name="Description" class="form-control form-control-sm" rows="2" placeholder="Description du workflow...">@Model.Description</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card builder-card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <div class="section-title mb-0"><i class="bi bi-list-ol"></i>Étapes du workflow</div>
                            <div class="step-reorder-hint mt-1"><i class="bi bi-grip-vertical me-1"></i>Glissez, utilisez ↑↓ ou changez le n° pour réordonner</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2" id="stepCountBadge" style="font-size:0.78rem;">@Model.Steps.Count étapes</span>
                    </div>
                    <div id="stepsContainer">
                        @for (var i = 0; i < Model.Steps.Count; i++)
                        {
                            var step = Model.Steps[i];
                            var stLabel = stepTypeLabels.ContainsKey(step.StepType) ? stepTypeLabels[step.StepType] : step.StepType;
                            var asLabel = assignLabels.ContainsKey(step.AssignmentType) ? assignLabels[step.AssignmentType] : step.AssignmentType;
                            var showSched = step.IsScheduled || step.AssignmentType == "AutoSystem";
                            <div class="step-card" data-index="@i">
                                <div class="step-header" onclick="toggleStep(this)">
                                    <div class="step-order-controls" onclick="event.stopPropagation()">
                                        <button type="button" class="step-drag-handle" title="Glisser pour réordonner" aria-label="Glisser"><i class="bi bi-grip-vertical"></i></button>
                                        <input type="number" class="step-num step-num-input" value="@(i + 1)" min="1" max="@Model.Steps.Count" title="Changer le numéro d'ordre" aria-label="Ordre de l'étape" onchange="onStepNumberChange(this)" onclick="event.stopPropagation()" />
                                        <div class="step-move-btns">
                                            <button type="button" class="btn-move-step btn-move-up" title="Monter" aria-label="Monter" onclick="event.stopPropagation();moveStep(this,-1)"><i class="bi bi-chevron-up"></i></button>
                                            <button type="button" class="btn-move-step btn-move-down" title="Descendre" aria-label="Descendre" onclick="event.stopPropagation();moveStep(this,1)"><i class="bi bi-chevron-down"></i></button>
                                        </div>
                                    </div>
                                    <h6>@(string.IsNullOrEmpty(step.Name) ? $"Étape {i+1}" : step.Name)</h6>
                                    <span class="step-type-badge">@stLabel</span>
                                    <span class="assign-badge"><i class="bi bi-person-fill me-1"></i>@asLabel</span>
                                    @if (step.SLAHours.HasValue) { <span class="sla-badge"><i class="bi bi-clock me-1"></i>@step.SLAHours h</span> }
                                    <span class="ms-auto d-flex align-items-center gap-2">
                                        <button type="button" class="btn-delete-step" onclick="event.stopPropagation();removeStep(this)" title="Supprimer"><i class="bi bi-trash3"></i></button>
                                        <i class="bi bi-chevron-down chevron-icon"></i>
                                    </span>
                                </div>
                                <div class="step-body">
                                    <!-- S1: Identification -->
                                    <div class="field-section">
                                        <div class="field-section-title"><i class="bi bi-tag-fill"></i>Identification</div>
                                        <div class="row g-2">
                                            <div class="col-md-5">
                                                <label class="form-label-sm">Nom de l'étape</label>
                                                <input type="text" name="Steps[@i].Name" value="@step.Name" class="form-control form-control-sm step-name-input" />
                                            </div>
                                            <div class="col-md-7">
                                                <label class="form-label-sm">Type d'étape</label>
                                                <select name="Steps[@i].StepType" class="form-select form-select-sm step-type-select" onchange="onStepTypeOrAssignChange(this)">
                                                    @foreach (var st in stepTypes) { <option value="@st" selected="@(step.StepType == st)">@(stepTypeLabels.ContainsKey(st) ? stepTypeLabels[st] : st)</option> }
                                                    @if (string.Equals(step.StepType, "Relance", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <option value="Relance" selected>Relance (obsolète → utiliser config ci-dessous)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label-sm">Description</label>
                                                <input type="text" name="Steps[@i].Description" value="@step.Description" class="form-control form-control-sm" placeholder="Description de l'étape..." />
                                            </div>
                                        </div>
                                    </div>
                                    @{
                                        var isClotureStep = step.StepType == "ClotureArchivage";
                                        var isInitStep = step.StepType == "Initialisation";
                                        var lifeAction = step.ActionOnLifecycleEnd ?? "ClotureDeclaration";
                                    }
                                    <input type="hidden" name="Steps[@i].DeadlineAnchor" value="@(isClotureStep ? "None" : "CalendrierMaroc")" class="deadline-anchor-hidden" />
                                    <input type="hidden" name="Steps[@i].ApplyDeadlineToDeclaration" value="@(isInitStep ? "true" : "false")" />
                                    <input type="hidden" name="Steps[@i].LifecycleEndMode" value="@(isInitStep ? "PeriodEnd" : "None")" class="lifecycle-mode-hidden" />
                                    <!-- Internal processing delay (non-Init, non-Clôture) -->
                                    <div class="field-section echeance-section @(isClotureStep || isInitStep ? "d-none" : "")">
                                        <div class="field-section-title"><i class="bi bi-hourglass-split"></i>Délai de traitement</div>
                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <label class="form-label-sm">Délai interne (heures)</label>
                                                <input type="number" name="Steps[@i].SLAHours" value="@step.SLAHours" class="form-control form-control-sm" placeholder="24" min="0" />
                                                <div class="form-text">Temps imparti au collaborateur pour cette étape.</div>
                                            </div>
                                        </div>
                                    </div>
                                    @{
                                        var winStart = 1; var winEnd = 1; var winMonths = 1; var winYears = 0;
                                        var lifeDef = MetaCompta.Domain.Common.MoroccoDeclarationCalendar.GetFrequencyLifecycleDefaults("Mensuelle");
                                        winStart = lifeDef.StartDay; winEnd = lifeDef.EndDay; winMonths = lifeDef.Months; winYears = lifeDef.Years;
                                        try
                                        {
                                            var cfgJson = string.IsNullOrWhiteSpace(step.ActionConfigJson) ? "{}" : step.ActionConfigJson!;
                                            using var cfgDoc = System.Text.Json.JsonDocument.Parse(cfgJson);
                                            string? pf = null;
                                            if (cfgDoc.RootElement.TryGetProperty("periodFrequency", out var pfe) && pfe.ValueKind == System.Text.Json.JsonValueKind.String)
                                                pf = pfe.GetString();
                                            if (!string.IsNullOrWhiteSpace(pf))
                                            {
                                                lifeDef = MetaCompta.Domain.Common.MoroccoDeclarationCalendar.GetFrequencyLifecycleDefaults(pf);
                                                winStart = lifeDef.StartDay; winEnd = lifeDef.EndDay; winMonths = lifeDef.Months; winYears = lifeDef.Years;
                                            }
                                            if (cfgDoc.RootElement.TryGetProperty("windowStartDay", out var ws) && ws.TryGetInt32(out var sd)) winStart = sd;
                                            if (cfgDoc.RootElement.TryGetProperty("windowEndDay", out var we) && we.TryGetInt32(out var ed)) winEnd = ed;
                                            if (cfgDoc.RootElement.TryGetProperty("windowMonthOffset", out var wo) && wo.TryGetInt32(out var mov)) winMonths = Math.Max(0, mov);
                                            else if (cfgDoc.RootElement.TryGetProperty("deadlineMonth", out var dm) && dm.TryGetInt32(out var dmv) && dmv is >= 1 and <= 12)
                                                winMonths = dmv;
                                            if (cfgDoc.RootElement.TryGetProperty("deadlineYearOffset", out var dy) && dy.TryGetInt32(out var dyv))
                                            {
                                                if (cfgDoc.RootElement.TryGetProperty("deadlineMonth", out _) && !cfgDoc.RootElement.TryGetProperty("windowMonthOffset", out _))
                                                    winYears = 0;
                                                else
                                                    winYears = Math.Max(0, dyv);
                                            }
                                        }
                                        catch { /* keep defaults */ }
                                    }
                                    <!-- S2: Assignation -->
                                    <div class="field-section">
                                        <div class="field-section-title"><i class="bi bi-person-fill-gear"></i>Assignation</div>
                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <label class="form-label-sm">Type d'assignation</label>
                                                <select name="Steps[@i].AssignmentType" class="form-select form-select-sm assign-select" onchange="toggleAssignFields(this); onStepTypeOrAssignChange(this)">
                                                    @foreach (var at in assignmentTypes) { <option value="@at" selected="@(step.AssignmentType == at)">@(assignLabels.ContainsKey(at) ? assignLabels[at] : at)</option> }
                                                </select>
                                            </div>
                                            <div class="col-md-8 assign-employee-field @(step.AssignmentType != "Employee" ? "d-none" : "")">
                                                <label class="form-label-sm">Employés</label>
                                                <select name="Steps[@i].AssignedToUserIds" class="form-select form-select-sm employee-multi" multiple data-placeholder="Rechercher par prénom ou nom...">
                                                    @foreach (var emp in employees)
                                                    {
                                                        var isSelected = (step.AssignedToUserIds != null && step.AssignedToUserIds.Contains(emp.Id))
                                                            || (!string.IsNullOrEmpty(step.AssignedToUserId) && step.AssignedToUserId == emp.Id);
                                                        var label = emp.NomComplet + (string.IsNullOrEmpty(emp.Role) ? "" : $" — {emp.Role}");
                                                        if (isSelected)
                                                        {
                                                            <option value="@emp.Id" data-first="@emp.FirstName" data-last="@emp.LastName" data-role="@emp.Role" selected>@label</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@emp.Id" data-first="@emp.FirstName" data-last="@emp.LastName" data-role="@emp.Role">@label</option>
                                                        }
                                                    }
                                                </select>
                                                @if (!employees.Any())
                                                {
                                                    <div class="form-text text-warning">Aucun employé cabinet chargé. Vérifiez Cabinet → Employés.</div>
                                                }
                                            </div>
                                            <div class="col-md-4 assign-role-field @(step.AssignmentType != "Role" ? "d-none" : "")">
                                                <label class="form-label-sm">Rôle</label>
                                                <select name="Steps[@i].AssignedToRoleName" class="form-select form-select-sm">
                                                    <option value="">--</option>
                                                    @foreach (var r in roles) { <option value="@r" selected="@(step.AssignedToRoleName == r)">@r</option> }
                                                </select>
                                            </div>
                                            <div class="col-md-4 assign-dept-field @(step.AssignmentType != "Department" ? "d-none" : "")">
                                                <label class="form-label-sm">Département</label>
                                                <select name="Steps[@i].AssignedToDepartmentId" class="form-select form-select-sm">
                                                    <option value="">--</option>
                                                    @foreach (var d in departments) { <option value="@d.Id" selected="@(step.AssignedToDepartmentId == d.Id)">@d.Name</option> }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- S3: Statut Declaration -->
                                    <div class="field-section">
                                        <div class="field-section-title"><i class="bi bi-arrow-left-right"></i>Statut Déclaration</div>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label-sm">É l'entrée de l'étape</label>
                                                <select name="Steps[@i].DeclarationStatusOnEntry" class="form-select form-select-sm">
                                                    <option value="">Aucun changement</option>
                                                    @foreach (var ds in declStatuses) { <option value="@ds" selected="@(step.DeclarationStatusOnEntry == ds)">@ds</option> }
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label-sm">É la complétion de l'étape</label>
                                                <select name="Steps[@i].DeclarationStatusOnComplete" class="form-select form-select-sm">
                                                    <option value="">Aucun changement</option>
                                                    @foreach (var ds in declStatuses) { <option value="@ds" selected="@(step.DeclarationStatusOnComplete == ds)">@ds</option> }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- S4: Actions -->
                                    <div class="field-section">
                                        <div class="field-section-title"><i class="bi bi-lightning-fill"></i>Actions Automatiques</div>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label-sm">Action à l'entrée</label>
                                                <select name="Steps[@i].ActionOnEntry" class="form-select form-select-sm">
                                                    @foreach (var a in actionTypes) { <option value="@a" selected="@(step.ActionOnEntry == a)">@a</option> }
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label-sm">Action à la complétion</label>
                                                <select name="Steps[@i].ActionOnComplete" class="form-select form-select-sm">
                                                    @foreach (var a in actionTypes) { <option value="@a" selected="@(step.ActionOnComplete == a)">@a</option> }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- S5: Comportement -->
                                    <div class="field-section">
                                        <div class="field-section-title"><i class="bi bi-toggles"></i>Comportement</div>
                                        <div class="chk-grid">
                                            <label class="chk-item"><input type="checkbox" name="Steps[@i].IsRequired" value="true" class="form-check-input" @(step.IsRequired ? "checked" : "") /><span>Obligatoire</span></label>
                                            <label class="chk-item"><input type="checkbox" name="Steps[@i].IsBlocking" value="true" class="form-check-input" @(step.IsBlocking ? "checked" : "") /><span>Bloquante</span></label>
                                            <label class="chk-item"><input type="checkbox" name="Steps[@i].AutoNotify" value="true" class="form-check-input" @(step.AutoNotify ? "checked" : "") /><span>Auto-notif</span></label>
                                            <label class="chk-item"><input type="checkbox" name="Steps[@i].AutoCreateTask" value="true" class="form-check-input" @(step.AutoCreateTask ? "checked" : "") /><span>Créer tâche</span></label>
                                            <label class="chk-item"><input type="checkbox" name="Steps[@i].IsClientStep" value="true" class="form-check-input" @(step.IsClientStep ? "checked" : "") /><span>Étape client</span></label>
                                            <label class="chk-item"><input type="checkbox" name="Steps[@i].IsScheduled" value="true" class="form-check-input sched-checkbox" @(step.IsScheduled ? "checked" : "") onchange="toggleSchedule(this)" /><span>Planifiée</span></label>
                                        </div>
                                    </div>
                                    <!-- S6: Fréquence & échéance (one block — no duplicate) -->
                                    <div class="field-section schedule-section @(showSched || isInitStep ? "" : "d-none")">
                                        <div class="field-section-title"><i class="bi bi-calendar-event"></i><span class="schedule-section-title-text">@(isInitStep ? "Périodes & échéances" : "Planification")</span></div>
                                        <div class="init-schedule-panel mb-2 @(step.StepType == "Initialisation" && step.AssignmentType == "AutoSystem" ? "" : "d-none")">
                                            <label class="form-label-sm mb-1">Mode de déclenchement</label>
                                            <div class="d-flex flex-wrap gap-1 mb-2">
                                                <button type="button" class="cron-freq-btn init-trigger-btn" data-mode="schedule" onclick="WfCron.setTriggerMode(this.closest('.step-card'),'schedule')"><i class="bi bi-clock-history"></i> Planifié</button>
                                                <button type="button" class="cron-freq-btn init-trigger-btn" data-mode="manual" onclick="WfCron.setTriggerMode(this.closest('.step-card'),'manual')"><i class="bi bi-hand-index"></i> Manuel</button>
                                                <button type="button" class="cron-freq-btn init-trigger-btn active" data-mode="both" onclick="WfCron.setTriggerMode(this.closest('.step-card'),'both')"><i class="bi bi-shuffle"></i> Planifié + Manuel</button>
                                            </div>
                                            <label class="chk-item mb-2"><input type="checkbox" class="form-check-input init-allow-manual" checked /><span>Autoriser Démarrer manuellement</span></label>
                                            <input type="hidden" name="Steps[@i].ActionConfigJson" class="action-config-input" value="@(string.IsNullOrWhiteSpace(step.ActionConfigJson) ? "{\"initTrigger\":\"both\",\"allowManualInit\":true,\"periodFrequency\":\"Mensuelle\",\"windowStartDay\":1,\"windowEndDay\":10,\"windowMonthOffset\":1}" : step.ActionConfigJson)" />
                                        </div>
                                        <div class="cron-builder cron-freq-panel" data-cron="@step.CronExpression">
                                            <div class="init-freq-echeance mb-2 @(isInitStep ? "" : "d-none")">
                                                <div class="life-panel">
                                                    <span class="life-label">Modèle de périodes</span>
                                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                                        <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="monthly" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'monthly')"><i class="bi bi-calendar-month"></i> Mensuel (12)</button>
                                                        <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="quarterly" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'quarterly')"><i class="bi bi-calendar3"></i> Trimestriel (4)</button>
                                                        <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="annually" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'annually')"><i class="bi bi-calendar-heart"></i> Annuel (1)</button>
                                                        <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="periodic" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'periodic')"><i class="bi bi-calendar-range"></i> Périodique</button>
                                                    </div>
                                                    <div class="period-template-editor mb-2"></div>
                                                    <div class="row g-2 align-items-end">
                                                        <div class="col-md-6">
                                                            <span class="life-label">Action à la fin</span>
                                                            <select name="Steps[@i].ActionOnLifecycleEnd" class="form-select form-select-sm" onchange="WfCron.syncPeriodTable(this.closest('.step-card'))">
                                                                @foreach (var a in actionTypes.Where(x => x != "None" && x != "CreateDeclaration"))
                                                                {
                                                                    var aLabel = a switch
                                                                    {
                                                                        "ClotureDeclaration" => "Clôturer",
                                                                        "ArchiveDeclaration" => "Archiver",
                                                                        "SuspendDeclaration" => "Suspendre",
                                                                        "CompleteDeclaration" => "Terminer",
                                                                        "ValidateDeclaration" => "Valider",
                                                                        "SubmitDeclaration" => "Soumettre",
                                                                        "NotifyEmployee" => "Notifier collaborateur",
                                                                        "NotifyClient" => "Notifier client",
                                                                        "PaymentReminder" => "Rappel paiement",
                                                                        _ => a
                                                                    };
                                                                    <option value="@a" selected="@(lifeAction == a)">@aLabel</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <input type="hidden" class="period-end-preview" />
                                                    <input type="hidden" class="window-start-day" value="1" />
                                                    <input type="hidden" class="window-end-day" value="1" />
                                                    <input type="hidden" class="window-month-offset" value="1" />
                                                    <input type="hidden" class="deadline-year-offset" value="0" />
                                                </div>
                                            </div>
                                            <div class="cron-freq-non-init-wrap @(isInitStep ? "d-none" : "")">
                                            <div class="mb-2 cron-freq-non-init">
                                                <label class="form-label-sm mb-1">Fréquence</label>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <button type="button" class="cron-freq-btn" data-freq="monthly" onclick="setCronFreq(this,'monthly')"><i class="bi bi-calendar-month"></i> Mensuel</button>
                                                    <button type="button" class="cron-freq-btn" data-freq="quarterly" onclick="setCronFreq(this,'quarterly')"><i class="bi bi-calendar3"></i> Trimestriel</button>
                                                    <button type="button" class="cron-freq-btn" data-freq="annually" onclick="setCronFreq(this,'annually')"><i class="bi bi-calendar-heart"></i> Annuel</button>
                                                    <button type="button" class="cron-freq-btn cron-freq-extra" data-freq="custom" onclick="setCronFreq(this,'custom')"><i class="bi bi-calendar-plus"></i> Personnalisé</button>
                                                    <button type="button" class="cron-freq-btn cron-freq-extra" data-freq="weekly" onclick="setCronFreq(this,'weekly')"><i class="bi bi-calendar-week"></i> Hebdo</button>
                                                    <button type="button" class="cron-freq-btn cron-freq-extra" data-freq="daily" onclick="setCronFreq(this,'daily')"><i class="bi bi-calendar-day"></i> Quotidien</button>
                                                </div>
                                            </div>
                                            </div>
                                            <div class="cron-options-weekly d-none mb-2">
                                                <label class="form-label-sm mb-1">Jour de la semaine</label>
                                                <div class="d-flex gap-1">
                                                    <button type="button" class="cron-day-btn" data-dow="1" onclick="toggleCronDay(this)">Lu</button>
                                                    <button type="button" class="cron-day-btn" data-dow="2" onclick="toggleCronDay(this)">Ma</button>
                                                    <button type="button" class="cron-day-btn" data-dow="3" onclick="toggleCronDay(this)">Me</button>
                                                    <button type="button" class="cron-day-btn" data-dow="4" onclick="toggleCronDay(this)">Je</button>
                                                    <button type="button" class="cron-day-btn" data-dow="5" onclick="toggleCronDay(this)">Ve</button>
                                                    <button type="button" class="cron-day-btn" data-dow="6" onclick="toggleCronDay(this)">Sa</button>
                                                    <button type="button" class="cron-day-btn" data-dow="0" onclick="toggleCronDay(this)">Di</button>
                                                </div>
                                            </div>
                                            <div class="cron-options-monthly d-none mb-2 cron-options-monthly-extra">
                                                <label class="form-label-sm mb-1">Jour du mois (cron)</label>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <button type="button" class="cron-day-btn" data-dom="1" onclick="toggleCronDom(this)">1</button>
                                                    <button type="button" class="cron-day-btn" data-dom="5" onclick="toggleCronDom(this)">5</button>
                                                    <button type="button" class="cron-day-btn" data-dom="10" onclick="toggleCronDom(this)">10</button>
                                                    <button type="button" class="cron-day-btn" data-dom="15" onclick="toggleCronDom(this)">15</button>
                                                    <button type="button" class="cron-day-btn" data-dom="20" onclick="toggleCronDom(this)">20</button>
                                                    <button type="button" class="cron-day-btn" data-dom="25" onclick="toggleCronDom(this)">25</button>
                                                    <button type="button" class="cron-day-btn" data-dom="28" onclick="toggleCronDom(this)">28</button>
                                                </div>
                                            </div>
                                            <div class="cron-options-quarterly d-none mb-2">
                                                <label class="form-label-sm mb-1">Mois d'exécution</label>
                                                <div class="d-flex flex-wrap gap-1 mb-2">
                                                    <button type="button" class="cron-month-btn active" data-m="1" onclick="toggleCronMonth(this)">Jan</button>
                                                    <button type="button" class="cron-month-btn" data-m="2" onclick="toggleCronMonth(this)">Fév</button>
                                                    <button type="button" class="cron-month-btn" data-m="3" onclick="toggleCronMonth(this)">Mar</button>
                                                    <button type="button" class="cron-month-btn active" data-m="4" onclick="toggleCronMonth(this)">Avr</button>
                                                    <button type="button" class="cron-month-btn" data-m="5" onclick="toggleCronMonth(this)">Mai</button>
                                                    <button type="button" class="cron-month-btn" data-m="6" onclick="toggleCronMonth(this)">Jun</button>
                                                    <button type="button" class="cron-month-btn active" data-m="7" onclick="toggleCronMonth(this)">Jul</button>
                                                    <button type="button" class="cron-month-btn" data-m="8" onclick="toggleCronMonth(this)">Août</button>
                                                    <button type="button" class="cron-month-btn" data-m="9" onclick="toggleCronMonth(this)">Sep</button>
                                                    <button type="button" class="cron-month-btn active" data-m="10" onclick="toggleCronMonth(this)">Oct</button>
                                                    <button type="button" class="cron-month-btn" data-m="11" onclick="toggleCronMonth(this)">Nov</button>
                                                    <button type="button" class="cron-month-btn" data-m="12" onclick="toggleCronMonth(this)">Déc</button>
                                                </div>
                                                <label class="form-label-sm">Jour</label>
                                                <select class="form-select form-select-sm cron-quarterly-day" style="max-width:120px;" onchange="buildCron(this.closest('.cron-builder'))">
                                                    <option value="1">1</option><option value="5">5</option><option value="10">10</option><option value="15">15</option>
                                                </select>
                                            </div>
                                            <div class="cron-options-annually d-none mb-2">
                                                <label class="form-label-sm mb-1">Mois et jour</label>
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                        <select class="form-select form-select-sm cron-annual-month" onchange="buildCron(this.closest('.cron-builder'))">
                                                            <option value="1">Janvier</option><option value="2">Février</option><option value="3">Mars</option>
                                                            <option value="4">Avril</option><option value="5">Mai</option><option value="6">Juin</option>
                                                            <option value="7">Juillet</option><option value="8">Août</option><option value="9">Septembre</option>
                                                            <option value="10">Octobre</option><option value="11">Novembre</option><option value="12">Décembre</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <select class="form-select form-select-sm cron-annual-day" onchange="buildCron(this.closest('.cron-builder'))">
                                                            <option value="1">1er</option><option value="5">5</option><option value="10">10</option>
                                                            <option value="15">15</option><option value="20">20</option><option value="25">25</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="cron-options-custom d-none mb-2">
                                                <label class="form-label-sm mb-1">Date personnalisée</label>
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                        <input type="date" class="form-control form-control-sm cron-custom-date" onchange="buildCron(this.closest('.cron-builder'))" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <select class="form-select form-select-sm cron-custom-repeat" onchange="buildCron(this.closest('.cron-builder'))">
                                                            <option value="yearly">Répéter chaque année</option>
                                                            <option value="monthly">Répéter chaque mois (jour)</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row g-2 mt-1">
                                                <div class="col-md-4">
                                                    <label class="form-label-sm">Heure d'exécution</label>
                                                    <input type="time" class="form-control form-control-sm cron-time" value="08:00" onchange="buildCron(this.closest('.cron-builder'))" />
                                                </div>
                                            </div>
                                            <div class="cron-preview d-none">
                                                <span class="cron-preview-icon"><i class="bi bi-play-fill"></i></span>
                                                <div>
                                                    <div class="cron-preview-label">Ouverture</div>
                                                    <div class="cron-preview-text"></div>
                                                    <div class="cron-preview-cron"></div>
                                                </div>
                                            </div>
                                            <div class="cron-preview-end d-none">
                                                <span class="cron-preview-icon"><i class="bi bi-flag-fill"></i></span>
                                                <div>
                                                    <div class="cron-preview-label">Échéance</div>
                                                    <div class="cron-preview-text"></div>
                                                    <div class="cron-preview-cron"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <input type="hidden" name="Steps[@i].CronExpression" class="cron-input" value="@step.CronExpression" />
                                        <input type="hidden" name="Steps[@i].CronDescription" class="cron-desc-input" value="@step.CronDescription" />
                                    </div>
                                    <!-- S7: Relance = config on any step (not a step type) -->
                                    @{
                                        var retryDays = step.RetryIntervalHours is > 0
                                            ? Math.Max(1, (int)Math.Round(step.RetryIntervalHours.Value / 24.0))
                                            : 15;
                                        var relanceEnabled = step.MaxRetries > 0
                                            || string.Equals(step.StepType, "Relance", StringComparison.OrdinalIgnoreCase);
                                        var hideRelanceForType = string.Equals(step.StepType, "Initialisation", StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(step.StepType, "ClotureArchivage", StringComparison.OrdinalIgnoreCase);
                                    }
                                    <div class="field-section relance-config-section @(hideRelanceForType ? "d-none" : "")" data-relance-panel>
                                        <div class="field-section-title"><i class="bi bi-arrow-repeat"></i>Relances automatiques</div>
                                        <label class="chk-item mb-2">
                                            <input type="checkbox" class="form-check-input relance-enable" @(relanceEnabled ? "checked" : "") onchange="toggleRelanceConfig(this)" />
                                            <span>Activer les relances si cette étape n'est pas terminée</span>
                                        </label>
                                        <div class="relance-fields @(relanceEnabled ? "" : "d-none")">
                                            <div class="alert alert-info py-2 px-3 small mb-2 mt-1 rounded-3">
                                                Ex. demande documents reçue par le client → après <strong>N jours</strong> le système renvoie une relance, jusqu'à <strong>N fois</strong>, puis exécute l'action choisie.
                                            </div>
                                            <div class="row g-2 mt-1">
                                                <div class="col-md-3">
                                                    <label class="form-label-sm">1ʳᵉ relance après (jours)</label>
                                                    <input type="number" class="form-control form-control-sm relance-days-input" value="@retryDays" min="1" placeholder="15" @(relanceEnabled ? "" : "disabled") />
                                                    <input type="hidden" name="Steps[@i].RetryIntervalHours" class="relance-hours-input" value="@(step.RetryIntervalHours ?? retryDays * 24)" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label-sm">Nombre de relances</label>
                                                    <input type="number" name="Steps[@i].MaxRetries" value="@(relanceEnabled ? (step.MaxRetries > 0 ? step.MaxRetries : 3) : 0)" class="form-control form-control-sm relance-max-input" min="0" @(relanceEnabled ? "" : "disabled") />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label-sm">Action à chaque relance</label>
                                                    <select class="form-select form-select-sm relance-action-hint" disabled>
                                                        <option selected>Renvoyer la relance client</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label-sm">Après N relances</label>
                                                    <select name="Steps[@i].OnMaxRetriesAction" class="form-select form-select-sm relance-onmax-input" @(relanceEnabled ? "" : "disabled")>
                                                        @foreach (var om in onMaxRetries)
                                                        {
                                                            var omLabel = onMaxRetriesLabels.ContainsKey(om) ? onMaxRetriesLabels[om] : om;
                                                            var selected = string.IsNullOrEmpty(step.OnMaxRetriesAction)
                                                                ? om == "Suspend"
                                                                : step.OnMaxRetriesAction == om;
                                                            <option value="@om" selected="@selected">@omLabel</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        @if (!relanceEnabled)
                                        {
                                            <input type="hidden" name="Steps[@i].MaxRetries" value="0" class="relance-max-fallback" />
                                        }
                                    </div>
                                    <!-- S8: Routage -->
                                    <div class="field-section">
                                        <details @(step.RoutingMode != "Sequential" ? "open" : "")>
                                            <summary class="field-section-title" style="cursor:pointer;"><i class="bi bi-signpost-split-fill"></i>Routage Avancé<span class="toggle-hint ms-2">(cliquez pour ouvrir)</span></summary>
                                            <div class="row g-2 mt-1">
                                                <div class="col-md-4"><label class="form-label-sm">Mode de routage</label><select name="Steps[@i].RoutingMode" class="form-select form-select-sm">@foreach (var rm in routingModes) { <option value="@rm" selected="@(step.RoutingMode == rm)">@rm</option> }</select></div>
                                                <div class="col-md-4"><label class="form-label-sm">Déclencheur</label><select name="Steps[@i].TriggerSource" class="form-select form-select-sm init-trigger-source">@foreach (var ts in triggerSources) { <option value="@ts" selected="@(step.TriggerSource == ts)">@ts</option> }</select></div>
                                                <div class="col-md-4"><label class="form-label-sm">Aller à l'étape N°</label><input type="number" name="Steps[@i].GotoStepOrder" value="@step.GotoStepOrder" class="form-control form-control-sm" placeholder="N° étape" min="0" /></div>
                                            </div>
                                        </details>
                                    </div>
                                    <input type="hidden" name="Steps[@i].StepOrder" value="@i" class="step-order-input" />
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn-add-step mt-2" onclick="addStep()"><i class="bi bi-plus-circle"></i>Ajouter une étape</button>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                @if (isEditMode && (ViewBag.CanWorkflowDelete as bool? ?? false))
                {
                    <form asp-action="DeleteTemplate" asp-controller="Workflow" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce modèle ?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@editId" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4"><i class="bi bi-trash me-1"></i>Supprimer</button>
                    </form>
                }
                @if (isEditMode ? (ViewBag.CanWorkflowEdit as bool? ?? false) : (ViewBag.CanWorkflowCreate as bool? ?? false))
                {
                    <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>@(isEditMode ? "Mettre à jour" : "Créer le workflow")</button>
                }
            </div>
        </form>
    </div>
</div>

<template id="stepTemplate">
    <div class="step-card collapsed-step" data-index="__IDX__">
        <div class="step-header" onclick="toggleStep(this)">
            <div class="step-order-controls" onclick="event.stopPropagation()">
                <button type="button" class="step-drag-handle" title="Glisser pour réordonner" aria-label="Glisser"><i class="bi bi-grip-vertical"></i></button>
                <input type="number" class="step-num step-num-input" value="__NUM__" min="1" title="Changer le numéro d'ordre" aria-label="Ordre de l'étape" onchange="onStepNumberChange(this)" onclick="event.stopPropagation()" />
                <div class="step-move-btns">
                    <button type="button" class="btn-move-step btn-move-up" title="Monter" aria-label="Monter" onclick="event.stopPropagation();moveStep(this,-1)"><i class="bi bi-chevron-up"></i></button>
                    <button type="button" class="btn-move-step btn-move-down" title="Descendre" aria-label="Descendre" onclick="event.stopPropagation();moveStep(this,1)"><i class="bi bi-chevron-down"></i></button>
                </div>
            </div>
            <h6>Étape __NUM__</h6>
            <span class="step-type-badge">Initialisation</span>
            <span class="assign-badge"><i class="bi bi-person-fill me-1"></i>Employé</span>
            <span class="ms-auto d-flex align-items-center gap-2">
                <button type="button" class="btn-delete-step" onclick="event.stopPropagation();removeStep(this)" title="Supprimer"><i class="bi bi-trash3"></i></button>
                <i class="bi bi-chevron-down chevron-icon"></i>
            </span>
        </div>
        <div class="step-body">
            <!-- T-S1: Identification -->
            <div class="field-section">
                <div class="field-section-title"><i class="bi bi-tag-fill"></i>Identification</div>
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="form-label-sm">Nom de l'étape</label>
                        <input type="text" name="Steps[__IDX__].Name" class="form-control form-control-sm step-name-input" />
                    </div>
                    <div class="col-md-7">
                        <label class="form-label-sm">Type d'étape</label>
                        <select name="Steps[__IDX__].StepType" class="form-select form-select-sm step-type-select" onchange="onStepTypeOrAssignChange(this)">
                            <option value="Initialisation">Initialisation</option>
                            <option value="DemandePieces">Demande pièces</option>
                            <option value="Collecte">Collecte</option>
                            <option value="Saisie">Saisie</option>
                            <option value="Controle">Contrôle</option>
                            <option value="ValidationInterne">Valid. interne</option>
                            <option value="ValidationClient">Valid. client</option>
                            <option value="DepotSoumission">Dépôt</option>
                            <option value="Paiement">Paiement</option>
                            <option value="Rapprochement">Rapprochement</option>
                            <option value="ClotureArchivage">Clôture</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label-sm">Description</label>
                        <input type="text" name="Steps[__IDX__].Description" class="form-control form-control-sm" placeholder="Description de l'étape..." />
                    </div>
                </div>
            </div>
            <input type="hidden" name="Steps[__IDX__].DeadlineAnchor" value="CalendrierMaroc" class="deadline-anchor-hidden" />
            <input type="hidden" name="Steps[__IDX__].ApplyDeadlineToDeclaration" value="false" class="apply-ddl-hidden" />
            <div class="field-section echeance-section">
                <div class="field-section-title"><i class="bi bi-hourglass-split"></i>Délai de traitement</div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label-sm">Délai interne (heures)</label>
                        <input type="number" name="Steps[__IDX__].SLAHours" class="form-control form-control-sm" placeholder="24" min="0" />
                        <div class="form-text">Temps imparti au collaborateur pour cette étape.</div>
                    </div>
                </div>
            </div>
            <input type="hidden" name="Steps[__IDX__].LifecycleEndMode" value="None" class="lifecycle-mode-hidden" />
            <!-- T-S2: Assignation -->
            <div class="field-section">
                <div class="field-section-title"><i class="bi bi-person-fill-gear"></i>Assignation</div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label-sm">Type d'assignation</label>
                        <select name="Steps[__IDX__].AssignmentType" class="form-select form-select-sm assign-select" onchange="toggleAssignFields(this); onStepTypeOrAssignChange(this)">
                            <option value="Employee">Employé</option>
                            <option value="Role">Rôle</option>
                            <option value="Department">Département</option>
                            <option value="Client">Client</option>
                            <option value="AutoSystem">Automatique</option>
                        </select>
                    </div>
                    <div class="col-md-8 assign-employee-field">
                        <label class="form-label-sm">Employés</label>
                        <select name="Steps[__IDX__].AssignedToUserIds" class="form-select form-select-sm employee-multi" multiple data-placeholder="Rechercher par prénom ou nom...">
                            __EMPLOYEE_OPTIONS__
                        </select>
                    </div>
                    <div class="col-md-4 assign-role-field d-none">
                        <label class="form-label-sm">Rôle</label>
                        <select name="Steps[__IDX__].AssignedToRoleName" class="form-select form-select-sm">
                            <option value="">--</option>
                            <option value="Gerant">Gerant</option><option value="Manager">Manager</option><option value="Collaborateur">Collaborateur</option><option value="Assistant">Assistant</option><option value="Stagiaire">Stagiaire</option>
                        </select>
                    </div>
                    <div class="col-md-4 assign-dept-field d-none">
                        <label class="form-label-sm">Département</label>
                        <select name="Steps[__IDX__].AssignedToDepartmentId" class="form-select form-select-sm">
                            <option value="">--</option>
                            __DEPT_OPTIONS__
                        </select>
                    </div>
                </div>
            </div>
            <!-- T-S3: Statut Declaration -->
            <div class="field-section">
                <div class="field-section-title"><i class="bi bi-arrow-left-right"></i>Statut Déclaration</div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label-sm">É l'entrée</label>
                        <select name="Steps[__IDX__].DeclarationStatusOnEntry" class="form-select form-select-sm">
                            <option value="">Aucun changement</option>
                            <option value="Brouillon">Brouillon</option><option value="ACompleter">ACompleter</option><option value="EnCours">EnCours</option>
                            <option value="EnPreparation">EnPreparation</option><option value="Completee">Completee</option><option value="EnRevision">EnRevision</option>
                            <option value="Validee">Validee</option><option value="Soumise">Soumise</option><option value="Payee">Payee</option>
                            <option value="Refusee">Refusee</option><option value="Rejetee">Rejetee</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">É la complétion</label>
                        <select name="Steps[__IDX__].DeclarationStatusOnComplete" class="form-select form-select-sm">
                            <option value="">Aucun changement</option>
                            <option value="Brouillon">Brouillon</option><option value="ACompleter">ACompleter</option><option value="EnCours">EnCours</option>
                            <option value="EnPreparation">EnPreparation</option><option value="Completee">Completee</option><option value="EnRevision">EnRevision</option>
                            <option value="Validee">Validee</option><option value="Soumise">Soumise</option><option value="Payee">Payee</option>
                            <option value="Refusee">Refusee</option><option value="Rejetee">Rejetee</option>
                        </select>
                    </div>
                </div>
            </div>
            <!-- T-S4: Actions -->
            <div class="field-section">
                <div class="field-section-title"><i class="bi bi-lightning-fill"></i>Actions Automatiques</div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label-sm">Action à l'entrée</label>
                        <select name="Steps[__IDX__].ActionOnEntry" class="form-select form-select-sm">
                            <option value="None">None</option><option value="CreateDeclaration">CreateDeclaration</option><option value="CompleteDeclaration">CompleteDeclaration</option>
                            <option value="ValidateDeclaration">ValidateDeclaration</option><option value="SubmitDeclaration">SubmitDeclaration</option>
                            <option value="SuspendDeclaration">SuspendDeclaration</option><option value="ArchiveDeclaration">ArchiveDeclaration</option>
                            <option value="ClotureDeclaration">ClotureDeclaration</option>
                            <option value="RelanceClient">RelanceClient</option><option value="NotifyEmployee">NotifyEmployee</option><option value="NotifyClient">NotifyClient</option>
                            <option value="GeneratePDF">GeneratePDF</option><option value="ExportXML">ExportXML</option><option value="SendEmail">SendEmail</option>
                            <option value="CreateTask">CreateTask</option><option value="RequestDocuments">RequestDocuments</option><option value="ApproveByClient">ApproveByClient</option>
                            <option value="PaymentReminder">PaymentReminder</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Action à la complétion</label>
                        <select name="Steps[__IDX__].ActionOnComplete" class="form-select form-select-sm">
                            <option value="None">None</option><option value="CreateDeclaration">CreateDeclaration</option><option value="CompleteDeclaration">CompleteDeclaration</option>
                            <option value="ValidateDeclaration">ValidateDeclaration</option><option value="SubmitDeclaration">SubmitDeclaration</option>
                            <option value="SuspendDeclaration">SuspendDeclaration</option><option value="ArchiveDeclaration">ArchiveDeclaration</option>
                            <option value="ClotureDeclaration">ClotureDeclaration</option>
                            <option value="RelanceClient">RelanceClient</option><option value="NotifyEmployee">NotifyEmployee</option><option value="NotifyClient">NotifyClient</option>
                            <option value="GeneratePDF">GeneratePDF</option><option value="ExportXML">ExportXML</option><option value="SendEmail">SendEmail</option>
                            <option value="CreateTask">CreateTask</option><option value="RequestDocuments">RequestDocuments</option><option value="ApproveByClient">ApproveByClient</option>
                            <option value="PaymentReminder">PaymentReminder</option>
                        </select>
                    </div>
                </div>
            </div>
            <!-- T-S5: Comportement -->
            <div class="field-section">
                <div class="field-section-title"><i class="bi bi-toggles"></i>Comportement</div>
                <div class="chk-grid">
                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].IsRequired" value="true" class="form-check-input" /><span>Obligatoire</span></label>
                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].IsBlocking" value="true" class="form-check-input" /><span>Bloquante</span></label>
                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].AutoNotify" value="true" class="form-check-input" /><span>Auto-notif</span></label>
                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].AutoCreateTask" value="true" class="form-check-input" /><span>Créer tâche</span></label>
                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].IsClientStep" value="true" class="form-check-input" /><span>Étape client</span></label>
                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].IsScheduled" value="true" class="form-check-input sched-checkbox" onchange="toggleSchedule(this)" /><span>Planifiée</span></label>
                </div>
            </div>
            <!-- T-S6: Fréquence & échéance (one block) -->
            <div class="field-section schedule-section d-none">
                <div class="field-section-title"><i class="bi bi-calendar-event"></i><span class="schedule-section-title-text">Périodes &amp; échéances</span></div>
                <div class="init-schedule-panel mb-2 d-none">
                    <label class="form-label-sm mb-1">Mode de déclenchement</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="cron-freq-btn init-trigger-btn" data-mode="schedule" onclick="WfCron.setTriggerMode(this.closest('.step-card'),'schedule')"><i class="bi bi-clock-history"></i> Planifié</button>
                        <button type="button" class="cron-freq-btn init-trigger-btn" data-mode="manual" onclick="WfCron.setTriggerMode(this.closest('.step-card'),'manual')"><i class="bi bi-hand-index"></i> Manuel</button>
                        <button type="button" class="cron-freq-btn init-trigger-btn active" data-mode="both" onclick="WfCron.setTriggerMode(this.closest('.step-card'),'both')"><i class="bi bi-shuffle"></i> Planifié + Manuel</button>
                    </div>
                    <label class="chk-item mb-2"><input type="checkbox" class="form-check-input init-allow-manual" checked /><span>Autoriser Démarrer manuellement</span></label>
                    <input type="hidden" name="Steps[__IDX__].ActionConfigJson" class="action-config-input" value='{"initTrigger":"both","allowManualInit":true,"periodFrequency":"Mensuelle","windowStartDay":1,"windowEndDay":10,"windowMonthOffset":1}' />
                </div>
                <div class="cron-builder cron-freq-panel" data-cron="">
                    <div class="init-freq-echeance mb-2 d-none">
                        <div class="life-panel">
                            <span class="life-label">Modèle de périodes</span>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="monthly" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'monthly')"><i class="bi bi-calendar-month"></i> Mensuel (12)</button>
                                <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="quarterly" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'quarterly')"><i class="bi bi-calendar3"></i> Trimestriel (4)</button>
                                <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="annually" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'annually')"><i class="bi bi-calendar-heart"></i> Annuel (1)</button>
                                <button type="button" class="cron-freq-btn period-tpl-btn" data-tpl="periodic" onclick="WfCron.loadPeriodTemplate(this.closest('.step-card'),'periodic')"><i class="bi bi-calendar-range"></i> Périodique</button>
                            </div>
                            <div class="period-template-editor mb-2"></div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-6">
                                    <span class="life-label">Action à la fin</span>
                                    <select name="Steps[__IDX__].ActionOnLifecycleEnd" class="form-select form-select-sm" onchange="WfCron.syncPeriodTable(this.closest('.step-card'))">
                                        <option value="ClotureDeclaration" selected>Clôturer</option>
                                        <option value="ArchiveDeclaration">Archiver</option>
                                        <option value="SuspendDeclaration">Suspendre</option>
                                        <option value="CompleteDeclaration">Terminer</option>
                                        <option value="ValidateDeclaration">Valider</option>
                                        <option value="SubmitDeclaration">Soumettre</option>
                                        <option value="NotifyEmployee">Notifier collaborateur</option>
                                        <option value="NotifyClient">Notifier client</option>
                                        <option value="PaymentReminder">Rappel paiement</option>
                                    </select>
                                </div>
                            </div>
                            <input type="hidden" class="period-end-preview" />
                            <input type="hidden" class="window-start-day" value="1" />
                            <input type="hidden" class="window-end-day" value="1" />
                            <input type="hidden" class="window-month-offset" value="1" />
                            <input type="hidden" class="deadline-year-offset" value="0" />
                        </div>
                    </div>
                    <div class="d-none cron-freq-non-init-wrap">
                    <div class="mb-2 cron-freq-non-init">
                        <label class="form-label-sm mb-1">Fréquence</label>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="cron-freq-btn" data-freq="monthly" onclick="setCronFreq(this,'monthly')"><i class="bi bi-calendar-month"></i> Mensuel</button>
                            <button type="button" class="cron-freq-btn" data-freq="quarterly" onclick="setCronFreq(this,'quarterly')"><i class="bi bi-calendar3"></i> Trimestriel</button>
                            <button type="button" class="cron-freq-btn" data-freq="annually" onclick="setCronFreq(this,'annually')"><i class="bi bi-calendar-heart"></i> Annuel</button>
                            <button type="button" class="cron-freq-btn cron-freq-extra" data-freq="custom" onclick="setCronFreq(this,'custom')"><i class="bi bi-calendar-plus"></i> Personnalisé</button>
                            <button type="button" class="cron-freq-btn cron-freq-extra" data-freq="weekly" onclick="setCronFreq(this,'weekly')"><i class="bi bi-calendar-week"></i> Hebdo</button>
                            <button type="button" class="cron-freq-btn cron-freq-extra" data-freq="daily" onclick="setCronFreq(this,'daily')"><i class="bi bi-calendar-day"></i> Quotidien</button>
                        </div>
                    </div>
                    </div>
                    <div class="cron-options-weekly d-none mb-2">
                        <label class="form-label-sm mb-1">Jour de la semaine</label>
                        <div class="d-flex gap-1">
                            <button type="button" class="cron-day-btn" data-dow="1" onclick="toggleCronDay(this)">Lu</button>
                            <button type="button" class="cron-day-btn" data-dow="2" onclick="toggleCronDay(this)">Ma</button>
                            <button type="button" class="cron-day-btn" data-dow="3" onclick="toggleCronDay(this)">Me</button>
                            <button type="button" class="cron-day-btn" data-dow="4" onclick="toggleCronDay(this)">Je</button>
                            <button type="button" class="cron-day-btn" data-dow="5" onclick="toggleCronDay(this)">Ve</button>
                            <button type="button" class="cron-day-btn" data-dow="6" onclick="toggleCronDay(this)">Sa</button>
                            <button type="button" class="cron-day-btn" data-dow="0" onclick="toggleCronDay(this)">Di</button>
                        </div>
                    </div>
                    <div class="cron-options-monthly d-none mb-2 cron-options-monthly-extra">
                        <label class="form-label-sm mb-1">Jour du mois (cron)</label>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="cron-day-btn" data-dom="1" onclick="toggleCronDom(this)">1</button>
                            <button type="button" class="cron-day-btn" data-dom="5" onclick="toggleCronDom(this)">5</button>
                            <button type="button" class="cron-day-btn" data-dom="10" onclick="toggleCronDom(this)">10</button>
                            <button type="button" class="cron-day-btn" data-dom="15" onclick="toggleCronDom(this)">15</button>
                            <button type="button" class="cron-day-btn" data-dom="20" onclick="toggleCronDom(this)">20</button>
                            <button type="button" class="cron-day-btn" data-dom="25" onclick="toggleCronDom(this)">25</button>
                            <button type="button" class="cron-day-btn" data-dom="28" onclick="toggleCronDom(this)">28</button>
                        </div>
                    </div>
                    <div class="cron-options-quarterly d-none mb-2">
                        <label class="form-label-sm mb-1">Mois d'exécution</label>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <button type="button" class="cron-month-btn active" data-m="1" onclick="toggleCronMonth(this)">Jan</button>
                            <button type="button" class="cron-month-btn" data-m="2" onclick="toggleCronMonth(this)">Fév</button>
                            <button type="button" class="cron-month-btn" data-m="3" onclick="toggleCronMonth(this)">Mar</button>
                            <button type="button" class="cron-month-btn active" data-m="4" onclick="toggleCronMonth(this)">Avr</button>
                            <button type="button" class="cron-month-btn" data-m="5" onclick="toggleCronMonth(this)">Mai</button>
                            <button type="button" class="cron-month-btn" data-m="6" onclick="toggleCronMonth(this)">Jun</button>
                            <button type="button" class="cron-month-btn active" data-m="7" onclick="toggleCronMonth(this)">Jul</button>
                            <button type="button" class="cron-month-btn" data-m="8" onclick="toggleCronMonth(this)">Août</button>
                            <button type="button" class="cron-month-btn" data-m="9" onclick="toggleCronMonth(this)">Sep</button>
                            <button type="button" class="cron-month-btn active" data-m="10" onclick="toggleCronMonth(this)">Oct</button>
                            <button type="button" class="cron-month-btn" data-m="11" onclick="toggleCronMonth(this)">Nov</button>
                            <button type="button" class="cron-month-btn" data-m="12" onclick="toggleCronMonth(this)">Déc</button>
                        </div>
                        <label class="form-label-sm">Jour</label>
                        <select class="form-select form-select-sm cron-quarterly-day" style="max-width:120px;" onchange="buildCron(this.closest('.cron-builder'))">
                            <option value="1">1</option><option value="5">5</option><option value="10">10</option><option value="15">15</option>
                        </select>
                    </div>
                    <div class="cron-options-annually d-none mb-2">
                        <label class="form-label-sm mb-1">Mois et jour</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <select class="form-select form-select-sm cron-annual-month" onchange="buildCron(this.closest('.cron-builder'))">
                                    <option value="1">Janvier</option><option value="2">Février</option><option value="3">Mars</option>
                                    <option value="4">Avril</option><option value="5">Mai</option><option value="6">Juin</option>
                                    <option value="7">Juillet</option><option value="8">Août</option><option value="9">Septembre</option>
                                    <option value="10">Octobre</option><option value="11">Novembre</option><option value="12">Décembre</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <select class="form-select form-select-sm cron-annual-day" onchange="buildCron(this.closest('.cron-builder'))">
                                    <option value="1">1er</option><option value="5">5</option><option value="10">10</option>
                                    <option value="15">15</option><option value="20">20</option><option value="25">25</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="cron-options-custom d-none mb-2">
                        <label class="form-label-sm mb-1">Date personnalisée</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input type="date" class="form-control form-control-sm cron-custom-date" onchange="buildCron(this.closest('.cron-builder'))" />
                            </div>
                            <div class="col-md-6">
                                <select class="form-select form-select-sm cron-custom-repeat" onchange="buildCron(this.closest('.cron-builder'))">
                                    <option value="yearly">Répéter chaque année</option>
                                    <option value="monthly">Répéter chaque mois (jour)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col-md-4">
                            <label class="form-label-sm">Heure d'exécution</label>
                            <input type="time" class="form-control form-control-sm cron-time" value="08:00" onchange="buildCron(this.closest('.cron-builder'))" />
                        </div>
                    </div>
                    <div class="cron-preview d-none">
                        <span class="cron-preview-icon"><i class="bi bi-play-fill"></i></span>
                        <div>
                            <div class="cron-preview-label">Ouverture</div>
                            <div class="cron-preview-text"></div>
                            <div class="cron-preview-cron"></div>
                        </div>
                    </div>
                    <div class="cron-preview-end d-none">
                        <span class="cron-preview-icon"><i class="bi bi-flag-fill"></i></span>
                        <div>
                                                    <div class="cron-preview-label">Échéance</div>
                            <div class="cron-preview-text"></div>
                            <div class="cron-preview-cron"></div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="Steps[__IDX__].CronExpression" class="cron-input" value="" />
                <input type="hidden" name="Steps[__IDX__].CronDescription" class="cron-desc-input" value="" />
            </div>
            <!-- T-S7: Relance = config on any step -->
            <div class="field-section relance-config-section" data-relance-panel>
                <div class="field-section-title"><i class="bi bi-arrow-repeat"></i>Relances automatiques</div>
                <label class="chk-item mb-2">
                    <input type="checkbox" class="form-check-input relance-enable" onchange="toggleRelanceConfig(this)" />
                    <span>Activer les relances si cette étape n'est pas terminée</span>
                </label>
                <div class="relance-fields d-none">
                    <div class="alert alert-info py-2 px-3 small mb-2 mt-1 rounded-3">
                        Ex. demande documents reçue par le client → après <strong>N jours</strong> le système renvoie une relance, jusqu'à <strong>N fois</strong>, puis exécute l'action choisie.
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col-md-3">
                            <label class="form-label-sm">1ʳᵉ relance après (jours)</label>
                            <input type="number" class="form-control form-control-sm relance-days-input" value="15" min="1" placeholder="15" disabled />
                            <input type="hidden" name="Steps[__IDX__].RetryIntervalHours" class="relance-hours-input" value="360" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sm">Nombre de relances</label>
                            <input type="number" class="form-control form-control-sm relance-max-input" min="0" value="3" disabled />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sm">Action à chaque relance</label>
                            <select class="form-select form-select-sm" disabled><option selected>Renvoyer la relance client</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-sm">Après N relances</label>
                            <select name="Steps[__IDX__].OnMaxRetriesAction" class="form-select form-select-sm relance-onmax-input" disabled>
                                <option value="Suspend" selected>Suspendre la déclaration</option>
                                <option value="EscalateToManager">Escalader au manager</option>
                                <option value="NextStep">Passer à l'étape suivante</option>
                                <option value="SkipStep">Ignorer l'étape</option>
                                <option value="Cancel">Annuler le workflow</option>
                            </select>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="Steps[__IDX__].MaxRetries" value="0" class="relance-max-fallback" />
            </div>
            <!-- T-S8: Routage -->
            <div class="field-section">
                <details>
                    <summary class="field-section-title" style="cursor:pointer;"><i class="bi bi-signpost-split-fill"></i>Routage Avancé<span class="toggle-hint ms-2">(cliquez pour ouvrir)</span></summary>
                    <div class="row g-2 mt-1">
                        <div class="col-md-4"><label class="form-label-sm">Mode de routage</label><select name="Steps[__IDX__].RoutingMode" class="form-select form-select-sm"><option value="Sequential">Sequential</option><option value="ConditionalBranch">ConditionalBranch</option><option value="SkipToStep">SkipToStep</option><option value="EndWorkflow">EndWorkflow</option></select></div>
                        <div class="col-md-4"><label class="form-label-sm">Déclencheur</label><select name="Steps[__IDX__].TriggerSource" class="form-select form-select-sm init-trigger-source"><option value="Manual">Manual</option><option value="System">System</option><option value="Employee">Employee</option><option value="Client">Client</option><option value="Extranet">Extranet</option><option value="API">API</option><option value="Schedule">Schedule</option></select></div>
                        <div class="col-md-4"><label class="form-label-sm">Aller à l'étape N°</label><input type="number" name="Steps[__IDX__].GotoStepOrder" class="form-control form-control-sm" placeholder="N° étape" min="0" /></div>
                    </div>
                </details>
            </div>
            <input type="hidden" name="Steps[__IDX__].StepOrder" value="__IDX__" class="step-order-input" />
        </div>
    </div>
</template>

@section Scripts {
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
<script src="~/js/workflow-cron.js" asp-append-version="true"></script>
<script src="~/js/workflow-step-reorder.js" asp-append-version="true"></script>
<style>
    .employee-multi + .select2-container { width: 100% !important; }
    .select2-container--bootstrap-5 .select2-selection--multiple { min-height: 38px; }
</style>
<script>
    const employeeOptionsHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        string.Concat(employees.Select(e =>
        {
            var label = System.Net.WebUtility.HtmlEncode(e.NomComplet) + (string.IsNullOrEmpty(e.Role) ? "" : $" — {System.Net.WebUtility.HtmlEncode(e.Role)}");
            return $"<option value=\"{e.Id}\" data-first=\"{System.Net.WebUtility.HtmlEncode(e.FirstName)}\" data-last=\"{System.Net.WebUtility.HtmlEncode(e.LastName)}\" data-role=\"{System.Net.WebUtility.HtmlEncode(e.Role ?? "")}\">{label}</option>";
        }))));
    const deptOptionsHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        string.Concat(departments.Select(d => $"<option value=\"{d.Id}\">{System.Net.WebUtility.HtmlEncode(d.Name)}</option>"))));

    function normalizeSearch(s) {
        return (s || '').toString().toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function destroyEmployeeSelect2(root) {
        $(root || document).find('select.employee-multi').each(function () {
            if ($(this).hasClass('select2-hidden-accessible')) {
                $(this).select2('destroy');
            }
        });
    }

    function initEmployeeSelect2(root) {
        $(root || document).find('select.employee-multi').each(function () {
            const $el = $(this);
            if ($el.hasClass('select2-hidden-accessible')) return;
            $el.select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: $el.data('placeholder') || 'Rechercher par prénom ou nom...',
                allowClear: true,
                closeOnSelect: false,
                language: {
                    noResults: function () { return 'Aucun employé trouvé'; },
                    searching: function () { return 'Recherche…'; },
                    removeAllItems: function () { return 'Tout retirer'; }
                },
                matcher: function (params, data) {
                    if ($.trim(params.term) === '') return data;
                    if (typeof data.text === 'undefined') return null;
                    const term = normalizeSearch(params.term);
                    const $opt = $(data.element);
                    const hay = normalizeSearch([
                        data.text,
                        $opt.attr('data-first'),
                        $opt.attr('data-last'),
                        $opt.attr('data-role')
                    ].join(' '));
                    return hay.indexOf(term) > -1 ? data : null;
                }
            });
        });
    }

    // === Toggle step expand/collapse ===
    function toggleStep(header) {
        header.closest('.step-card').classList.toggle('collapsed-step');
    }

    // === Add new step from template ===
    function addStep() {
        const container = document.getElementById('stepsContainer');
        const idx = container.querySelectorAll('.step-card').length;
        const tpl = document.getElementById('stepTemplate').content.cloneNode(true);
        const card = tpl.querySelector('.step-card');
        let html = card.outerHTML.replace(/__IDX__/g, idx).replace(/__NUM__/g, idx + 1);
        html = html.replace(/__EMPLOYEE_OPTIONS__/g, employeeOptionsHtml).replace(/__DEPT_OPTIONS__/g, deptOptionsHtml);
        container.insertAdjacentHTML('beforeend', html);
        const newCard = container.lastElementChild;
        newCard.classList.remove('collapsed-step');
        syncStepTypePanels(newCard);
        initEmployeeSelect2(newCard);
        reindexSteps();
        newCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // === Remove step ===
    function removeStep(btn) {
        if (!confirm('Supprimer cette étape ?')) return;
        const card = btn.closest('.step-card');
        destroyEmployeeSelect2(card);
        card.remove();
        reindexSteps();
        updateStepCount();
    }

    function getReorderOpts() {
        return {
            beforeReindex: function (container) { destroyEmployeeSelect2(container); },
            afterReindex: function (container) { initEmployeeSelect2(container); },
            onCountChange: function (n) {
                const badge = document.getElementById('stepCountBadge');
                if (badge) badge.textContent = n + ' étape' + (n !== 1 ? 's' : '');
            }
        };
    }

    // === Reindex all steps (names, StepOrder, numbers, GotoStepOrder) ===
    function reindexSteps() {
        const container = document.getElementById('stepsContainer');
        if (window.WfStepReorder) WfStepReorder.reindex(container, getReorderOpts());
    }

    function moveStep(btn, delta) {
        const container = document.getElementById('stepsContainer');
        if (window.WfStepReorder) WfStepReorder.moveByDelta(btn, delta, getReorderOpts());
    }

    function onStepNumberChange(input) {
        if (window.WfStepReorder) WfStepReorder.onNumberChange(input, getReorderOpts());
    }

    // === Update step count badge ===
    function updateStepCount() {
        const count = document.querySelectorAll('#stepsContainer .step-card').length;
        document.getElementById('stepCountBadge').textContent = count + ' étape' + (count !== 1 ? 's' : '');
        if (window.WfStepReorder) WfStepReorder.updateMoveButtons(document.getElementById('stepsContainer'));
    }

    // === Toggle assignment fields + auto-show schedule for AutoSystem ===
    function toggleAssignFields(sel) {
        const card = sel.closest('.step-card');
        const val = sel.value;
        card.querySelector('.assign-employee-field').classList.toggle('d-none', val !== 'Employee');
        card.querySelector('.assign-role-field').classList.toggle('d-none', val !== 'Role');
        card.querySelector('.assign-dept-field').classList.toggle('d-none', val !== 'Department');

        // Auto-show schedule section for AutoSystem
        const schedSection = card.querySelector('.schedule-section');
        const schedCheckbox = card.querySelector('.sched-checkbox');
        if (val === 'AutoSystem') {
            if (schedSection) schedSection.classList.remove('d-none');
            if (schedCheckbox) schedCheckbox.checked = true;
        }

        if (val === 'Employee') {
            initEmployeeSelect2(card);
        }
    }

    function syncRelanceDaysToHours(card) {
        if (!card) return;
        const days = card.querySelector('.relance-days-input');
        const hours = card.querySelector('.relance-hours-input');
        if (!days || !hours || days.disabled) return;
        const d = Math.max(1, parseInt(days.value || '15', 10) || 15);
        days.value = d;
        hours.value = d * 24;
    }

    function toggleRelanceConfig(chk) {
        const card = chk.closest('.step-card');
        if (!card) return;
        const on = !!chk.checked;
        const fields = card.querySelector('.relance-fields');
        const maxIn = card.querySelector('.relance-max-input');
        const days = card.querySelector('.relance-days-input');
        const onMax = card.querySelector('.relance-onmax-input');
        const fallback = card.querySelector('.relance-max-fallback');
        if (fields) fields.classList.toggle('d-none', !on);
        [maxIn, days, onMax].forEach(el => { if (el) el.disabled = !on; });
        if (on) {
            if (fallback) fallback.remove();
            if (maxIn) {
                if (!maxIn.name) {
                    const idx = card.dataset.index || '0';
                    maxIn.name = 'Steps[' + idx + '].MaxRetries';
                }
                if (!maxIn.value || maxIn.value === '0') maxIn.value = '3';
            }
            if (days && (!days.value || days.value === '0')) days.value = '15';
            syncRelanceDaysToHours(card);
        } else {
            if (maxIn) {
                maxIn.value = '0';
                maxIn.removeAttribute('name');
            }
            const panel = card.querySelector('[data-relance-panel]');
            const idx = card.dataset.index || '0';
            let fb = card.querySelector('.relance-max-fallback');
            if (!fb && panel) {
                fb = document.createElement('input');
                fb.type = 'hidden';
                fb.className = 'relance-max-fallback';
                panel.appendChild(fb);
            }
            if (fb) {
                fb.name = 'Steps[' + idx + '].MaxRetries';
                fb.value = '0';
            }
            const hours = card.querySelector('.relance-hours-input');
            if (hours) hours.value = '0';
        }
    }

    function syncRelancePanel(card) {
        if (!card) return;
        const typeSel = card.querySelector('.step-type-select');
        const type = typeSel ? typeSel.value : '';
        const panel = card.querySelector('[data-relance-panel]');
        const hide = type === 'Initialisation' || type === 'ClotureArchivage';
        if (panel) panel.classList.toggle('d-none', hide);
        if (!hide) {
            const enable = card.querySelector('.relance-enable');
            if (enable) toggleRelanceConfig(enable);
        }
    }

    function syncStepTypePanels(card) {
        if (!card) return;
        const typeSel = card.querySelector('.step-type-select');
        const type = typeSel ? typeSel.value : '';
        const isInit = type === 'Initialisation';
        const isCloture = type === 'ClotureArchivage';
        const echeance = card.querySelector('.echeance-section');
        const initBlock = card.querySelector('.init-freq-echeance');
        const schedule = card.querySelector('.schedule-section');
        const titleEl = card.querySelector('.schedule-section-title-text');
        const anchorHidden = card.querySelector('.deadline-anchor-hidden');
        const applyHidden = card.querySelector('input[name$=".ApplyDeadlineToDeclaration"]');
        const lifeModeHidden = card.querySelector('.lifecycle-mode-hidden');
        if (anchorHidden) anchorHidden.value = isCloture ? 'None' : 'CalendrierMaroc';
        if (applyHidden && applyHidden.type === 'hidden') applyHidden.value = isInit ? 'true' : 'false';
        if (lifeModeHidden) lifeModeHidden.value = isInit ? 'PeriodEnd' : 'None';
        if (echeance) {
            const hide = isCloture || isInit;
            echeance.classList.toggle('d-none', hide);
            echeance.querySelectorAll('input,select,textarea').forEach(el => { el.disabled = hide; });
        }
        if (initBlock) {
            initBlock.classList.toggle('d-none', !isInit);
            initBlock.querySelectorAll('input,select,textarea').forEach(el => { el.disabled = !isInit; });
        }
        card.querySelectorAll('.cron-freq-extra').forEach(btn => btn.classList.toggle('d-none', isInit));
        card.querySelectorAll('.cron-options-monthly-extra').forEach(el => {
            if (isInit) el.classList.add('d-none');
        });
        if (titleEl) titleEl.textContent = isInit ? 'Périodes & échéances' : 'Planification';
        if (schedule && isInit) schedule.classList.remove('d-none');
        if (isInit && window.WfCron) WfCron.initPeriodEditor(card);
    }

    function onStepTypeOrAssignChange(el) {
        const card = el.closest('.step-card');
        if (card && window.WfCron) WfCron.syncInitScheduleVisibility(card);
        syncRelancePanel(card);
        syncStepTypePanels(card);
    }

    // === Toggle schedule section visibility ===
    function toggleSchedule(chk) {
        const section = chk.closest('.step-card').querySelector('.schedule-section');
        if (section) section.classList.toggle('d-none', !chk.checked);
    }

    // Cron helpers are provided by ~/js/workflow-cron.js (global setCronFreq, buildCron, …)

    // === INIT on page load ===
    document.addEventListener('DOMContentLoaded', function() {
        // Collapse all existing steps except first
        document.querySelectorAll('#stepsContainer .step-card').forEach((card, i) => {
            if (i > 0) card.classList.add('collapsed-step');
        });

        const stepsContainer = document.getElementById('stepsContainer');
        if (window.WfStepReorder && stepsContainer) {
            WfStepReorder.bindContainer(stepsContainer, getReorderOpts());
        }

        // Init existing assign fields
        document.querySelectorAll('.assign-select').forEach(sel => {
            toggleAssignFields(sel);
        });
        initEmployeeSelect2(document.getElementById('stepsContainer'));

        // Parse existing cron expressions + Init AutoSystem panels
        document.querySelectorAll('.cron-builder').forEach(builder => {
            if (window.WfCron) {
                WfCron.parseCronToUI(builder);
            }
        });
        document.querySelectorAll('#stepsContainer .step-card').forEach(card => {
            if (window.WfCron) WfCron.syncInitScheduleVisibility(card);
            syncRelancePanel(card);
            syncStepTypePanels(card);
            if (window.WfCron) WfCron.initPeriodEditor(card);
            const days = card.querySelector('.relance-days-input');
            if (days) days.addEventListener('change', () => syncRelanceDaysToHours(card));
            if (days) days.addEventListener('input', () => syncRelanceDaysToHours(card));
        });

        const builderForm = document.getElementById('builderForm');
        if (builderForm) {
            builderForm.addEventListener('submit', function (e) {
                document.querySelectorAll('#stepsContainer .step-card').forEach(card => {
                    syncRelanceDaysToHours(card);
                    const enable = card.querySelector('.relance-enable');
                    if (enable) toggleRelanceConfig(enable);
                    if (window.WfCron) WfCron.syncPeriodTable(card);
                });
                if (!window.WfCron) return;
                const err = WfCron.validateInitSteps(document.getElementById('stepsContainer'));
                if (err) {
                    e.preventDefault();
                    alert(err);
                }
            });
        }
    });
</script>
}
