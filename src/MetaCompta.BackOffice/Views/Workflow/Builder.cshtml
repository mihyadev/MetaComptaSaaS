                    </div>
                    <div class="cron-options-monthly d-none mb-2">
                        <label class="form-label-sm mb-1">Jour du mois</label>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="cron-day-btn" data-dom="1" onclick="toggleCronDom(this)">1</button>
                            <button type="button" class="cron-day-btn" data-dom="5" onclick="toggleCronDom(this)">5</button>
                            <button type="button" class="cron-day-btn" data-dom="10" onclick="toggleCronDom(this)">10</button>
                            <button type="button" class="cron-day-btn" data-dom="15" onclick="toggleCronDom(this)">15</button>
                            <button type="button" class="cron-day-btn" data-dom="20" onclick="toggleCronDom(this)">20</button>
                            <button type="button" class="cron-day-btn" data-dom="25" onclick="toggleCronDom(this)">25</button>
                            <button type="button" class="cron-day-btn" data-dom="28" onclick="toggleCronDom(this)">28</button>
                        </div>
                    </div>
                    <div class="cron-options-quarterly d-none mb-2">
                        <label class="form-label-sm mb-1">Mois d'exécution</label>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="cron-month-btn active" data-m="1" onclick="toggleCronMonth(this)">Jan</button>
                            <button type="button" class="cron-month-btn" data-m="2" onclick="toggleCronMonth(this)">Fév</button>
                            <button type="button" class="cron-month-btn" data-m="3" onclick="toggleCronMonth(this)">Mar</button>
                            <button type="button" class="cron-month-btn active" data-m="4" onclick="toggleCronMonth(this)">Avr</button>
                            <button type="button" class="cron-month-btn" data-m="5" onclick="toggleCronMonth(this)">Mai</button>
                            <button type="button" class="cron-month-btn" data-m="6" onclick="toggleCronMonth(this)">Jun</button>
                            <button type="button" class="cron-month-btn active" data-m="7" onclick="toggleCronMonth(this)">Jul</button>
                            <button type="button" class="cron-month-btn" data-m="8" onclick="toggleCronMonth(this)">Août</button>
                            <button type="button" class="cron-month-btn" data-m="9" onclick="toggleCronMonth(this)">Sep</button>
                            <button type="button" class="cron-month-btn active" data-m="10" onclick="toggleCronMonth(this)">Oct</button>
                            <button type="button" class="cron-month-btn" data-m="11" onclick="toggleCronMonth(this)">Nov</button>
                            <button type="button" class="cron-month-btn" data-m="12" onclick="toggleCronMonth(this)">Déc</button>
                        </div>
                    </div>
                    <div class="cron-options-annually d-none mb-2">
                        <label class="form-label-sm mb-1">Mois et jour</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <select class="form-select form-select-sm cron-annual-month" onchange="buildCron(this.closest('.cron-builder'))">
                                    <option value="1">Janvier</option><option value="2">Février</option><option value="3">Mars</option>
                                    <option value="4">Avril</option><option value="5">Mai</option><option value="6">Juin</option>
                                    <option value="7">Juillet</option><option value="8">Août</option><option value="9">Septembre</option>
                                    <option value="10">Octobre</option><option value="11">Novembre</option><option value="12">Décembre</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <select class="form-select form-select-sm cron-annual-day" onchange="buildCron(this.closest('.cron-builder'))">
                                    <option value="1">1er</option><option value="5">5</option><option value="10">10</option>
                                    <option value="15">15</option><option value="20">20</option><option value="25">25</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col-md-4">
                            <label class="form-label-sm">Heure d'exécution</label>
                            <input type="time" class="form-control form-control-sm cron-time" value="08:00" onchange="buildCron(this.closest('.cron-builder'))" />
                        </div>
                    </div>
                    <div class="cron-preview d-none">
                        <span class="cron-preview-icon"><i class="bi bi-check-lg"></i></span>
                        <div>
                            <div class="cron-preview-text"></div>
                            <div class="cron-preview-cron"></div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="Steps[__IDX__].CronExpression" class="cron-input" value="" />
                <input type="hidden" name="Steps[__IDX__].CronDescription" class="cron-desc-input" value="" />
            </div>
            <!-- T-S7: Relance -->
            <div class="field-section">
                <details>
                    <summary class="field-section-title" style="cursor:pointer;"><i class="bi bi-arrow-repeat"></i>Relance / Retry<span class="toggle-hint ms-2">(cliquez pour ouvrir)</span></summary>
                    <div class="row g-2 mt-1">
                        <div class="col-md-3"><label class="form-label-sm">Max relances</label><input type="number" name="Steps[__IDX__].MaxRetries" class="form-control form-control-sm" min="0" value="0" /></div>
                        <div class="col-md-3"><label class="form-label-sm">Intervalle (h)</label><input type="number" name="Steps[__IDX__].RetryIntervalHours" class="form-control form-control-sm" placeholder="24" min="0" /></div>
                        <div class="col-md-3"><label class="form-label-sm">Après max relances</label><select name="Steps[__IDX__].OnMaxRetriesAction" class="form-select form-select-sm"><option value="NextStep">NextStep</option><option value="Suspend">Suspend</option><option value="Cancel">Cancel</option><option value="SkipStep">SkipStep</option><option value="EscalateToManager">EscalateToManager</option></select></div>
                        <div class="col-md-3"><label class="form-label-sm">Priorité tâche</label><select name="Steps[__IDX__].TaskPriority" class="form-select form-select-sm"><option value="Faible">Faible</option><option value="Moyenne" selected>Moyenne</option><option value="Haute">Haute</option><option value="Urgente">Urgente</option></select></div>
                    </div>
                </details>
            </div>
            <!-- T-S8: Routage -->
            <div class="field-section">
                <details>
                    <summary class="field-section-title" style="cursor:pointer;"><i class="bi bi-signpost-split-fill"></i>Routage Avancé<span class="toggle-hint ms-2">(cliquez pour ouvrir)</span></summary>
                    <div class="row g-2 mt-1">
                        <div class="col-md-4"><label class="form-label-sm">Mode de routage</label><select name="Steps[__IDX__].RoutingMode" class="form-select form-select-sm"><option value="Sequential">Sequential</option><option value="ConditionalBranch">ConditionalBranch</option><option value="SkipToStep">SkipToStep</option><option value="EndWorkflow">EndWorkflow</option></select></div>
                        <div class="col-md-4"><label class="form-label-sm">Déclencheur</label><select name="Steps[__IDX__].TriggerSource" class="form-select form-select-sm"><option value="Manual">Manual</option><option value="System">System</option><option value="Employee">Employee</option><option value="Client">Client</option><option value="Extranet">Extranet</option><option value="API">API</option><option value="Schedule">Schedule</option></select></div>
                        <div class="col-md-4"><label class="form-label-sm">Aller à l'étape N°</label><input type="number" name="Steps[__IDX__].GotoStepOrder" class="form-control form-control-sm" placeholder="N° étape" min="0" /></div>
                    </div>
                </details>
            </div>
            <input type="hidden" name="Steps[__IDX__].StepOrder" value="__IDX__" class="step-order-input" />
        </div>
    </div>
</template>

@section Scripts {
<script>
    // === Toggle step expand/collapse ===
    function toggleStep(header) {
        header.closest('.step-card').classList.toggle('collapsed-step');
    }

    // === Add new step from template ===
    function addStep() {
        const container = document.getElementById('stepsContainer');
        const idx = container.querySelectorAll('.step-card').length;
        const tpl = document.getElementById('stepTemplate').content.cloneNode(true);
        const card = tpl.querySelector('.step-card');
        const html = card.outerHTML.replace(/__IDX__/g, idx).replace(/__NUM__/g, idx + 1);
        container.insertAdjacentHTML('beforeend', html);
        const newCard = container.lastElementChild;
        newCard.classList.remove('collapsed-step');
        updateStepCount();
    }

    // === Remove step ===
    function removeStep(btn) {
        if (!confirm('Supprimer cette étape ?')) return;
        btn.closest('.step-card').remove();
        reindexSteps();
        updateStepCount();
    }

    // === Reindex all steps ===
    function reindexSteps() {
        document.querySelectorAll('#stepsContainer .step-card').forEach((card, i) => {
            card.dataset.index = i;
            card.querySelector('.step-num').textContent = i + 1;
            card.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/Steps\[\d+\]/, 'Steps[' + i + ']');
            });
            const orderInput = card.querySelector('.step-order-input');
            if (orderInput) orderInput.value = i;
        });
    }

    // === Update step count badge ===
    function updateStepCount() {
        const count = document.querySelectorAll('#stepsContainer .step-card').length;
        document.getElementById('stepCountBadge').textContent = count + ' étapes';
    }

    // === Toggle assignment fields + auto-show schedule for AutoSystem ===
    function toggleAssignFields(sel) {
        const card = sel.closest('.step-card');
        const val = sel.value;
        card.querySelector('.assign-employee-field').classList.toggle('d-none', val !== 'Employee');
        card.querySelector('.assign-role-field').classList.toggle('d-none', val !== 'Role');
        card.querySelector('.assign-dept-field').classList.toggle('d-none', val !== 'Department');

        // Auto-show schedule section for AutoSystem
        const schedSection = card.querySelector('.schedule-section');
        const schedCheckbox = card.querySelector('.sched-checkbox');
        if (val === 'AutoSystem') {
            if (schedSection) schedSection.classList.remove('d-none');
            if (schedCheckbox) schedCheckbox.checked = true;
        }
    }

    // === Toggle schedule section visibility ===
    function toggleSchedule(chk) {
        const section = chk.closest('.step-card').querySelector('.schedule-section');
        if (section) section.classList.toggle('d-none', !chk.checked);
    }

    // === CRON BUILDER FUNCTIONS ===

    const dayNames = ['Di', 'Lu', 'Ma', 'Me', 'Je', 'Ve', 'Sa'];
    const monthNames = ['', 'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];

    function setCronFreq(btn, freq) {
        const builder = btn.closest('.cron-builder');
        // Toggle active state on frequency buttons
        builder.querySelectorAll('.cron-freq-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        builder.dataset.freq = freq;

        // Show/hide option panels
        builder.querySelector('.cron-options-weekly').classList.toggle('d-none', freq !== 'weekly');
        builder.querySelector('.cron-options-monthly').classList.toggle('d-none', freq !== 'monthly');
        builder.querySelector('.cron-options-quarterly').classList.toggle('d-none', freq !== 'quarterly');
        builder.querySelector('.cron-options-annually').classList.toggle('d-none', freq !== 'annually');

        buildCron(builder);
    }

    function toggleCronDay(btn) {
        btn.classList.toggle('active');
        buildCron(btn.closest('.cron-builder'));
    }

    function toggleCronDom(btn) {
        btn.classList.toggle('active');
        buildCron(btn.closest('.cron-builder'));
    }

    function toggleCronMonth(btn) {
        btn.classList.toggle('active');
        buildCron(btn.closest('.cron-builder'));
    }

    function buildCron(builder) {
        const freq = builder.dataset.freq;
        if (!freq) { hideCronPreview(builder); return; }

        const timeInput = builder.querySelector('.cron-time');
        const [h, m] = (timeInput.value || '08:00').split(':').map(Number);
        let cron = '', desc = '';

        if (freq === 'daily') {
            cron = m + ' ' + h + ' * * *';
            desc = 'Tous les jours à ' + pad(h) + ':' + pad(m);
        }
        else if (freq === 'weekly') {
            const days = [...builder.querySelectorAll('.cron-options-weekly .cron-day-btn.active')].map(b => b.dataset.dow);
            if (days.length === 0) { hideCronPreview(builder); return; }
            cron = m + ' ' + h + ' * * ' + days.join(',');
            const dayLabels = days.map(d => dayNames[parseInt(d)]).join(', ');
            desc = 'Chaque ' + dayLabels + ' à ' + pad(h) + ':' + pad(m);
        }
        else if (freq === 'monthly') {
            const doms = [...builder.querySelectorAll('.cron-options-monthly .cron-day-btn.active')].map(b => b.dataset.dom);
            if (doms.length === 0) { hideCronPreview(builder); return; }
            cron = m + ' ' + h + ' ' + doms.join(',') + ' * *';
            desc = 'Le ' + doms.join(', ') + ' de chaque mois à ' + pad(h) + ':' + pad(m);
        }
        else if (freq === 'quarterly') {
            const months = [...builder.querySelectorAll('.cron-options-quarterly .cron-month-btn.active')].map(b => b.dataset.m);
            if (months.length === 0) { hideCronPreview(builder); return; }
            cron = m + ' ' + h + ' 1 ' + months.join(',') + ' *';
            const mLabels = months.map(mm => monthNames[parseInt(mm)]).join(', ');
            desc = 'Le 1er de ' + mLabels + ' à ' + pad(h) + ':' + pad(m);
        }
        else if (freq === 'annually') {
            const monthSel = builder.querySelector('.cron-annual-month');
            const daySel = builder.querySelector('.cron-annual-day');
            const mm = monthSel ? monthSel.value : '1';
            const dd = daySel ? daySel.value : '1';
            cron = m + ' ' + h + ' ' + dd + ' ' + mm + ' *';
            desc = 'Le ' + dd + ' ' + monthNames[parseInt(mm)] + ' à ' + pad(h) + ':' + pad(m);
        }

        // Update hidden inputs
        const section = builder.closest('.schedule-section');
        if (section) {
            const cronInput = section.querySelector('.cron-input');
            const descInput = section.querySelector('.cron-desc-input');
            if (cronInput) cronInput.value = cron;
            if (descInput) descInput.value = desc;
        }

        // Show preview
        const preview = builder.querySelector('.cron-preview');
        if (preview) {
            preview.classList.remove('d-none');
            preview.querySelector('.cron-preview-text').textContent = desc;
            preview.querySelector('.cron-preview-cron').textContent = cron;
        }
    }

    function hideCronPreview(builder) {
        const preview = builder.querySelector('.cron-preview');
        if (preview) preview.classList.add('d-none');
    }

    function pad(n) { return String(n).padStart(2, '0'); }

    // === Parse existing cron expression back to UI ===
    function parseCronToUI(builder) {
        const cronStr = builder.dataset.cron;
        if (!cronStr || !cronStr.trim()) return;

        const parts = cronStr.trim().split(/\s+/);
        if (parts.length < 5) return;

        const [mm, hh, dom, mon, dow] = parts;
        const timeInput = builder.querySelector('.cron-time');
        if (timeInput) timeInput.value = pad(parseInt(hh)) + ':' + pad(parseInt(mm));

        // Determine frequency from pattern
        if (dow !== '*') {
            // Weekly
            const freqBtn = builder.querySelector('.cron-freq-btn[data-freq="weekly"]');
            if (freqBtn) setCronFreq(freqBtn, 'weekly');
            dow.split(',').forEach(d => {
                const btn = builder.querySelector('.cron-day-btn[data-dow="' + d + '"]');
                if (btn) btn.classList.add('active');
            });
        } else if (mon !== '*') {
            const months = mon.split(',');
            if (months.length <= 4) {
                // Quarterly
                const freqBtn = builder.querySelector('.cron-freq-btn[data-freq="quarterly"]');
                if (freqBtn) setCronFreq(freqBtn, 'quarterly');
                builder.querySelectorAll('.cron-options-quarterly .cron-month-btn').forEach(b => b.classList.remove('active'));
                months.forEach(m => {
                    const btn = builder.querySelector('.cron-month-btn[data-m="' + m + '"]');
                    if (btn) btn.classList.add('active');
                });
            } else {
                // Annually
                const freqBtn = builder.querySelector('.cron-freq-btn[data-freq="annually"]');
                if (freqBtn) setCronFreq(freqBtn, 'annually');
                const mSel = builder.querySelector('.cron-annual-month');
                const dSel = builder.querySelector('.cron-annual-day');
                if (mSel) mSel.value = months[0];
                if (dSel) dSel.value = dom;
            }
        } else if (dom !== '*') {
            // Monthly
            const freqBtn = builder.querySelector('.cron-freq-btn[data-freq="monthly"]');
            if (freqBtn) setCronFreq(freqBtn, 'monthly');
            dom.split(',').forEach(d => {
                const btn = builder.querySelector('.cron-day-btn[data-dom="' + d + '"]');
                if (btn) btn.classList.add('active');
            });
        } else {
            // Daily
            const freqBtn = builder.querySelector('.cron-freq-btn[data-freq="daily"]');
            if (freqBtn) setCronFreq(freqBtn, 'daily');
        }

        buildCron(builder);
    }

    // === INIT on page load ===
    document.addEventListener('DOMContentLoaded', function() {
        // Collapse all existing steps except first
        document.querySelectorAll('#stepsContainer .step-card').forEach((card, i) => {
            if (i > 0) card.classList.add('collapsed-step');
        });

        // Init existing assign fields
        document.querySelectorAll('.assign-select').forEach(sel => {
            toggleAssignFields(sel);
        });

        // Parse existing cron expressions
        document.querySelectorAll('.cron-builder').forEach(builder => {
            parseCronToUI(builder);
        });
    });
</script>
}
