                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].IsClientStep" value="true" class="form-check-input" /><span>Étape client</span></label>
                    <label class="chk-item"><input type="checkbox" name="Steps[__IDX__].IsScheduled" value="true" class="form-check-input sched-checkbox" onchange="toggleSchedule(this)" /><span>Planifiée</span></label>
                </div>
            </div>
            <!-- T-S6: Planification / Visual Cron Builder -->
            <div class="field-section schedule-section d-none">
