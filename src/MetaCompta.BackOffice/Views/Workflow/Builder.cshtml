                            <option value="CreateTask">CreateTask</option><option value="RequestDocuments">RequestDocuments</option><option value="ApproveByClient">ApproveByClient</option>
                            <option value="PaymentReminder">PaymentReminder</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Action à la complétion</label>
                        <select name="Steps[__IDX__].ActionOnComplete" class="form-select form-select-sm">
