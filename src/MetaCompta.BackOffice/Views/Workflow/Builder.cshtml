                            <option value="EnPreparation">EnPreparation</option><option value="Completee">Completee</option><option value="EnRevision">EnRevision</option>
                            <option value="Validee">Validee</option><option value="Soumise">Soumise</option><option value="Payee">Payee</option>
                            <option value="Refusee">Refusee</option><option value="Rejetee">Rejetee</option>
