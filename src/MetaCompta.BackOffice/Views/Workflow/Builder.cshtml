                        <label class="form-label-sm">Type d'assignation</label>
                        <select name="Steps[__IDX__].AssignmentType" class="form-select form-select-sm assign-select" onchange="toggleAssignFields(this)">
                            <option value="Employee">Employé</option>
                            <option value="Role">Rôle</option>
                            <option value="Department">Département</option>
                            <option value="Client">Client</option>
                            <option value="AutoSystem">Automatique</option>
                        </select>
                    </div>
                    <div class="col-md-4 assign-employee-field">
                        <label class="form-label-sm">Employé</label>
                        <select name="Steps[__IDX__].AssignedToUserId" class="form-select form-select-sm"><option value="">Automatique</option></select>
                    </div>
                    <div class="col-md-4 assign-role-field d-none">
                        <label class="form-label-sm">Rôle</label>
                        <select name="Steps[__IDX__].AssignedToRoleName" class="form-select form-select-sm">
