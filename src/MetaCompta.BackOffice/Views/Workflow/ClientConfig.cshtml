@using MetaCompta.Application.DTOs
@using MetaCompta.Domain.Common
@model List<ClientWorkflowConfigDto>
@{
    ViewData["Title"] = "Affectation Workflow Client";
    var client = ViewBag.Client as ClientDto;
    var clientId = (int)ViewBag.ClientId;
    var templates = ViewBag.Templates as List<WorkflowTemplateDto> ?? new List<WorkflowTemplateDto>();
    var catalogTypes = DeclarationServiceCatalog.All
        .Select(e => e.DeclarationType)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(t => t)
        .ToList();
    var activeTemplates = templates.Where(t => t.IsActive).OrderBy(t => t.DeclarationType).ThenBy(t => t.Name).ToList();
}

<style>
    .cc-header { background: var(--monday-blue); border-radius: 18px; color: #fff; padding: 1.75rem 2.25rem; }
    .cc-glass { background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 16px; box-shadow: var(--monday-shadow); }
    .cc-section-title { font-size: 0.88rem; font-weight: 700; color: var(--monday-text); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
    .cc-table th { font-size: 0.75rem; font-weight: 700; color: var(--monday-muted); text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid var(--monday-border); padding: 0.65rem 0.75rem; background: var(--monday-bg); }
    .cc-table td { font-size: 0.82rem; padding: 0.65rem 0.75rem; vertical-align: middle; border-bottom: 1px solid var(--monday-border); }
    .cc-check { font-size: 1.1rem; }
</style>

<div class="cc-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3" style="position:relative; z-index:2;">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2" style="font-size:0.8rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" style="color:rgba(255,255,255,0.7);">Workflow</a></li>
                    <li class="breadcrumb-item text-white">Affectation</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1"><i class="bi bi-person-gear me-2"></i>Affectation des templates</h4>
            <p class="mb-0" style="font-size:0.85rem; opacity:0.85;">
                Associer un modèle de workflow déjà construit à @(client?.RaisonSociale ?? $"Client #{clientId}")
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light" style="border-radius:10px; font-weight:600; font-size:0.83rem;"><i class="bi bi-arrow-left me-1"></i> Retour</a>
    </div>
</div>

@if (Model.Any())
{
    <div class="cc-glass mb-4 overflow-hidden">
        <div class="p-3 border-bottom" style="background:#f8fafc;">
            <div class="cc-section-title mb-0"><i class="bi bi-list-check text-primary"></i> Affectations existantes</div>
        </div>
        <div class="table-responsive">
            <table class="table cc-table mb-0">
                <thead>
                    <tr><th>Type</th><th>Modèle</th><th>Valid. client</th><th>Docs</th><th>SLA</th><th>Auto-start</th><th>Actif</th></tr>
                </thead>
                <tbody>
                    @foreach (var cfg in Model)
                    {
                        var typeLabel = DeclarationServiceCatalog.Get(cfg.DeclarationType)?.DisplayName ?? cfg.DeclarationType;
                        <tr>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary" style="border-radius:8px; font-size:0.72rem;">@typeLabel</span></td>
                            <td class="fw-semibold">@(cfg.WorkflowTemplateName ?? "Auto")</td>
                            <td class="cc-check">@(cfg.ClientValidationEnabled ? "✅" : "❌")</td>
                            <td class="cc-check">@(cfg.DocumentRequestEnabled ? "✅" : "❌")</td>
                            <td><span class="badge bg-info bg-opacity-10 text-info" style="border-radius:8px;">x@cfg.SLAMultiplier</span></td>
                            <td class="cc-check">@(cfg.AutoStartWorkflow ? "✅" : "❌")</td>
                            <td class="cc-check">@(cfg.IsActive ? "✅" : "❌")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-light border mb-4">
        <i class="bi bi-info-circle me-1"></i>Aucune affectation pour ce client. Choisissez un type de déclaration et un modèle ci-dessous.
    </div>
}

@if (ViewBag.CanWorkflowConfigure as bool? ?? false)
{
<div class="cc-glass p-4">
    <div class="cc-section-title"><i class="bi bi-plus-circle text-primary"></i> Affecter / modifier un template</div>
    <p class="text-body-secondary small mb-3">Les modèles listés viennent du Builder. Sélectionnez le type catalogue puis le template à appliquer à ce dossier.</p>
    <form asp-action="SaveClientConfig" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ClientId" value="@clientId" />
        <div class="row g-3">
            <div class="col-md-4">
                <label class="cc-form-label">Type de déclaration</label>
                <select name="DeclarationType" id="ccDeclarationType" class="form-select cc-form-select">
                    <option value="All">Tous types</option>
                    @foreach (var t in catalogTypes)
                    {
                        var label = DeclarationServiceCatalog.Get(t)?.DisplayName ?? t;
                        <option value="@t">@label (@t)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="cc-form-label">Modèle de workflow</label>
                <select name="WorkflowTemplateId" id="ccWorkflowTemplateId" class="form-select cc-form-select">
                    <option value="" data-type="">— Résolution auto —</option>
                    @foreach (var t in activeTemplates)
                    {
                        <option value="@t.Id" data-type="@(t.DeclarationType ?? "")">@t.Name (@(t.DeclarationType ?? "?"))</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="cc-form-label">Multiplicateur SLA</label>
                <input name="SLAMultiplier" type="number" step="0.1" min="0.1" max="5" class="form-control cc-form-control" value="1.0" />
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-2 cc-form-check">
                    <input name="ClientValidationEnabled" type="checkbox" class="form-check-input" checked value="true" />
                    <label class="form-check-label">Validation client</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-2 cc-form-check">
                    <input name="DocumentRequestEnabled" type="checkbox" class="form-check-input" checked value="true" />
                    <label class="form-check-label">Demande de documents</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-2 cc-form-check">
                    <input name="AutoStartWorkflow" type="checkbox" class="form-check-input" checked value="true" />
                    <label class="form-check-label">Auto-démarrage</label>
                </div>
            </div>
        </div>
        <hr class="my-3" />
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn" style="border-radius:10px; padding:0.5rem 1.5rem; font-weight:700; background:linear-gradient(135deg,#7c3aed,#a855f7); color:#fff; border:none;"><i class="bi bi-check-circle-fill me-2"></i>Enregistrer l'affectation</button>
        </div>
    </form>
</div>

<script>
(function () {
    var typeSel = document.getElementById('ccDeclarationType');
    var tplSel = document.getElementById('ccWorkflowTemplateId');
    if (!typeSel || !tplSel) return;
    var allOptions = Array.prototype.map.call(tplSel.options, function (o) {
        return { value: o.value, text: o.text, type: (o.getAttribute('data-type') || '').toUpperCase() };
    });
    function filterTemplates() {
        var want = (typeSel.value || '').toUpperCase();
        var keep = tplSel.value;
        tplSel.innerHTML = '';
        allOptions.forEach(function (opt) {
            if (!opt.value || want === 'ALL' || !opt.type || opt.type === want) {
                var o = document.createElement('option');
                o.value = opt.value;
                o.textContent = opt.text;
                o.setAttribute('data-type', opt.type);
                tplSel.appendChild(o);
            }
        });
        if (Array.prototype.some.call(tplSel.options, function (o) { return o.value === keep; })) {
            tplSel.value = keep;
        }
    }
    typeSel.addEventListener('change', filterTemplates);
})();
</script>
}
