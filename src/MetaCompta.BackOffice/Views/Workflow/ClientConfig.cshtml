@using MetaCompta.Application.DTOs
@model List<ClientWorkflowConfigDto>
@{
    ViewData["Title"] = "Configuration Workflow Client";
    var client = ViewBag.Client as ClientDto;
    var clientId = (int)ViewBag.ClientId;
    var templates = ViewBag.Templates as List<WorkflowTemplateDto> ?? new List<WorkflowTemplateDto>();
}

<style>
    .cc-header { background:linear-gradient(135deg,#7c3aed 0%,#a855f7 50%,#c084fc 100%); border-radius:18px; color:#fff; padding:1.75rem 2.25rem; position:relative; overflow:hidden; }
    .cc-header::before { content:''; position:absolute; top:-40%; right:-10%; width:250px; height:250px; border-radius:50%; background:rgba(255,255,255,0.06); }
    .cc-glass { background:rgba(255,255,255,0.92); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,0.5); border-radius:16px; box-shadow:0 8px 30px rgba(0,0,0,0.05); }
    .cc-section-title { font-size:0.88rem; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem; }
    .cc-form-label { font-size:0.8rem; font-weight:600; color:#475569; margin-bottom:0.3rem; }
    .cc-form-control { border-radius:10px; border:1.5px solid #e2e8f0; font-size:0.85rem; }
    .cc-form-select { border-radius:10px; border:1.5px solid #e2e8f0; font-size:0.85rem; }
    .cc-form-check .form-check-input { border-radius:6px; }
    .cc-form-check .form-check-label { font-size:0.8rem; color:#475569; font-weight:500; }
    .cc-table th { font-size:0.75rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.5px; border-bottom:2px solid #e2e8f0; padding:0.65rem 0.75rem; background:#f8fafc; }
    .cc-table td { font-size:0.82rem; padding:0.65rem 0.75rem; vertical-align:middle; border-bottom:1px solid #f1f5f9; }
    .cc-check { font-size:1.1rem; }
</style>

<!-- HEADER -->
<div class="cc-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3" style="position:relative; z-index:2;">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2" style="font-size:0.8rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" style="color:rgba(255,255,255,0.7);">Workflow</a></li>
                    <li class="breadcrumb-item text-white">Config client</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1"><i class="bi bi-gear-fill me-2"></i>Configuration Workflow</h4>
            <p class="mb-0" style="font-size:0.85rem; opacity:0.85;">@(client?.RaisonSociale ?? $"Client #{clientId}")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light" style="border-radius:10px; font-weight:600; font-size:0.83rem;"><i class="bi bi-arrow-left me-1"></i> Retour</a>
    </div>
</div>

<!-- EXISTING CONFIGS -->
@if (Model.Any())
{
    <div class="cc-glass mb-4 overflow-hidden">
        <div class="p-3 border-bottom" style="background:#f8fafc;">
            <div class="cc-section-title mb-0"><i class="bi bi-list-check text-primary"></i> Configurations existantes</div>
        </div>
        <div class="table-responsive">
            <table class="table cc-table mb-0">
                <thead>
                    <tr><th>Type</th><th>Modèle</th><th>Valid. client</th><th>Docs</th><th>SLA</th><th>Auto-start</th><th>Actif</th></tr>
                </thead>
                <tbody>
                    @foreach (var cfg in Model)
                    {
                        <tr>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary" style="border-radius:8px; font-size:0.72rem;">@cfg.DeclarationType</span></td>
                            <td class="fw-semibold">@(cfg.WorkflowTemplateName ?? "Auto")</td>
                            <td class="cc-check">@(cfg.ClientValidationEnabled ? "✅" : "❌")</td>
                            <td class="cc-check">@(cfg.DocumentRequestEnabled ? "✅" : "❌")</td>
                            <td><span class="badge bg-info bg-opacity-10 text-info" style="border-radius:8px;">x@cfg.SLAMultiplier</span></td>
                            <td class="cc-check">@(cfg.AutoStartWorkflow ? "✅" : "❌")</td>
                            <td class="cc-check">@(cfg.IsActive ? "✅" : "❌")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ADD / UPDATE -->
<div class="cc-glass p-4">
    <div class="cc-section-title"><i class="bi bi-plus-circle text-primary"></i> Ajouter / Modifier une configuration</div>
    <form asp-action="SaveClientConfig" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ClientId" value="@clientId" />
        <div class="row g-3">
            <div class="col-md-4">
                <label class="cc-form-label">Type de déclaration</label>
                <select name="DeclarationType" class="form-select cc-form-select">
                    <option value="All">Tous types</option>
                    @foreach (var t in new[] { "TVA", "IS", "IR", "CNSS", "IR_SALAIRES", "Paie", "Juridique", "Comptabilite" })
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="cc-form-label">Modèle de workflow</label>
                <select name="WorkflowTemplateId" class="form-select cc-form-select">
                    <option value="">&#8212; Résolution auto &#8212;</option>
                    @foreach (var t in templates.Where(t => t.IsActive))
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="cc-form-label">Multiplicateur SLA</label>
                <input name="SLAMultiplier" type="number" step="0.1" min="0.1" max="5" class="form-control cc-form-control" value="1.0" />
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-2 cc-form-check">
                    <input name="ClientValidationEnabled" type="checkbox" class="form-check-input" checked value="true" />
                    <label class="form-check-label">Validation client</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-2 cc-form-check">
                    <input name="DocumentRequestEnabled" type="checkbox" class="form-check-input" checked value="true" />
                    <label class="form-check-label">Demande de documents</label>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-2 cc-form-check">
                    <input name="AutoStartWorkflow" type="checkbox" class="form-check-input" checked value="true" />
                    <label class="form-check-label">Auto-démarrage</label>
                </div>
            </div>
        </div>
        <hr class="my-3" />
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn" style="border-radius:10px; padding:0.5rem 1.5rem; font-weight:700; background:linear-gradient(135deg,#7c3aed,#a855f7); color:#fff; border:none;"><i class="bi bi-check-circle-fill me-2"></i>Sauvegarder</button>
        </div>
    </form>
</div>