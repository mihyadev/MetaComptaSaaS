@using MetaCompta.Application.DTOs
@model WorkflowStepInstanceDto
@{
    var cardType = ViewData["CardType"]?.ToString() ?? "action";
    var stripeGradient = cardType switch
    {
        "overdue" => "linear-gradient(90deg,#dc2626,#ef4444)",
        "action"  => "linear-gradient(90deg,#2563eb,#7c3aed)",
        "waiting" => "linear-gradient(90deg,#f59e0b,#fbbf24)",
        _         => "linear-gradient(90deg,#64748b,#94a3b8)"
    };

    // Determine action button style & label based on ActionOnComplete
    var actionOnComplete = Model.ActionOnComplete ?? "None";
    var (btnClass, btnIcon, btnLabel) = actionOnComplete switch
    {
        "ValidateDeclaration" or "ValidateStep" => ("btn-action-validate", "bi-check-circle-fill", "Valider"),
        "SubmitDeclaration" or "SubmitToAuthority" => ("btn-action-submit", "bi-send-fill", "Soumettre"),
        "ApproveDeclaration" or "ReviewAndApprove" => ("btn-action-approve", "bi-award-fill", "Approuver"),
        "CompleteDeclaration" or "MarkComplete" or "ArchiveDeclaration" => ("btn-action-complete", "bi-check2-all", "Terminer"),
        "RequestClientDocuments" or "SendClientNotification" => ("btn-action-submit", "bi-envelope-fill", "Demander"),
        "CalculateDeclaration" or "GenerateReport" => ("btn-action-complete", "bi-calculator-fill", "Calculer"),
        "CreateDeclaration" => ("btn-action-default", "bi-plus-circle-fill", "Créer"),
        "PayDeclaration" or "ConfirmPayment" => ("btn-action-validate", "bi-credit-card-fill", "Payer"),
        _ => ("btn-action-default", "bi-arrow-right-circle-fill", "Traiter")
    };

    // Contextual description
    var actionDesc = actionOnComplete switch
    {
        "ValidateDeclaration" or "ValidateStep" => "Veuillez vérifier et valider cette étape",
        "SubmitDeclaration" or "SubmitToAuthority" => "Veuillez soumettre la déclaration à l'autorité compétente",
        "ApproveDeclaration" or "ReviewAndApprove" => "Veuillez examiner et approuver cette demande",
        "CompleteDeclaration" or "MarkComplete" or "ArchiveDeclaration" => "Veuillez finaliser et clôturer cette étape",
        "RequestClientDocuments" => "Documents requis de la part du client",
        "SendClientNotification" => "Notification à envoyer au client",
        "CalculateDeclaration" or "GenerateReport" => "Calcul ou rapport à générer",
        "CreateDeclaration" => "Nouvelle déclaration à créer",
        "PayDeclaration" or "ConfirmPayment" => "Paiement à effectuer ou confirmer",
        _ => "Action requise sur cette étape du workflow"
    };

    // Status badge
    var (statusBg, statusColor, statusLabel) = Model.Status switch
    {
        "InProgress" => ("#dbeafe", "#2563eb", "En cours"),
        "Pending"    => ("#fef3c7", "#d97706", "En attente"),
        "WaitingForValidation" => ("#ede9fe", "#7c3aed", "Validation"),
        "WaitingClient" => ("#fef3c7", "#d97706", "Attente client"),
        "Blocked"    => ("#fee2e2", "#dc2626", "Bloquée"),
        _            => ("#f1f5f9", "#64748b", Model.Status)
    };

    var isValidateAction = actionOnComplete is "ValidateDeclaration" or "ValidateStep";
    var canActOnCard = isValidateAction
        ? (ViewBag.CanWorkflowValidate as bool? ?? false)
        : (ViewBag.CanWorkflowAdvance as bool? ?? false);
}

<div class="col-lg-6 col-xl-4">
    <div class="req-card @(cardType == "overdue" ? "overdue-pulse" : "")">
        <div class="top-stripe" style="background:@stripeGradient;"></div>
        <div class="p-3">
            <!-- Row 1: Step name + Status -->
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h6 class="fw-bold mb-0" style="font-size:0.9rem; color:#1e293b;">@Model.StepName</h6>
                @if (cardType == "overdue")
                {
                    <span class="req-badge" style="background:#fee2e2; color:#dc2626;"><i class="bi bi-exclamation-triangle-fill"></i> RETARD</span>
                }
                else
                {
                    <span class="req-badge" style="background:@statusBg; color:@statusColor;">@statusLabel</span>
                }
            </div>

            <!-- Row 2: Client + Declaration tags -->
            <div class="d-flex flex-wrap gap-2 mb-2">
                @if (!string.IsNullOrEmpty(Model.ClientName))
                {
                    <span class="req-client-tag"><i class="bi bi-building"></i> @Model.ClientName</span>
                }
                @if (!string.IsNullOrEmpty(Model.DeclarationType) && Model.DeclarationType != "All")
                {
                    <span class="req-decl-tag"><i class="bi bi-file-earmark-text-fill"></i> @Model.DeclarationType</span>
                }
                @if (!string.IsNullOrEmpty(Model.AssignmentType))
                {
                    <span class="req-badge" style="background:rgba(37,99,235,0.06); color:#2563eb; font-size:0.68rem;"><i class="bi bi-person-fill"></i> @Model.AssignmentType</span>
                }
            </div>

            <!-- Row 3: Action description -->
            <div class="req-action-desc">
                <i class="bi bi-info-circle me-1" style="color:#7c3aed;"></i> @actionDesc
            </div>

            <!-- Row 4: Due date -->
            @if (Model.DueDate.HasValue)
            {
                <div class="mb-2" style="font-size:0.76rem; color:@(Model.IsOverdue ? "#dc2626" : "#64748b"); font-weight:@(Model.IsOverdue ? "700" : "500");">
                    <i class="bi bi-@(Model.IsOverdue ? "calendar-x" : "calendar-event") me-1"></i>Échéance : @Model.DueDate.Value.ToString("dd/MM/yyyy HH:mm")
                </div>
            }

            <!-- Row 5: Block reason -->
            @if (!string.IsNullOrEmpty(Model.BlockReason))
            {
                <div class="p-2 rounded mb-2" style="background:#fef2f2; font-size:0.74rem; color:#dc2626; border-radius:8px;">
                    <i class="bi bi-exclamation-octagon me-1"></i>@Model.BlockReason
                </div>
            }

            <!-- Row 6: Notes -->
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="p-2 rounded mb-2" style="background:#f8fafc; font-size:0.74rem; color:#475569; border-radius:8px;">
                    <i class="bi bi-chat-text me-1"></i>@Model.Notes
                </div>
            }

            <!-- Row 7: Actions -->
            <div class="d-flex gap-2 mt-3">
                <a asp-action="InstanceDetails" asp-route-id="@Model.WorkflowInstanceId"
                   class="btn btn-sm btn-outline-primary flex-fill" style="border-radius:10px; font-weight:600; font-size:0.8rem;">
                    <i class="bi bi-eye me-1"></i> Détails
                </a>
                @if (canActOnCard && (Model.Status == "InProgress" || Model.Status == "Pending" || Model.Status == "WaitingForValidation"))
                {
                    <form asp-action="AdvanceStep" method="post" class="flex-fill">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="instanceId" value="@Model.WorkflowInstanceId" />
                        <button type="submit" class="btn btn-sm @btnClass w-100" style="border-radius:10px; font-weight:600; font-size:0.8rem;"
                                onclick="return confirm('Confirmer : @btnLabel cette étape ?')">
                            <i class="bi @btnIcon me-1"></i> @btnLabel
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
