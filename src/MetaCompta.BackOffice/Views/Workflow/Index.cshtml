@using MetaCompta.Application.DTOs
@model WorkflowDashboardDto
@{
    ViewData["Title"] = "Workflow Engine";
}

<style>
    .wf-dash-header { background:linear-gradient(135deg,#0f172a 0%,#1e293b 40%,#334155 100%); border-radius:18px; color:#fff; padding:2rem 2.25rem; position:relative; overflow:hidden; }
    .wf-dash-header::before { content:''; position:absolute; top:-60%; right:-15%; width:350px; height:350px; border-radius:50%; background:radial-gradient(circle,rgba(37,99,235,0.12),transparent 70%); }
    .wf-dash-header::after { content:''; position:absolute; bottom:-40%; left:20%; width:250px; height:250px; border-radius:50%; background:radial-gradient(circle,rgba(124,58,237,0.08),transparent 70%); }

    .wf-stat-card { background:rgba(255,255,255,0.92); backdrop-filter:blur(20px); border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; transition:all .35s ease; position:relative; }
    .wf-stat-card:hover { transform:translateY(-4px); box-shadow:0 14px 40px rgba(0,0,0,0.1); border-color:#cbd5e1; }
    .wf-stat-card .stat-bar { height:4px; }
    .wf-stat-card .stat-icon { width:52px; height:52px; border-radius:14px; display:flex; align-items:center; justify-content:center; font-size:1.3rem; }
    .wf-stat-val { font-size:2rem; font-weight:800; line-height:1; letter-spacing:-0.02em; }
    .wf-stat-lbl { font-size:0.75rem; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:0.04em; }

    .wf-glass { background:rgba(255,255,255,0.9); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,0.5); border-radius:16px; box-shadow:0 8px 30px rgba(0,0,0,0.05); }
    .wf-glass-title { font-size:0.88rem; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:0.5rem; }
    .wf-mini-badge { display:inline-flex; align-items:center; gap:0.2rem; padding:0.12rem 0.5rem; border-radius:20px; font-size:0.68rem; font-weight:600; }

    .wf-recent-row { display:flex; justify-content:space-between; align-items:center; padding:0.65rem 0; border-bottom:1px solid #f1f5f9; transition:background .2s; gap:0.5rem; }
    .wf-recent-row:last-child { border-bottom:none; }
    .wf-recent-row:hover { background:#f8fafc; border-radius:8px; padding-left:0.4rem; padding-right:0.4rem; }

    .wf-progress-thin { height:6px; border-radius:3px; background:#e2e8f0; overflow:hidden; }
    .wf-progress-thin .fill { height:100%; border-radius:3px; transition:width 1.2s ease; }

    .wf-dist-row { display:flex; align-items:center; gap:0.75rem; padding:0.5rem 0; }
    .wf-dist-bar-bg { flex:1; height:8px; border-radius:4px; background:#f1f5f9; overflow:hidden; }
    .wf-dist-bar-fill { height:100%; border-radius:4px; transition:width 1s ease; }

    .wf-quick-link { display:flex; flex-direction:column; align-items:center; gap:0.4rem; padding:1rem; border-radius:14px; border:1px solid #e2e8f0; background:rgba(255,255,255,0.9); transition:all .3s ease; text-decoration:none; color:#475569; min-width:100px; }
    .wf-quick-link:hover { transform:translateY(-3px); box-shadow:0 8px 25px rgba(0,0,0,0.08); border-color:#cbd5e1; color:#1e293b; }
    .wf-quick-link .ql-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; }
    .wf-quick-link .ql-label { font-size:0.72rem; font-weight:700; text-align:center; }
</style>

<!-- ═══════════ HEADER ═══════════ -->
<div class="wf-dash-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3" style="position:relative; z-index:2;">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-diagram-3-fill me-2"></i>Workflow Engine</h4>
            <p class="mb-0" style="font-size:0.88rem; opacity:0.8;">Tableau de bord des processus métier — Suivi en temps réel</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Builder" class="btn btn-warning" style="border-radius:10px; font-weight:700; font-size:0.83rem;"><i class="bi bi-tools me-1"></i> Builder</a>
            <a asp-action="StartWorkflow" class="btn btn-light" style="border-radius:10px; font-weight:700; font-size:0.83rem;"><i class="bi bi-play-circle-fill me-1"></i> Démarrer</a>
            <a asp-action="MyTasks" class="btn btn-outline-light" style="border-radius:10px; font-weight:600; font-size:0.83rem;"><i class="bi bi-person-check me-1"></i> Mes tâches</a>
        </div>
    </div>
</div>

<!-- ═══════════ STAT CARDS ═══════════ -->
<div class="row g-3 mb-4">
    @{
        var stats = new[] {
            ("Actifs", Model.ActiveWorkflows, "#2563eb", "linear-gradient(90deg,#2563eb,#3b82f6)", "bi-lightning-charge-fill", "#dbeafe"),
            ("Terminés", Model.CompletedThisMonth, "#059669", "linear-gradient(90deg,#059669,#10b981)", "bi-check-circle-fill", "#d1fae5"),
            ("Attente client", Model.WaitingForClient, "#f59e0b", "linear-gradient(90deg,#f59e0b,#fbbf24)", "bi-hourglass-split", "#fef3c7"),
            ("En retard", Model.OverdueSteps, "#dc2626", "linear-gradient(90deg,#dc2626,#ef4444)", "bi-exclamation-triangle-fill", "#fee2e2"),
            ("Mes actions", Model.PendingMyAction, "#7c3aed", "linear-gradient(90deg,#7c3aed,#a78bfa)", "bi-person-fill-gear", "#ede9fe")
        };
    }
    @foreach (var (label, value, color, grad, icon, bg) in stats)
    {
        <div class="col-6 col-lg">
            <div class="wf-stat-card h-100">
                <div class="stat-bar" style="background:@grad;"></div>
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="stat-icon" style="background:@bg; color:@color;"><i class="bi @icon"></i></div>
                        @if (label == "En retard" && value > 0) { <span class="wf-mini-badge" style="background:#fee2e2; color:#dc2626; animation:pulse 2s infinite;">⚠</span> }
                    </div>
                    <div class="wf-stat-val" style="color:@color;">@value</div>
                    <div class="wf-stat-lbl mt-1">@label</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ═══════════ QUICK LINKS ═══════════ -->
<div class="d-flex gap-3 flex-wrap mb-4">
    <a asp-action="Builder" class="wf-quick-link" style="border-color:#f59e0b; background:rgba(254,243,199,0.5);">
        <div class="ql-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff;"><i class="bi bi-tools"></i></div>
        <div class="ql-label" style="color:#92400e;">Builder <span style="font-size:0.55rem; background:#f59e0b; color:#fff; padding:0.05rem 0.35rem; border-radius:8px; vertical-align:middle;">NEW</span></div>
    </a>
    <a asp-action="Templates" class="wf-quick-link">
        <div class="ql-icon" style="background:#dbeafe; color:#2563eb;"><i class="bi bi-file-earmark-ruled"></i></div>
        <div class="ql-label">Modèles</div>
    </a>
    <a asp-action="Instances" class="wf-quick-link">
        <div class="ql-icon" style="background:#d1fae5; color:#059669;"><i class="bi bi-collection-fill"></i></div>
        <div class="ql-label">Instances</div>
    </a>
    <a asp-action="MyTasks" class="wf-quick-link">
        <div class="ql-icon" style="background:#ede9fe; color:#7c3aed;"><i class="bi bi-person-check-fill"></i></div>
        <div class="ql-label">Mes tâches</div>
    </a>
    <a asp-action="StartWorkflow" class="wf-quick-link">
        <div class="ql-icon" style="background:#fef3c7; color:#d97706;"><i class="bi bi-play-circle-fill"></i></div>
        <div class="ql-label">Démarrer</div>
    </a>
    <a asp-action="ClientConfig" class="wf-quick-link">
        <div class="ql-icon" style="background:#fce7f3; color:#be185d;"><i class="bi bi-gear-wide-connected"></i></div>
        <div class="ql-label">Config client</div>
    </a>
</div>

<div class="row g-4">
    <!-- ═══════════ MY PENDING STEPS ═══════════ -->
    <div class="col-lg-7">
        <div class="wf-glass p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="wf-glass-title"><i class="bi bi-list-check text-primary"></i> Mes étapes en attente</div>
                <a asp-action="MyTasks" class="wf-mini-badge" style="background:#dbeafe; color:#2563eb; text-decoration:none;">Voir tout <i class="bi bi-arrow-right"></i></a>
            </div>

            @if (Model.MyPendingSteps?.Any() == true)
            {
                @foreach (var step in Model.MyPendingSteps.Take(8))
                {
                    var sc = step.Status switch { "InProgress"=>"#2563eb", "Pending"=>"#f59e0b", "Blocked"=>"#dc2626", "WaitingForClient"=>"#d97706", _=>"#94a3b8" };
                    var si = step.StepType switch { "Initialisation"=>"bi-rocket-takeoff-fill", "DemandePieces"=>"bi-envelope-paper-fill", "Collecte"=>"bi-cloud-arrow-up-fill", "Saisie"=>"bi-keyboard-fill", "Controle"=>"bi-search", "ValidationInterne"=>"bi-shield-check", "ValidationClient"=>"bi-person-check", "DepotSoumission"=>"bi-send-fill", "ClotureArchivage"=>"bi-archive-fill", _=>"bi-circle-fill" };
                    <div class="wf-recent-row">
                        <div class="d-flex align-items-center gap-2 flex-grow-1 min-width-0">
                            <div style="width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; background:@(sc)15; color:@sc; font-size:0.8rem; flex-shrink:0;">
                                <i class="bi @si"></i>
                            </div>
                            <div style="min-width:0;">
                                <div class="fw-bold text-truncate" style="font-size:0.82rem; color:#1e293b;">@step.StepName</div>
                                <div style="font-size:0.7rem; color:#94a3b8;">WF #@step.WorkflowInstanceId · @step.StepType</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            @if (step.IsOverdue) { <span class="wf-mini-badge" style="background:#fee2e2; color:#dc2626;"><i class="bi bi-exclamation-triangle-fill"></i> Retard</span> }
                            else { <span class="wf-mini-badge" style="background:@(sc)15; color:@sc;">@step.Status</span> }
                            <a asp-action="InstanceDetails" asp-route-id="@step.WorkflowInstanceId" class="btn btn-sm" style="border-radius:6px; padding:0.15rem 0.4rem; font-size:0.72rem; background:#f1f5f9; color:#475569;"><i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-check-circle-fill d-block mb-2" style="font-size:2.5rem; color:#10b981;"></i>
                    <div class="fw-bold" style="color:#1e293b; font-size:0.88rem;">Tout est à jour !</div>
                    <div style="font-size:0.78rem; color:#94a3b8;">Aucune étape en attente de votre action.</div>
                </div>
            }
        </div>
    </div>

    <!-- ═══════════ STATUS DISTRIBUTION ═══════════ -->
    <div class="col-lg-5">
        <div class="wf-glass p-4 h-100">
            <div class="wf-glass-title mb-3"><i class="bi bi-pie-chart-fill text-primary"></i> Distribution des statuts</div>

            @if (Model.StatusDistribution?.Any() == true)
            {
                var total = (double)Model.StatusDistribution.Values.Sum();
                var distColors = new Dictionary<string, string>
                {
                    ["Active"] = "#2563eb", ["Completed"] = "#059669", ["Paused"] = "#d97706",
                    ["Cancelled"] = "#dc2626", ["Error"] = "#ef4444"
                };

                @foreach (var kv in Model.StatusDistribution.OrderByDescending(x => x.Value))
                {
                    var pct = total > 0 ? (kv.Value / total * 100).ToString("F1") : "0";
                    var dc = distColors.ContainsKey(kv.Key) ? distColors[kv.Key] : "#94a3b8";
                    var dl = kv.Key switch { "Active"=>"Actifs", "Completed"=>"Terminés", "Paused"=>"En pause", "Cancelled"=>"Annulés", "Error"=>"Erreur", _=>kv.Key };
                    <div class="wf-dist-row">
                        <div style="min-width:90px;">
                            <div class="fw-bold" style="font-size:0.8rem; color:#1e293b;">@dl</div>
                            <div style="font-size:0.68rem; color:#94a3b8;">@kv.Value workflows</div>
                        </div>
                        <div class="wf-dist-bar-bg">
                            <div class="wf-dist-bar-fill" style="width:@(pct)%; background:@dc;"></div>
                        </div>
                        <div class="fw-bold" style="font-size:0.8rem; color:@dc; min-width:40px; text-align:right;">@(pct)%</div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-3" style="color:#94a3b8; font-size:0.82rem;"><i class="bi bi-bar-chart d-block mb-2" style="font-size:2rem;"></i>Aucune donnée disponible</div>
            }

            <!-- Step Type Distribution -->
            @if (Model.StepTypeDistribution?.Any() == true)
            {
                <hr class="my-3" style="border-color:#f1f5f9;" />
                <div class="wf-glass-title mb-2"><i class="bi bi-bar-chart-steps text-primary"></i> Types d'étapes actives</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var kv in Model.StepTypeDistribution.OrderByDescending(x => x.Value))
                    {
                        var stepColor = kv.Key switch { "Initialisation"=>"#475569", "DemandePieces"=>"#2563eb", "Collecte"=>"#d97706", "Saisie"=>"#0284c7", "Controle"=>"#7c3aed", "ValidationInterne"=>"#059669", "ValidationClient"=>"#d97706", "DepotSoumission"=>"#dc2626", "ClotureArchivage"=>"#475569", _=>"#94a3b8" };
                        <span class="wf-mini-badge" style="background:@(stepColor)12; color:@stepColor; border:1px solid @(stepColor)25;">@kv.Key <strong>@kv.Value</strong></span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- ═══════════ RECENT WORKFLOWS ═══════════ -->
@if (Model.RecentWorkflows?.Any() == true)
{
    <div class="wf-glass p-4 mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="wf-glass-title"><i class="bi bi-clock-history text-primary"></i> Workflows récents</div>
            <a asp-action="Instances" class="wf-mini-badge" style="background:#dbeafe; color:#2563eb; text-decoration:none;">Tous <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="table-responsive">
            <table class="table mb-0" style="font-size:0.82rem;">
                <thead>
                    <tr style="border-bottom:2px solid #e2e8f0;">
                        <th style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#64748b; font-weight:700; padding:0.5rem;">ID</th>
                        <th style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#64748b; font-weight:700; padding:0.5rem;">Client</th>
                        <th style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#64748b; font-weight:700; padding:0.5rem;">Type</th>
                        <th style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#64748b; font-weight:700; padding:0.5rem;">Étape</th>
                        <th style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#64748b; font-weight:700; padding:0.5rem;">Progression</th>
                        <th style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#64748b; font-weight:700; padding:0.5rem;">Statut</th>
                        <th style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:#64748b; font-weight:700; padding:0.5rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var wf in Model.RecentWorkflows.Take(10))
                    {
                        var sc = wf.Status switch { "Active"=>"#2563eb", "Completed"=>"#059669", "Paused"=>"#d97706", "Cancelled"=>"#dc2626", _=>"#94a3b8" };
                        var si = wf.Status switch { "Active"=>"bi-lightning-charge-fill", "Completed"=>"bi-check-circle-fill", "Paused"=>"bi-pause-circle-fill", "Cancelled"=>"bi-x-circle-fill", _=>"bi-circle" };
                        <tr style="border-bottom:1px solid #f1f5f9;">
                            <td class="fw-bold" style="padding:0.6rem 0.5rem;">#@wf.Id</td>
                            <td style="padding:0.6rem 0.5rem;">@(wf.ClientName ?? "—")</td>
                            <td style="padding:0.6rem 0.5rem;"><span class="wf-mini-badge" style="background:rgba(37,99,235,0.08); color:#2563eb;">@wf.DeclarationType</span></td>
                            <td style="padding:0.6rem 0.5rem;">
                                <div class="fw-bold" style="font-size:0.78rem;">@wf.CurrentStepName</div>
                            </td>
                            <td style="padding:0.6rem 0.5rem; min-width:100px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="wf-progress-thin flex-grow-1"><div class="fill" style="width:@wf.ProgressPercent%; background:@sc;"></div></div>
                                    <span style="font-size:0.7rem; font-weight:700; color:@sc;">@wf.ProgressPercent%</span>
                                </div>
                            </td>
                            <td style="padding:0.6rem 0.5rem;"><span class="wf-mini-badge" style="background:@(sc)15; color:@sc;"><i class="bi @si"></i> @wf.Status</span></td>
                            <td style="padding:0.6rem 0.5rem;">
                                <a asp-action="InstanceDetails" asp-route-id="@wf.Id" class="btn btn-sm" style="border-radius:6px; padding:0.12rem 0.4rem; font-size:0.72rem; background:#f1f5f9; color:#475569;"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
