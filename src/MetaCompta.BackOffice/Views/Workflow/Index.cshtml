@using MetaCompta.Application.DTOs
@model WorkflowDashboardDto
@{
    ViewData["Title"] = "Workflow";
    var canConfigure = ViewBag.CanWorkflowConfigure as bool? ?? false;
    var canCreate = ViewBag.CanWorkflowCreate as bool? ?? false;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-diagram-3 text-primary me-2"></i>Workflow</h4>
        <p class="text-muted mb-0">Pilotage des processus métier — suivi en temps réel</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (canConfigure)
        {
            <a asp-action="Builder" class="btn btn-outline-warning rounded-pill px-3">
                <i class="bi bi-tools me-1"></i>Builder
            </a>
        }
        @if (canCreate)
        {
            <a asp-action="StartWorkflow" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-play-circle me-1"></i>Démarrer
            </a>
        }
        <a asp-action="MyTasks" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-person-check me-1"></i>Mes tâches
        </a>
    </div>
</div>

<!-- KPI strip -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl">
        <a asp-action="Instances" asp-route-status="Active" class="text-decoration-none">
            <div class="stat-card h-100" style="border-left:4px solid var(--monday-blue);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Actifs</div>
                        <div class="stat-value">@Model.ActiveWorkflows</div>
                    </div>
                    <div class="stat-icon" style="background:rgba(0,115,234,0.1);color:var(--monday-blue);">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl">
        <a asp-action="Instances" asp-route-status="Completed" class="text-decoration-none">
            <div class="stat-card h-100" style="border-left:4px solid var(--monday-green);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Terminés (mois)</div>
                        <div class="stat-value">@Model.CompletedThisMonth</div>
                    </div>
                    <div class="stat-icon" style="background:rgba(0,200,117,0.12);color:var(--monday-green);">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl">
        <div class="stat-card h-100" style="border-left:4px solid var(--monday-orange);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Attente client</div>
                    <div class="stat-value">@Model.WaitingForClient</div>
                </div>
                <div class="stat-icon" style="background:rgba(253,171,61,0.15);color:var(--monday-orange);">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl">
        <div class="stat-card h-100" style="border-left:4px solid var(--monday-red);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">En retard</div>
                    <div class="stat-value @(Model.OverdueSteps > 0 ? "text-danger" : "")">@Model.OverdueSteps</div>
                </div>
                <div class="stat-icon" style="background:rgba(226,68,92,0.12);color:var(--monday-red);">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl">
        <a asp-action="MyTasks" class="text-decoration-none">
            <div class="stat-card h-100" style="border-left:4px solid var(--monday-purple);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-label">Mes actions</div>
                        <div class="stat-value">@Model.PendingMyAction</div>
                    </div>
                    <div class="stat-icon" style="background:rgba(97,97,255,0.12);color:var(--monday-purple);">
                        <i class="bi bi-person-fill-gear"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Quick actions (monday board tiles) -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap gap-2 align-items-stretch">
            @if (canConfigure)
            {
                <a asp-action="Builder" class="wf-board-tile">
                    <span class="wf-board-tile-icon" style="background:rgba(253,171,61,0.15);color:var(--monday-orange);"><i class="bi bi-tools"></i></span>
                    <span class="wf-board-tile-label">Builder</span>
                </a>
            }
            <a asp-action="Templates" class="wf-board-tile">
                <span class="wf-board-tile-icon" style="background:rgba(0,115,234,0.1);color:var(--monday-blue);"><i class="bi bi-file-earmark-ruled"></i></span>
                <span class="wf-board-tile-label">Modèles</span>
            </a>
            <a asp-action="Instances" class="wf-board-tile">
                <span class="wf-board-tile-icon" style="background:rgba(0,200,117,0.12);color:var(--monday-green);"><i class="bi bi-collection-fill"></i></span>
                <span class="wf-board-tile-label">Instances</span>
            </a>
            <a asp-action="MyTasks" class="wf-board-tile">
                <span class="wf-board-tile-icon" style="background:rgba(97,97,255,0.12);color:var(--monday-purple);"><i class="bi bi-person-check-fill"></i></span>
                <span class="wf-board-tile-label">Mes tâches</span>
            </a>
            @if (canCreate)
            {
                <a asp-action="StartWorkflow" class="wf-board-tile">
                    <span class="wf-board-tile-icon" style="background:rgba(253,171,61,0.15);color:var(--monday-orange);"><i class="bi bi-play-circle-fill"></i></span>
                    <span class="wf-board-tile-label">Démarrer</span>
                </a>
            }
            <a asp-action="ClientConfig" class="wf-board-tile">
                <span class="wf-board-tile-icon" style="background:rgba(255,21,138,0.1);color:var(--monday-pink);"><i class="bi bi-gear-wide-connected"></i></span>
                <span class="wf-board-tile-label">Config client</span>
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Pending steps -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-0 px-4 pt-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-list-check text-primary me-2"></i>Mes étapes en attente</h6>
                <a asp-action="MyTasks" class="btn btn-sm btn-outline-primary rounded-pill px-3">Voir tout</a>
            </div>
            <div class="card-body pt-2">
                @if (Model.MyPendingSteps?.Any() == true)
                {
                    <div class="list-group list-group-flush wf-step-list">
                        @foreach (var step in Model.MyPendingSteps.Take(8))
                        {
                            var statusClass = step.Status switch
                            {
                                "InProgress" => "wf-chip-blue",
                                "Pending" => "wf-chip-orange",
                                "Blocked" => "wf-chip-red",
                                "WaitingForClient" => "wf-chip-orange",
                                _ => "wf-chip-muted"
                            };
                            var statusLabel = step.Status switch
                            {
                                "InProgress" => "En cours",
                                "Pending" => "En attente",
                                "Blocked" => "Bloqué",
                                "WaitingForClient" => "Client",
                                _ => step.Status
                            };
                            var icon = step.StepType switch
                            {
                                "Initialisation" => "bi-rocket-takeoff",
                                "DemandePieces" => "bi-envelope-paper",
                                "Collecte" => "bi-cloud-arrow-up",
                                "Saisie" => "bi-keyboard",
                                "Controle" => "bi-search",
                                "ValidationInterne" => "bi-shield-check",
                                "ValidationClient" => "bi-person-check",
                                "DepotSoumission" => "bi-send",
                                "ClotureArchivage" => "bi-archive",
                                _ => "bi-circle"
                            };
                            <a asp-action="InstanceDetails" asp-route-id="@step.WorkflowInstanceId"
                               class="list-group-item list-group-item-action border-0 px-0 py-2 wf-step-row">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="wf-step-icon"><i class="bi @icon"></i></div>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold text-truncate">@step.StepName</div>
                                        <div class="small text-muted text-truncate">WF #@step.WorkflowInstanceId · @step.StepType</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        @if (step.IsOverdue)
                                        {
                                            <span class="badge rounded-pill wf-chip-red">Retard</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill @statusClass">@statusLabel</span>
                                        }
                                        <i class="bi bi-chevron-right text-muted"></i>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="wf-empty-icon mb-2"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="fw-semibold">Tout est à jour</div>
                        <div class="small text-muted">Aucune étape en attente de votre action.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Status distribution -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-0 px-4 pt-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart text-primary me-2"></i>Distribution des statuts</h6>
            </div>
            <div class="card-body pt-2">
                @if (Model.StatusDistribution?.Any() == true)
                {
                    var total = (double)Model.StatusDistribution.Values.Sum();
                    var distMeta = new Dictionary<string, (string Label, string Color)>
                    {
                        ["Active"] = ("Actifs", "var(--monday-blue)"),
                        ["Completed"] = ("Terminés", "var(--monday-green)"),
                        ["Paused"] = ("En pause", "var(--monday-orange)"),
                        ["Cancelled"] = ("Annulés", "var(--monday-red)"),
                        ["Error"] = ("Erreur", "var(--monday-red)")
                    };

                    foreach (var kv in Model.StatusDistribution.OrderByDescending(x => x.Value))
                    {
                        var pct = total > 0 ? kv.Value / total * 100 : 0;
                        var meta = distMeta.ContainsKey(kv.Key) ? distMeta[kv.Key] : (kv.Key, "var(--monday-muted)");
                        <div class="wf-dist-row mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>
                                    <span class="fw-semibold">@meta.Item1</span>
                                    <span class="small text-muted ms-1">@kv.Value</span>
                                </div>
                                <span class="fw-bold small" style="color:@meta.Item2;">@pct.ToString("0.#")%</span>
                            </div>
                            <div class="progress wf-progress" role="progressbar" aria-valuenow="@pct.ToString("0")" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background:@meta.Item2;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-bar-chart d-block mb-2 fs-3 opacity-50"></i>
                        Aucune donnée disponible
                    </div>
                }

                @if (Model.StepTypeDistribution?.Any() == true)
                {
                    <hr class="my-3" />
                    <div class="fw-semibold small mb-2 text-muted text-uppercase" style="letter-spacing:.04em;">Types d'étapes actives</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var kv in Model.StepTypeDistribution.OrderByDescending(x => x.Value))
                        {
                            <span class="badge rounded-pill bg-primary-subtle text-primary fw-semibold">
                                @kv.Key <span class="ms-1 opacity-75">@kv.Value</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent workflows board table -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-0 px-4 pt-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Workflows récents</h6>
        <a asp-action="Instances" class="btn btn-sm btn-outline-primary rounded-pill px-3">Toutes les instances</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentWorkflows?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 mc-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Client</th>
                            <th>Type</th>
                            <th>Étape en cours</th>
                            <th style="min-width:140px;">Progression</th>
                            <th>Statut</th>
                            <th class="pe-4 text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var wf in Model.RecentWorkflows.Take(10))
                        {
                            var statusChip = wf.Status switch
                            {
                                "Active" => "wf-chip-blue",
                                "Completed" => "wf-chip-green",
                                "Paused" => "wf-chip-orange",
                                "Cancelled" => "wf-chip-red",
                                _ => "wf-chip-muted"
                            };
                            var statusLabel = wf.Status switch
                            {
                                "Active" => "Actif",
                                "Completed" => "Terminé",
                                "Paused" => "En pause",
                                "Cancelled" => "Annulé",
                                _ => wf.Status
                            };
                            var barColor = wf.Status switch
                            {
                                "Active" => "var(--monday-blue)",
                                "Completed" => "var(--monday-green)",
                                "Paused" => "var(--monday-orange)",
                                "Cancelled" => "var(--monday-red)",
                                _ => "var(--monday-muted)"
                            };
                            <tr>
                                <td class="ps-4 fw-bold">#@wf.Id</td>
                                <td class="fw-semibold">@(wf.ClientName ?? "—")</td>
                                <td><span class="badge rounded-pill bg-primary-subtle text-primary">@wf.DeclarationType</span></td>
                                <td>
                                    <div class="fw-semibold small">@(wf.CurrentStepName ?? "—")</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress wf-progress flex-grow-1">
                                            <div class="progress-bar" style="width:@wf.ProgressPercent%; background:@barColor;"></div>
                                        </div>
                                        <span class="small fw-bold text-muted" style="min-width:2.5rem;">@wf.ProgressPercent%</span>
                                    </div>
                                </td>
                                <td><span class="badge rounded-pill @statusChip">@statusLabel</span></td>
                                <td class="pe-4 text-end">
                                    <a asp-action="InstanceDetails" asp-route-id="@wf.Id"
                                       class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Détails">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                <div class="fw-semibold mb-1">Aucun workflow récent</div>
                <div class="small mb-3">Démarrez un processus pour un client / une déclaration.</div>
                @if (canCreate)
                {
                    <a asp-action="StartWorkflow" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-play-circle me-1"></i>Démarrer un workflow
                    </a>
                }
            </div>
        }
    </div>
</div>
