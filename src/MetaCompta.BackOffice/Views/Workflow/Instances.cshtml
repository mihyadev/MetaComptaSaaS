@model MetaCompta.Application.DTOs.PagedResult<MetaCompta.Application.DTOs.WorkflowInstanceDto>
@{
    ViewData["Title"] = "Instances de workflow";
    var canCreate = ViewBag.CanWorkflowCreate as bool? ?? false;
    var active = Model?.Items?.Count(i => i.Status == "Active") ?? 0;
    var completed = Model?.Items?.Count(i => i.Status == "Completed") ?? 0;
    var paused = Model?.Items?.Count(i => i.Status == "Paused") ?? 0;
    var cancelled = Model?.Items?.Count(i => i.Status == "Cancelled") ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size:0.85rem;">
                <li class="breadcrumb-item"><a asp-controller="Workflow" asp-action="Index">Workflow</a></li>
                <li class="breadcrumb-item active">Instances</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0"><i class="bi bi-collection text-primary me-2"></i>Instances de workflow</h4>
        <p class="text-muted mb-0">Suivi de tous les processus en cours et historiques</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="StartWorkflow" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-play-circle me-1"></i>Démarrer
        </a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card" style="border-left:4px solid var(--monday-blue);">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">Actifs</div><div class="stat-value">@active</div></div>
                <div class="stat-icon" style="background:rgba(0,115,234,0.1);color:var(--monday-blue);"><i class="bi bi-lightning-charge"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card" style="border-left:4px solid var(--monday-green);">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">Terminés</div><div class="stat-value">@completed</div></div>
                <div class="stat-icon" style="background:rgba(0,200,117,0.12);color:var(--monday-green);"><i class="bi bi-check-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card" style="border-left:4px solid var(--monday-orange);">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">En pause</div><div class="stat-value">@paused</div></div>
                <div class="stat-icon" style="background:rgba(253,171,61,0.15);color:var(--monday-orange);"><i class="bi bi-pause-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card" style="border-left:4px solid var(--monday-muted);">
            <div class="d-flex align-items-center justify-content-between">
                <div><div class="stat-label">Annulés</div><div class="stat-value">@cancelled</div></div>
                <div class="stat-icon" style="background:#eef0f6;color:var(--monday-muted);"><i class="bi bi-x-circle"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Statut</label>
                <select name="status" class="form-select">
                    <option value="">Tous</option>
                    <option value="Active" selected="@(ViewBag.Status?.ToString() == "Active")">Actif</option>
                    <option value="Completed" selected="@(ViewBag.Status?.ToString() == "Completed")">Terminé</option>
                    <option value="Paused" selected="@(ViewBag.Status?.ToString() == "Paused")">En pause</option>
                    <option value="Cancelled" selected="@(ViewBag.Status?.ToString() == "Cancelled")">Annulé</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Client ID</label>
                <input type="number" name="clientId" class="form-control" value="@ViewBag.ClientId" placeholder="ID client" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Déclaration ID</label>
                <input type="number" name="declarationId" class="form-control" value="@ViewBag.DeclarationId" placeholder="ID déclaration" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary rounded-pill w-100"><i class="bi bi-funnel me-1"></i>Filtrer</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-transparent border-0 px-4 pt-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-list-columns text-primary me-2"></i>Workflows (@(Model?.TotalCount ?? 0))</h6>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Tableau de bord</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 mc-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Client</th>
                        <th>Type</th>
                        <th>Période</th>
                        <th>Étape actuelle</th>
                        <th style="min-width:150px;">Progression</th>
                        <th>Démarré par</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        foreach (var inst in Model.Items)
                        {
                            var statusChip = inst.Status switch
                            {
                                "Active" => "wf-chip-blue",
                                "Completed" => "wf-chip-green",
                                "Paused" => "wf-chip-orange",
                                "Cancelled" => "wf-chip-muted",
                                _ => "wf-chip-muted"
                            };
                            var statusLabel = inst.Status switch
                            {
                                "Active" => "Actif",
                                "Completed" => "Terminé",
                                "Paused" => "En pause",
                                "Cancelled" => "Annulé",
                                _ => inst.Status
                            };
                            var barColor = inst.Status switch
                            {
                                "Active" => "var(--monday-blue)",
                                "Completed" => "var(--monday-green)",
                                "Paused" => "var(--monday-orange)",
                                _ => "var(--monday-muted)"
                            };
                            <tr>
                                <td class="ps-4 fw-semibold">@inst.ClientName</td>
                                <td><span class="badge rounded-pill bg-primary-subtle text-primary">@inst.DeclarationType</span></td>
                                <td>@(inst.DeclarationPeriode ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inst.CurrentStepName))
                                    {
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <span class="badge rounded-pill bg-primary-subtle text-primary">@inst.CurrentStepOrder</span>
                                            <span class="small fw-semibold">@inst.CurrentStepName</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress wf-progress flex-grow-1">
                                            <div class="progress-bar" style="width:@inst.ProgressPercent%; background:@barColor;"></div>
                                        </div>
                                        <small class="text-muted fw-bold">@inst.ProgressPercent%</small>
                                    </div>
                                    <small class="text-muted">@inst.CompletedSteps / @inst.TotalSteps étapes</small>
                                </td>
                                <td class="small">@(inst.StartedByUserName ?? "—")</td>
                                <td class="small">@inst.StartedAt.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge rounded-pill @statusChip">@statusLabel</span></td>
                                <td class="pe-4 text-end">
                                    <a asp-action="InstanceDetails" asp-route-id="@inst.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Détails">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-diagram-3 fs-2 d-block mb-2 opacity-50"></i>
                                <div class="fw-semibold mb-1">Aucune instance trouvée</div>
                                @if (canCreate)
                                {
                                    <a asp-action="StartWorkflow" class="btn btn-sm btn-primary rounded-pill px-3 mt-2">Démarrer un workflow</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model != null && Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Instances", "Workflow", new { page = i, status = ViewBag.Status, clientId = ViewBag.ClientId, declarationId = ViewBag.DeclarationId })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
