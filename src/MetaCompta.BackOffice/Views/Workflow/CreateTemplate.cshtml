@using MetaCompta.Application.DTOs
@model WorkflowTemplateCreateDto
@{
    ViewData["Title"] = ViewBag.TemplateId != null ? "Modifier le modèle" : "Nouveau modèle de workflow";
    var clients = ViewBag.Clients as List<ClientDto> ?? new List<ClientDto>();
    var departments = ViewBag.Departments as List<DepartmentDto> ?? new List<DepartmentDto>();
    var isEdit = ViewBag.TemplateId != null;
    var formAction = isEdit ? "EditTemplate" : "CreateTemplate";
    var stepTypes = new[] { "Initialisation", "DemandePieces", "Collecte", "Saisie", "Controle", "ValidationInterne",
        "ValidationClient", "DepotSoumission", "Paiement", "Rapprochement", "ClotureArchivage" };
    var assignmentTypes = new[] { "Employee", "Role", "Department", "Client", "AutoSystem" };
    var taskTypes = new[] { "Standard", "DocumentRequest", "DataEntry", "Review", "Validation", "Submission", "Archiving",
"ClientAction" };
    var priorities = new[] { "Faible", "Moyenne", "Haute", "Urgente" };
}

<style>
    .ct-header { background: var(--monday-blue); border-radius: 18px; color: #fff; padding: 1.75rem 2.25rem; }
    .ct-glass { background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 16px; box-shadow: var(--monday-shadow); }
    .ct-section-title { font-size: 0.88rem; font-weight: 700; color: var(--monday-text); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
    .ct-step-card { background: var(--monday-surface); border: 1px solid var(--monday-border); border-radius: 14px; overflow: hidden; position: relative; }
    .ct-step-card .step-accent { position: absolute; top: 0; left: 0; width: 4px; height: 100%; border-radius: 4px 0 0 4px; background: var(--monday-blue); }
    .ct-step-header { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; background: var(--monday-bg); border-bottom: 1px solid var(--monday-border); cursor: pointer; }
    .ct-step-num { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.82rem; }
    .ct-step-body { padding: 1rem; }
    .ct-form-label { font-size: 0.78rem; font-weight: 600; color: var(--monday-muted); margin-bottom: 0.3rem; }
    .ct-preview-mini { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; overflow-x: auto; background: var(--monday-bg); border-radius: 10px; }
    .ct-preview-dot { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.55rem; font-weight: 800; color: #fff; flex-shrink: 0; background: var(--monday-blue); }
    .ct-preview-line { width: 20px; height: 2px; background: var(--monday-border); flex-shrink: 0; }
</style>

<!-- HEADER -->
<div class="ct-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3" style="position:relative; z-index:2;">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2" style="font-size:0.8rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")"
                            style="color:rgba(255,255,255,0.7);">Workflow</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Templates")"
                            style="color:rgba(255,255,255,0.7);">Modèles</a></li>
                    <li class="breadcrumb-item text-white">@(isEdit ? "Modifier" : "Nouveau")</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1"><i
                    class="bi @(isEdit ? "bi-pencil-fill" : "bi-plus-circle-fill") me-2"></i>@ViewData["Title"]</h4>
            <p class="mb-0" style="font-size:0.85rem; opacity:0.8;">Définissez les étapes, les assignations et les
                règles du processus</p>
        </div>
        <a asp-action="Templates" class="btn btn-outline-light"
            style="border-radius:10px; font-weight:600; font-size:0.83rem;"><i class="bi bi-arrow-left me-1"></i>
            Retour</a>
    </div>
</div>

<form asp-action="@formAction" method="post" id="templateForm">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" name="id" value="@ViewBag.TemplateId" />
    }

    <!-- GENERAL INFO -->
    <div class="ct-glass p-4 mb-4">
        <div class="ct-section-title"><i class="bi bi-info-circle text-primary"></i> Informations générales</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="ct-form-label">Nom du modèle <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control ct-form-control" placeholder="Ex: Processus TVA standard"
                    required />
            </div>
            <div class="col-md-3">
                <label class="ct-form-label">Type de déclaration</label>
                <select asp-for="DeclarationType" class="form-select ct-form-select" id="declType">
                    <option value="All">Tous types</option>
                    @foreach (var t in new[] { "TVA", "IS", "IR", "CNSS", "DTS", "IR_SALAIRES", "Paie", "Juridique",
                                        "Comptabilite" })
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="ct-form-label">Client spécifique</label>
                <select asp-for="ClientId" class="form-select ct-form-select">
                    <option value="">&#8212; Global (tous clients) &#8212;</option>
                    @foreach (var c in clients)
                    {
                        <option value="@c.Id">@c.RaisonSociale</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="ct-form-label">Description</label>
                <textarea asp-for="Description" class="form-control ct-form-control" rows="2"
                    placeholder="Description du processus..."></textarea>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mt-2 ct-form-check">
                    <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Modèle par défaut</label>
                </div>
            </div>
        </div>
    </div>

    <!-- MINI PREVIEW -->
    <div class="ct-glass px-4 py-3 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="ct-section-title mb-0"><i class="bi bi-eye text-primary"></i> Aperçu du pipeline</div>
            <span class="badge bg-primary bg-opacity-10 text-primary" style="border-radius:20px; font-size:0.72rem;"
                id="stepCountBadge">0 étapes</span>
        </div>
        <div class="ct-preview-mini" id="pipelinePreview">
            <div class="text-muted" style="font-size:0.78rem;">Ajoutez des étapes ci-dessous...</div>
        </div>
    </div>

    <!-- STEPS -->
    <div class="ct-glass p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="ct-section-title mb-0"><i class="bi bi-list-ol text-primary"></i> Étapes du workflow</div>
            <button type="button" class="btn btn-sm btn-primary" style="border-radius:10px; font-weight:600;"
                onclick="addStep()">
                <i class="bi bi-plus-circle me-1"></i> Ajouter une étape
            </button>
        </div>
        <div id="stepsContainer"></div>
        <div id="noSteps" class="text-center py-5" style="border:2px dashed #e2e8f0; border-radius:14px;">
            <i class="bi bi-diagram-3" style="font-size:3rem; color:#cbd5e1;"></i>
            <h6 class="fw-bold mt-2" style="color:#1e293b;">Aucune étape</h6>
            <p class="text-muted mb-3" style="font-size:0.82rem;">Cliquez sur Ajouter pour construire votre workflow</p>
            <button type="button" class="btn btn-primary" style="border-radius:10px;" onclick="addStep()"><i
                    class="bi bi-plus-circle me-1"></i> Première étape</button>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-end">
        <a asp-action="Templates" class="btn btn-outline-secondary"
            style="border-radius:10px; padding:0.5rem 1.5rem; font-weight:600;">Annuler</a>
        @if (isEdit ? (ViewBag.CanWorkflowEdit as bool? ?? false) : (ViewBag.CanWorkflowCreate as bool? ?? false))
        {
            <button type="submit" class="btn btn-primary"
                style="border-radius:10px; padding:0.5rem 1.5rem; font-weight:700;"><i
                    class="bi bi-check-circle-fill me-2"></i>@(isEdit ? "Mettre à jour" : "Créer le modèle")</button>
        }
    </div>
</form>

@section Scripts {
    <script>
        let stepIndex = 0;
        const stepTypesArr = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stepTypes));
        const assignTypesArr = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(assignmentTypes));
        const taskTypesArr = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(taskTypes));
        const prioritiesArr = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(priorities));
        const deptOpts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(departments.Select(d => new { d.Id, d.Name })));
        const roleOpts = ['Gerant', 'Manager', 'Collaborateur', 'Assistant', 'Stagiaire'];
        const colorMap = { 'Initialisation': '#475569', 'DemandePieces': '#2563eb', 'Collecte': '#d97706', 'Saisie': '#0284c7', 'Controle': '#7c3aed', 'ValidationInterne': '#059669', 'ValidationClient': '#d97706', 'DepotSoumission': '#dc2626', 'ClotureArchivage': '#475569' };

        function addStep() {
            document.getElementById('noSteps').classList.add('d-none');
            var c = document.getElementById('stepsContainer');
            var i = stepIndex;
            var h = '<div class="ct-step-card mb-3" data-index="' + i + '" id="step-' + i + '">';
            h += '<div class="step-accent" style="background:#94a3b8;"></div>';
            h += '<div class="ct-step-header" onclick="toggleStep(' + i + ')">';
            h += '<div class="d-flex align-items-center gap-2"><div class="ct-step-num" style="background:#f1f5f9; color:#475569;">' + (i + 1) + '</div><div><div class="fw-bold" style="font-size:0.85rem;">Étape ' + (i + 1) + '</div></div></div>';
            h += '<div class="d-flex align-items-center gap-2"><button type="button" class="btn btn-sm btn-outline-danger" style="border-radius:6px;" onclick="event.stopPropagation(); removeStep(' + i + ')"><i class="bi bi-trash3"></i></button><i class="bi bi-chevron-down" id="chevron-' + i + '"></i></div>';
            h += '</div>';
            h += '<div class="ct-step-body" id="body-' + i + '"><div class="row g-3">';
            h += '<div class="col-md-5"><label class="ct-form-label">Nom *</label><input name="Steps[' + i + '].Name" class="form-control ct-form-control step-name-input" required data-index="' + i + '" oninput="updatePreview()" /></div>';
            h += '<div class="col-md-3"><label class="ct-form-label">Type</label><select name="Steps[' + i + '].StepType" class="form-select ct-form-select step-type-select" data-index="' + i + '" onchange="updatePreview()">' + stepTypesArr.map(function (t) { return '<option value="' + t + '">' + t + '</option>'; }).join('') + '</select></div>';
            h += '<div class="col-md-2"><label class="ct-form-label">Ordre</label><input name="Steps[' + i + '].StepOrder" type="number" class="form-control ct-form-control" value="' + i + '" /></div>';
            h += '<div class="col-md-2"><label class="ct-form-label">SLA (h)</label><input name="Steps[' + i + '].SLAHours" type="number" class="form-control ct-form-control" /></div>';
            h += '<div class="col-12"><label class="ct-form-label">Description</label><input name="Steps[' + i + '].Description" class="form-control ct-form-control" placeholder="Ce qui se passe..." /></div>';

            // Assignment section
            h += '<div class="col-12"><div class="p-3 rounded-3" style="background:#f8fafc; border:1px solid #f1f5f9;"><div class="ct-form-label mb-2"><i class="bi bi-people-fill text-primary me-1"></i> Assignation</div><div class="row g-2">';
            h += '<div class="col-md-3"><select name="Steps[' + i + '].AssignmentType" class="form-select ct-form-select" onchange="toggleAssign(this,' + i + ')">' + assignTypesArr.map(function (a) { return '<option value="' + a + '">' + a + '</option>'; }).join('') + '</select></div>';
            h += '<div class="col-md-3" id="au-' + i + '"><input name="Steps[' + i + '].AssignedToUserId" class="form-control ct-form-control" placeholder="User ID" /></div>';
            h += '<div class="col-md-3" id="ar-' + i + '" style="display:none;"><select name="Steps[' + i + '].AssignedToRoleName" class="form-select ct-form-select"><option value="">--</option>' + roleOpts.map(function (r) { return '<option value="' + r + '">' + r + '</option>'; }).join('') + '</select></div>';
            h += '<div class="col-md-3" id="ad-' + i + '" style="display:none;"><select name="Steps[' + i + '].AssignedToDepartmentId" class="form-select ct-form-select"><option value="">--</option>' + deptOpts.map(function (d) { return '<option value="' + d.Id + '">' + d.Name + '</option>'; }).join('') + '</select></div>';
            h += '<div class="col-md-3"><div class="form-check form-switch ct-form-check mt-1"><input name="Steps[' + i + '].IsClientStep" type="checkbox" class="form-check-input" value="true" /><label class="form-check-label">Client</label></div></div>';
            h += '</div></div></div>';

            // Rules section
            h += '<div class="col-12"><div class="p-3 rounded-3" style="background:#fefbf3; border:1px solid #fef3c7;"><div class="ct-form-label mb-2"><i class="bi bi-sliders text-warning me-1"></i> Règles</div><div class="row g-2">';
            h += '<div class="col-md-2"><div class="form-check form-switch ct-form-check"><input name="Steps[' + i + '].IsRequired" type="checkbox" class="form-check-input" checked value="true" /><label class="form-check-label">Requis</label></div></div>';
            h += '<div class="col-md-2"><div class="form-check form-switch ct-form-check"><input name="Steps[' + i + '].IsBlocking" type="checkbox" class="form-check-input" checked value="true" /><label class="form-check-label">Bloquant</label></div></div>';
            h += '<div class="col-md-2"><div class="form-check form-switch ct-form-check"><input name="Steps[' + i + '].AutoCreateTask" type="checkbox" class="form-check-input" checked value="true" /><label class="form-check-label">Tâche</label></div></div>';
            h += '<div class="col-md-2"><div class="form-check form-switch ct-form-check"><input name="Steps[' + i + '].AutoNotify" type="checkbox" class="form-check-input" checked value="true" /><label class="form-check-label">Notif</label></div></div>';
            h += '<div class="col-md-2"><select name="Steps[' + i + '].TaskType" class="form-select ct-form-select" style="font-size:0.78rem;">' + taskTypesArr.map(function (t) { return '<option>' + t + '</option>'; }).join('') + '</select></div>';
            h += '<div class="col-md-2"><select name="Steps[' + i + '].TaskPriority" class="form-select ct-form-select" style="font-size:0.78rem;">' + prioritiesArr.map(function (p) { return '<option' + (p === 'Moyenne' ? ' selected' : '') + '>' + p + '</option>'; }).join('') + '</select></div>';
            h += '</div></div></div>';

            // Status mapping
            h += '<div class="col-md-6"><label class="ct-form-label">Statut entrée</label><input name="Steps[' + i + '].DeclarationStatusOnEntry" class="form-control ct-form-control" placeholder="Ex: ACompleter" /></div>';
            h += '<div class="col-md-6"><label class="ct-form-label">Statut complétion</label><input name="Steps[' + i + '].DeclarationStatusOnComplete" class="form-control ct-form-control" placeholder="Ex: Validee" /></div>';
            h += '</div></div></div>';
            c.insertAdjacentHTML('beforeend', h);
            stepIndex++;
            updatePreview();
        }

        function removeStep(idx) {
            var el = document.getElementById('step-' + idx);
            if (el) el.remove();
            updatePreview();
            if (!document.querySelectorAll('.ct-step-card').length) document.getElementById('noSteps').classList.remove('d-none');
        }

        function toggleStep(idx) {
            var b = document.getElementById('body-' + idx);
            var ch = document.getElementById('chevron-' + idx);
            if (b) { var vis = b.style.display === 'none'; b.style.display = vis ? '' : 'none'; if (ch) ch.style.transform = vis ? '' : 'rotate(-90deg)'; }
        }

        function toggleAssign(sel, idx) {
            var v = sel.value;
            ['au', 'ar', 'ad'].forEach(function (prefix) {
                var el = document.getElementById(prefix + '-' + idx);
                if (el) el.style.display = 'none';
            });
            if (v === 'Employee') { var e = document.getElementById('au-' + idx); if (e) e.style.display = ''; }
            if (v === 'Role') { var e = document.getElementById('ar-' + idx); if (e) e.style.display = ''; }
            if (v === 'Department') { var e = document.getElementById('ad-' + idx); if (e) e.style.display = ''; }
        }

        function updatePreview() {
            var cards = document.querySelectorAll('.ct-step-card');
            var preview = document.getElementById('pipelinePreview');
            var badge = document.getElementById('stepCountBadge');
            if (!cards.length) { preview.innerHTML = '<div class="text-muted" style="font-size:0.78rem;">Ajoutez des étapes...</div>'; badge.textContent = '0 étapes'; return; }
            badge.textContent = cards.length + ' étape' + (cards.length > 1 ? 's' : '');
            var html = '';
            cards.forEach(function (card, idx) {
                var sel = card.querySelector('.step-type-select');
                var type = sel ? sel.value : 'Initialisation';
                var color = colorMap[type] || '#94a3b8';
                if (idx > 0) html += '<div class="ct-preview-line"></div>';
                html += '<div class="ct-preview-dot" style="background:' + color + ';">' + (idx + 1) + '</div>';
            });
            preview.innerHTML = html;
        }

        updatePreview();
    </script>
}
