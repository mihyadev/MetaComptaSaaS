@{
    ViewData["Title"] = "Notifications";
    var notifications = ViewBag.Notifications as List<MetaCompta.Application.DTOs.NotificationDto> ?? new List<MetaCompta.Application.DTOs.NotificationDto>();
    var unreadCount = notifications.Count(n => !n.IsRead);
    var readCount = notifications.Count(n => n.IsRead);
    var actionCount = notifications.Count(n => !string.IsNullOrEmpty(n.Url));
}

<div class="ex-page-hero">
    <div>
        <h4>Notifications</h4>
        <p class="ex-sub">Alertes, rappels et actions demandées par votre cabinet.</p>
    </div>
    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllAsRead" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-all me-1"></i>Tout marquer comme lu</button>
        </form>
    }
</div>

<div class="ex-kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="ex-kpi danger">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Non lues</div><div class="ex-kpi-value">@unreadCount</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-bell"></i></div>
        </div>
        <div class="ex-kpi-foot">À consulter</div>
    </div>
    <div class="ex-kpi success">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Lues</div><div class="ex-kpi-value">@readCount</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-check-circle"></i></div>
        </div>
        <div class="ex-kpi-foot">Archivées</div>
    </div>
    <div class="ex-kpi">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Avec action</div><div class="ex-kpi-value">@actionCount</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-arrow-up-right-circle"></i></div>
        </div>
        <div class="ex-kpi-foot">Liens utiles</div>
    </div>
</div>

@if (notifications.Any())
{
    <div class="ex-board-card">
        <div class="ex-panel-head">
            <div>
                <h3><i class="bi bi-bell text-primary me-2"></i>Fil d'activité</h3>
                <p>Les plus récentes en premier</p>
            </div>
        </div>
        <div class="ex-activity-list" style="padding: 0.85rem 1.1rem 1.15rem;">
            @foreach (var notif in notifications.OrderByDescending(n => n.CreatedAt))
            {
                var iconClass = notif.Type switch {
                    "Success" => "bi-check-circle-fill text-success",
                    "Warning" => "bi-exclamation-triangle-fill text-warning",
                    "Error" => "bi-x-circle-fill text-danger",
                    _ => "bi-info-circle-fill text-primary"
                };
                <div class="ex-activity-item @(notif.IsRead ? "" : "ex-notif-unread")">
                    <div class="d-flex align-items-start gap-3 flex-grow-1">
                        <div class="ex-kpi-icon" style="width:42px;height:42px;"><i class="bi @iconClass"></i></div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between gap-2 flex-wrap">
                                <div class="fw-semibold">@notif.Titre</div>
                                <div class="ex-activity-meta">@notif.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="ex-activity-meta mb-2">@notif.Message</div>
                            <div class="d-flex gap-2 flex-wrap">
                                @if (!notif.IsRead) { <span class="badge bg-danger rounded-pill">Nouveau</span> }
                                @if (!string.IsNullOrEmpty(notif.Url))
                                {
                                    <a href="@notif.Url" class="btn btn-primary btn-sm"><i class="bi bi-arrow-right me-1"></i>Ouvrir</a>
                                }
                                @if (!notif.IsRead)
                                {
                                    <form asp-action="MarkAsRead" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@notif.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Marquer lu</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="ex-board-card">
        <div class="ex-empty py-5">
            <i class="bi bi-bell-slash"></i>
            <p>Aucune notification pour le moment.</p>
        </div>
    </div>
}
