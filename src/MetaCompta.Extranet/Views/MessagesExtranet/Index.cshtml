@using MetaCompta.Application.DTOs
@{
    ViewData["Title"] = "Messagerie";
    var messages = ViewBag.Messages as List<MessageDto> ?? new List<MessageDto>();
    var clientId = ViewBag.ClientId as int?;
    var openThread = ViewBag.OpenThread as int?;
    var unreadCount = messages.Count(m => !m.IsReadByRecipient && m.SenderRole == "Cabinet");

    var threads = messages
        .GroupBy(m => m.DeclarationId ?? 0)
        .Select(g =>
        {
            var ordered = g.OrderBy(m => m.CreatedAt).ToList();
            var last = ordered.Last();
            return new
            {
                DeclId = g.Key,
                Messages = ordered,
                Last = last,
                Unread = ordered.Count(m => !m.IsReadByRecipient && m.SenderRole == "Cabinet"),
                Count = ordered.Count
            };
        })
        .OrderByDescending(t => t.Unread > 0)
        .ThenByDescending(t => t.Last.CreatedAt)
        .ToList();
}

<div class="wa-shell" id="waShell">
    <aside class="wa-list">
        <header class="wa-list-head">
            <div>
                <h1>Messages</h1>
                <p>@(unreadCount > 0 ? $"{unreadCount} non lu(s)" : "Cabinet ↔ vous")</p>
            </div>
        </header>
        <div class="wa-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="threadSearch" placeholder="Rechercher…" autocomplete="off" />
        </div>
        <div class="wa-threads" role="list">
            @if (!threads.Any())
            {
                <div class="wa-empty-inline">
                    <i class="bi bi-chat-square-dots"></i>
                    <p>Aucune conversation. Ouvrez un dossier pour écrire au cabinet.</p>
                    <a href="/Dossiers" class="btn btn-primary btn-sm rounded-pill">Mes dossiers</a>
                </div>
            }
            @foreach (var t in threads)
            {
                var hasU = t.Unread > 0;
                var sender = t.Last.SenderName ?? "Cabinet";
                var initials = string.Concat(sender.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
                if (string.IsNullOrWhiteSpace(initials)) initials = "C";
                var isCab = t.Last.SenderRole == "Cabinet";
                var timeStr = t.Last.CreatedAt.Date == DateTime.Today ? t.Last.CreatedAt.ToString("HH:mm")
                    : t.Last.CreatedAt.Date == DateTime.Today.AddDays(-1) ? "Hier"
                    : t.Last.CreatedAt.ToString("dd/MM");
                var preview = (t.Last.Contenu ?? "").Replace("\n", " ");
                if (preview.Length > 70) preview = preview.Substring(0, 70) + "…";
                var title = t.DeclId > 0 ? $"Dossier #{t.DeclId}" : "Général";

                <button type="button" class="wa-thread @(hasU ? "unread" : "")" role="listitem"
                        data-thread="@t.DeclId"
                        data-search="@sender.ToLowerInvariant() @title.ToLowerInvariant() @t.DeclId">
                    <span class="wa-avatar @(isCab ? "cab" : "me")">@initials</span>
                    <span class="wa-thread-body">
                        <span class="wa-thread-row">
                            <strong>@title</strong>
                            <time>@timeStr</time>
                        </span>
                        <span class="wa-thread-row sub">
                            <span class="wa-preview">@(isCab ? "" : "Vous : ")@preview</span>
                            @if (hasU) { <span class="wa-unread">@t.Unread</span> }
                        </span>
                    </span>
                </button>
            }
        </div>
    </aside>

    <section class="wa-chat">
        <div class="wa-chat-empty" id="chatEmpty">
            <div>
                <i class="bi bi-chat-heart"></i>
                <h2>Conversation</h2>
                <p>Choisissez un fil à gauche pour lire et répondre au cabinet.</p>
            </div>
        </div>

        @foreach (var t in threads)
        {
            var title = t.DeclId > 0 ? $"Dossier #{t.DeclId}" : "Conversation générale";
            <div class="wa-room chat-panel d-none" data-panel="@t.DeclId">
                <header class="wa-room-head">
                    <div class="wa-room-title">
                        <span class="wa-avatar cab sm">CA</span>
                        <div>
                            <strong>@title</strong>
                            <span>@t.Count message(s) · Cabinet</span>
                        </div>
                    </div>
                    @if (t.DeclId > 0)
                    {
                        <a class="wa-link" href="/Declarations/Details/@t.DeclId"><i class="bi bi-folder2-open"></i> Ouvrir</a>
                    }
                </header>

                <div class="wa-log" role="log" aria-live="polite">
                    <ol class="wa-messages">
                    @{
                        DateTime? prevDate = null;
                        string? prevSender = null;
                    }
                    @foreach (var msg in t.Messages)
                    {
                        var isMe = string.Equals(msg.SenderRole, "Client", StringComparison.OrdinalIgnoreCase);
                        var sameSender = prevSender != null && string.Equals(prevSender, msg.SenderId + "|" + msg.SenderRole, StringComparison.Ordinal);
                        if (prevDate == null || msg.CreatedAt.Date != prevDate)
                        {
                            prevDate = msg.CreatedAt.Date;
                            sameSender = false;
                            var lbl = msg.CreatedAt.Date == DateTime.Today ? "Aujourd'hui"
                                : msg.CreatedAt.Date == DateTime.Today.AddDays(-1) ? "Hier"
                                : msg.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"));
                            <li class="wa-day" aria-hidden="true"><span>@lbl</span></li>
                        }

                        var av = string.Concat((msg.SenderName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
                        if (string.IsNullOrWhiteSpace(av)) av = isMe ? "V" : "C";

                        <li class="wa-msg @(isMe ? "own" : "peer") @(sameSender ? "grouped" : "")">
                            @if (!isMe)
                            {
                                <span class="wa-avatar cab sm @(sameSender ? "ghost" : "")">@av</span>
                            }
                            <article class="wa-bubble">
                                @if (!isMe && !sameSender)
                                {
                                    <header class="wa-bubble-meta">@msg.SenderName</header>
                                }
                                @if (!string.IsNullOrWhiteSpace(msg.Sujet))
                                {
                                    <div class="wa-subject">@msg.Sujet</div>
                                }
                                <p class="wa-text">@msg.Contenu</p>
                                <footer class="wa-meta">
                                    <time datetime="@msg.CreatedAt.ToString("o")">@msg.CreatedAt.ToString("HH:mm")</time>
                                    @if (isMe)
                                    {
                                        <i class="bi @(msg.IsReadByRecipient ? "bi-check2-all" : "bi-check2")" title="@(msg.IsReadByRecipient ? "Lu" : "Envoyé")"></i>
                                    }
                                    else if (!msg.IsReadByRecipient)
                                    {
                                        <span class="wa-new">Nouveau</span>
                                    }
                                </footer>
                            </article>
                        </li>
                        prevSender = msg.SenderId + "|" + msg.SenderRole;
                    }
                    </ol>
                </div>

                <footer class="wa-composer">
                    @if (t.DeclId > 0)
                    {
                        <form asp-controller="MessagesExtranet" asp-action="SendMessage" method="post" class="wa-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="declarationId" value="@t.DeclId" />
                            @if (clientId.HasValue)
                            {
                                <input type="hidden" name="clientId" value="@clientId.Value" />
                            }
                            <input type="text" name="sujet" class="wa-sujet" placeholder="Objet (optionnel)" maxlength="120" />
                            <div class="wa-compose-row">
                                <textarea name="contenu" rows="1" placeholder="Écrire un message…" required maxlength="4000"></textarea>
                                <button type="submit" class="wa-send" aria-label="Envoyer"><i class="bi bi-send-fill"></i></button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="wa-compose-hint">
                            Reliez votre message à un dossier pour répondre.
                            <a href="/Dossiers">Voir mes dossiers</a>
                        </div>
                    }
                </footer>
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
(function () {
    var threads = document.querySelectorAll('.wa-thread');
    var panels = document.querySelectorAll('.chat-panel');
    var empty = document.getElementById('chatEmpty');
    var search = document.getElementById('threadSearch');
    var prefer = @(openThread.HasValue ? openThread.Value.ToString() : "null");

    function scrollLog(panel) {
        var log = panel && panel.querySelector('.wa-log');
        if (log) log.scrollTop = log.scrollHeight;
    }

    function openThread(el) {
        if (!el) return;
        var id = el.getAttribute('data-thread');
        threads.forEach(function (t) { t.classList.remove('active'); });
        el.classList.add('active');
        el.classList.remove('unread');
        var badge = el.querySelector('.wa-unread');
        if (badge) badge.remove();
        if (empty) empty.classList.add('d-none');
        panels.forEach(function (p) {
            var match = p.getAttribute('data-panel') === id;
            p.classList.toggle('d-none', !match);
            if (match) {
                scrollLog(p);
                var ta = p.querySelector('textarea');
                if (ta) setTimeout(function () { ta.focus(); }, 50);
            }
        });
        if (history.replaceState) {
            var url = new URL(window.location.href);
            url.searchParams.set('thread', id);
            history.replaceState({}, '', url);
        }
    }

    threads.forEach(function (t) {
        t.addEventListener('click', function () { openThread(t); });
    });

    var preferred = prefer != null
        ? Array.prototype.find.call(threads, function (t) { return t.getAttribute('data-thread') === String(prefer); })
        : null;
    var firstUnread = Array.prototype.find.call(threads, function (t) { return t.classList.contains('unread'); });
    openThread(preferred || firstUnread || threads[0]);

    if (search) {
        search.addEventListener('input', function () {
            var q = (search.value || '').toLowerCase().trim();
            threads.forEach(function (t) {
                var hay = (t.getAttribute('data-search') || '');
                t.style.display = (!q || hay.indexOf(q) !== -1) ? '' : 'none';
            });
        });
    }

    document.querySelectorAll('.wa-form textarea').forEach(function (ta) {
        ta.addEventListener('input', function () {
            ta.style.height = 'auto';
            ta.style.height = Math.min(140, ta.scrollHeight) + 'px';
        });
        ta.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                ta.form && ta.form.requestSubmit();
            }
        });
    });
})();
</script>
}
