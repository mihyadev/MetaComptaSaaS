@model MetaCompta.Application.DTOs.ClientDto
@{
    ViewData["Title"] = "Mon entreprise";
    var initials = string.Concat((Model.RaisonSociale ?? "MC").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
}

<div class="ex-page-hero">
    <div>
        <h4>Mon entreprise</h4>
        <p class="ex-sub">Identifiants fiscaux, contacts et services fiduciaires.</p>
    </div>
    <a href="/MessagesExtranet" class="btn btn-primary btn-sm d-none d-md-inline-flex align-items-center gap-1"><i class="bi bi-chat-dots"></i>Contacter le cabinet</a>
</div>

<div class="ex-company-banner">
    <div class="ex-co-mark">@initials</div>
    <div class="flex-grow-1">
        <h3 class="mb-1 fw-bold" style="font-size:1.35rem; letter-spacing:-0.02em;">@Model.RaisonSociale</h3>
        <div class="ex-meta-row">
            @if (!string.IsNullOrEmpty(Model.FormeJuridique)) { <span><i class="bi bi-briefcase"></i>@Model.FormeJuridique</span> }
            @if (!string.IsNullOrEmpty(Model.SecteurActivite)) { <span><i class="bi bi-tag"></i>@Model.SecteurActivite</span> }
            @if (!string.IsNullOrEmpty(Model.ICE)) { <span><i class="bi bi-upc"></i>ICE @Model.ICE</span> }
            <span class="badge @(Model.Statut == "Active" ? "bg-success" : "bg-secondary") rounded-pill">@Model.Statut</span>
        </div>
    </div>
</div>

<div class="ex-kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="ex-kpi">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Employés</div><div class="ex-kpi-value">@Model.EmployeeCount</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-people"></i></div>
        </div>
        <div class="ex-kpi-foot">Actifs</div>
    </div>
    <div class="ex-kpi purple">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Déclarations</div><div class="ex-kpi-value">@Model.DeclarationCount</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-file-earmark-text"></i></div>
        </div>
        <div class="ex-kpi-foot">Historique</div>
    </div>
    <div class="ex-kpi success">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Services</div><div class="ex-kpi-value">@(Model.ServicesFiduciaires?.Count(s => s.EstActifAujourdhui) ?? 0)</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-clipboard-check"></i></div>
        </div>
        <div class="ex-kpi-foot">Actifs aujourd'hui</div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="ex-board-card h-100">
            <div class="ex-panel-head"><div><h3><i class="bi bi-hash text-primary me-2"></i>Identifiants fiscaux</h3><p>Références légales</p></div></div>
            <div class="ex-panel-body">
                <div class="ex-info-grid">
                    <div class="ex-info-item"><div class="ex-info-label">ICE</div><div class="ex-info-value">@(Model.ICE ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Identifiant fiscal</div><div class="ex-info-value">@(Model.IF ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Registre commerce</div><div class="ex-info-value">@(Model.RC ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">CNSS</div><div class="ex-info-value">@(Model.NumeroCNSS ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Patente</div><div class="ex-info-value">@(Model.NumeroPatente ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Code activité</div><div class="ex-info-value">@(Model.CodeActivite ?? "-")</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="ex-board-card h-100">
            <div class="ex-panel-head"><div><h3><i class="bi bi-info-circle text-primary me-2"></i>Informations générales</h3><p>Structure &amp; fiscalité</p></div></div>
            <div class="ex-panel-body">
                <div class="ex-info-grid">
                    <div class="ex-info-item"><div class="ex-info-label">Forme juridique</div><div class="ex-info-value">@(Model.FormeJuridique ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Secteur</div><div class="ex-info-value">@(Model.SecteurActivite ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Capital social</div><div class="ex-info-value">@(Model.CapitalSocial?.ToString("N2") ?? "-") MAD</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Date création</div><div class="ex-info-value">@(Model.DateCreation?.ToString("dd/MM/yyyy") ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Type TVA</div><div class="ex-info-value">@Model.TypeTVA</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Mois clôture</div><div class="ex-info-value">@(new DateTime(2000, Model.MoisClotureExercice, 1).ToString("MMMM", new System.Globalization.CultureInfo("fr-FR")))</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="ex-board-card h-100">
            <div class="ex-panel-head"><div><h3><i class="bi bi-geo-alt text-danger me-2"></i>Coordonnées</h3><p>Siège social</p></div></div>
            <div class="ex-panel-body">
                <div class="ex-info-grid">
                    <div class="ex-info-item" style="grid-column: 1 / -1;"><div class="ex-info-label">Adresse</div><div class="ex-info-value">@(Model.AdresseSiegeSocial ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Ville</div><div class="ex-info-value">@(Model.VilleSiegeSocial ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Téléphone</div><div class="ex-info-value">@(Model.TelephonePrincipal ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Email</div><div class="ex-info-value">@(Model.EmailPrincipal ?? "-")</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="ex-board-card h-100">
            <div class="ex-panel-head"><div><h3><i class="bi bi-person-badge text-success me-2"></i>Contact principal</h3><p>Interlocuteur entreprise</p></div></div>
            <div class="ex-panel-body">
                <div class="ex-info-grid">
                    <div class="ex-info-item"><div class="ex-info-label">Nom</div><div class="ex-info-value">@(Model.ContactNom ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Fonction</div><div class="ex-info-value">@(Model.ContactFonction ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Téléphone</div><div class="ex-info-value">@(Model.ContactTelephone ?? "-")</div></div>
                    <div class="ex-info-item"><div class="ex-info-label">Email</div><div class="ex-info-value">@(Model.ContactEmail ?? "-")</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ManagerPrincipalName))
{
    <div class="ex-board-card mb-3">
        <div class="ex-panel-body">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="ex-kpi-icon" style="width:52px;height:52px;font-size:1.35rem;"><i class="bi bi-person-fill"></i></div>
                <div class="flex-grow-1">
                    <div class="fw-bold">@Model.ManagerPrincipalName</div>
                    <div class="small text-muted">Responsable de votre dossier</div>
                </div>
                <a href="/MessagesExtranet" class="btn btn-primary btn-sm"><i class="bi bi-chat-dots me-1"></i>Contacter</a>
            </div>
        </div>
    </div>
}

@if (Model.ServicesFiduciaires != null && Model.ServicesFiduciaires.Any())
{
    <div class="ex-board-card">
        <div class="ex-panel-head"><div><h3><i class="bi bi-clipboard-check text-warning me-2"></i>Services fiduciaires</h3><p>Périmètre contractuel</p></div></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 ex-table">
                <thead><tr><th>Service</th><th>Catégorie</th><th>Fréquence</th><th>Statut</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.ServicesFiduciaires)
                    {
                        <tr>
                            <td class="fw-semibold">@s.LibelleService</td>
                            <td><span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@s.Categorie</span></td>
                            <td>@s.Frequence</td>
                            <td><span class="badge @(s.EstActifAujourdhui ? "bg-success" : "bg-secondary") rounded-pill">@(s.EstActifAujourdhui ? "Actif" : "Inactif")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
