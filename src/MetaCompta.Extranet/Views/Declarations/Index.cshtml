@model List<MetaCompta.Application.DTOs.DeclarationDto>
@using MetaCompta.Application.DTOs
@{
    ViewData["Title"] = "Mes Déclarations";
    var declarations = Model ?? new List<DeclarationDto>();
    var closedStatuses = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        { "Soumise", "Validee", "Payee", "Payée", "Cloturee", "Clôturée", "Archivee", "Archivée", "Rapprochee", "Rapprochée" };
    var enCours = declarations.Count(d => !closedStatuses.Contains(d.Statut));
    var soumises = declarations.Count(d => closedStatuses.Contains(d.Statut));
    var urgentes = declarations.Count(d => d.DaysUntilDeadline <= 7 && !closedStatuses.Contains(d.Statut));
    var totalMontant = declarations.Where(d => d.MontantDu.HasValue).Sum(d => d.MontantDu!.Value);
}

<div class="ex-page-hero">
    <div>
        <h4>Mes déclarations</h4>
        <p class="ex-sub">Suivi du statut, de l'avancement workflow et des échéances.</p>
    </div>
    <a href="/Tasks" class="btn btn-primary btn-sm"><i class="bi bi-list-task me-1"></i>Mes tâches</a>
</div>

<div class="ex-kpi-grid">
    <div class="ex-kpi">
        <div><div class="ex-kpi-label">En cours</div><div class="ex-kpi-value">@enCours</div></div>
        <div class="ex-kpi-icon"><i class="bi bi-hourglass-split"></i></div>
    </div>
    <div class="ex-kpi success">
        <div><div class="ex-kpi-label">Clôturées / payées</div><div class="ex-kpi-value">@soumises</div></div>
        <div class="ex-kpi-icon"><i class="bi bi-check-circle"></i></div>
    </div>
    <div class="ex-kpi danger">
        <div><div class="ex-kpi-label">Urgentes</div><div class="ex-kpi-value">@urgentes</div></div>
        <div class="ex-kpi-icon"><i class="bi bi-exclamation-triangle"></i></div>
    </div>
    <div class="ex-kpi warning">
        <div><div class="ex-kpi-label">Montant total</div><div class="ex-kpi-value" style="font-size:1.35rem;">@totalMontant.ToString("N0") <small class="fw-600 fs-6">MAD</small></div></div>
        <div class="ex-kpi-icon"><i class="bi bi-cash-coin"></i></div>
    </div>
</div>

<ul class="nav nav-pills gap-2 mb-4" id="filterTabs">
    <li class="nav-item"><button class="nav-link active rounded-pill px-3 py-1 small filter-btn" data-filter="all">Toutes (@declarations.Count)</button></li>
    <li class="nav-item"><button class="nav-link rounded-pill px-3 py-1 small filter-btn" data-filter="encours">En cours (@enCours)</button></li>
    <li class="nav-item"><button class="nav-link rounded-pill px-3 py-1 small filter-btn" data-filter="soumise">Clôturées (@soumises)</button></li>
    <li class="nav-item"><button class="nav-link rounded-pill px-3 py-1 small filter-btn" data-filter="urgente">Urgentes (@urgentes)</button></li>
</ul>

<div id="declarationList">
@foreach (var d in declarations.OrderBy(x => x.DateLimite))
{
    var isClosed = closedStatuses.Contains(d.Statut);
    var statusClass = d.Statut switch
    {
        "Soumise" or "Validee" or "Payee" or "Payée" or "Cloturee" or "Clôturée" or "Archivee" or "Archivée" or "Rapprochee" or "Rapprochée" => "success",
        "EnCours" or "EnPreparation" or "EnRevision" => "info",
        "EnAttenteValidation" or "APayer" => "warning",
        "Refusee" or "Rejetee" => "danger",
        _ => "secondary"
    };
    var statusLabel = d.Statut switch
    {
        "Brouillon" => "Brouillon", "EnCours" => "En cours", "EnPreparation" => "En préparation",
        "EnRevision" => "En révision", "EnAttenteValidation" => "Validation", "Validee" => "Validée",
        "Soumise" => "Soumise", "Payee" or "Payée" => "Payée", "Cloturee" or "Clôturée" => "Clôturée",
        "Archivee" or "Archivée" => "Archivée", "Rapprochee" or "Rapprochée" => "Rapprochée",
        "APayer" => "À payer", "Rejetee" or "Refusee" => "Rejetée", _ => d.Statut
    };
    var typeIcon = d.Type switch { "TVA" => "bi-percent", "IS" => "bi-bank", "IR" => "bi-person-badge", "CNSS" => "bi-shield-check", "DTS" => "bi-file-earmark-person", _ => "bi-file-earmark-text" };
    var isOverdue = d.DaysUntilDeadline <= 0 && !isClosed;
    var isUrgent = d.DaysUntilDeadline <= 7 && !isOverdue && !isClosed;
    var filterGroup = isClosed ? "soumise" : "encours";
    var urgentAttr = isUrgent || isOverdue ? "urgente" : "";
    var accent = isOverdue ? "accent-danger" : isUrgent ? "accent-warning" : isClosed ? "accent-success" : "accent-info";

    <div class="ex-board-card @accent declaration-card" data-group="@filterGroup" data-urgent="@urgentAttr">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="ex-kpi-icon text-@statusClass" style="background:rgba(var(--bs-@(statusClass == "info" ? "info" : statusClass)-rgb),0.12);">
                <i class="bi @typeIcon"></i>
            </div>
            <div class="flex-grow-1" style="min-width:220px;">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h6 class="fw-bold mb-0">@d.Type — @d.Periode</h6>
                    <span class="badge bg-@statusClass rounded-pill">@statusLabel</span>
                    @if (isOverdue) { <span class="badge bg-danger rounded-pill">@(Math.Abs(d.DaysUntilDeadline))j retard</span> }
                    else if (isUrgent) { <span class="badge bg-warning text-dark rounded-pill">@(d.DaysUntilDeadline)j</span> }
                    @if (isClosed) { <span class="ex-status-pill bg-success-subtle text-success-emphasis"><i class="bi bi-lock-fill"></i>Clôturée</span> }
                </div>
                <div class="ex-meta-row">
                    <span><i class="bi bi-calendar3"></i>Échéance @d.DateLimite.ToString("dd/MM/yyyy")</span>
                    @if (d.MontantDu.HasValue) { <span><i class="bi bi-cash-coin"></i>@d.MontantDu.Value.ToString("N2") MAD</span> }
                    @if (!string.IsNullOrEmpty(d.CurrentStepName))
                    {
                        <span><i class="bi bi-diagram-3"></i>@(d.WorkflowStatus == "Active" ? "Étape" : "WF") : @d.CurrentStepName</span>
                    }
                </div>
                @if (d.TotalSteps > 0)
                {
                    <div class="ex-progress">
                        <div class="ex-progress-meta">
                            <span>Avancement</span>
                            <span>@d.CompletedSteps / @d.TotalSteps (@d.ProgressPercent.ToString("0.#")%)</span>
                        </div>
                        <div class="progress"><div class="progress-bar" style="width:@(d.ProgressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                    </div>
                }
            </div>
            <a href="/Declarations/Details/@d.Id" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-eye me-1"></i>Détails</a>
        </div>
    </div>
}
</div>

@if (!declarations.Any())
{
    <div class="ex-board-card text-center py-5">
        <i class="bi bi-file-earmark-x text-muted" style="font-size:3rem;"></i>
        <h5 class="mt-3 fw-semibold text-muted">Aucune déclaration</h5>
        <p class="mb-0 small text-muted">Vos déclarations apparaîtront ici une fois créées par votre cabinet.</p>
    </div>
}

@section Scripts {
<script>
$(function(){
    $('.filter-btn').on('click', function(){
        $('.filter-btn').removeClass('active');
        $(this).addClass('active');
        var f = $(this).data('filter');
        if (f === 'all') { $('.declaration-card').show(); }
        else if (f === 'urgente') { $('.declaration-card').hide(); $('.declaration-card[data-urgent="urgente"]').show(); }
        else { $('.declaration-card').hide(); $('.declaration-card[data-group="'+f+'"]').show(); }
    });
});
</script>
}
