@model MetaCompta.Application.DTOs.DeclarationDto
@using MetaCompta.Application.DTOs
@{
    ViewData["Title"] = $"Déclaration {Model.Type} — {Model.Periode}";
    var documents = ViewBag.Documents as List<DocumentDto> ?? new List<DocumentDto>();
    var messages = ViewBag.Messages as List<MessageDto> ?? new List<MessageDto>();
    var wfInstance = ViewBag.WorkflowInstance as WorkflowInstanceDto;
    var currentStep = ViewBag.CurrentStep as WorkflowStepInstanceDto;
    var isClientStep = currentStep != null && (
        currentStep.AssignmentType == "Client"
        || currentStep.IsClientStep
        || currentStep.Status == "WaitingForClient");
    var clientName = Context.Session.GetString("ClientName") ?? Model.ClientName ?? "—";
    var tvaData = ViewBag.TVAData as DeclarationTVADto;
    var isData = ViewBag.ISData as DeclarationISDto;
    var irData = ViewBag.IRData as DeclarationIRDto;
    var cnssData = ViewBag.CNSSData as DeclarationCNSSDto;
    var cnssRoster = ViewBag.CnssRoster as CnssEmployeeRosterDto;
    // Fallback: parse snapshot JSON if live roster endpoint empty but calculate was saved
    if (cnssRoster == null && !string.IsNullOrWhiteSpace(cnssData?.DetailEmployesJson))
    {
        try
        {
            var lines = System.Text.Json.JsonSerializer.Deserialize<List<CnssEmployeeLineDto>>(cnssData.DetailEmployesJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            cnssRoster = new CnssEmployeeRosterDto
            {
                DeclarationId = Model.Id,
                ClientId = Model.ClientId,
                ClientName = Model.ClientName,
                PresentCount = lines.Count,
                EntrantCount = lines.Count(l => l.IsEntrant),
                SortantCount = lines.Count(l => l.IsSortant),
                Employees = lines
            };
        }
        catch { /* ignore bad json */ }
    }

    var typeIcon = Model.Type switch {
        "TVA" => "bi-percent", "IS" => "bi-bank", "IR" => "bi-person-badge",
        "CNSS" => "bi-shield-check", "AMO" => "bi-heart-pulse", "DTS" => "bi-file-earmark-person", _ => "bi-file-earmark-text"
    };
    var statutColor = Model.Statut switch {
        "Soumise" or "Validee" or "Payee" => "success",
        "EnCours" or "EnRevision" or "EnPreparation" => "info",
        "EnAttenteValidation" => "warning",
        "Refusee" or "Rejetee" => "danger", _ => "secondary"
    };
    var statutLabel = Model.Statut switch {
        "Brouillon" => "Brouillon", "EnCours" => "En cours",
        "EnPreparation" => "En préparation", "EnRevision" => "En révision",
        "EnAttenteValidation" => "Validation requise", "Validee" => "Validée",
        "Soumise" => "Soumise", "Payee" => "Payée",
        "Rejetee" or "Refusee" => "Rejetée", _ => Model.Statut
    };
    var isOverdue = Model.DaysUntilDeadline <= 0 && Model.Statut != "Soumise" && Model.Statut != "Validee" && Model.Statut != "Payee";
    var isUrgent = Model.DaysUntilDeadline <= 7 && !isOverdue && Model.Statut != "Soumise" && Model.Statut != "Validee" && Model.Statut != "Payee";
    var isDone = Model.Statut == "Soumise" || Model.Statut == "Validee" || Model.Statut == "Payee";

    decimal montantAPayer = Model.MontantDu ?? 0;
    if (tvaData != null) montantAPayer = tvaData.TVAaPayer;
    else if (isData != null) montantAPayer = isData.ISAPayer;
    else if (irData != null) montantAPayer = irData.IRNet;
    else if (cnssData != null) montantAPayer = cnssData.MontantTotal;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <a href="/Declarations" class="btn btn-sm btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
    <div class="small text-muted">@clientName</div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary text-white flex-shrink-0" style="width:50px;height:50px;">
                <i class="bi @typeIcon fs-4"></i>
            </div>
            <div>
                <h4 class="mb-0">@Model.Type — @Model.Periode</h4>
                <span class="badge bg-@statutColor rounded-pill">@statutLabel</span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card border shadow-none bg-body-tertiary">
                    <div class="card-body p-3">
                        <div class="small text-muted text-uppercase fw-semibold mb-1">Montant à payer</div>
                        <div class="fs-4 fw-bold text-primary">@montantAPayer.ToString("N2")</div>
                        <div class="small text-muted">MAD</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border shadow-none bg-body-tertiary">
                    <div class="card-body p-3">
                        <div class="small text-muted text-uppercase fw-semibold mb-1">Date limite</div>
                        <div class="fs-5 fw-bold @(isOverdue ? "text-danger" : isUrgent ? "text-warning" : "")">@Model.DateLimite.ToString("dd/MM/yyyy")</div>
                        @if (isOverdue) { <div class="small text-danger">@(Math.Abs(Model.DaysUntilDeadline)) jours de retard</div> }
                        else if (isDone) { <div class="small text-success">Terminée</div> }
                        else { <div class="small text-muted">@Model.DaysUntilDeadline jours restants</div> }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border shadow-none bg-body-tertiary">
                    <div class="card-body p-3">
                        <div class="small text-muted text-uppercase fw-semibold mb-1">Votre comptable</div>
                        <div class="fw-bold">@(Model.AssistantName ?? "Non assigné")</div>
                        @if (Model.MontantCredit.HasValue && Model.MontantCredit > 0)
                        {
                            <div class="small mt-2 text-success">Crédit disponible: @Model.MontantCredit.Value.ToString("N2") MAD</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isClientStep)
{
    var isCollecteStep = currentStep!.StepType == "Collecte" || currentStep.StepType == "DemandePieces";
    var isApprovalStep = currentStep.StepType == "ValidationClient";

    <div class="card shadow-sm mb-4 border-start border-warning border-4">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-2"><i class="bi bi-bell text-warning me-1"></i>Action demandée</h6>
            <p class="small mb-3 text-muted">@currentStep.StepName @if (!string.IsNullOrEmpty(currentStep.Notes)) { <span>— @currentStep.Notes</span> }</p>

            @if (isCollecteStep)
            {
                <div class="d-flex flex-wrap gap-2">
                    <a href="#uploadFormClient" class="btn btn-primary btn-sm" onclick="document.getElementById('uploadFormClient').classList.add('show');">
                        <i class="bi bi-cloud-upload me-1"></i>Déposer les documents
                    </a>
                    <form asp-controller="Declarations" asp-action="ApproveStep" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="declarationId" value="@Model.Id" />
                        <input type="hidden" name="workflowInstanceId" value="@wfInstance!.Id" />
                        <input type="hidden" name="notes" value="Documents déposés par le client" />
                        <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('Confirmer que vous avez déposé tous les documents requis ?');">
                            <i class="bi bi-check-circle me-1"></i>J'ai terminé
                        </button>
                    </form>
                </div>
            }
            else if (isApprovalStep)
            {
                <form asp-controller="Declarations" asp-action="ApproveStep" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="declarationId" value="@Model.Id" />
                    <input type="hidden" name="workflowInstanceId" value="@wfInstance!.Id" />
                    <div class="mb-2">
                        <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Commentaire (optionnel)" style="max-width:500px;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm" onclick="return confirm('Confirmer l\'approbation ?');">
                        <i class="bi bi-check-circle me-1"></i>Approuver
                    </button>
                </form>
            }
        </div>
    </div>
}

@if (wfInstance != null)
{
    var totalSteps = wfInstance.TotalSteps > 0 ? wfInstance.TotalSteps : (wfInstance.StepInstances?.Count ?? 0);
    var completedSteps = wfInstance.CompletedSteps;
    var progress = totalSteps > 0 ? (int)Math.Round(completedSteps * 100.0 / totalSteps) : (int)Math.Round(wfInstance.ProgressPercent);
    var steps = wfInstance.StepInstances?.OrderBy(s => s.StepOrder).ToList() ?? new List<WorkflowStepInstanceDto>();
    var isWfDone = string.Equals(wfInstance.Status, "Completed", StringComparison.OrdinalIgnoreCase);
    var holderLabel = isClientStep ? "À votre charge" : "Cabinet en cours";

    <div class="ex-board-card accent-info mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <div>
                <span class="fw-bold">Avancement du dossier</span>
                <span class="ex-status-pill ms-2 @(isClientStep ? "bg-warning-subtle text-warning-emphasis" : "bg-primary-subtle text-primary-emphasis")">@holderLabel</span>
                @if (isDone || isWfDone)
                {
                    <span class="ex-status-pill ms-1 bg-success-subtle text-success-emphasis"><i class="bi bi-lock-fill"></i> Déclaration @statutLabel</span>
                }
            </div>
            <span class="small text-primary fw-semibold">@completedSteps / @totalSteps étapes (@progress%)</span>
        </div>
        <div class="ex-progress mb-3">
            <div class="progress" style="height:8px;"><div class="progress-bar" style="width:@(progress)%"></div></div>
        </div>
        @if (steps.Any())
        {
            <ul class="ex-timeline">
            @foreach (var s in steps)
            {
                var cls = s.Status is "Completed" or "Skipped" ? "done"
                    : (s.StepOrder == wfInstance.CurrentStepOrder || s.Status is "InProgress" or "WaitingForClient" or "WaitingForValidation") ? "current"
                    : "upcoming";
                var stLabel = s.Status switch
                {
                    "Completed" => "Terminée",
                    "Skipped" => "Ignorée",
                    "WaitingForClient" => "Action client",
                    "InProgress" => "En cours",
                    "WaitingForValidation" => "Validation",
                    "Pending" => "À venir",
                    _ => s.Status
                };
                <li class="@cls">
                    <div class="dot">@(cls == "done" ? "✓" : s.StepOrder.ToString())</div>
                    <div>
                        <div class="step-title">@s.StepName</div>
                        <div class="step-meta">@stLabel@(s.IsClientStep || s.AssignmentType == "Client" ? " · Client" : " · Cabinet")</div>
                    </div>
                </li>
            }
            </ul>
        }
    </div>
}
else if (isDone)
{
    <div class="ex-board-card accent-success mb-4">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-lock-fill text-success"></i>
            <div>
                <div class="fw-bold">Déclaration @statutLabel</div>
                <div class="small text-muted">Dossier clos côté client — aucune action requise.</div>
            </div>
        </div>
    </div>
}

@* ── CNSS personnel detail (client employees) ── *@
@if (string.Equals(Model.Type, "CNSS", StringComparison.OrdinalIgnoreCase) || string.Equals(Model.Type, "AMO", StringComparison.OrdinalIgnoreCase))
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-3 px-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div>
                    <h6 class="fw-bold mb-0"><i class="bi bi-people-fill text-success me-2"></i>État du personnel — @Model.Periode</h6>
                    <small class="text-muted">Salariés de votre entreprise déclarés à la CNSS pour cette période</small>
                </div>
                @if (cnssData != null)
                {
                    <div class="text-end small">
                        <div class="fw-semibold">@cnssData.NombreEmployes salarié(s)</div>
                        <div class="text-muted">Total cotisations : <strong class="text-primary">@cnssData.MontantTotal.ToString("N2") MAD</strong></div>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 flex-wrap mt-3">
                <span class="badge rounded-pill text-bg-primary px-3 py-2">Présents : @(cnssRoster?.PresentCount ?? cnssData?.NombreEmployes ?? 0)</span>
                <span class="badge rounded-pill text-bg-success px-3 py-2">Entrants : @(cnssRoster?.EntrantCount ?? 0)</span>
                <span class="badge rounded-pill text-bg-danger px-3 py-2">Sortants : @(cnssRoster?.SortantCount ?? 0)</span>
            </div>
        </div>
        <div class="card-body px-4 pb-4 pt-2">
            @if (cnssData != null)
            {
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="rounded-3 border p-2 h-100">
                            <div class="text-muted small text-uppercase">Salaires bruts</div>
                            <div class="fw-bold">@cnssData.TotalSalairesBruts.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="rounded-3 border p-2 h-100">
                            <div class="text-muted small text-uppercase">Cot. salariales</div>
                            <div class="fw-bold">@cnssData.TotalCotisationSalariale.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="rounded-3 border p-2 h-100">
                            <div class="text-muted small text-uppercase">Cot. patronales</div>
                            <div class="fw-bold">@cnssData.TotalCotisationPatronale.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="rounded-3 border p-2 h-100">
                            <div class="text-muted small text-uppercase">AMO + FP</div>
                            <div class="fw-bold">@((cnssData.TotalAMOSalariale + cnssData.TotalAMOPatronale + cnssData.TotalFormationProfessionnelle).ToString("N2"))</div>
                        </div>
                    </div>
                </div>
            }

            <div class="cnss-emp-scroll">
                <table class="table table-hover cnss-emp-table">
                    <colgroup>
                        <col class="cnss-col-mov" />
                        <col class="cnss-col-emp" />
                        <col class="cnss-col-dates" />
                        <col class="cnss-col-jours" />
                        <col class="cnss-col-salary" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Mvt</th>
                            <th>Salarié</th>
                            <th>Dates</th>
                            <th class="text-center">Jours</th>
                            <th class="text-end">Salaire</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (cnssRoster?.Employees == null || cnssRoster.Employees.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Aucun détail salarié disponible pour le moment. Votre cabinet complète l’état du personnel lors de la saisie CNSS.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in cnssRoster.Employees)
                        {
                            var badge = e.IsEntrant && e.IsSortant ? "text-bg-warning"
                                : e.IsEntrant ? "text-bg-success"
                                : e.IsSortant ? "text-bg-danger"
                                : "text-bg-primary";
                            var mvtShort = e.IsEntrant && e.IsSortant ? "E+S"
                                : e.IsEntrant ? "E"
                                : e.IsSortant ? "S"
                                : "P";
                            <tr title="@e.Movement — @e.Prenom @e.Nom">
                                <td><span class="badge @badge" title="@e.Movement">@mvtShort</span></td>
                                <td>
                                    <div class="cnss-emp-name">@e.Prenom @e.Nom</div>
                                    <div class="cnss-emp-meta">
                                        @(string.IsNullOrWhiteSpace(e.MatriculeEmployeur) ? "—" : e.MatriculeEmployeur)
                                        · @e.CIN
                                        · @(string.IsNullOrWhiteSpace(e.NumeroCNSS) ? "—" : e.NumeroCNSS)
                                    </div>
                                </td>
                                <td class="cnss-emp-dates">
                                    <div>@e.DateEmbauche.ToString("dd/MM/yy")</div>
                                    <div class="text-muted">
                                        @(e.DateSortie.HasValue ? e.DateSortie.Value.ToString("dd/MM/yy") : "—")
                                        @if (!string.IsNullOrEmpty(e.MotifSortie))
                                        {
                                            <span title="@e.MotifSortie">· @e.MotifSortie</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center cnss-emp-jours">@e.JoursTravailles</td>
                                <td class="text-end cnss-emp-salary fw-semibold">@e.SalaireBrut.ToString("N2")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <div class="small text-muted mt-2">
                <i class="bi bi-info-circle me-1"></i>
                P = Présent · E = Entrant · S = Sortant · E+S = les deux sur la période.
            </div>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold d-flex align-items-center justify-content-between">
                <span><i class="bi bi-paperclip text-primary me-2"></i>Documents (@documents.Count)</span>
                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#uploadFormClient">
                    Déposer
                </button>
            </div>
            <div class="card-body p-0">
                <div class="collapse p-3" id="uploadFormClient">
                    <div class="p-3 rounded-3 bg-body-tertiary border">
                        <form asp-controller="Declarations" asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="declarationId" value="@Model.Id" />
                            <div class="mb-2">
                                <input type="file" name="file" class="form-control form-control-sm" required accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.csv,.doc,.docx" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col"><input type="text" name="titre" class="form-control form-control-sm" placeholder="Titre (optionnel)" /></div>
                                <div class="col-auto">
                                    <select name="categorie" class="form-select form-select-sm">
                                        <option value="Fiscal">Fiscal</option>
                                        <option value="Comptable">Comptable</option>
                                        <option value="Legal">Légal</option>
                                        <option value="Bancaire">Bancaire</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100">Envoyer</button>
                        </form>
                    </div>
                </div>

                @if (documents.Any())
                {
                    <div class="p-3" style="max-height:320px; overflow-y:auto;">
                        @foreach (var doc in documents)
                        {
                            var sBadge = doc.Statut switch { "Valide" => "success", "Rejete" => "danger", _ => "warning" };
                            <div class="d-flex align-items-center gap-2 py-2 border-bottom">
                                <i class="bi bi-file-earmark text-muted"></i>
                                <div class="flex-grow-1 min-width-0">
                                    <div class="fw-medium text-truncate small">@doc.NomFichier</div>
                                    <div class="small text-muted" style="font-size:.72rem;">@doc.Categorie · @doc.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </div>
                                <span class="badge bg-@sBadge rounded-pill" style="font-size:.65rem;">@doc.Statut</span>
                                <a href="/Declarations/DownloadDocument/@doc.Id" class="btn btn-sm text-primary" title="Télécharger"><i class="bi bi-download"></i></a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">Aucun document</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100" id="messages">
            <div class="card-header bg-white fw-semibold d-flex align-items-center justify-content-between">
                <span><i class="bi bi-chat-dots text-primary me-2"></i>Messages (@messages.Count)</span>
                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newMsgForm">Écrire</button>
            </div>
            <div class="card-body p-0">
                <div class="collapse" id="newMsgForm">
                    <div class="border-top p-3">
                        <form asp-controller="Declarations" asp-action="SendMessage" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="declarationId" value="@Model.Id" />
                            <input type="hidden" name="clientId" value="@Model.ClientId" />
                            <div class="mb-2"><input type="text" name="sujet" class="form-control form-control-sm rounded-pill" placeholder="Objet (optionnel)" style="font-size:.85rem;" /></div>
                            <div class="d-flex gap-2 align-items-end">
                                <textarea name="contenu" class="form-control flex-grow-1" rows="2" placeholder="Écrivez votre message..." required style="border-radius:20px;"></textarea>
                                <button type="submit" class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px; height:40px;" title="Envoyer"><i class="bi bi-send"></i></button>
                            </div>
                        </form>
                    </div>
                </div>

                @if (messages.Any())
                {
                    <div class="d-flex flex-column gap-2 p-3" style="max-height:320px; overflow-y:auto;">
                        @{
                            DateTime? pDate = null;
                        }
                        @foreach (var msg in messages.OrderBy(m => m.CreatedAt))
                        {
                            var isMe = msg.SenderRole == "Client";
                            if (pDate == null || msg.CreatedAt.Date != pDate)
                            {
                                pDate = msg.CreatedAt.Date;
                                var dl = msg.CreatedAt.Date == DateTime.Today ? "Aujourd'hui"
                                    : msg.CreatedAt.Date == DateTime.Today.AddDays(-1) ? "Hier"
                                    : msg.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"));
                                <div class="text-center text-muted small border-top border-bottom py-1 my-2"><span>@dl</span></div>
                            }
                            <div class="d-flex @(isMe ? "justify-content-end" : "")">
                                <div class="@(isMe ? "bg-primary text-white" : "bg-light border") rounded-3 p-3 @(isMe ? "ms-5" : "me-5")" style="max-width:80%;">
                                    <div class="d-flex align-items-center gap-1 mb-1" style="font-size:.72rem; font-weight:600;">
                                        <i class="bi @(isMe ? "bi-person" : "bi-building")"></i>
                                        <span class="@(isMe ? "text-white-50" : "text-info")">@(isMe ? "Vous" : msg.SenderName)</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(msg.Sujet))
                                    {
                                        <div class="@(isMe ? "text-white-75" : "fw-semibold")" style="font-size:.78rem; font-weight:600; margin-bottom:4px;">@msg.Sujet</div>
                                    }
                                    <div>@msg.Contenu</div>
                                    <div class="text-end small mt-1 @(isMe ? "text-white-50" : "text-muted")">@msg.CreatedAt.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">Aucun message</div>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.PdfUrl))
{
    <div class="card shadow-sm mb-4">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
            <span><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Déclaration officielle PDF</span>
            <a href="@Model.PdfUrl" target="_blank" class="btn btn-primary btn-sm"><i class="bi bi-download me-1"></i>Télécharger</a>
        </div>
    </div>
}

@if (tvaData != null || isData != null || irData != null || cnssData != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body p-0">
            <button class="btn w-100 text-start p-3 d-flex align-items-center border-0 text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#fiscalDetail" style="font-size:.85rem;">
                <i class="bi bi-calculator text-primary me-2"></i>
                <span class="text-body">Détail fiscal (optionnel)</span>
                <i class="bi bi-chevron-down ms-auto"></i>
            </button>
            <div class="collapse" id="fiscalDetail">
                <div class="px-3 pb-3">
                    @if (tvaData != null)
                    {
                        <div class="small mb-2"><strong>TVA:</strong> Collectée @tvaData.TVACollecteeTotale.ToString("N2") · Récupérable @tvaData.TVARecuperableTotale.ToString("N2") · À payer @tvaData.TVAaPayer.ToString("N2") MAD</div>
                    }
                    @if (isData != null)
                    {
                        <div class="small mb-2"><strong>IS:</strong> Base @isData.BaseImposable.ToString("N2") · Taux @isData.TauxIS.ToString("N1")% · À payer @isData.ISAPayer.ToString("N2") MAD</div>
                    }
                    @if (irData != null)
                    {
                        <div class="small mb-2"><strong>IR:</strong> Net imposable @irData.RevenuNetImposable.ToString("N2") · À payer @irData.IRNet.ToString("N2") MAD</div>
                    }
                    @if (cnssData != null)
                    {
                        <div class="small"><strong>CNSS:</strong> Employés @cnssData.NombreEmployes · Bruts @cnssData.TotalSalairesBruts.ToString("N2") · Total à payer @cnssData.MontantTotal.ToString("N2") MAD</div>
                        <div class="small text-muted">Voir le détail du personnel dans le tableau « État du personnel » ci-dessus.</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
        <div class="toast show bg-success text-white rounded-3" role="alert">
            <div class="toast-body"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
        <div class="toast show bg-danger text-white rounded-3" role="alert">
            <div class="toast-body"><i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]</div>
        </div>
    </div>
}
