@model List<PaySlipDto>
@{
    ViewData["Title"] = "Bulletins de paie";
    var payslips = Model ?? new List<PaySlipDto>();
    var totalNet = payslips.Sum(p => p.SalaireNet);
    var totalBrut = payslips.Sum(p => p.SalaireBrut);
    var totalRetenues = payslips.Sum(p => p.CotisationCNSS + p.CotisationAMO + p.IR);
}

<div class="ex-page-hero">
    <div>
        <h4>Bulletins de paie</h4>
        <p class="ex-sub">Historique des bulletins partagés pour votre entreprise.</p>
    </div>
</div>

<div class="ex-kpi-grid">
    <div class="ex-kpi">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Bulletins</div><div class="ex-kpi-value">@payslips.Count</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-file-earmark-text"></i></div>
        </div>
        <div class="ex-kpi-foot">Périodes</div>
    </div>
    <div class="ex-kpi purple">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Brut</div><div class="ex-kpi-value" style="font-size:1.35rem;">@totalBrut.ToString("N0")</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-cash-stack"></i></div>
        </div>
        <div class="ex-kpi-foot">MAD</div>
    </div>
    <div class="ex-kpi danger">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Retenues</div><div class="ex-kpi-value" style="font-size:1.35rem;">@totalRetenues.ToString("N0")</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-dash-circle"></i></div>
        </div>
        <div class="ex-kpi-foot">CNSS + AMO + IR</div>
    </div>
    <div class="ex-kpi success">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Net</div><div class="ex-kpi-value" style="font-size:1.35rem;">@totalNet.ToString("N0")</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-check-circle"></i></div>
        </div>
        <div class="ex-kpi-foot">MAD</div>
    </div>
</div>

<div class="ex-board-card">
    <div class="ex-panel-head">
        <div>
            <h3><i class="bi bi-receipt text-primary me-2"></i>Historique</h3>
            <p>Consultation des bulletins disponibles</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 ex-table">
            <thead>
                <tr>
                    <th>Période</th>
                    <th class="text-end">Brut</th>
                    <th class="text-end">CNSS</th>
                    <th class="text-end">AMO</th>
                    <th class="text-end">IR</th>
                    <th class="text-end">Net à payer</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @if (payslips.Any())
                {
                    @foreach (var p in payslips)
                    {
                        <tr>
                            <td class="fw-semibold">@p.PeriodLabel</td>
                            <td class="text-end">@p.SalaireBrut.ToString("N2")</td>
                            <td class="text-end text-danger">@p.CotisationCNSS.ToString("N2")</td>
                            <td class="text-end text-danger">@p.CotisationAMO.ToString("N2")</td>
                            <td class="text-end text-danger">@p.IR.ToString("N2")</td>
                            <td class="text-end fw-bold text-success">@p.SalaireNet.ToString("N2") MAD</td>
                            <td class="text-end"><button class="btn btn-primary btn-sm"><i class="bi bi-printer me-1"></i>Imprimer</button></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="ex-empty">
                                <i class="bi bi-file-earmark-x"></i>
                                @if (ViewBag.PaySlipsUnavailable as bool? == true)
                                {
                                    <p>Les bulletins seront bientôt disponibles dans votre espace client.</p>
                                }
                                else
                                {
                                    <p>Aucun bulletin de paie disponible.</p>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
