<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetaCompta Espace Client</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
@{
    var clientName = Context.Session.GetString("ClientName") ?? "MetaCompta";
    var userName = Context.Session.GetString("UserName") ?? "Client";
    var initials = string.Concat(clientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Nav(string c) => ctrl == c ? "nav-link active" : "nav-link";
    var badgeTasks = Context.Items["BadgeTasks"] as int? ?? 0;
    var badgeNotif = Context.Items["BadgeNotif"] as int? ?? 0;
    var badgeMsg = Context.Items["BadgeMsg"] as int? ?? 0;
}

<nav class="mc-sidebar" id="sidebar" aria-label="Navigation extranet">
    <div class="sidebar-brand">
        <div class="brand-icon"><i class="bi bi-kanban-fill"></i></div>
        <div>
            <h4>Espace Client</h4>
            <div class="brand-sub">@clientName</div>
        </div>
    </div>
    <div class="sidebar-client-context">
        <div class="client-context-card">
            <div class="client-context-label"><i class="bi bi-building"></i> Entreprise</div>
            <div class="client-context-name" title="@clientName">@clientName</div>
            <div class="client-context-hint">Portail extranet</div>
        </div>
    </div>
    <div class="sidebar-scroll">
        <div class="nav-section">Menu <span class="section-line"></span></div>
        <ul class="nav flex-column">
            <li class="nav-item"><a class="@Nav("Home")" href="/Home"><i class="bi bi-grid-1x2-fill"></i> Tableau de bord</a></li>
            <li class="nav-item"><a class="@Nav("Contrats")" href="/Contrats"><i class="bi bi-file-earmark-medical"></i> Mon contrat</a></li>
            <li class="nav-item"><a class="@Nav("Declarations")" href="/Declarations"><i class="bi bi-file-earmark-text"></i> Mes déclarations</a></li>
            <li class="nav-item"><a class="@Nav("Documents")" href="/Documents"><i class="bi bi-folder"></i> Documents</a></li>
            <li class="nav-item">
                <a class="@Nav("MessagesExtranet")" href="/MessagesExtranet"><i class="bi bi-chat-left-text"></i> Messages
                    @if (badgeMsg > 0) { <span class="nav-badge">@badgeMsg</span> }
                </a>
            </li>
            <li class="nav-item">
                <a class="@Nav("Tasks")" href="/Tasks"><i class="bi bi-check2-square"></i> Mes tâches
                    @if (badgeTasks > 0) { <span class="nav-badge">@badgeTasks</span> }
                </a>
            </li>
            <li class="nav-item"><a class="@Nav("PaySlips")" href="/PaySlips"><i class="bi bi-receipt"></i> Bulletins de paie</a></li>
            <li class="nav-item">
                <a class="@Nav("Notifications")" href="/Notifications"><i class="bi bi-bell"></i> Notifications
                    @if (badgeNotif > 0) { <span class="nav-badge">@badgeNotif</span> }
                </a>
            </li>
            <li class="nav-item"><a class="@Nav("Profile")" href="/Profile"><i class="bi bi-building"></i> Mon entreprise</a></li>
        </ul>
    </div>
</nav>

<div class="mc-main">
    <header class="mc-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light border d-md-none rounded-circle" type="button" onclick="document.getElementById('sidebar').classList.toggle('show')">
                <i class="bi bi-list"></i>
            </button>
            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">@initials</span>
            <span class="fw-bold d-none d-sm-inline">@clientName</span>
        </div>
        <div class="user-menu">
            <a class="notification-bell text-decoration-none position-relative" href="/Notifications" title="Notifications">
                <i class="bi bi-bell"></i>
                @if (badgeNotif > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.55rem;">@badgeNotif</span>
                }
            </a>
            <div class="dropdown">
                <button class="btn btn-light border rounded-pill dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                    <span class="user-avatar">@(string.IsNullOrEmpty(userName) ? "C" : userName.Substring(0, 1).ToUpper())</span>
                    <span class="d-none d-md-inline small fw-semibold">@userName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/Profile"><i class="bi bi-building me-2"></i>Mon entreprise</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                </ul>
            </div>
        </div>
    </header>
    <div class="mc-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
