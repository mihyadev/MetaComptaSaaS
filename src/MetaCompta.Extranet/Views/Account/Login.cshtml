@{
    ViewData["Title"] = "Connexion";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MetaCompta - Espace Client</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { min-height: 100vh; background: linear-gradient(135deg, #0c4a6e, #0369a1, #0ea5e9); display: flex; align-items: center; justify-content: center; }
        .login-card { background: #fff; border-radius: 20px; padding: 3rem; max-width: 420px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        .login-card h2 { font-weight: 800; }
        .btn-ext { background: linear-gradient(135deg, #0ea5e9, #0369a1); border: none; border-radius: 12px; padding: 0.75rem; font-weight: 600; }
        .btn-ext:hover { transform: translateY(-1px); box-shadow: 0 5px 15px rgba(14,165,233,0.4); }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <h2>🏛️ MetaCompta</h2>
            <p class="text-muted">Espace Client — Portail Extranet</p>
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 rounded-3"><i class="bi bi-exclamation-triangle me-1"></i>@Html.ValidationSummary(true)</div>
        }
        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-medium">Email</label>
                <input type="email" name="email" class="form-control" placeholder="votre@email.ma" required style="border-radius:10px;" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-medium">Mot de passe</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required style="border-radius:10px;" />
            </div>
            <button type="submit" class="btn btn-ext btn-primary w-100 mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Se Connecter
            </button>
        </form>
        <div class="text-center"><small class="text-muted">© 2026 MetaCompta. Portail Client Sécurisé.</small></div>
    </div>
</body>
</html>
