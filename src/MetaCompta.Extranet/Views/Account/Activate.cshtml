@model MetaCompta.Application.DTOs.ActivateAccountDto
@{
    ViewData["Title"] = "Activation du compte";
    Layout = null;
    var fullName = ViewBag.FullName as string ?? "";
    var email = ViewBag.Email as string ?? "";
    var alreadyActivated = ViewBag.AlreadyActivated as bool? ?? false;
    var tokenInvalid = ViewBag.TokenInvalid as bool? ?? false;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MetaCompta - Activation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="container" style="max-width:480px;">
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:56px;height:56px;background:rgba(14,165,233,.12);color:#0ea5e9;font-size:1.5rem;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h1 class="h4 fw-bold mb-1">Activer votre espace client</h1>
                    @if (!string.IsNullOrEmpty(fullName))
                    {
                        <p class="text-secondary small mb-0">@fullName · @email</p>
                    }
                </div>

                @if (alreadyActivated)
                {
                    <div class="alert alert-success rounded-4">Compte déjà activé. Vous pouvez vous connecter.</div>
                    <a class="btn btn-primary w-100 rounded-pill" href="@Url.Action("Login", "Account")">Se connecter</a>
                }
                else if (tokenInvalid)
                {
                    <div class="alert alert-danger rounded-4">
                        Ce lien est invalide ou a expiré. Contactez votre cabinet pour un nouvel email.
                    </div>
                    <a class="btn btn-outline-secondary w-100 rounded-pill" href="@Url.Action("Login", "Account")">Retour</a>
                }
                else
                {
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 rounded-4">@Html.ValidationSummary(false)</div>
                    }
                    <form method="post" asp-action="Activate" asp-controller="Account">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold" asp-for="Password">Mot de passe</label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required />
                            <div class="form-text">Min. 8 caractères, majuscule, chiffre et caractère spécial.</div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold" asp-for="ConfirmPassword">Confirmer</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill btn-lg">
                            <i class="bi bi-check2-circle me-1"></i>Activer mon compte
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</body>
</html>
