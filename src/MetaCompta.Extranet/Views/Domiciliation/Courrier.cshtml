@using MetaCompta.Domain.Common
@model MetaCompta.Application.DTOs.CourrierDomiciliationDto
@{
    ViewData["Title"] = "Correspondance";
    var hasOpenAction = Model.ActionsClient?.Any(a => a.Statut != "Closed" && a.Statut is not ("HandedOver" or "Delivered")) == true;
    var canAct = !hasOpenAction && Model.ClientNotifie && Model.Statut is not ("Closed" or "Archived");
    var statutLabel = RefCodes.StatutCourrierDomiciliation.Label(Model.Statut);
}

<div class="ex-page-hero">
    <div>
        <a href="/Domiciliation" class="ex-icon-btn mb-2" title="Retour"><i class="bi bi-arrow-left"></i></a>
        <h4 class="mb-1">@(Model.Expediteur ?? Model.TypeCourrier)</h4>
        <p class="ex-sub mb-0">Correspondance · @Model.TypeCourrier · @Model.DateReception.ToLocalTime().ToString("dd/MM/yyyy")</p>
    </div>
    <span class="badge bg-primary rounded-pill px-3 py-2">@statutLabel</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]</div>
}

@{
    var sharedPieces = Model.PartageDocumentClient
        ? (Model.Pieces?.Any() == true
            ? Model.Pieces
            : (Model.ScanDocumentId.HasValue
                ? new List<MetaCompta.Application.DTOs.CourrierPieceJointeDto>
                {
                    new()
                    {
                        DocumentId = Model.ScanDocumentId.Value,
                        Titre = Model.ScanDocumentTitre ?? "Document",
                        NomFichier = Model.ScanDocumentTitre ?? "document",
                        ContentType = "application/pdf",
                        IsPrimary = true
                    }
                }
                : new List<MetaCompta.Application.DTOs.CourrierPieceJointeDto>()))
        : new List<MetaCompta.Application.DTOs.CourrierPieceJointeDto>();
}

@if (sharedPieces.Any())
{
    <div class="ex-board-card mb-4">
        <div class="ex-panel-head">
            <div>
                <h3><i class="bi bi-images text-primary me-2"></i>Documents</h3>
                <p>Fichiers partagés par le cabinet</p>
            </div>
        </div>
        <div class="row g-3 px-3 pb-3">
            @foreach (var p in sharedPieces)
            {
                <div class="col-6 col-md-4">
                    <a href="/Declarations/DownloadDocument/@p.DocumentId" class="text-decoration-none d-block border rounded-3 p-3 h-100 bg-body-tertiary">
                        <div class="text-center mb-2"><i class="bi bi-file-earmark-pdf text-danger fs-2"></i></div>
                        <div class="fw-semibold text-dark text-truncate small">@p.Titre</div>
                    </a>
                </div>
            }
        </div>
    </div>
}

@if (canAct)
{
    <div class="alert alert-warning border-0 rounded-4 mb-3">
        <strong>Choisissez une seule action</strong> — le cabinet s’occupe ensuite.
    </div>
    <div class="ex-board-card mb-4">
        <div class="row g-3 px-3 py-3">
            <div class="col-md-6">
                <form method="post" action="/Domiciliation/Courrier/@Model.Id/Action" class="p-3 rounded-3 border h-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TypeAction" value="Pickup" />
                    <div class="fw-bold mb-1">1. Retrait au cabinet</div>
                    <p class="small text-muted mb-3">Je viens récupérer le courrier.</p>
                    <button type="submit" class="btn btn-primary btn-sm">Demander le retrait</button>
                </form>
            </div>
            <div class="col-md-6">
                <form method="post" action="/Domiciliation/Courrier/@Model.Id/Action" class="p-3 rounded-3 border h-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TypeAction" value="Forward" />
                    <div class="fw-bold mb-1">2. Réexpédition</div>
                    <p class="small text-muted mb-2">Envoyez à mon adresse.</p>
                    <input name="AdresseForward" class="form-control form-control-sm mb-2" placeholder="Adresse complète" required />
                    <button type="submit" class="btn btn-outline-primary btn-sm">Demander la réexpédition</button>
                </form>
            </div>
            <div class="col-md-6">
                <form method="post" action="/Domiciliation/Courrier/@Model.Id/Action" class="p-3 rounded-3 border h-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TypeAction" value="View" />
                    <div class="fw-bold mb-1">3. Consultation seule</div>
                    <p class="small text-muted mb-3">J’ai lu le document — rien d’autre.</p>
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Confirmer</button>
                </form>
            </div>
            <div class="col-md-6">
                <form method="post" action="/Domiciliation/Courrier/@Model.Id/Action" class="p-3 rounded-3 border h-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TypeAction" value="Archive" />
                    <div class="fw-bold mb-1">4. Aucune suite</div>
                    <p class="small text-muted mb-3">Pas de retrait ni envoi.</p>
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Archiver</button>
                </form>
            </div>
        </div>
    </div>
}
else if (hasOpenAction)
{
    <div class="ex-board-card">
        <div class="ex-empty py-4">
            <i class="bi bi-hourglass-split text-info"></i>
            <h5 class="mt-3 fw-bold">Demande envoyée</h5>
            <p>Le cabinet traite votre demande.</p>
        </div>
    </div>
}
else if (!Model.ClientNotifie)
{
    <div class="ex-board-card">
        <div class="ex-empty py-4">
            <i class="bi bi-envelope text-muted"></i>
            <h5 class="mt-3 fw-bold">Pas encore disponible</h5>
            <p>Le cabinet n’a pas encore ouvert ce courrier pour vous.</p>
        </div>
    </div>
}
else
{
    <div class="ex-board-card">
        <div class="ex-empty py-4">
            <i class="bi bi-check-circle text-success"></i>
            <h5 class="mt-3 fw-bold">Terminé</h5>
            <p>Aucune action en cours.</p>
        </div>
    </div>
}
