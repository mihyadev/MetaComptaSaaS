@model List<MetaCompta.Application.DTOs.DocumentDto>
@using MetaCompta.Application.DTOs
@{
    ViewData["Title"] = "Mes Documents";
    var documents = Model ?? new List<DocumentDto>();
    var validated = documents.Count(d => d.Statut == "Valide");
    var pending = documents.Count(d => d.Statut == "EnAttente");
}

<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1">Mes Documents</h4>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0" style="font-size:0.8rem;"><li class="breadcrumb-item"><a href="/Home" class="text-decoration-none">Accueil</a></li><li class="breadcrumb-item active">Documents</li></ol></nav>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm h-100 border-start border-primary border-4">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div><div class="small text-muted text-uppercase fw-semibold">Total Documents</div><div class="fs-3 fw-bold">@documents.Count</div></div>
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary flex-shrink-0" style="width:48px;height:48px;"><i class="bi bi-folder-fill fs-5"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm h-100 border-start border-success border-4">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div><div class="small text-muted text-uppercase fw-semibold">Validés</div><div class="fs-3 fw-bold text-success">@validated</div></div>
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success flex-shrink-0" style="width:48px;height:48px;"><i class="bi bi-check-circle fs-5"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm h-100 border-start border-warning border-4">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div><div class="small text-muted text-uppercase fw-semibold">En attente</div><div class="fs-3 fw-bold text-warning">@pending</div></div>
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning flex-shrink-0" style="width:48px;height:48px;"><i class="bi bi-hourglass-split fs-5"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm h-100 border-start border-danger border-4">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div><div class="small text-muted text-uppercase fw-semibold">Rejetés</div><div class="fs-3 fw-bold text-danger">@documents.Count(d => d.Statut == "Rejete")</div></div>
                <div class="rounded-3 d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger flex-shrink-0" style="width:48px;height:48px;"><i class="bi bi-x-circle fs-5"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <span class="fw-semibold"><i class="bi bi-file-earmark-text text-primary me-2"></i>Liste des documents</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th class="ps-4">Document</th><th>Catégorie</th><th>Type</th><th>Taille</th><th>Date</th><th>Statut</th><th></th></tr></thead>
                <tbody>
                    @if (documents.Any())
                    {
                        foreach (var doc in documents.OrderByDescending(d => d.CreatedAt))
                        {
                            var icon = (doc.ContentType ?? "") switch {
                                var ct when ct.Contains("pdf") => "bi-file-earmark-pdf text-danger",
                                var ct when ct.Contains("image") => "bi-file-earmark-image text-success",
                                var ct when ct.Contains("excel") || ct.Contains("spreadsheet") => "bi-file-earmark-excel text-success",
                                var ct when ct.Contains("word") => "bi-file-earmark-word text-primary",
                                _ => "bi-file-earmark text-secondary"
                            };
                            var sClass = doc.Statut switch { "Valide" => "success", "EnAttente" => "warning", "Rejete" => "danger", _ => "secondary" };
                            var sLabel = doc.Statut switch { "Valide" => "Validé", "EnAttente" => "En attente", "Rejete" => "Rejeté", _ => doc.Statut };
                            <tr>
                                <td class="ps-4"><div class="d-flex align-items-center gap-2"><i class="bi @icon fs-5"></i><span class="fw-medium">@doc.NomFichier</span></div></td>
                                <td><span class="badge bg-info bg-opacity-10 text-info rounded-pill">@doc.Categorie</span></td>
                                <td class="small">@doc.TypeDocument</td>
                                <td class="small">@doc.TailleFichier</td>
                                <td class="small">@doc.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-@sClass rounded-pill">@sLabel</span></td>
                                <td class="text-end pe-3">
                                    <a href="/Declarations/DownloadDocument/@doc.Id" class="btn btn-sm btn-outline-primary" title="Télécharger"><i class="bi bi-download"></i></a>
                                    @if (doc.DeclarationId.HasValue)
                                    {
                                        <a href="/Declarations/Details/@doc.DeclarationId" class="btn btn-sm btn-outline-secondary" title="Déclaration"><i class="bi bi-box-arrow-up-right"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-folder-x text-muted" style="font-size:3rem;"></i>
                                <p class="mt-2 mb-0 fw-medium text-muted">Aucun document</p>
                                <p class="small mb-0 text-muted">Vos documents apparaîtront ici une fois partagés par votre cabinet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

