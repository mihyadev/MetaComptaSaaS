@model List<MetaCompta.Application.DTOs.DocumentDto>
@using MetaCompta.Application.DTOs
@{
    ViewData["Title"] = "Documents";
    var documents = Model ?? new List<DocumentDto>();
    var validated = documents.Count(d => d.Statut == "Valide");
    var pending = documents.Count(d => d.Statut == "EnAttente");
    var rejected = documents.Count(d => d.Statut == "Rejete");
}

<div class="ex-page-hero">
    <div>
        <h4>Documents</h4>
        <p class="ex-sub">Fichiers partagés par votre cabinet et documents que vous avez déposés.</p>
    </div>
</div>

<div class="ex-kpi-grid">
    <div class="ex-kpi">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Total</div><div class="ex-kpi-value">@documents.Count</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-folder-fill"></i></div>
        </div>
        <div class="ex-kpi-foot">Tous les documents</div>
    </div>
    <div class="ex-kpi success">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Validés</div><div class="ex-kpi-value">@validated</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-check-circle"></i></div>
        </div>
        <div class="ex-kpi-foot">Approuvés</div>
    </div>
    <div class="ex-kpi warning">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">En attente</div><div class="ex-kpi-value">@pending</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-hourglass-split"></i></div>
        </div>
        <div class="ex-kpi-foot">À traiter</div>
    </div>
    <div class="ex-kpi danger">
        <div class="ex-kpi-top">
            <div><div class="ex-kpi-label">Rejetés</div><div class="ex-kpi-value">@rejected</div></div>
            <div class="ex-kpi-icon"><i class="bi bi-x-circle"></i></div>
        </div>
        <div class="ex-kpi-foot">À corriger</div>
    </div>
</div>

<div class="ex-board-card">
    <div class="ex-panel-head">
        <div>
            <h3><i class="bi bi-file-earmark-text text-primary me-2"></i>Liste des documents</h3>
            <p>Téléchargez ou ouvrez la déclaration liée</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 ex-table">
            <thead><tr><th>Document</th><th>Catégorie</th><th>Type</th><th>Taille</th><th>Date</th><th>Statut</th><th></th></tr></thead>
            <tbody>
            @if (documents.Any())
            {
                foreach (var doc in documents.OrderByDescending(d => d.CreatedAt))
                {
                    var icon = (doc.ContentType ?? "") switch {
                        var ct when ct.Contains("pdf") => "bi-file-earmark-pdf text-danger",
                        var ct when ct.Contains("image") => "bi-file-earmark-image text-success",
                        var ct when ct.Contains("excel") || ct.Contains("spreadsheet") => "bi-file-earmark-excel text-success",
                        var ct when ct.Contains("word") => "bi-file-earmark-word text-primary",
                        _ => "bi-file-earmark text-secondary"
                    };
                    var sClass = doc.Statut switch { "Valide" => "success", "EnAttente" => "warning", "Rejete" => "danger", _ => "secondary" };
                    var sLabel = doc.Statut switch { "Valide" => "Validé", "EnAttente" => "En attente", "Rejete" => "Rejeté", _ => doc.Statut };
                    <tr>
                        <td><div class="d-flex align-items-center gap-2"><i class="bi @icon fs-5"></i><span class="fw-semibold">@doc.NomFichier</span></div></td>
                        <td><span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@doc.Categorie</span></td>
                        <td class="small">@doc.TypeDocument</td>
                        <td class="small">@doc.TailleFichier</td>
                        <td class="small">@doc.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge bg-@sClass rounded-pill">@sLabel</span></td>
                        <td class="text-end">
                            <a href="/Declarations/DownloadDocument/@doc.Id" class="btn btn-sm btn-outline-primary" title="Télécharger"><i class="bi bi-download"></i></a>
                            @if (doc.DeclarationId.HasValue)
                            {
                                <a href="/Declarations/Details/@doc.DeclarationId" class="btn btn-sm btn-outline-secondary" title="Déclaration"><i class="bi bi-box-arrow-up-right"></i></a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">
                        <div class="ex-empty">
                            <i class="bi bi-folder-x"></i>
                            <p>Aucun document partagé pour le moment.</p>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
