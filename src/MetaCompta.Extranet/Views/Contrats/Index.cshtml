@model ContratCommercialDto?
@{
    ViewData["Title"] = "Mon contrat";
    var hasContract = ViewBag.HasContract as bool? ?? false;
    var declarations = ViewBag.Declarations as List<DeclarationDto> ?? new();
}

@if (!hasContract || Model == null)
{
    <div class="ex-page-hero">
        <div>
            <h4>Mon contrat</h4>
            <p class="ex-sub">Synthèse de votre mission fiduciaire.</p>
        </div>
    </div>
    <div class="ex-board-card">
        <div class="ex-empty py-5">
            <i class="bi bi-file-earmark-text"></i>
            <p>Aucun contrat n'est encore disponible dans votre espace client.</p>
        </div>
    </div>
}
else
{
    <div class="ex-page-hero">
        <div>
            <h4>Mon contrat</h4>
            <p class="ex-sub">Honoraires, périmètre et suivi des dépôts.</p>
        </div>
        <span class="badge text-bg-success rounded-pill px-3 py-2">@Model.Statut</span>
    </div>

    <div class="ex-company-banner">
        <div class="ex-co-mark"><i class="bi bi-file-earmark-medical"></i></div>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="h5 mb-1 fw-bold" style="letter-spacing:-0.02em;">@Model.Reference</h2>
                    <p class="ex-sub mb-0">@(Model.Objet ?? "Contrat de mission fiduciaire")</p>
                </div>
                <div class="text-md-end">
                    <div class="small text-muted fw-semibold text-uppercase" style="letter-spacing:.04em;">Validité</div>
                    <div class="fw-bold">
                        @(Model.DateDebutContrat?.ToString("dd/MM/yyyy") ?? "—")
                        <span class="text-muted mx-1">→</span>
                        @(Model.DateFinContrat?.ToString("dd/MM/yyyy") ?? "—")
                    </div>
                </div>
            </div>
            <div class="ex-meta-row mt-3">
                <span><i class="bi bi-upc"></i>ICE <strong>@(Model.ClientICE ?? "—")</strong></span>
                <span><i class="bi bi-hash"></i>IF <strong>@(Model.ClientIF ?? "—")</strong></span>
                <span><i class="bi bi-shield"></i>CNSS <strong>@(Model.ClientNumeroCNSS ?? "—")</strong></span>
                <span><i class="bi bi-geo"></i>RC <strong>@(string.IsNullOrWhiteSpace(Model.ClientRC) ? "—" : Model.ClientRC)@(string.IsNullOrWhiteSpace(Model.ClientVille) ? "" : " — " + Model.ClientVille)</strong></span>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-7">
            <div class="ex-board-card h-100">
                <div class="ex-panel-head"><div><h3><i class="bi bi-cash-coin text-primary me-2"></i>Grille d'honoraires</h3><p>Détail des lignes contractuelles</p></div></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 ex-table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Prix HT</th>
                                <th class="text-end">Remise %</th>
                                <th class="text-end">TVA %</th>
                                <th class="text-end">TTC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.Lignes.OrderBy(x => x.Ordre))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@l.Description</div>
                                        @if (!string.IsNullOrWhiteSpace(l.ModeFacturation))
                                        {
                                            <small class="text-muted">@l.ModeFacturation</small>
                                        }
                                    </td>
                                    <td class="text-end">@l.PrixUnitaireHT.ToString("N2")</td>
                                    <td class="text-end">@((l.RemisePourcentage ?? 0).ToString("N2"))</td>
                                    <td class="text-end">@l.TauxTVA.ToString("N0")</td>
                                    <td class="text-end fw-semibold">@l.MontantTTC.ToString("N2")</td>
                                </tr>
                            }
                            @if (!Model.Lignes.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Aucune ligne d'honoraires</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-semibold">Total contrat TTC (@Model.Devise)</td>
                                <td class="text-end fw-bold">@Model.MontantTTC.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="ex-board-card h-100">
                <div class="ex-panel-head"><div><h3><i class="bi bi-check2-square text-success me-2"></i>Périmètre de mission</h3><p>Services opérationnels</p></div></div>
                <div class="ex-panel-body">
                    @if (Model.ServicesActives.Any())
                    {
                        <div class="ex-activity-list">
                            @foreach (var s in Model.ServicesActives)
                            {
                                <div class="ex-activity-item">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                        <div>
                                            <div class="fw-semibold">@(s.LibelleService ?? s.TypeService)</div>
                                            <div class="ex-activity-meta">@s.TypeService</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ex-empty"><p>Aucun service opérationnel listé sur ce contrat.</p></div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="ex-board-card">
        <div class="ex-panel-head"><div><h3><i class="bi bi-clipboard2-check text-primary me-2"></i>Suivi des dépôts</h3><p>Déclarations liées au contrat</p></div></div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 ex-table">
                <thead>
                    <tr>
                        <th>Déclaration</th>
                        <th>Période</th>
                        <th>Statut</th>
                        <th>Reçu / PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in declarations.OrderByDescending(x => x.DateLimite))
                    {
                        var badge = d.Statut switch
                        {
                            "Brouillon" or "ACompleter" => ("secondary", "À faire"),
                            "EnCours" or "EnPreparation" or "EnRevision" => ("warning", "En cours"),
                            "Completee" or "Validee" => ("info", "Prêt"),
                            "Soumise" or "Payee" => ("success", "Déposé / Transmis"),
                            _ => ("light", d.Statut)
                        };
                        <tr>
                            <td class="fw-semibold">@d.Type</td>
                            <td class="small">@(string.IsNullOrWhiteSpace(d.Periode) ? d.DateDebut.ToString("MM/yyyy") : d.Periode)</td>
                            <td><span class="badge text-bg-@badge.Item1 rounded-pill">@badge.Item2</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.PdfUrl))
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@d.PdfUrl" target="_blank" rel="noopener">
                                        <i class="bi bi-download me-1"></i>Reçu
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!declarations.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">Aucune déclaration générée pour le moment</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
